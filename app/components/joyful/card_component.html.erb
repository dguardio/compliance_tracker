<%= tag.div(**@system_arguments.merge(class: "bg-white rounded-card shadow-sm border border-slate-100 overflow-hidden hover:shadow-primary-glow transition-shadow duration-300 #{@system_arguments[:class]}")) do %>
  <% if card_header? %>
    <%= card_header %>
  <% elsif @title.present? || @icon.present? %>
    <div class="px-6 py-4 border-b border-slate-50 flex items-start justify-between">
       <div class="flex items-center gap-3">
          <% if @icon %>
             <div class="p-2 bg-primary-50 rounded-lg text-primary-600">
               <i class="<%= @icon %> text-lg"></i>
             </div>
          <% end %>
          <div>
            <% if @title %>
              <h3 class="text-base font-semibold text-gray-900"><%= @title %></h3>
            <% end %>
            <% if @subtitle %>
              <p class="text-sm text-gray-500 tabular-nums"><%= @subtitle %></p>
            <% end %>
          </div>
       </div>
       <% if actions? %>
         <div class="flex items-center gap-2">
           <%= actions %>
         </div>
       <% end %>
    </div>
  <% end %>

  <div class="<%= @padding ? 'p-6' : '' %>">
    <%= content %>
  </div>

  <% if footer? %>
    <div class="px-6 py-4 bg-slate-50 border-t border-slate-100">
      <%= footer %>
    </div>
  <% end %>
<% end %>
