<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
  <!-- Header -->
  <div class="flex items-end justify-between mb-8">
    <div>
      <h1 class="text-3xl font-bold text-gray-900 tracking-tight">The Audit Room</h1>
      <p class="mt-2 text-lg text-gray-500">Collect, organize, and submit evidence. <span class="text-indigo-600 font-medium">Keep the auditors smiling.</span></p>
    </div>
    <%= render Joyful::ButtonComponent.new(text: "New Request", variant: :primary, path: new_organization_evidence_request_path(@organization), icon: "fa fa-plus") %>
  </div>

  <!-- Big Friendly Dropzone (Visual Placeholder) -->
  <div class="mb-12 bg-white rounded-3xl border-4 border-dashed border-slate-200 p-12 text-center hover:border-indigo-300 hover:bg-indigo-50 transition-all cursor-pointer group relative overflow-hidden">
     <!-- Decoration -->
     <div class="absolute top-0 right-0 w-64 h-64 bg-indigo-100 rounded-full blur-3xl opacity-0 group-hover:opacity-50 transition-opacity translate-x-1/2 -translate-y-1/2 pointer-events-none"></div>

     <div class="relative z-10">
        <div class="mx-auto h-20 w-20 bg-indigo-100 text-indigo-600 rounded-full flex items-center justify-center mb-6 group-hover:scale-110 transition-transform shadow-sm">
           <svg class="h-10 w-10" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 16a4 4 0 01-.88-7.903A5 5 0 1115.9 6L16 6a5 5 0 011 9.9M15 13l-3-3m0 0l-3 3m3-3v12"></path></svg>
        </div>
        <h3 class="text-xl font-bold text-gray-900 mb-2">Drop files here to start</h3>
        <p class="text-gray-500 mb-6">Or click to browse your computer. We support PDF, DOCX, and PNG.</p>
        <%= render Joyful::ButtonComponent.new(text: "Upload Evidence", variant: :secondary, path: "#") %> <!-- Placeholder action -->
     </div>
  </div>

  <!-- Filter Tabs -->
  <div class="border-b border-gray-200 mb-6">
      <nav class="-mb-px flex space-x-8" aria-label="Tabs">
        <a href="#" class="border-indigo-500 text-indigo-600 whitespace-nowrap py-4 px-1 border-b-2 font-medium text-sm" aria-current="page">Open Requests</a>
        <a href="#" class="border-transparent text-gray-500 hover:text-gray-700 hover:border-gray-300 whitespace-nowrap py-4 px-1 border-b-2 font-medium text-sm">Review Pending</a>
        <a href="#" class="border-transparent text-gray-500 hover:text-gray-700 hover:border-gray-300 whitespace-nowrap py-4 px-1 border-b-2 font-medium text-sm">Approved</a>
        <a href="#" class="border-transparent text-gray-500 hover:text-gray-700 hover:border-gray-300 whitespace-nowrap py-4 px-1 border-b-2 font-medium text-sm">Rejected</a>
      </nav>
  </div>

  <!-- Evidence List -->
  <div class="space-y-4">
      <% if @evidence_requests.any? %>
         <% @evidence_requests.each do |request| %>
            <%= render Joyful::CardComponent.new(padding: false) do %>
                <div class="p-4 sm:px-6 flex items-center gap-6 group hover:bg-slate-50 transition-colors cursor-pointer"
                     data-controller="drawer-trigger" 
                     data-action="click->drawer-trigger#open" 
                     data-drawer-trigger-id-value="evidence-drawer-<%= request.id %>">
                   
                   <!-- Status Icon -->
                   <div class="flex-shrink-0">
                      <% case request.status %>
                      <% when 'approved' %>
                        <div class="h-10 w-10 rounded-full bg-success-100 flex items-center justify-center text-success-600">
                           <svg class="h-6 w-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path></svg>
                        </div>
                      <% when 'rejected' %>
                         <div class="h-10 w-10 rounded-full bg-danger-100 flex items-center justify-center text-danger-600">
                           <svg class="h-6 w-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path></svg>
                        </div>
                      <% else %> <!-- draft / open -->
                         <div class="h-10 w-10 rounded-full bg-primary-100 flex items-center justify-center text-primary-600">
                           <svg class="h-6 w-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"></path></svg>
                        </div>
                      <% end %>
                   </div>

                   <!-- Main Info -->
                   <div class="flex-1 min-w-0 grid grid-cols-1 md:grid-cols-2 gap-4">
                       <div>
                          <h4 class="text-base font-semibold text-gray-900 truncate group-hover:text-primary-600 transition-colors"><%= request.title %></h4>
                          <p class="text-sm text-gray-500">
                             <% if request.compliance_control %>
                                Linked to: <%= request.compliance_control.name %>
                             <% else %>
                                No control linked
                             <% end %>
                          </p>
                       </div>
                       <div class="flex items-center gap-4 text-sm text-gray-500">
                          <div class="flex items-center gap-2">
                             <div class="h-6 w-6 rounded-full bg-slate-200 flex items-center justify-center text-xs font-bold text-slate-600">
                                <%= request.assigned_to&.first_name&.first || "?" %>
                             </div>
                             <span><%= request.assigned_to&.first_name || "Unassigned" %></span>
                          </div>
                          <div>
                             Due <%= request.due_date&.strftime('%b %d') %>
                          </div>
                       </div>
                   </div>

                   <!-- Pill and Action -->
                   <div class="flex items-center gap-4">
                      <%= render Joyful::StatusPillComponent.new(status: request.status, text: request.status) %>
                      <div class="opacity-0 group-hover:opacity-100 transition-opacity">
                         <svg class="h-5 w-5 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"></path></svg>
                      </div>
                   </div>
                </div>
            <% end %>

            <!-- Hidden Drawer for each request -->
            <%= render Joyful::DrawerComponent.new(title: request.title, id: "evidence-drawer-#{request.id}") do %>
               <div class="space-y-6">
                  <div>
                     <h3 class="text-sm font-medium text-gray-500">Details</h3>
                     <div class="mt-2 text-sm text-gray-900 prose prose-sm">
                        <%= request.description.presence || "No description." %>
                     </div>
                  </div>
                  <div>
                    <h3 class="text-sm font-medium text-gray-500">Control</h3>
                    <p class="mt-1 text-sm text-gray-900 font-medium"><%= request.compliance_control&.name || "None" %></p>
                  </div>
                  
                  <div class="pt-4 border-t border-gray-100">
                      <h3 class="text-sm font-medium text-gray-900 mb-4">Evidence Files</h3>
                      <!-- Simulate file list -->
                      <p class="text-sm text-gray-500 italic">No files uploaded yet.</p>
                      <div class="mt-4">
                         <%= render Joyful::ButtonComponent.new(text: "Upload File", variant: :secondary) %>
                      </div>
                  </div>

                  <div class="pt-4 border-t border-gray-100">
                     <%= link_to "View Full Request", organization_evidence_request_path(@organization, request), class: "w-full flex justify-center py-2 px-4 border border-transparent rounded-pill shadow-sm text-sm font-medium text-white bg-primary-600 hover:bg-primary-700 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-primary-500" %>
                  </div>
               </div>
            <% end %>

         <% end %>
      <% else %>
         <div class="text-center py-12">
            <h3 class="text-lg font-medium text-gray-900">No requests found</h3>
            <p class="text-gray-500">Create a new evidence request to get started.</p>
         </div>
      <% end %>
  </div>
</div>
