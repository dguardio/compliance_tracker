<div class="min-h-screen bg-gray-50 py-8">
  <div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="mb-6">
      <%= link_to "← Back to Evidence Requests", organization_evidence_requests_path(@organization), class: "text-indigo-600 hover:text-indigo-900 font-medium" %>
    </div>
    
    <div class="bg-white shadow overflow-hidden sm:rounded-lg">
      <div class="px-4 py-5 sm:px-6">
        <h3 class="text-lg leading-6 font-medium text-gray-900">Edit Evidence Request</h3>
        <p class="mt-1 max-w-2xl text-sm text-gray-500">Update evidence request details.</p>
      </div>
      <div class="border-t border-gray-200 px-4 py-5 sm:p-6">
        <%= render 'form', evidence_request: @evidence_request %>
      </div>
    </div>
  </div>
</div>
