<%= form_with(model: [@organization, evidence_request], local: true, class: "space-y-6") do |form| %>
  <% if evidence_request.errors.any? %>
    <div class="rounded-md bg-red-50 p-4">
      <div class="flex">
        <div class="flex-shrink-0">
          <svg class="h-5 w-5 text-red-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-2.5L13.732 4c-.77-.833-1.964-.833-2.732 0L3.732 16.5c-.77.833.192 2.5 1.732 2.5z" />
          </svg>
        </div>
        <div class="ml-3">
          <h3 class="text-sm font-medium text-red-800">
            <%= pluralize(evidence_request.errors.count, "error") %> prohibited this evidence request from being saved:
          </h3>
          <div class="mt-2 text-sm text-red-700">
            <ul class="list-disc pl-5 space-y-1">
              <% evidence_request.errors.full_messages.each do |message| %>
                <li><%= message %></li>
              <% end %>
            </ul>
          </div>
        </div>
      </div>
    </div>
  <% end %>

  <div>
    <%= form.label :title, class: "block text-sm font-medium text-gray-700" %>
    <div class="mt-1">
      <%= form.text_field :title, class: "shadow-sm focus:ring-indigo-500 focus:border-indigo-500 block w-full sm:text-sm border-gray-300 rounded-md" %>
    </div>
  </div>

  <div>
    <%= form.label :description, class: "block text-sm font-medium text-gray-700" %>
    <div class="mt-1">
      <%= form.text_area :description, rows: 4, class: "shadow-sm focus:ring-indigo-500 focus:border-indigo-500 block w-full sm:text-sm border-gray-300 rounded-md" %>
    </div>
  </div>

  <div class="grid grid-cols-1 gap-y-6 gap-x-4 sm:grid-cols-2">
    <div>
      <%= form.label :status, class: "block text-sm font-medium text-gray-700" %>
      <div class="mt-1">
        <%= form.select :status, EvidenceRequest.statuses.keys.map { |w| [w.titleize, w] }, {}, class: "shadow-sm focus:ring-indigo-500 focus:border-indigo-500 block w-full sm:text-sm border-gray-300 rounded-md" %>
      </div>
    </div>

    <div>
      <%= form.label :due_date, class: "block text-sm font-medium text-gray-700" %>
      <div class="mt-1">
        <%= form.date_field :due_date, class: "shadow-sm focus:ring-indigo-500 focus:border-indigo-500 block w-full sm:text-sm border-gray-300 rounded-md" %>
      </div>
    </div>
  </div>

  <div>
    <%= form.label :assigned_to_id, "Assigned To", class: "block text-sm font-medium text-gray-700" %>
    <div class="mt-1">
      <%= form.collection_select :assigned_to_id, @organization.users, :id, :full_name, { prompt: 'Select User' }, class: "shadow-sm focus:ring-indigo-500 focus:border-indigo-500 block w-full sm:text-sm border-gray-300 rounded-md" %>
    </div>
  </div>

  <div class="grid grid-cols-1 gap-y-6 gap-x-4 sm:grid-cols-2">
    <div>
      <%= form.label :compliance_requirement_id, "Requirement", class: "block text-sm font-medium text-gray-700" %>
      <div class="mt-1">
        <%= form.collection_select :compliance_requirement_id, @organization.compliance_requirements, :id, :name, { prompt: 'Select Requirement' }, class: "shadow-sm focus:ring-indigo-500 focus:border-indigo-500 block w-full sm:text-sm border-gray-300 rounded-md" %>
      </div>
    </div>

    <div>
      <%= form.label :compliance_control_id, "Control", class: "block text-sm font-medium text-gray-700" %>
      <div class="mt-1">
        <%= form.collection_select :compliance_control_id, @organization.compliance_controls, :id, :name, { prompt: 'Select Control' }, class: "shadow-sm focus:ring-indigo-500 focus:border-indigo-500 block w-full sm:text-sm border-gray-300 rounded-md" %>
      </div>
    </div>
  </div>

  <div>
    <%= form.label :document_ids, "Link Existing Documents", class: "block text-sm font-medium text-gray-700" %>
    <div class="mt-1">
      <%= form.collection_select :document_ids, @organization.documents, :id, :title, { prompt: 'Select Documents' }, { multiple: true, class: "shadow-sm focus:ring-indigo-500 focus:border-indigo-500 block w-full sm:text-sm border-gray-300 rounded-md" } %>
      <p class="mt-2 text-sm text-gray-500">Hold Ctrl (Windows) or Command (Mac) to select multiple documents.</p>
    </div>
  </div>

  <div class="flex justify-end">
    <%= link_to "Cancel", organization_evidence_requests_path(@organization), class: "bg-white py-2 px-4 border border-gray-300 rounded-md shadow-sm text-sm font-medium text-gray-700 hover:bg-gray-50 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-indigo-500" %>
    <%= form.submit class: "ml-3 inline-flex justify-center py-2 px-4 border border-transparent shadow-sm text-sm font-medium rounded-md text-white bg-indigo-600 hover:bg-indigo-700 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-indigo-500" %>
  </div>
<% end %>
