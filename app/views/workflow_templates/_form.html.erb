<%= form_with(model: [organization, workflow_template], class: "space-y-6") do |form| %>
  <% if workflow_template.errors.any? %>
    <div id="error_explanation" class="bg-red-50 text-red-700 border border-red-200 p-4 rounded-md">
      <h2 class="text-lg font-medium"><%= pluralize(workflow_template.errors.count, "error") %> prohibited this template from being saved:</h2>
      <ul class="mt-3 list-disc list-inside text-sm">
        <% workflow_template.errors.full_messages.each do |message| %>
          <li><%= message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <%= render Joyful::InputComponent.new(
        form: form,
        method: :name,
        label: "Template Name",
        placeholder: "e.g., Standard Document Review"
      ) %>

  <%= render Joyful::InputComponent.new(
        form: form,
        method: :description,
        label: "Description",
        type: :textarea,
        placeholder: "Describe the purpose of this workflow..."
      ) %>

  <div class="relative flex items-start">
    <div class="flex h-5 items-center">
      <%= form.check_box :is_default, class: "h-4 w-4 rounded border-gray-300 text-primary-600 focus:ring-primary-500" %>
    </div>
    <div class="ml-3 text-sm">
      <%= form.label :is_default, "Set as default template for this organization", class: "font-medium text-gray-700" %>
    </div>
  </div>

  <div class="flex justify-end">
    <%= render Joyful::ButtonComponent.new(
          text: "Save Template",
          form: form,
          variant: :primary,
          class: "shadow-primary-glow"
        ) %>
  </div>
<% end %>
