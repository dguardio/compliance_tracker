<div class="max-w-7xl mx-auto py-10 px-4 sm:px-6 lg:px-8">
  <div class="flex justify-between items-start mb-8">
    <div>
      <%= link_to organization_workflow_templates_path(@organization), class: "group inline-flex items-center text-sm font-medium text-gray-500 hover:text-primary-600 mb-2 transition-colors" do %>
        <i class="fas fa-arrow-left mr-2 group-hover:-translate-x-1 transition-transform"></i> Back to blueprints
      <% end %>
      
      <div class="flex items-center gap-3">
        <h1 class="text-3xl font-bold text-gray-900"><%= @workflow_template.name %></h1>
        <% if @workflow_template.is_default? %>
          <span class="px-2.5 py-0.5 rounded-full text-xs font-semibold bg-green-100 text-green-800 border border-green-200">
            Default
          </span>
        <% end %>
      </div>
      <p class="text-gray-500 mt-2 max-w-2xl"><%= @workflow_template.description %></p>
    </div>
    
    <div>
      <%= render Joyful::ButtonComponent.new(
            text: "Edit Settings",
            path: edit_organization_workflow_template_path(@organization, @workflow_template),
            variant: :secondary,
            icon: "cog"
          ) %>
    </div>
  </div>

  <div class="grid grid-cols-1 lg:grid-cols-3 gap-8" 
       data-controller="workflow-editor" 
       data-organization-id="<%= @organization.id %>"
       data-workflow-editor-template-id-value="<%= @workflow_template.id %>"
       data-workflow-editor-transitions-value="<%= @transitions_json %>">
    
    <!-- Visual Workflow Canvas -->
    <div class="lg:col-span-2">
       <%= render Joyful::CardComponent.new(class: "h-full") do %>
          <div class="flex justify-between items-center mb-6">
            <h2 class="text-lg font-bold text-gray-900 flex items-center">
              <i class="fas fa-project-diagram mr-2 text-primary-500"></i> Workflow Canvas
            </h2>
            <div class="text-xs text-gray-400">
              <i class="fas fa-mouse-pointer mr-1"></i> Drag to reorder
            </div>
          </div>
          
          <div data-workflow-editor-target="canvas" 
               id="workflow-canvas"
               class="relative bg-slate-50 rounded-xl border-2 border-dashed border-gray-200 min-h-[500px] p-6 transition-colors hover:border-primary-300/50" 
               style="position: relative; height: 600px;">
            <% @workflow_steps.each_with_index do |step, index| %>
              <%= render 'workflow_steps/workflow_step', workflow_step: step, index: index %>
            <% end %>
            
            <% if @workflow_steps.empty? %>
              <div class="absolute inset-0 flex flex-col items-center justify-center text-gray-400 pointer-events-none">
                <i class="fas fa-layer-group text-4xl mb-3 opacity-50"></i>
                <p>Add steps to begin designing this workflow</p>
              </div>
            <% end %>
          </div>
       <% end %>
    </div>

    <!-- Add Step Form Sidebar -->
    <div>
      <%= render Joyful::CardComponent.new(class: "sticky top-24") do %>
        <h2 class="text-lg font-bold text-gray-900 mb-4 flex items-center">
          <i class="fas fa-plus-circle mr-2 text-primary-500"></i> Add New Step
        </h2>
        <%= render 'workflow_steps/form', workflow_step: @new_workflow_step %>
      <% end %>
    </div>
  </div>
</div>
