<div class="max-w-7xl mx-auto py-10 px-4 sm:px-6 lg:px-8">
  <div class="flex justify-between items-center mb-6">
    <div>
      <h1 class="text-3xl font-bold text-gray-900"><%= @workflow_template.name %></h1>
      <p class="text-sm text-gray-500 mt-1"><%= @workflow_template.description %></p>
      <% if @workflow_template.is_default? %>
        <p class="mt-2 px-2 inline-flex text-xs leading-5 font-semibold rounded-full bg-green-100 text-green-800">
          Default Template
        </p>
      <% end %>
    </div>
    <div>
      <%= link_to 'Back to templates', organization_workflow_templates_path(@organization), class: "text-sm font-medium text-gray-600" %>
      <%= link_to 'Edit Template', edit_organization_workflow_template_path(@organization, @workflow_template), class: "ml-4 inline-flex items-center px-4 py-2 border border-gray-300 text-sm font-medium rounded-md text-gray-700 bg-white hover:bg-gray-50" %>
    </div>
  </div>

  <div class="grid grid-cols-1 lg:grid-cols-3 gap-8 mt-8" 
       data-controller="workflow-editor" 
       data-organization-id="<%= @organization.id %>"
       data-workflow-editor-template-id-value="<%= @workflow_template.id %>"
       data-workflow-editor-transitions-value="<%= @transitions_json %>">
    <!-- Visual Workflow Canvas -->
    <div class="lg:col-span-2">
            <h2 class="text-2xl font-bold text-gray-900 mb-4">Workflow Canvas</h2>
            <div data-workflow-editor-target="canvas" 
                 id="workflow-canvas"
                 class="relative bg-white shadow-inner-lg rounded-lg border-2 border-dashed border-gray-300 p-4" 
                 style="position: relative; height: 500px;">
              <% @workflow_steps.each_with_index do |step, index| %>
                <%= render 'workflow_steps/workflow_step', workflow_step: step, index: index %>
              <% end %>
            </div>
    </div>

    <!-- Add Step Form -->
    <div>
      <h2 class="text-2xl font-bold text-gray-900 mb-4">Add New Step</h2>
      <div class="bg-white shadow p-6 rounded-lg">
        <%= render 'workflow_steps/form', workflow_step: @new_workflow_step %>
      </div>
    </div>
  </div>
</div>
