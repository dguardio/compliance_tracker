<%= form_with model: @test_plan, url: @test_plan.persisted? ? organization_control_testing_path(@organization, @test_plan) : organization_control_testing_index_path(@organization), class: "space-y-6" do |f| %>
  <% if @test_plan.errors.any? %>
    <div class="bg-red-50 border-l-4 border-red-400 p-4 rounded">
      <ul class="text-sm text-red-700 list-disc list-inside">
        <% @test_plan.errors.full_messages.each do |message| %>
          <li><%= message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
    <div class="md:col-span-2">
      <%= f.label :title, class: "block text-sm font-medium text-gray-700" %>
      <%= f.text_field :title, class: "mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:ring-indigo-500 focus:border-indigo-500 sm:text-sm", required: true %>
    </div>
    <div class="md:col-span-2">
      <%= f.label :description, class: "block text-sm font-medium text-gray-700" %>
      <%= f.text_area :description, rows: 3, class: "mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:ring-indigo-500 focus:border-indigo-500 sm:text-sm" %>
    </div>
    <div>
      <%= f.label :compliance_control_id, "Control", class: "block text-sm font-medium text-gray-700" %>
      <%= f.select :compliance_control_id, @controls.map { |c| [c.name, c.id] }, { include_blank: "Select control" }, class: "mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:ring-indigo-500 focus:border-indigo-500 sm:text-sm" %>
    </div>
    <div>
      <%= f.label :frequency, class: "block text-sm font-medium text-gray-700" %>
      <%= f.select :frequency, TestPlan.frequencies.keys.map { |k| [k.titleize, k] }, {}, class: "mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:ring-indigo-500 focus:border-indigo-500 sm:text-sm" %>
    </div>
    <div>
      <%= f.label :status, class: "block text-sm font-medium text-gray-700" %>
      <%= f.select :status, TestPlan.statuses.keys.map { |k| [k.titleize, k] }, {}, class: "mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:ring-indigo-500 focus:border-indigo-500 sm:text-sm" %>
    </div>
    <div>
      <%= f.label :next_due_date, class: "block text-sm font-medium text-gray-700" %>
      <%= f.date_field :next_due_date, class: "mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:ring-indigo-500 focus:border-indigo-500 sm:text-sm" %>
    </div>
    <div class="md:col-span-2">
      <%= f.label :procedures, "Test Procedures", class: "block text-sm font-medium text-gray-700" %>
      <%= f.text_area :procedures, rows: 6, class: "mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:ring-indigo-500 focus:border-indigo-500 sm:text-sm", placeholder: "Step-by-step testing procedures..." %>
    </div>
  </div>

  <div class="flex justify-end space-x-3 pt-4 border-t">
    <%= link_to "Cancel", @test_plan.persisted? ? organization_control_testing_path(@organization, @test_plan) : organization_control_testing_index_path(@organization),
                class: "inline-flex items-center px-4 py-2 border border-gray-300 text-sm font-medium rounded-md text-gray-700 bg-white hover:bg-gray-50" %>
    <%= f.submit @test_plan.persisted? ? "Update Test Plan" : "Create Test Plan",
                 class: "inline-flex items-center px-4 py-2 border border-transparent text-sm font-medium rounded-md text-white bg-indigo-600 hover:bg-indigo-700 cursor-pointer" %>
  </div>
<% end %>
