<div class="container mx-auto px-4 py-8">
  <div class="flex justify-between items-center mb-6">
    <h1 class="text-2xl font-bold text-gray-800">Global Standards Search</h1>
  </div>

  <% if @compliance_framework %>
    <div class="bg-blue-50 border-l-4 border-blue-400 p-4 mb-6">
      <div class="flex items-center justify-between">
        <div class="flex items-center">
          <div class="flex-shrink-0">
             <i class="fas fa-file-import text-blue-500"></i>
          </div>
          <div class="ml-3">
             <p class="text-sm text-blue-700">
               Importing standards into <strong><%= @compliance_framework.name %></strong>
             </p>
          </div>
        </div>
        <div>
          <%= link_to "Cancel Import", organization_compliance_framework_path(@organization, @compliance_framework), class: "text-sm font-medium text-blue-600 hover:text-blue-500" %>
        </div>
      </div>
    </div>
  <% end %>

  <div class="bg-white p-6 rounded-lg shadow-sm border border-gray-200 mb-8">
    <%= form_with url: search_standard_requirements_path, method: :get, local: true, class: "flex gap-4" do |f| %>
      <%= f.text_field :q, value: params[:q], placeholder: "Describe a compliance requirement (e.g., 'data retention policy for eu users')...", class: "flex-1 rounded-md border-gray-300 shadow-sm focus:border-indigo-500 focus:ring-indigo-500" %>
      <% if @organization && @compliance_framework %>
        <%= hidden_field_tag :organization_id, @organization.id %>
        <%= hidden_field_tag :compliance_framework_id, @compliance_framework.id %>
      <% end %>
      <%= f.submit "Semantic Search", class: "px-4 py-2 bg-indigo-600 text-white rounded-md hover:bg-indigo-700 cursor-pointer" %>
    <% end %>
  </div>

  <% if @results.present? %>
    <h2 class="text-lg font-semibold mb-4 text-gray-700">Top Semantic Matches</h2>
    <div class="space-y-4">
      <% @results.each do |req| %>
        <div class="bg-white p-4 rounded border border-gray-200 hover:border-indigo-300 transition-colors">
          <div class="flex justify-between">
            <h3 class="font-medium text-lg text-indigo-900"><%= req.name %></h3>
            <div class="flex items-center gap-2">
              <span class="text-xs font-mono text-gray-500 bg-gray-100 px-2 py-1 rounded"><%= req.external_id %></span>
              <% if @compliance_framework %>
                <%= button_to adopt_standard_requirement_path(req, organization_id: @organization.id, compliance_framework_id: @compliance_framework.id, q: params[:q]), 
                    method: :post, 
                    class: "ml-2 px-3 py-1 bg-green-600 text-white text-xs font-medium rounded hover:bg-green-700 transition-colors focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-green-500" do %>
                  <i class="fas fa-plus mr-1"></i> Adopt
                <% end %>
              <% end %>
            </div>
          </div>
          <p class="text-gray-600 mt-2 text-sm"><%= req.description %></p>
          <div class="mt-3 flex gap-2 text-xs text-gray-500">
            <span class="px-2 py-1 bg-blue-50 text-blue-700 rounded"><%= req.category %></span>
            <% if req.regulation %>
              <span class="px-2 py-1 bg-green-50 text-green-700 rounded"><%= req.regulation.title %></span>
            <% end %>
            <% if req.respond_to?(:neighbor_distance) && req.neighbor_distance %>
               <span class="px-2 py-1 bg-yellow-50 text-yellow-700 rounded">Dist: <%= req.neighbor_distance.round(4) %></span>
            <% end %>
          </div>
        </div>
      <% end %>
    </div>
  <% elsif params[:q].present? %>
    <div class="text-center py-12 text-gray-500">
      <p>No relevant standards found for your query. Try rephrasing.</p>
    </div>
  <% else %>
    <h2 class="text-lg font-semibold mb-4 text-gray-700">Recent Standards</h2>
    <div class="space-y-4 opacity-75">
      <% @standard_requirements.each do |req| %>
        <div class="bg-white p-4 rounded border border-gray-200">
          <div class="flex justify-between items-start mb-2">
             <h3 class="font-medium text-gray-900"><%= req.name %></h3>
             <% if @compliance_framework %>
                <%= button_to adopt_standard_requirement_path(req, organization_id: @organization.id, compliance_framework_id: @compliance_framework.id, q: params[:q]), 
                    method: :post, 
                    class: "px-3 py-1 bg-green-600 text-white text-xs font-medium rounded hover:bg-green-700 transition-colors" do %>
                  Adopt
                <% end %>
             <% end %>
          </div>
          <p class="text-gray-500 text-sm truncate"><%= req.description %></p>
        </div>
      <% end %>
    </div>
  <% end %>
</div>
