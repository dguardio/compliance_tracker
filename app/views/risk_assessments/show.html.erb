<div class="container mx-auto px-4 py-8">
  <div class="mb-6">
    <%= link_to "← Back to Risk Assessments", risk_assessments_path, 
                class: "text-blue-600 hover:text-blue-800 font-medium" %>
  </div>

  <div class="max-w-4xl mx-auto">
    <!-- Header -->
    <div class="bg-white shadow rounded-lg mb-6">
      <div class="px-6 py-4 border-b border-gray-200">
        <div class="flex items-center justify-between">
          <div>
            <h1 class="text-3xl font-bold text-gray-900"><%= @risk_assessment.name %></h1>
            <p class="mt-1 text-sm text-gray-500">
              Risk Assessment for <%= @compliance_framework.name %> → 
              <%= @compliance_requirement.name %>
              <% if @compliance_control %>
                → <%= @compliance_control.name %>
              <% end %>
            </p>
          </div>
          <div class="flex items-center space-x-3">
            <span class="inline-flex items-center px-3 py-1 rounded-full text-sm font-medium bg-<%= @risk_assessment.risk_level_color %>-100 text-<%= @risk_assessment.risk_level_color %>-800">
              <%= @risk_assessment.risk_level %> Risk
            </span>
            <span class="inline-flex items-center px-3 py-1 rounded-full text-sm font-medium bg-gray-100 text-gray-800">
              <%= @risk_assessment.status.titleize %>
            </span>
          </div>
        </div>
      </div>

      <!-- Risk Score Display -->
      <div class="px-6 py-4 bg-gray-50">
        <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
          <div class="text-center">
            <div class="text-2xl font-bold text-<%= @risk_assessment.risk_level_color %>-600">
              <%= @risk_assessment.risk_score %>
            </div>
            <div class="text-sm text-gray-500">Risk Score</div>
          </div>
          <div class="text-center">
            <div class="text-2xl font-bold text-gray-600">
              <%= @risk_assessment.likelihood.titleize %>
            </div>
            <div class="text-sm text-gray-500">Likelihood</div>
          </div>
          <div class="text-center">
            <div class="text-2xl font-bold text-gray-600">
              <%= @risk_assessment.impact.titleize %>
            </div>
            <div class="text-sm text-gray-500">Impact</div>
          </div>
        </div>
      </div>
    </div>

    <div class="grid grid-cols-1 lg:grid-cols-3 gap-6">
      <!-- Main Content -->
      <div class="lg:col-span-2 space-y-6">
        <!-- Description -->
        <div class="bg-white shadow rounded-lg">
          <div class="px-6 py-4 border-b border-gray-200">
            <h3 class="text-lg font-medium text-gray-900">Description</h3>
          </div>
          <div class="px-6 py-4">
            <p class="text-gray-700 whitespace-pre-wrap"><%= @risk_assessment.description %></p>
          </div>
        </div>

        <!-- Mitigation Plan -->
        <% if @risk_assessment.mitigation_plan.present? %>
          <div class="bg-white shadow rounded-lg">
            <div class="px-6 py-4 border-b border-gray-200">
              <h3 class="text-lg font-medium text-gray-900">Mitigation Plan</h3>
            </div>
            <div class="px-6 py-4">
              <p class="text-gray-700 whitespace-pre-wrap"><%= @risk_assessment.mitigation_plan %></p>
            </div>
          </div>
        <% end %>

        <!-- Risk Matrix -->
        <div class="bg-white shadow rounded-lg">
          <div class="px-6 py-4 border-b border-gray-200">
            <h3 class="text-lg font-medium text-gray-900">Risk Matrix</h3>
          </div>
          <div class="px-6 py-4">
            <div class="grid grid-cols-6 gap-1 text-xs">
              <!-- Header row -->
              <div class="h-8"></div>
              <div class="h-8 flex items-center justify-center font-medium">Very Low</div>
              <div class="h-8 flex items-center justify-center font-medium">Low</div>
              <div class="h-8 flex items-center justify-center font-medium">Medium</div>
              <div class="h-8 flex items-center justify-center font-medium">High</div>
              <div class="h-8 flex items-center justify-center font-medium">Very High</div>
              
              <!-- Impact rows -->
              <% ['Catastrophic', 'Major', 'Moderate', 'Minor', 'Negligible'].each_with_index do |impact, impact_index| %>
                <div class="text-xs font-medium text-gray-500 text-center py-1">
                  <%= impact %>
                </div>
                <% (1..5).each do |likelihood_index| %>
                  <% score = (5 - impact_index) * likelihood_index %>
                  <% color_class = case score
                     when 1..4 then 'bg-green-200'
                     when 5..8 then 'bg-blue-200'
                     when 9..12 then 'bg-yellow-200'
                     when 13..16 then 'bg-orange-200'
                     when 17..25 then 'bg-red-200'
                     end %>
                  <div class="h-12 flex items-center justify-center <%= color_class %> border border-gray-300">
                    <% if score == @risk_assessment.risk_score %>
                      <div class="w-3 h-3 bg-black rounded-full"></div>
                    <% else %>
                      <span class="text-gray-600"><%= score %></span>
                    <% end %>
                  </div>
                <% end %>
              <% end %>
            </div>
            <div class="mt-4 text-xs text-gray-500">
              <div class="flex items-center space-x-4">
                <span>Current Risk: <span class="font-medium"><%= @risk_assessment.risk_score %></span></span>
                <span>•</span>
                <span>Likelihood: <span class="font-medium"><%= @risk_assessment.likelihood.titleize %></span></span>
                <span>•</span>
                <span>Impact: <span class="font-medium"><%= @risk_assessment.impact.titleize %></span></span>
              </div>
            </div>
          </div>
        </div>
      </div>

      <!-- Sidebar -->
      <div class="space-y-6">
        <!-- Key Information -->
        <div class="bg-white shadow rounded-lg">
          <div class="px-6 py-4 border-b border-gray-200">
            <h3 class="text-lg font-medium text-gray-900">Key Information</h3>
          </div>
          <div class="px-6 py-4 space-y-4">
            <div>
              <dt class="text-sm font-medium text-gray-500">Assessment Date</dt>
              <dd class="mt-1 text-sm text-gray-900"><%= @risk_assessment.assessment_date.strftime("%B %d, %Y") %></dd>
            </div>
            <div>
              <dt class="text-sm font-medium text-gray-500">Next Review Date</dt>
              <dd class="mt-1 text-sm text-gray-900">
                <span class="<%= @risk_assessment.overdue? ? 'text-red-600' : @risk_assessment.due_soon? ? 'text-yellow-600' : 'text-gray-900' %>">
                  <%= @risk_assessment.next_review_date.strftime("%B %d, %Y") %>
                </span>
                <% if @risk_assessment.overdue? %>
                  <span class="ml-2 inline-flex items-center px-2 py-0.5 rounded-full text-xs font-medium bg-red-100 text-red-800">
                    Overdue
                  </span>
                <% elsif @risk_assessment.due_soon? %>
                  <span class="ml-2 inline-flex items-center px-2 py-0.5 rounded-full text-xs font-medium bg-yellow-100 text-yellow-800">
                    Due Soon
                  </span>
                <% end %>
              </dd>
            </div>
            <div>
              <dt class="text-sm font-medium text-gray-500">Created By</dt>
              <dd class="mt-1 text-sm text-gray-900"><%= @risk_assessment.created_by.full_name %></dd>
            </div>
            <div>
              <dt class="text-sm font-medium text-gray-500">Assigned To</dt>
              <dd class="mt-1 text-sm text-gray-900"><%= @risk_assessment.assigned_to.full_name %></dd>
            </div>
            <div>
              <dt class="text-sm font-medium text-gray-500">Status</dt>
              <dd class="mt-1">
                <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-gray-100 text-gray-800">
                  <%= @risk_assessment.status.titleize %>
                </span>
              </dd>
            </div>
          </div>
        </div>

        <!-- Actions -->
        <div class="bg-white shadow rounded-lg">
          <div class="px-6 py-4 border-b border-gray-200">
            <h3 class="text-lg font-medium text-gray-900">Actions</h3>
          </div>
          <div class="px-6 py-4 space-y-3">
            <%= link_to "Edit Risk Assessment", edit_risk_assessment_path(@risk_assessment), 
                        class: "w-full inline-flex justify-center items-center px-4 py-2 border border-gray-300 shadow-sm text-sm font-medium rounded-md text-gray-700 bg-white hover:bg-gray-50 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-indigo-500" %>
            
            <% if policy(@risk_assessment).can_review? %>
              <%= link_to "Mark as Reviewed", "#", 
                          class: "w-full inline-flex justify-center items-center px-4 py-2 border border-transparent text-sm font-medium rounded-md text-white bg-blue-600 hover:bg-blue-700 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-blue-500" %>
            <% end %>
            
            <% if policy(@risk_assessment).can_approve? %>
              <%= link_to "Approve Assessment", "#", 
                          class: "w-full inline-flex justify-center items-center px-4 py-2 border border-transparent text-sm font-medium rounded-md text-white bg-green-600 hover:bg-green-700 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-green-500" %>
            <% end %>
            
            <%= link_to "Delete Risk Assessment", risk_assessment_path(@risk_assessment), 
                        method: :delete,
                        data: { confirm: "Are you sure you want to delete this risk assessment?" },
                        class: "w-full inline-flex justify-center items-center px-4 py-2 border border-transparent text-sm font-medium rounded-md text-white bg-red-600 hover:bg-red-700 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-red-500" %>
          </div>
        </div>

        <!-- Related Compliance -->
        <div class="bg-white shadow rounded-lg">
          <div class="px-6 py-4 border-b border-gray-200">
            <h3 class="text-lg font-medium text-gray-900">Related Compliance</h3>
          </div>
          <div class="px-6 py-4 space-y-3">
            <div>
              <dt class="text-sm font-medium text-gray-500">Framework</dt>
              <dd class="mt-1 text-sm text-gray-900">
                <%= link_to @compliance_framework.name, organization_compliance_framework_path(@organization, @compliance_framework), 
                            class: "text-indigo-600 hover:text-indigo-900" %>
              </dd>
            </div>
            <div>
              <dt class="text-sm font-medium text-gray-500">Requirement</dt>
              <dd class="mt-1 text-sm text-gray-900">
                <%= link_to @compliance_requirement.name, organization_compliance_framework_compliance_requirement_path(@organization, @compliance_framework, @compliance_requirement), 
                            class: "text-indigo-600 hover:text-indigo-900" %>
              </dd>
            </div>
            <% if @compliance_control %>
              <div>
                <dt class="text-sm font-medium text-gray-500">Control</dt>
                <dd class="mt-1 text-sm text-gray-900">
                  <%= link_to @compliance_control.name, organization_compliance_framework_compliance_requirement_compliance_control_path(@organization, @compliance_framework, @compliance_requirement, @compliance_control), 
                              class: "text-indigo-600 hover:text-indigo-900" %>
                </dd>
              </div>
            <% end %>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>
