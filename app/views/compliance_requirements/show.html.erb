<div class="container mx-auto px-4 py-8">
  <div class="mb-6">
    <%= link_to "← Back to Requirements", organization_compliance_framework_compliance_requirements_path(@organization, @compliance_framework), 
                class: "text-blue-600 hover:text-blue-800 font-medium" %>
  </div>

  <div class="bg-white rounded-lg shadow-md p-6 mb-8">
    <div class="flex justify-between items-start mb-6">
      <div>
        <h1 class="text-3xl font-bold text-gray-900 mb-2"><%= @compliance_requirement.name %></h1>
        <p class="text-gray-600 text-lg"><%= @compliance_requirement.description %></p>
      </div>
      <div class="flex space-x-2">
        <% if policy(@compliance_requirement).update? %>
          <%= link_to "Edit", edit_organization_compliance_framework_compliance_requirement_path(@organization, @compliance_framework, @compliance_requirement), 
                      class: "bg-blue-600 hover:bg-blue-700 text-white font-bold py-2 px-4 rounded" %>
        <% end %>
        <% if policy(@compliance_requirement).destroy? %>
          <%= link_to "Delete", organization_compliance_framework_compliance_requirement_path(@organization, @compliance_framework, @compliance_requirement), 
                      method: :delete, 
                      data: { confirm: "Are you sure you want to delete this requirement?" },
                      class: "bg-red-600 hover:bg-red-700 text-white font-bold py-2 px-4 rounded" %>
        <% end %>
      </div>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6 mb-8">
      <div class="bg-gray-50 rounded-lg p-4">
        <h3 class="text-sm font-medium text-gray-500 mb-1">Code</h3>
        <p class="text-lg font-semibold text-gray-900"><%= @compliance_requirement.code %></p>
      </div>
      
      <div class="bg-gray-50 rounded-lg p-4">
        <h3 class="text-sm font-medium text-gray-500 mb-1">Priority</h3>
        <p class="text-lg font-semibold">
          <span class="px-2 py-1 text-xs font-medium rounded-full 
                     <%= @compliance_requirement.priority == 'high' ? 'bg-red-100 text-red-800' : 
                         @compliance_requirement.priority == 'medium' ? 'bg-yellow-100 text-yellow-800' : 'bg-green-100 text-green-800' %>">
            <%= @compliance_requirement.priority&.titleize || 'Unknown' %>
          </span>
        </p>
      </div>
      
      <div class="bg-gray-50 rounded-lg p-4">
        <h3 class="text-sm font-medium text-gray-500 mb-1">Status</h3>
        <p class="text-lg font-semibold">
          <span class="px-2 py-1 text-xs font-medium rounded-full 
                     <%= @compliance_requirement.status == 'active' ? 'bg-green-100 text-green-800' : 'bg-gray-100 text-gray-800' %>">
            <%= @compliance_requirement.status&.titleize || 'Unknown' %>
          </span>
        </p>
      </div>
      
      <div class="bg-gray-50 rounded-lg p-4">
        <h3 class="text-sm font-medium text-gray-500 mb-1">Controls</h3>
        <p class="text-lg font-semibold text-gray-900"><%= @compliance_controls.count %></p>
      </div>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-6 mb-8">
      <div>
        <h3 class="text-sm font-medium text-gray-500 mb-1">Type</h3>
        <p class="text-lg font-semibold text-gray-900"><%= @compliance_requirement.requirement_type&.titleize || 'Unknown' %></p>
      </div>
      
      <div>
        <h3 class="text-sm font-medium text-gray-500 mb-1">Framework</h3>
        <p class="text-lg font-semibold text-gray-900">
          <%= link_to @compliance_framework.name, organization_compliance_framework_path(@organization, @compliance_framework), 
                      class: "text-blue-600 hover:text-blue-800" %>
        </p>
      </div>
    </div>

    <% if @compliance_requirement.settings.present? %>
      <div class="border-t border-gray-200 pt-6">
        <h3 class="text-lg font-semibold text-gray-900 mb-4">Requirement Details</h3>
        <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
          <% @compliance_requirement.settings.each do |key, value| %>
            <div class="flex justify-between">
              <span class="text-gray-600 font-medium"><%= key.titleize %>:</span>
              <span class="text-gray-900"><%= value %></span>
            </div>
          <% end %>
        </div>
      </div>
    <% end %>
  </div>

  <!-- Controls Section -->
  <div class="bg-white rounded-lg shadow-md p-6 mb-8">
    <div class="flex justify-between items-center mb-6">
      <h2 class="text-2xl font-bold text-gray-900">Compliance Controls</h2>
      <% if policy(ComplianceControl.new(compliance_requirement: @compliance_requirement, organization: @organization)).create? %>
        <%= link_to "New Control", new_organization_compliance_framework_compliance_requirement_compliance_control_path(@organization, @compliance_framework, @compliance_requirement), 
                    class: "bg-green-600 hover:bg-green-700 text-white font-bold py-2 px-4 rounded" %>
      <% end %>
    </div>

    <% if @compliance_controls.any? %>
      <div class="space-y-4">
        <% @compliance_controls.each do |control| %>
          <div class="border border-gray-200 rounded-lg p-4 hover:bg-gray-50">
            <div class="flex justify-between items-start mb-2">
              <div>
                <h3 class="text-lg font-semibold text-gray-900">
                  <%= link_to control.name, organization_compliance_framework_compliance_requirement_compliance_control_path(@organization, @compliance_framework, @compliance_requirement, control), 
                              class: "hover:text-blue-600" %>
                </h3>
                <p class="text-sm text-gray-500"><%= control.control_type.titleize %> Control</p>
              </div>
              <div class="flex space-x-2">
                <span class="px-2 py-1 text-xs font-medium rounded-full 
                           <%= control.effectiveness == 'high' ? 'bg-green-100 text-green-800' : 
                               control.effectiveness == 'medium' ? 'bg-yellow-100 text-yellow-800' : 'bg-red-100 text-red-800' %>">
                  <%= control.effectiveness&.titleize || 'Unknown' %> Effectiveness
                </span>
                <span class="px-2 py-1 text-xs font-medium rounded-full 
                           <%= control.status == 'active' ? 'bg-green-100 text-green-800' : 'bg-gray-100 text-gray-800' %>">
                  <%= control.status&.titleize || 'Unknown' %>
                </span>
              </div>
            </div>
            <p class="text-gray-600 mb-3"><%= control.description %></p>
            <% if control.settings&.dig('control_owner') %>
              <div class="text-sm text-gray-500">
                Owner: <%= control.settings['control_owner'] %>
              </div>
            <% end %>
          </div>
        <% end %>
      </div>
    <% else %>
      <div class="text-center py-8">
        <div class="text-gray-400 mb-4">
          <svg class="mx-auto h-12 w-12" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"></path>
          </svg>
        </div>
        <h3 class="text-lg font-medium text-gray-900 mb-2">No compliance controls</h3>
        <p class="text-gray-500 mb-4">Add controls to this requirement to get started.</p>
        <% if policy(ComplianceControl.new(compliance_requirement: @compliance_requirement, organization: @organization)).create? %>
          <%= link_to "Add Control", new_organization_compliance_framework_compliance_requirement_compliance_control_path(@organization, @compliance_framework, @compliance_requirement), 
                      class: "bg-green-600 hover:bg-green-700 text-white font-bold py-2 px-4 rounded" %>
        <% end %>
      </div>
    <% end %>
  </div>

  <!-- Risk Assessments Section -->
  <div class="bg-white rounded-lg shadow-md p-6">
    <div class="flex justify-between items-center mb-6">
      <h2 class="text-2xl font-bold text-gray-900">Risk Assessments</h2>
      <% if policy(RiskAssessment.new(organization: @organization, compliance_framework: @compliance_framework, compliance_requirement: @compliance_requirement)).create? %>
        <%= link_to "New Risk Assessment", new_organization_compliance_framework_risk_assessment_path(@organization, @compliance_framework), 
                    class: "bg-red-600 hover:bg-red-700 text-white font-bold py-2 px-4 rounded" %>
      <% end %>
    </div>

    <% requirement_risk_assessments = @compliance_requirement.risk_assessments.includes(:created_by, :assigned_to, :compliance_control) %>
    
    <% if requirement_risk_assessments.any? %>
      <div class="overflow-x-auto">
        <table class="min-w-full divide-y divide-gray-200">
          <thead class="bg-gray-50">
            <tr>
              <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Risk Assessment</th>
              <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Risk Level</th>
              <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Status</th>
              <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Control</th>
              <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Assigned To</th>
              <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Next Review</th>
              <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Actions</th>
            </tr>
          </thead>
          <tbody class="bg-white divide-y divide-gray-200">
            <% requirement_risk_assessments.each do |risk_assessment| %>
              <tr>
                <td class="px-6 py-4 whitespace-nowrap">
                  <div class="flex items-center">
                    <div class="flex-shrink-0 h-8 w-8">
                      <div class="h-8 w-8 rounded-full bg-<%= risk_assessment.risk_level_color %>-500 flex items-center justify-center">
                        <span class="text-white font-semibold text-xs">
                          <%= risk_assessment.risk_score %>
                        </span>
                      </div>
                    </div>
                    <div class="ml-4">
                      <div class="text-sm font-medium text-gray-900">
                        <%= link_to risk_assessment.name, organization_compliance_framework_risk_assessment_path(@organization, @compliance_framework, risk_assessment), 
                                    class: "hover:text-blue-600" %>
                      </div>
                      <div class="text-sm text-gray-500">
                        <%= risk_assessment.compliance_control&.name || 'No specific control' %>
                      </div>
                    </div>
                  </div>
                </td>
                <td class="px-6 py-4 whitespace-nowrap">
                  <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-<%= risk_assessment.risk_level_color %>-100 text-<%= risk_assessment.risk_level_color %>-800">
                    <%= risk_assessment.risk_level %>
                  </span>
                </td>
                <td class="px-6 py-4 whitespace-nowrap">
                  <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-gray-100 text-gray-800">
                    <%= risk_assessment.status.titleize %>
                  </span>
                </td>
                <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-900">
                  <% if risk_assessment.compliance_control %>
                    <%= link_to risk_assessment.compliance_control.name, organization_compliance_framework_compliance_requirement_compliance_control_path(@organization, @compliance_framework, @compliance_requirement, risk_assessment.compliance_control), 
                                class: "text-indigo-600 hover:text-indigo-900" %>
                  <% else %>
                    <span class="text-gray-400">-</span>
                  <% end %>
                </td>
                <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-900">
                  <%= risk_assessment.assigned_to.full_name %>
                </td>
                <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-900">
                  <span class="<%= risk_assessment.overdue? ? 'text-red-600' : risk_assessment.due_soon? ? 'text-yellow-600' : 'text-gray-900' %>">
                    <%= risk_assessment.next_review_date.strftime("%b %d, %Y") %>
                  </span>
                  <% if risk_assessment.overdue? %>
                    <span class="ml-2 inline-flex items-center px-2 py-0.5 rounded-full text-xs font-medium bg-red-100 text-red-800">
                      Overdue
                    </span>
                  <% elsif risk_assessment.due_soon? %>
                    <span class="ml-2 inline-flex items-center px-2 py-0.5 rounded-full text-xs font-medium bg-yellow-100 text-yellow-800">
                      Due Soon
                    </span>
                  <% end %>
                </td>
                <td class="px-6 py-4 whitespace-nowrap text-sm font-medium">
                  <%= link_to "View", organization_compliance_framework_risk_assessment_path(@organization, @compliance_framework, risk_assessment), 
                              class: "text-indigo-600 hover:text-indigo-900" %>
                </td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
    <% else %>
      <div class="text-center py-8">
        <div class="text-gray-400 mb-4">
          <svg class="mx-auto h-12 w-12" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-2.5L13.732 4c-.77-.833-1.964-.833-2.732 0L3.732 16.5c-.77.833.192 2.5 1.732 2.5z"></path>
          </svg>
        </div>
        <h3 class="text-lg font-medium text-gray-900 mb-2">No risk assessments</h3>
        <p class="text-gray-500 mb-4">Create risk assessments for this requirement to track compliance risks.</p>
        <% if policy(RiskAssessment.new(organization: @organization, compliance_framework: @compliance_framework, compliance_requirement: @compliance_requirement)).create? %>
          <%= link_to "Create Risk Assessment", new_organization_compliance_framework_risk_assessment_path(@organization, @compliance_framework), 
                      class: "bg-red-600 hover:bg-red-700 text-white font-bold py-2 px-4 rounded" %>
        <% end %>
      </div>
    <% end %>
  </div>
</div> 