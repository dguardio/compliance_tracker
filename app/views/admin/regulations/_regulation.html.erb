<div id="<%= dom_id regulation %>" class="space-y-8 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
  <!-- Header Section -->
  <div class="md:flex md:items-center md:justify-between">
    <div class="min-w-0 flex-1">
      <h2 class="text-2xl font-bold leading-7 text-gray-900 sm:truncate sm:text-3xl sm:tracking-tight">
        <%= regulation.title %>
      </h2>
    </div>
    <div class="mt-4 flex md:ml-4 md:mt-0">
      <% if regulation.previous_version_id.present? %>
        <%= link_to diff_admin_regulation_path(regulation), class: "inline-flex items-center rounded-md bg-white px-3 py-2 text-sm font-semibold text-gray-900 shadow-sm ring-1 ring-inset ring-gray-300 hover:bg-gray-50 mr-3" do %>
          <svg class="-ml-0.5 mr-1.5 h-5 w-5 text-gray-400" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
            <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm.75-11.25a.75.75 0 00-1.5 0v2.5h-2.5a.75.75 0 000 1.5h2.5v2.5a.75.75 0 001.5 0v-2.5h2.5a.75.75 0 000-1.5h-2.5v-2.5z" clip-rule="evenodd" />
          </svg>
          View Redline
        <% end %>
        <%= link_to diff_admin_regulation_path(regulation, format: :pdf), class: "inline-flex items-center rounded-md bg-white px-3 py-2 text-sm font-semibold text-gray-900 shadow-sm ring-1 ring-inset ring-gray-300 hover:bg-gray-50 mr-3" do %>
          <svg class="-ml-0.5 mr-1.5 h-5 w-5 text-gray-400" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
            <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm.75-11.25a.75.75 0 00-1.5 0v2.5h-2.5a.75.75 0 000 1.5h2.5v2.5a.75.75 0 001.5 0v-2.5h2.5a.75.75 0 000-1.5h-2.5v-2.5z" clip-rule="evenodd" />
          </svg>
          Download Diff
        <% end %>
      <% end %>
      <%= link_to 'Edit', edit_admin_regulation_path(regulation), class: "inline-flex items-center rounded-md bg-indigo-600 px-3 py-2 text-sm font-semibold text-white shadow-sm hover:bg-indigo-500 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-indigo-600" %>
    </div>
  </div>

  <!-- Metadata Card -->
  <div class="overflow-hidden bg-white shadow sm:rounded-lg">
    <div class="px-4 py-5 sm:px-6">
      <h3 class="text-base font-semibold leading-6 text-gray-900">Regulation Information</h3>
      <p class="mt-1 max-w-2xl text-sm text-gray-500">Core details and status.</p>
    </div>
    <div class="border-t border-gray-200">
      <dl class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4">
        <div class="border-b border-gray-200 px-4 py-5 sm:px-6">
          <dt class="text-sm font-medium text-gray-500">Agency</dt>
          <dd class="mt-1 text-sm text-gray-900"><%= regulation.agency %></dd>
        </div>
        <div class="border-b border-gray-200 px-4 py-5 sm:px-6">
          <dt class="text-sm font-medium text-gray-500">Jurisdiction</dt>
          <dd class="mt-1 text-sm text-gray-900"><%= regulation.jurisdiction %></dd>
        </div>
        <div class="border-b border-gray-200 px-4 py-5 sm:px-6">
          <dt class="text-sm font-medium text-gray-500">Revision</dt>
          <dd class="mt-1 text-sm text-gray-900"><%= regulation.revision %></dd>
        </div>
        <div class="border-b border-gray-200 px-4 py-5 sm:px-6">
          <dt class="text-sm font-medium text-gray-500">Status</dt>
          <dd class="mt-1 text-sm text-gray-900">
             <span class="inline-flex items-center rounded-md px-2 py-1 text-xs font-medium ring-1 ring-inset <%= regulation.status == 'active' ? 'bg-green-50 text-green-700 ring-green-600/20' : 'bg-gray-50 text-gray-600 ring-gray-500/10' %>">
              <%= regulation.status.humanize %>
            </span>
          </dd>
        </div>
        <div class="border-b border-gray-200 px-4 py-5 sm:px-6">
          <dt class="text-sm font-medium text-gray-500">Type</dt>
          <dd class="mt-1 text-sm text-gray-900"><%= regulation.reg_type %></dd>
        </div>
        <div class="border-b border-gray-200 px-4 py-5 sm:px-6">
          <dt class="text-sm font-medium text-gray-500">Effective Date</dt>
          <dd class="mt-1 text-sm text-gray-900"><%= regulation.effective_date %></dd>
        </div>
        <div class="border-b border-gray-200 px-4 py-5 sm:px-6 sm:col-span-2">
          <dt class="text-sm font-medium text-gray-500">External ID</dt>
          <dd class="mt-1 text-sm text-gray-900 break-words max-w-full overflow-hidden">
            <%= link_to regulation.external_id, regulation.external_id, target: "_blank", class: "text-indigo-600 hover:text-indigo-500 break-all" %>
          </dd>
        </div>
      </dl>
    </div>
  </div>

  <!-- AI Analysis Section -->
  <% if regulation.metadata['obligations'].present? || regulation.metadata['entity_types'].present? %>
    <div class="overflow-hidden bg-white shadow sm:rounded-lg border border-indigo-100">
      <div class="px-4 py-5 sm:px-6 bg-indigo-50">
        <h3 class="text-base font-semibold leading-6 text-indigo-900">AI Analysis</h3>
        <p class="mt-1 max-w-2xl text-sm text-indigo-700">Insights extracted by the intelligence engine.</p>
      </div>
      <div class="border-t border-indigo-100 px-4 py-5 sm:p-6">
        <div class="grid grid-cols-1 gap-x-6 gap-y-8 sm:grid-cols-2">
          <div>
            <h4 class="text-sm font-medium text-gray-900">Obligations</h4>
            <ul role="list" class="mt-4 space-y-2 text-sm text-gray-600 list-disc pl-5">
              <% (regulation.metadata['obligations'] || []).each do |obligation| %>
                <li><%= obligation %></li>
              <% end %>
            </ul>
          </div>
          <div>
            <h4 class="text-sm font-medium text-gray-900">Entity Types</h4>
            <div class="mt-4 flex flex-wrap gap-2">
              <% (regulation.metadata['entity_types'] || []).each do |entity| %>
                <span class="inline-flex items-center rounded-md bg-blue-50 px-2 py-1 text-xs font-medium text-blue-700 ring-1 ring-inset ring-blue-700/10"><%= entity %></span>
              <% end %>
            </div>
            
            <% if regulation.metadata['topics'].present? %>
              <h4 class="text-sm font-medium text-gray-900 mt-6">Topics</h4>
              <div class="mt-4 flex flex-wrap gap-2">
                <% (regulation.metadata['topics'] || []).each do |topic| %>
                  <span class="inline-flex items-center rounded-md bg-purple-50 px-2 py-1 text-xs font-medium text-purple-700 ring-1 ring-inset ring-purple-700/10"><%= topic %></span>
                <% end %>
              </div>
            <% end %>
          </div>
        </div>
      </div>
    </div>
  <% end %>

  <!-- Full Text Section -->
  <div class="overflow-hidden bg-white shadow sm:rounded-lg">
    <div class="px-4 py-5 sm:px-6">
      <h3 class="text-base font-semibold leading-6 text-gray-900">Full Text</h3>
    </div>
    <div class="border-t border-gray-200 px-4 py-5 sm:p-6">
      <div class="prose max-w-none text-gray-700 bg-gray-50 p-4 rounded-md border border-gray-200 overflow-auto max-h-96 break-words">
        <%= render_json(regulation.full_text) %>
      </div>
    </div>
  </div>

  <!-- Files Section -->
  <div class="overflow-hidden bg-white shadow sm:rounded-lg">
    <div class="px-4 py-5 sm:px-6">
      <h3 class="text-base font-semibold leading-6 text-gray-900">Files</h3>
    </div>
    <div class="border-t border-gray-200 px-4 py-5 sm:p-6">
      <div class="bg-gray-50 p-4 rounded-md border border-gray-200">
        <%= render_json(regulation.files) %>
      </div>
    </div>
  </div>

  <!-- Raw Metadata (Collapsible Details) -->
  <div class="overflow-hidden bg-white shadow sm:rounded-lg">
    <details class="group">
      <summary class="flex cursor-pointer items-center justify-between px-4 py-5 sm:px-6 hover:bg-gray-50">
        <h3 class="text-base font-semibold leading-6 text-gray-900">Raw Metadata</h3>
        <span class="ml-6 flex h-7 w-7 items-center justify-center rounded-full border border-gray-200 bg-white group-open:rotate-180">
          <svg class="h-6 w-6 text-gray-500" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" d="M19.5 8.25l-7.5 7.5-7.5-7.5" />
          </svg>
        </span>
      </summary>
      <div class="border-t border-gray-200 px-4 py-5 sm:p-6">
        <pre class="overflow-auto text-xs text-gray-600"><%= JSON.pretty_generate(regulation.metadata) %></pre>
      </div>
    </details>
  </div>

  <!-- Feedback Section -->
  <div class="bg-white shadow sm:rounded-lg overflow-hidden">
    <div class="px-4 py-5 sm:px-6">
       <h3 class="text-base font-semibold leading-6 text-gray-900">Provide Feedback</h3>
    </div>
    <div class="border-t border-gray-200 px-4 py-5 sm:p-6">
      <%= form_with(model: Feedback.new, url: feedbacks_path, class: "space-y-4") do |form| %>
        <%= hidden_field_tag :feedbackable_type, 'Regulation' %>
        <%= hidden_field_tag :feedbackable_id, regulation.id %>
        <div>
          <%= form.label :content, "Your Feedback on AI Extraction", class: "block text-sm font-medium text-gray-700" %>
          <div class="mt-1">
            <%= form.text_area :content, rows: 3, class: "block w-full rounded-md border-gray-300 shadow-sm focus:border-indigo-500 focus:ring-indigo-500 sm:text-sm", placeholder: "Report issues with extraction..." %>
          </div>
        </div>
        <div class="flex justify-end">
          <%= form.submit "Submit Feedback", class: "rounded-md bg-indigo-600 px-3 py-2 text-sm font-semibold text-white shadow-sm hover:bg-indigo-500 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-indigo-600" %>
        </div>
      <% end %>
    </div>
  </div>
</div>
