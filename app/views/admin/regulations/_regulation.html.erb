<div id="<%= dom_id regulation %>">
  <p class="my-5">
    <strong class="block font-medium mb-1">Title:</strong>
    <%= regulation.title %>
  </p>

  <p class="my-5">
    <strong class="block font-medium mb-1">Agency:</strong>
    <%= regulation.agency %>
  </p>

  <p class="my-5">
    <strong class="block font-medium mb-1">Jurisdiction:</strong>
    <%= regulation.jurisdiction %>
  </p>

  <p class="my-5">
    <strong class="block font-medium mb-1">Reg type:</strong>
    <%= regulation.reg_type %>
  </p>

  <p class="my-5">
    <strong class="block font-medium mb-1">Version:</strong>
    <%= regulation.version %>
  </p>

  <p class="my-5">
    <strong class="block font-medium mb-1">Effective date:</strong>
    <%= regulation.effective_date %>
  </p>

  <p class="my-5">
    <strong class="block font-medium mb-1">Status:</strong>
    <%= regulation.status %>
  </p>

  <p class="my-5">
    <strong class="block font-medium mb-1">Full text:</strong>
    <%= regulation.full_text %>
  </p>

  <p class="my-5">
    <strong class="block font-medium mb-1">Files:</strong>
    <%= regulation.files %>
  </p>

  <p class="my-5">
    <strong class="block font-medium mb-1">Metadata:</strong>
    <%= regulation.metadata %>
  </p>

  <p class="my-5">
    <strong class="block font-medium mb-1">External:</strong>
    <%= regulation.external_id %>
  </p>

  <p class="my-5">
    <strong class="block font-medium mb-1">Previous version:</strong>
    <%= regulation.previous_version_id %>
  </p>

</div>
