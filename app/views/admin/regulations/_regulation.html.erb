<div id="<%= dom_id regulation %>" class="bg-white rounded-lg shadow-md p-6">
  <div class="flex justify-between items-start mb-6">
    <div>
      <h1 class="text-3xl font-bold text-gray-900 mb-2"><%= regulation.title %></h1>
    </div>
  </div>

  <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6 mb-8">
    <div class="bg-gray-50 rounded-lg p-4">
      <h3 class="text-sm font-medium text-gray-500 mb-1">Agency</h3>
      <p class="text-lg font-semibold text-gray-900"><%= regulation.agency %></p>
    </div>
    <div class="bg-gray-50 rounded-lg p-4">
      <h3 class="text-sm font-medium text-gray-500 mb-1">Jurisdiction</h3>
      <p class="text-lg font-semibold text-gray-900"><%= regulation.jurisdiction %></p>
    </div>
    <div class="bg-gray-50 rounded-lg p-4">
      <h3 class="text-sm font-medium text-gray-500 mb-1">Version</h3>
      <p class="text-lg font-semibold text-gray-900"><%= regulation.version %></p>
    </div>
    <div class="bg-gray-50 rounded-lg p-4">
      <h3 class="text-sm font-medium text-gray-500 mb-1">Status</h3>
      <p class="text-lg font-semibold">
        <span class="px-2 py-1 text-xs font-medium rounded-full 
                   <%= regulation.status == 'active' ? 'bg-green-100 text-green-800' : 'bg-gray-100 text-gray-800' %>">
          <%= regulation.status.titleize %>
        </span>
      </p>
    </div>
    <div class="bg-gray-50 rounded-lg p-4">
      <h3 class="text-sm font-medium text-gray-500 mb-1">Type</h3>
      <p class="text-lg font-semibold text-gray-900"><%= regulation.reg_type %></p>
    </div>
    <div class="bg-gray-50 rounded-lg p-4">
      <h3 class="text-sm font-medium text-gray-500 mb-1">Effective Date</h3>
      <p class="text-lg font-semibold text-gray-900"><%= regulation.effective_date %></p>
    </div>
    <div class="bg-gray-50 rounded-lg p-4">
      <h3 class="text-sm font-medium text-gray-500 mb-1">External ID</h3>
      <p class="text-lg font-semibold text-gray-900"><%= regulation.external_id %></p>
    </div>
    <div class="bg-gray-50 rounded-lg p-4">
      <h3 class="text-sm font-medium text-gray-500 mb-1">Previous Version ID</h3>
      <p class="text-lg font-semibold text-gray-900"><%= regulation.previous_version_id %></p>
    </div>
  </div>

  <div class="border-t border-gray-200 pt-6 mb-8">
    <h3 class="text-lg font-semibold text-gray-900 mb-4">Full Text</h3>
    <div class="p-4 bg-gray-50 rounded-md border border-gray-200">
      <%= render_json(regulation.full_text) %>
    </div>
  </div>

  <div class="border-t border-gray-200 pt-6 mb-8">
    <h3 class="text-lg font-semibold text-gray-900 mb-4">Files</h3>
    <div class="p-4 bg-gray-50 rounded-md border border-gray-200">
      <%= render_json(regulation.files) %>
    </div>
  </div>

  <div class="border-t border-gray-200 pt-6">
    <h3 class="text-lg font-semibold text-gray-900 mb-4">Metadata</h3>
    <div class="p-4 bg-gray-50 rounded-md border border-gray-200">
      <%= render_json(regulation.metadata) %>
    </div>
  </div>
</div>
