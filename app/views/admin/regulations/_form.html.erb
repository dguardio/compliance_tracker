<%= form_with(model: [:admin, regulation], class: "space-y-6") do |form| %>
  <% if regulation.errors.any? %>
    <%= render Joyful::CardComponent.new(padding: true) do %>
      <div class="space-y-2">
        <h2 class="text-lg font-bold text-red-700 flex items-center gap-2">
          <i class="fas fa-exclamation-circle"></i>
          <%= pluralize(regulation.errors.count, "error") %> prohibited this regulation from being saved:
        </h2>
        <ul class="list-disc pl-5 text-red-600">
          <% regulation.errors.each do |error| %>
            <li><%= error.full_message %></li>
          <% end %>
        </ul>
      </div>
    <% end %>
  <% end %>

  <%= render Joyful::CardComponent.new(title: "Regulation Details", icon: "balance-scale", padding: true) do %>
    <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
      <%= render Joyful::InputComponent.new(
            form: form, 
            method: :title, 
            label: "Title", 
            placeholder: "e.g., General Data Protection Regulation",
            class: "col-span-1 md:col-span-2"
          ) %>

      <%= render Joyful::InputComponent.new(
            form: form, 
            method: :agency, 
            label: "Agency", 
            placeholder: "e.g., EU Parliament"
          ) %>

      <%= render Joyful::InputComponent.new(
            form: form, 
            method: :jurisdiction, 
            label: "Jurisdiction", 
            placeholder: "e.g., European Union"
          ) %>

      <%= render Joyful::InputComponent.new(
            form: form, 
            method: :reg_type, 
            label: "Type", 
            type: :select,
            choices: [
              ['Federal Law', 'federal_law'],
              ['State Law', 'state_law'],
              ['Regulation', 'regulation'],
              ['Guidance', 'guidance'],
              ['Executive Order', 'executive_order'],
              ['Other', 'other']
            ],
            options: { prompt: 'Select regulation type' },
            html_options: { class: "w-full rounded-xl border-gray-300 shadow-sm focus:border-primary-500 focus:ring-primary-500" }
          ) %>

      <%= render Joyful::InputComponent.new(
            form: form, 
            method: :status, 
            label: "Status", 
            type: :select,
            choices: [
              ['Active', 'active'],
              ['Draft', 'draft'],
              ['Proposed', 'proposed'],
              ['Amended', 'amended'],
              ['Repealed', 'repealed'],
              ['Expired', 'expired']
            ],
            options: { prompt: 'Select status' },
            html_options: { class: "w-full rounded-xl border-gray-300 shadow-sm focus:border-primary-500 focus:ring-primary-500" }
          ) %>

      <%= render Joyful::InputComponent.new(
            form: form, 
            method: :version, 
            label: "Version", 
            type: :number_field,
            options: { min: 1 }
          ) %>

      <%= render Joyful::InputComponent.new(
            form: form, 
            method: :effective_date, 
            label: "Effective Date", 
            type: :date_field
          ) %>

      <%= render Joyful::InputComponent.new(
            form: form, 
            method: :external_id, 
            label: "External ID", 
            placeholder: "ID from external system"
          ) %>

      <%= render Joyful::InputComponent.new(
            form: form, 
            method: :previous_version_id, 
            label: "Previous Version ID", 
            type: :number_field
          ) %>
    </div>
  <% end %>

  <%= render Joyful::CardComponent.new(title: "Internal Data (JSON)", icon: "code", padding: true) do %>
    <div class="space-y-6">
      <%= render Joyful::InputComponent.new(
            form: form, 
            method: :full_text, 
            label: "Full Text", 
            type: :text_area,
            rows: 6,
            class: "font-mono text-sm"
          ) %>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
        <%= render Joyful::InputComponent.new(
              form: form, 
              method: :files, 
              label: "Files", 
              type: :text_area,
              rows: 4,
              class: "font-mono text-sm"
            ) %>

        <%= render Joyful::InputComponent.new(
              form: form, 
              method: :metadata, 
              label: "Metadata", 
              type: :text_area,
              rows: 4,
              class: "font-mono text-sm"
            ) %>
      </div>
    </div>
  <% end %>

  <div class="flex justify-end gap-3 pt-4">
    <%= render Joyful::ButtonComponent.new(
          text: "Cancel",
          variant: :secondary,
          path: admin_regulations_path
        ) %>
    
    <%= render Joyful::ButtonComponent.new(
          text: "Save Regulation",
          type: :submit,
          variant: :primary,
          icon: "save"
        ) %>
  </div>
<% end %>
