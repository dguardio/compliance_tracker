<div class="mx-auto md:w-2/3 w-full flex">
  <div class="mx-auto">
    <% if notice.present? %>
      <p class="py-2 px-3 bg-green-50 mb-5 text-green-500 font-medium rounded-lg inline-block" id="notice"><%= notice %></p>
    <% end %>

    <div class="bg-white shadow rounded-lg p-6 mb-6">
      <div class="flex justify-between items-start mb-4">
        <h3 class="text-lg font-medium text-gray-900">Regulation Text</h3>
        <%= link_to workspace_admin_regulation_path(@regulation), class: "inline-flex items-center px-4 py-2 border border-transparent text-sm font-medium rounded-md shadow-sm text-white bg-indigo-600 hover:bg-indigo-700 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-indigo-500" do %>
          <svg class="-ml-1 mr-2 h-5 w-5" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z" />
          </svg>
          Redline & Comment
        <% end %>
      </div>
      <div class="prose max-w-none">
        <%= render @regulation %>
      </div>
    </div>

    <% if current_organization %>
      <div class="mt-8 bg-white shadow sm:rounded-lg">
        <div class="px-4 py-5 sm:px-6 border-b border-gray-200">
          <h3 class="text-lg leading-6 font-medium text-gray-900">Linked Policies (Your Organization)</h3>
          <p class="mt-1 max-w-2xl text-sm text-gray-500">Internal policies linked to this regulation.</p>
        </div>
        <ul role="list" class="divide-y divide-gray-200">
          <% linked_policies = Policy.joins(:policy_links).where(policy_links: { linkable: @regulation, linkable_type: 'Regulation' }).where(organization: current_organization) %>
          <% linked_policies.each do |policy| %>
            <li class="px-4 py-4 sm:px-6 hover:bg-gray-50">
              <div class="flex items-center justify-between">
                <div class="text-sm font-medium text-indigo-600 truncate">
                  <%= link_to policy.title, admin_policy_path(policy) %>
                </div>
                <div class="ml-2 flex-shrink-0 flex">
                  <span class="px-2 inline-flex text-xs leading-5 font-semibold rounded-full <%= policy.active? ? 'bg-green-100 text-green-800' : 'bg-gray-100 text-gray-800' %>">
                    <%= policy.status.humanize %>
                  </span>
                </div>
              </div>
              <% link = policy.policy_links.find_by(linkable: @regulation) %>
              <% if link&.citation.present? %>
                <p class="mt-1 text-xs text-gray-500">Citation: <%= link.citation %></p>
              <% end %>
            </li>
          <% end %>
          <% if linked_policies.empty? %>
            <li class="px-4 py-4 sm:px-6 text-sm text-gray-500 italic">No linked policies found for your organization.</li>
          <% end %>
        </ul>
      </div>
    <% end %>

    <%= link_to "Edit this regulation", edit_admin_regulation_path(@regulation), class: "mt-2 rounded-lg py-3 px-5 bg-gray-100 inline-block font-medium" %>
    <%= link_to "Back to regulations", admin_regulations_path, class: "ml-2 rounded-lg py-3 px-5 bg-gray-100 inline-block font-medium" %>
    <div class="inline-block ml-2">
      <%= button_to "Destroy this regulation", admin_regulation_path(@regulation), method: :delete, class: "mt-2 rounded-lg py-3 px-5 bg-gray-100 font-medium" %>
    </div>
  </div>
</div>
