<div class="header">
  <h1>Regulation Diff: <%= @regulation.title %></h1>
  <p>
    <strong>Comparing Revision <%= @regulation.revision %></strong> (Current) 
    vs 
    <strong>Revision <%= @previous_regulation.revision %></strong> (Previous)
  </p>
  <p>Generated on: <%= Time.current.strftime("%Y-%m-%d %H:%M:%S") %></p>
</div>

<hr>

<!-- Include the Diff CSS -->
<%= wicked_pdf_stylesheet_link_tag "admin/diff" %>

<div class="content diff">
  <%= raw @diff_html %>
</div>
