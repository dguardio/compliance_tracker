<div class="mx-auto w-full px-4 sm:px-6 lg:px-8 flex">
  <div class="mx-auto w-full">
    <div class="mb-6 flex justify-between items-center">
      <div>
        <h2 class="text-2xl font-bold text-gray-900"><%= @regulation.title %></h2>
        <p class="text-sm text-gray-500">Workspace Mode - Commenting & Redlining</p>
      </div>
      <div class="flex gap-2">
        <%= link_to workspace_admin_regulation_path(@regulation, format: :pdf), class: "inline-flex items-center px-3 py-2 border border-gray-300 shadow-sm text-sm leading-4 font-medium rounded-md text-gray-700 bg-white hover:bg-gray-50 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-indigo-500", target: "_blank" do %>
          <svg class="-ml-0.5 mr-2 h-4 w-4" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4" />
          </svg>
          Download PDF
        <% end %>
        <%= link_to "Back to Regulation", admin_regulation_path(@regulation), class: "inline-flex items-center px-3 py-2 border border-transparent text-sm leading-4 font-medium rounded-md text-indigo-700 bg-indigo-100 hover:bg-indigo-200 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-indigo-500" %>
      </div>
    </div>

    <div class="flex gap-6" data-controller="commentable" 
         data-commentable-url-value="<%= admin_regulation_comments_path(@regulation) %>"
         data-commentable-comments-value="<%= @comments_json %>"
         data-commentable-users-value="<%= @users.to_json %>">
      <div class="flex-1 relative">
        <!-- PDF-specific logic -->
        <% if request.format.pdf? %>
          <style>
            .comment-highlight { background-color: #fef08a; } /* yellow-200 */
            .suggestion-highlight { background-color: #f3e8ff; color: #7e22ce; border-bottom: 2px solid #c084fc; } /* purple theme */
            .evidence-request-highlight { background-color: #dbeafe; color: #1d4ed8; border-bottom: 2px solid #3b82f6; } /* blue theme */
            /* Hide sidebar and form in PDF */
            .pdf-hidden { display: none !important; }
            .json-key { font-weight: bold; }
            .json-entry { margin-bottom: 0.5rem; }
            .json-array { margin-left: 1rem; border-left: 2px solid #e5e7eb; padding-left: 0.5rem; }
          </style>
          
          <div class="prose max-w-none bg-white p-8 shadow rounded-lg">
             <%= HighlightedJsonRenderer.new(@regulation.full_text, @regulation.comments).render %>
          </div>

          <!-- Render Comments List for PDF -->
          <div class="mt-8 border-t border-gray-200 pt-8">
            <h3 class="text-lg font-bold text-gray-900 mb-4">Comments & Annotations</h3>
            <% @regulation.comments.order(:start_index).each do |comment| %>
              <div class="mb-4 p-4 rounded-lg border <%= case comment.comment_type
                  when 'suggestion' then 'bg-purple-50 border-purple-200'
                  when 'evidence_request' then 'bg-blue-50 border-blue-200'
                  else 'bg-yellow-50 border-yellow-200'
                  end %>">
                <div class="flex justify-between items-start">
                  <div>
                    <span class="text-xs font-semibold uppercase tracking-wide <%= case comment.comment_type
                        when 'suggestion' then 'text-purple-800'
                        when 'evidence_request' then 'text-blue-800'
                        else 'text-yellow-800'
                        end %>">
                      <%= comment.comment_type.humanize %>
                    </span>
                    <span class="text-xs text-gray-500 ml-2">by <%= comment.user.full_name %></span>
                    <% if comment.assignee %>
                      <span class="text-xs text-gray-500 ml-2">assigned to <%= comment.assignee.full_name %></span>
                    <% end %>
                  </div>
                  <span class="text-xs text-gray-400"><%= comment.created_at.strftime("%b %d, %Y") %></span>
                </div>
                
                <div class="mt-2 text-sm text-gray-900"><%= comment.content %></div>
                
                <% if comment.suggested_text.present? %>
                  <div class="mt-2 text-sm">
                    <span class="font-medium text-gray-700">Suggested Change:</span>
                    <div class="mt-1 p-2 bg-white rounded border border-gray-200 font-mono text-xs">
                      <%= comment.suggested_text %>
                    </div>
                  </div>
                <% end %>
                
                <% if comment.selected_text.present? %>
                  <div class="mt-2 text-xs text-gray-500 italic">
                    Reference: "<%= comment.selected_text.truncate(100) %>"
                  </div>
                <% end %>
              </div>
            <% end %>
          </div>
        <% else %>
          <div id="regulation-text" data-action="mouseup->commentable#handleSelection" data-commentable-target="content" class="prose max-w-none bg-white p-8 shadow rounded-lg min-h-screen">
            <%= render_json(@regulation.full_text) %>
          </div>

          <!-- Comment Form Popover (Web only) -->
          <div data-commentable-target="form" class="absolute z-50 bg-white shadow-xl rounded-lg p-4 border border-gray-200 w-80 hidden">
            <h4 class="text-sm font-medium text-gray-900 mb-2">Add Comment</h4>
            <form data-action="submit->commentable#submit">
              <div class="mb-2 flex space-x-4 border-b border-gray-200 pb-2">
                <label class="inline-flex items-center">
                  <input type="radio" name="comment_type" value="comment" checked data-action="change->commentable#toggleType" class="form-radio text-indigo-600 h-4 w-4">
                  <span class="ml-2 text-xs text-gray-700">Comment</span>
                </label>
                <label class="inline-flex items-center">
                  <input type="radio" name="comment_type" value="suggestion" data-action="change->commentable#toggleType" class="form-radio text-purple-600 h-4 w-4">
                  <span class="ml-2 text-xs text-gray-700">Suggestion</span>
                </label>
                <label class="inline-flex items-center">
                  <input type="radio" name="comment_type" value="evidence_request" data-action="change->commentable#toggleType" class="form-radio text-blue-600 h-4 w-4">
                  <span class="ml-2 text-xs text-gray-700">Request Evidence</span>
                </label>
              </div>
              
              <div data-commentable-target="suggestionField" class="hidden mb-2">
                 <label class="block text-xs font-medium text-gray-700 mb-1">Suggested Text</label>
                 <textarea data-commentable-target="suggestedText" class="w-full text-sm border-gray-300 rounded-md shadow-sm focus:border-purple-500 focus:ring-purple-500" rows="2"></textarea>
              </div>

              <div data-commentable-target="assigneeField" class="hidden mb-2">
                 <label class="block text-xs font-medium text-gray-700 mb-1">Assign To</label>
                 <select data-commentable-target="assigneeSelect" class="w-full text-sm border-gray-300 rounded-md shadow-sm focus:border-blue-500 focus:ring-blue-500">
                   <option value="">Select User...</option>
                 </select>
              </div>

              <textarea data-commentable-target="input" class="w-full text-sm border-gray-300 rounded-md shadow-sm focus:border-indigo-500 focus:ring-indigo-500" rows="3" placeholder="Type your comment..."></textarea>
              <input type="hidden" data-commentable-target="selected">
              <input type="hidden" data-commentable-target="start">
              <input type="hidden" data-commentable-target="end">
              <div class="mt-3 flex justify-end space-x-2">
                <button type="button" data-action="click->commentable#hideForm" class="px-3 py-1.5 text-xs font-medium text-gray-700 bg-white border border-gray-300 rounded-md hover:bg-gray-50">Cancel</button>
                <button type="submit" class="px-3 py-1.5 text-xs font-medium text-white bg-indigo-600 rounded-md hover:bg-indigo-700">Save</button>
              </div>
            </form>
          </div>
        <% end %>
      </div>

      <!-- Sidebar for Comments -->
      <div class="w-80 flex-shrink-0 <%= 'pdf-hidden' if request.format.pdf? %>">
        <div class="bg-white shadow rounded-lg p-4 sticky top-24">
          <h3 class="text-lg font-medium text-gray-900 mb-4">Comments & Suggestions</h3>
          <div data-commentable-target="list" class="space-y-4 max-h-[calc(100vh-200px)] overflow-y-auto">
            <!-- Comments will be loaded here via Stimulus -->
          </div>
        </div>
      </div>
    </div>
  </div>
</div>
