<div class="container mx-auto px-4 py-8">
  <% if notice.present? %>
    <%= render Joyful::ToastComponent.new(message: notice, type: :success) %>
  <% end %>

  <!-- Header Section -->
  <div class="flex flex-col md:flex-row justify-between items-start md:items-center mb-8 gap-4">
    <div>
      <h1 class="text-3xl font-bold text-gray-900 tracking-tight">Regulation Library</h1>
      <p class="mt-1 text-gray-500">The authoritative source for all regulatory documents, standards, and laws.</p>
    </div>
    <div class="flex space-x-3">
        <%= render Joyful::ButtonComponent.new(
            text: "Add Regulation",
            path: new_admin_regulation_path,
            variant: :primary,
            icon: "plus"
        ) %>
    </div>
  </div>

  <!-- Search & Filter Bar -->
  <div class="bg-white rounded-xl shadow-sm border border-gray-100 p-4 mb-6">
    <%= search_form_for @q, url: admin_regulations_path, method: :get, class: "flex flex-col md:flex-row gap-4 items-end" do |f| %>
      <div class="flex-grow w-full md:w-1/3">
        <%= f.label :title_cont, "Search Library", class: "text-xs font-semibold text-gray-500 uppercase tracking-wider mb-1 block" %>
        <div class="relative">
          <div class="absolute inset-y-0 left-0 pl-3 flex items-center pointer-events-none">
            <svg class="h-5 w-5 text-gray-400" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor">
              <path fill-rule="evenodd" d="M8 4a4 4 0 100 8 4 4 0 000-8zM2 8a6 6 0 1110.89 3.476l4.817 4.817a1 1 0 01-1.414 1.414l-4.816-4.816A6 6 0 012 8z" clip-rule="evenodd" />
            </svg>
          </div>
          <%= text_field_tag :search_by_all, params[:search_by_all], class: "block w-full pl-10 pr-3 py-2 border border-gray-200 rounded-lg leading-5 bg-gray-50 placeholder-gray-400 focus:outline-none focus:bg-white focus:ring-2 focus:ring-primary-500 focus:border-primary-500 sm:text-sm transition-all duration-200", placeholder: "Search title, agency, or content..." %>
        </div>
      </div>
      
      <div class="w-full md:w-48">
        <%= f.label :agency_cont, "Agency", class: "text-xs font-semibold text-gray-500 uppercase tracking-wider mb-1 block" %>
        <%= f.search_field :agency_cont, class: "block w-full px-3 py-2 border border-gray-200 rounded-lg bg-gray-50 focus:outline-none focus:ring-primary-500 focus:border-primary-500 sm:text-sm", placeholder: "e.g. SEC, ISO" %>
      </div>

      <div class="w-full md:w-48">
        <%= f.label :jurisdiction_cont, "Jurisdiction", class: "text-xs font-semibold text-gray-500 uppercase tracking-wider mb-1 block" %>
        <%= f.search_field :jurisdiction_cont, class: "block w-full px-3 py-2 border border-gray-200 rounded-lg bg-gray-50 focus:outline-none focus:ring-primary-500 focus:border-primary-500 sm:text-sm", placeholder: "e.g. US, EU" %>
      </div>

      <div class="flex items-center pb-2">
        <label class="inline-flex items-center cursor-pointer">
          <%= check_box_tag :semantic_search, "1", params[:semantic_search] == "1", class: "form-checkbox h-4 w-4 text-primary-600 border-gray-300 rounded focus:ring-primary-500" %>
          <span class="ml-2 text-sm text-gray-600 font-medium">Semantic Search</span>
        </label>
      </div>

      <div class="flex gap-2">
        <%= render Joyful::ButtonComponent.new(
              text: "Search",
              variant: :secondary,
              form: f
            ) %>
        <%= link_to admin_regulations_path, 
            class: "inline-flex items-center justify-center px-4 py-2 border border-transparent font-medium rounded-lg text-gray-500 hover:text-gray-700 hover:bg-gray-50 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-gray-500 transition-colors duration-200" do %>
          <span class="sr-only">Clear</span>
           <svg class="h-5 w-5" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor">
            <path fill-rule="evenodd" d="M4.293 4.293a1 1 0 011.414 0L10 8.586l4.293-4.293a1 1 0 111.414 1.414L11.414 10l4.293 4.293a1 1 0 01-1.414 1.414L10 11.414l-4.293 4.293a1 1 0 01-1.414-1.414L8.586 10 4.293 5.707a1 1 0 010-1.414z" clip-rule="evenodd" />
          </svg>
        <% end %>
      </div>
    <% end %>
  </div>

  <%= form_with url: bulk_delete_admin_regulations_path, method: :delete, id: "bulk-actions-form", data: { confirm: "Delete selected regulations?" } do |form| %>
    <!-- Bulk Actions Toolbar (Hidden by default, shown by JS when items selected) -->
    <div id="bulk-toolbar" class="hidden bg-primary-50 border border-primary-200 rounded-lg p-3 mb-6 flex items-center justify-between animate-fadeInUp">
        <span class="text-sm text-primary-800 font-medium">Selected items: <span id="selected-count">0</span></span>
        <%= form.submit "Delete Selected", class: "px-3 py-1.5 bg-white border border-red-200 text-red-600 rounded-md text-sm font-medium hover:bg-red-50 cursor-pointer shadow-sm" %>
    </div>

    <!-- Regulations Grid -->
    <% if @regulations.any? %>
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 gap-6">
        <% @regulations.each do |regulation| %>
            <div class="group relative bg-white rounded-r-xl rounded-l-md shadow-sm hover:shadow-lg transition-all duration-300 border-l-4 border-l-primary-500 border-y border-r border-gray-200 flex flex-col h-full hover:-translate-y-1">
                <!-- Selection Checkbox (Absolute) -->
                <div class="absolute top-3 right-3 z-10 opacity-0 group-hover:opacity-100 transition-opacity">
                    <%= check_box_tag "regulation_ids[]", regulation.id, false, class: "regulation-checkbox w-5 h-5 text-primary-600 rounded focus:ring-primary-500 border-gray-300 shadow-sm" %>
                </div>

                <div class="p-5 flex-grow">
                    <div class="flex items-center justify-between mb-3">
                        <span class="text-xs font-bold text-gray-400 uppercase tracking-wider"><%= regulation.agency %></span>
                        <%= render Joyful::StatusPillComponent.new(status: regulation.status) %>
                    </div>
                    
                    <h3 class="text-lg font-bold text-gray-900 mb-2 leading-tight group-hover:text-primary-600 transition-colors">
                        <%= link_to regulation.title, admin_regulation_path(regulation) %>
                    </h3>
                    
                    <div class="flex items-center text-sm text-gray-500 mb-4">
                        <svg class="w-4 h-4 mr-1.5 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3.055 11H5a2 2 0 012 2v1a2 2 0 002 2 2 2 0 012 2v2.945M8 3.935V5.5A2.5 2.5 0 0010.5 8h.5a2 2 0 012 2 2 2 0 104 0 2 2 0 012-2h1.064M15 20.488V18a2 2 0 012-2h3.064M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path></svg>
                        <%= regulation.jurisdiction %>
                    </div>
                </div>

                <div class="bg-gray-50 px-5 py-3 border-t border-gray-100 flex justify-between items-center rounded-br-xl">
                    <span class="text-xs text-gray-500 font-medium">Effective: <%= regulation.effective_date&.strftime('%b %Y') || 'TBD' %></span>
                    
                    <div class="flex space-x-2">
                         <%= link_to admin_regulation_path(regulation), class: "text-gray-400 hover:text-primary-600 transition-colors", title: "View" do %>
                            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"></path><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z"></path></svg>
                        <% end %>
                        <%= link_to edit_admin_regulation_path(regulation), class: "text-gray-400 hover:text-blue-600 transition-colors", title: "Edit" do %>
                            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z"></path></svg>
                        <% end %>
                    </div>
                </div>
            </div>
        <% end %>
        </div>

        <!-- Pagination -->
        <div class="mt-8 flex justify-center">
        <%= paginate @regulations, theme: 'tailwind' %>
        </div>
    <% else %>
        <div class="text-center py-20 bg-white rounded-xl shadow-sm border border-dashed border-gray-300">
            <div class="mx-auto h-24 w-24 bg-indigo-50 rounded-full flex items-center justify-center mb-6 animate-float">
                <svg class="h-12 w-12 text-indigo-500" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.247 18 16.5 18c-1.746 0-3.332.477-4.5 1.253" />
                </svg>
            </div>
            <h3 class="text-xl font-bold text-gray-900 mb-2">Library is Empty</h3>
            <p class="text-gray-500 mb-8 max-w-sm mx-auto">Start building your regulatory library by adding standard regulations or internal policies.</p>
            <%= render Joyful::ButtonComponent.new(
                text: "Add Regulation",
                path: new_admin_regulation_path,
                variant: :primary,
                icon: "plus"
            ) %>
        </div>
    <% end %>
  <% end %>

  <script>
    document.addEventListener("DOMContentLoaded", function() {
        const checkboxes = document.querySelectorAll('.regulation-checkbox');
        const toolbar = document.getElementById('bulk-toolbar');
        const countSpan = document.getElementById('selected-count');

        function updateToolbar() {
            const checkedCount = document.querySelectorAll('.regulation-checkbox:checked').length;
            countSpan.textContent = checkedCount;
            if (checkedCount > 0) {
                toolbar.classList.remove('hidden');
            } else {
                toolbar.classList.add('hidden');
            }
        }

        checkboxes.forEach(cb => {
            cb.addEventListener('change', updateToolbar);
        });
    });
  </script>
</div>
