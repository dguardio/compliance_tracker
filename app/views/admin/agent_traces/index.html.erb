<div class="container mx-auto px-4 py-8">
  <div class="flex justify-between items-center mb-6">
    <h1 class="text-2xl font-bold">Agent Activity Log</h1>
    <div class="text-sm text-gray-500">
      Monitoring real-time agent decisions
    </div>
  </div>

  <div class="bg-white shadow-md rounded-lg overflow-hidden">
    <table class="min-w-full leading-normal">
      <thead>
        <tr>
          <th class="px-5 py-3 border-b-2 border-gray-200 bg-gray-100 text-left text-xs font-semibold text-gray-600 uppercase tracking-wider">
            Time
          </th>
          <th class="px-5 py-3 border-b-2 border-gray-200 bg-gray-100 text-left text-xs font-semibold text-gray-600 uppercase tracking-wider">
            Agent
          </th>
          <th class="px-5 py-3 border-b-2 border-gray-200 bg-gray-100 text-left text-xs font-semibold text-gray-600 uppercase tracking-wider">
            Action
          </th>
          <th class="px-5 py-3 border-b-2 border-gray-200 bg-gray-100 text-left text-xs font-semibold text-gray-600 uppercase tracking-wider">
            Status
          </th>
          <th class="px-5 py-3 border-b-2 border-gray-200 bg-gray-100 text-left text-xs font-semibold text-gray-600 uppercase tracking-wider">
            Duration
          </th>
          <th class="px-5 py-3 border-b-2 border-gray-200 bg-gray-100 text-left text-xs font-semibold text-gray-600 uppercase tracking-wider">
            Actions
          </th>
        </tr>
      </thead>
      <tbody>
        <% @traces.each do |trace| %>
          <tr>
            <td class="px-5 py-5 border-b border-gray-200 bg-white text-sm">
              <%= trace.created_at.strftime("%b %d, %H:%M:%S") %>
            </td>
            <td class="px-5 py-5 border-b border-gray-200 bg-white text-sm">
              <span class="font-medium text-gray-900"><%= trace.agent_name %></span>
            </td>
            <td class="px-5 py-5 border-b border-gray-200 bg-white text-sm">
              <%= trace.action %>
            </td>
            <td class="px-5 py-5 border-b border-gray-200 bg-white text-sm">
              <span class="px-2 inline-flex text-xs leading-5 font-semibold rounded-full 
                <%= trace.success? ? 'bg-green-100 text-green-800' : (trace.error? ? 'bg-red-100 text-red-800' : 'bg-yellow-100 text-yellow-800') %>">
                <%= trace.status %>
              </span>
            </td>
             <td class="px-5 py-5 border-b border-gray-200 bg-white text-sm">
              <%= trace.duration ? "#{trace.duration.round(2)}s" : '-' %>
            </td>
            <td class="px-5 py-5 border-b border-gray-200 bg-white text-sm">
              <%= link_to 'View Trace', admin_agent_trace_path(trace), class: "text-blue-600 hover:text-blue-900" %>
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>
    <div class="px-5 py-5 bg-white border-t flex flex-col xs:flex-row items-center xs:justify-between          ">
      <%= paginate @traces %>
    </div>
  </div>
</div>
