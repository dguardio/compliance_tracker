<div class="flex h-screen bg-gray-50 overflow-hidden" data-controller="ai-assistant modal">
  
  <!-- Main Content -->
  <div class="flex-1 flex flex-col overflow-hidden relative">
    <!-- Header -->
    <header class="bg-white border-b border-gray-200 py-4 px-6 shadow-sm z-20">
      <div class="flex flex-col md:flex-row justify-between md:items-center gap-4">
        <div>
          <h1 class="text-2xl font-bold text-gray-900 tracking-tight">Active Compliance Tables</h1>
          <p class="text-sm text-gray-500 mt-1">Analyze <%= @regulations.count %> regulations with AI-powered extraction.</p>
        </div>
        
        <div class="flex items-center space-x-3">
            <!-- Search -->
            <div class="w-64">
                <%= search_form_for @q, url: admin_compliance_tables_path, method: :get do |f| %>
                    <div class="relative">
                        <div class="pointer-events-none absolute inset-y-0 left-0 flex items-center pl-3">
                            <svg class="h-4 w-4 text-gray-400" viewBox="0 0 20 20" fill="currentColor">
                                <path fill-rule="evenodd" d="M9 3.5a5.5 5.5 0 100 11 5.5 5.5 0 000-11zM2 9a7 7 0 1112.452 4.391l3.328 3.329a.75.75 0 11-1.06 1.06l-3.329-3.328A7 7 0 012 9z" clip-rule="evenodd" />
                            </svg>
                        </div>
                        <%= f.search_field :title_cont, 
                            class: "block w-full rounded-pill border-gray-300 py-1.5 pl-9 text-gray-900 focus:ring-primary-500 focus:border-primary-500 sm:text-sm bg-gray-50",
                            placeholder: "Search regulations..." %>
                        <% @selected_column_ids.each do |id| %>
                            <%= hidden_field_tag "custom_column_ids[]", id %>
                        <% end %>
                    </div>
                <% end %>
            </div>

            <!-- Column Selector -->
             <div class="relative" data-controller="dropdown">
                <%= render Joyful::ButtonComponent.new(
                    text: "Columns",
                    variant: :secondary,
                    icon: "view-boards", # hypothetical icon mapping
                    data: { action: "click->dropdown#toggle" }
                ) %>

                <div data-dropdown-target="menu" class="hidden absolute right-0 z-50 mt-2 w-72 origin-top-right rounded-xl bg-white shadow-xl ring-1 ring-black ring-opacity-5 focus:outline-none animate-fadeInUp">
                    <%= form_with url: admin_compliance_tables_path, method: :get, class: "p-4" do |f| %>
                        <h3 class="text-xs font-semibold text-gray-500 uppercase tracking-wider mb-3">Visible Columns</h3>
                        <div class="mb-4 max-h-60 overflow-y-auto space-y-2 custom-scrollbar">
                        <% @available_columns.each do |column| %>
                            <label class="flex items-center p-2 rounded hover:bg-gray-50 cursor-pointer">
                                <%= check_box_tag "custom_column_ids[]", column.id, @selected_column_ids.include?(column.id.to_s), class: "h-4 w-4 rounded border-gray-300 text-primary-600 focus:ring-primary-500 transition duration-150 ease-in-out" %>
                                <span class="ml-3 text-sm font-medium text-gray-700"><%= column.name %></span>
                            </label>
                        <% end %>
                        </div>
                        <div class="pt-3 border-t border-gray-100">
                             <%= render Joyful::ButtonComponent.new(
                                text: "Update View",
                                variant: :primary,
                                class: "w-full"
                            ) %>
                        </div>
                    <% end %>
                </div>
            </div>

            <!-- Actions Dropdown or Group -->
             <%= render Joyful::ButtonComponent.new(
                text: "Export",
                path: admin_compliance_tables_path(format: :xlsx, custom_column_ids: @selected_column_ids, q: params[:q]),
                variant: :secondary
             ) %>

             <%= button_to extract_all_admin_custom_columns_path, 
                params: { custom_column_ids: @selected_column_ids },
                method: :post,
                class: "inline-flex items-center justify-center gap-2 px-4 py-2 rounded-pill font-medium transition-all duration-200 focus:outline-none focus:ring-2 focus:ring-offset-2 tabular-nums cursor-pointer bg-primary-600 text-white shadow-primary-glow hover:-translate-y-0.5 hover:shadow-lg active:translate-y-0 active:scale-95 focus:ring-primary-500" do %>
                <span>Run Extraction</span>
            <% end %>

            <%= render Joyful::ButtonComponent.new(
                text: "New Column",
                variant: :primary, # Maybe a different color if needed, but primary is safe
                icon: "plus",
                data: { action: "click->modal#open", modal_target_param: "newColumnModal" }
            ) %>
        </div>
      </div>
    </header>

    <!-- Data Grid -->
    <div class="flex-1 overflow-hidden bg-white">
      <div class="h-full overflow-x-auto overflow-y-auto custom-scrollbar">
        <table class="min-w-full divide-y divide-gray-200">
          <thead class="bg-gray-50 sticky top-0 z-10 shadow-sm">
            <tr>
              <th scope="col" class="px-6 py-4 text-left text-xs font-semibold text-gray-500 uppercase tracking-wider whitespace-nowrap bg-gray-50">Regulation</th>
              <% @custom_columns.each do |column| %>
                <th scope="col" class="px-6 py-4 text-left text-xs font-semibold text-primary-700 uppercase tracking-wider whitespace-nowrap bg-primary-50 group border-l border-primary-100 min-w-[300px]">
                  <div class="flex items-center justify-between space-x-2">
                    <span class="flex items-center">
                        <%= column.name %>
                         <!-- Mock Prompt Tooltip Trigger -->
                        <svg class="w-4 h-4 ml-1 text-primary-400 cursor-help" fill="none" viewBox="0 0 24 24" stroke="currentColor" title="<%= column.prompt %>"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" /></svg>
                    </span>
                    <%= link_to admin_compliance_tables_path(custom_column_ids: @selected_column_ids - [column.id.to_s], q: params[:q]), 
                        class: "text-primary-400 hover:text-primary-900 opacity-0 group-hover:opacity-100 transition-opacity p-1 rounded hover:bg-primary-100",
                        title: "Remove column" do %>
                      <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
                      </svg>
                    <% end %>
                  </div>
                </th>
              <% end %>
            </tr>
          </thead>
          <tbody class="bg-white divide-y divide-gray-100">
            <% if @regulations.any? %>
              <% @regulations.each do |regulation| %>
                <tr class="hover:bg-gray-50 transition-colors duration-150">
                  <td class="px-6 py-4 text-sm font-medium text-gray-900 bg-white sticky left-0 z-0">
                    <div class="max-w-xs">
                        <%= link_to regulation.title, admin_regulation_path(regulation), class: "text-primary-600 hover:text-primary-800 font-semibold block mb-1 truncate", title: regulation.title %>
                        <div class="flex items-center gap-2 text-xs text-gray-500">
                            <span class="bg-gray-100 px-1.5 py-0.5 rounded"><%= regulation.agency %></span>
                            <span>•</span>
                            <span><%= regulation.jurisdiction %></span>
                        </div>
                    </div>
                  </td>
                   <!-- Custom Columns -->
                 <% @custom_columns.each do |column| %>
                   <% extraction = regulation.regulation_extractions.find { |e| e.custom_column_id == column.id } %>
                   <td class="px-6 py-4 text-sm text-gray-900 bg-primary-50/10 border-l border-gray-100 align-top" data-controller="expandable-cell">
                     <% if extraction %>
                       <div class="relative group">
                         <div class="flex items-start justify-between cursor-pointer" data-action="click->expandable-cell#toggle">
                           <div class="flex-1 pr-4">
                             <p class="line-clamp-3 text-gray-700 leading-relaxed"><%= extraction.display_value&.truncate(150) || 'Not extracted' %></p>
                             <% if extraction.confidence_score %>
                               <% color_class = extraction.confidence_score > 0.8 ? 'bg-green-100 text-green-700' : (extraction.confidence_score > 0.5 ? 'bg-yellow-100 text-yellow-800' : 'bg-red-100 text-red-800') %>
                               <div class="mt-2">
                                    <span class="inline-flex items-center px-1.5 py-0.5 rounded text-[10px] font-bold uppercase tracking-wide <%= color_class %>">
                                        <%= (extraction.confidence_score * 100).to_i %>% Confidence
                                    </span>
                               </div>
                             <% end %>
                           </div>
                         </div>

                         <!-- Expandable Details (Joyful Style) -->
                         <div data-expandable-cell-target="details" class="hidden mt-3 p-4 bg-white border border-primary-100 rounded-xl shadow-lg relative animate-fadeInUp">
                           <div class="absolute -top-2 left-4 w-4 h-4 bg-white border-t border-l border-primary-100 transform rotate-45"></div>
                           <div class="space-y-4 relative z-10">
                             <div>
                               <p class="text-xs font-bold text-gray-400 uppercase tracking-wider mb-1">Full Extraction</p>
                               <div class="text-sm text-gray-900 bg-gray-50 p-2 rounded-lg border border-gray-100"><%= extraction.extracted_value %></div>
                             </div>
                             <% if extraction.reasoning.present? %>
                               <div>
                                 <p class="text-xs font-bold text-gray-400 uppercase tracking-wider mb-1">AI Reasoning</p>
                                 <p class="text-sm text-gray-600 italic"><%= extraction.reasoning %></p>
                               </div>
                             <% end %>
                             <% if extraction.source_text.present? %>
                               <div>
                                 <p class="text-xs font-bold text-gray-400 uppercase tracking-wider mb-1">Source Context</p>
                                 <p class="text-xs text-gray-500 bg-yellow-50 p-2 rounded border border-yellow-100">"<%= extraction.source_text.truncate(300) %>"</p>
                               </div>
                             <% end %>
                           </div>
                         </div>
                       </div>
                     <% else %>
                       <span class="text-gray-400 italic text-xs">Waiting for extraction...</span>
                     <% end %>
                   </td>
                 <% end %>
               </tr>
            <% end %>
            <% else %>
              <!-- Empty State -->
              <tr>
                <td colspan="<%= 1 + @custom_columns.count %>" class="px-6 py-20 text-center">
                  <div class="flex flex-col items-center justify-center">
                    <div class="bg-primary-50 p-4 rounded-full mb-4 animate-float">
                        <svg class="h-8 w-8 text-primary-500" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" />
                        </svg>
                    </div>
                    <h3 class="text-lg font-bold text-gray-900 mb-2">No Regulations Found</h3>
                    <p class="text-sm text-gray-500 mb-6 max-w-md mx-auto">
                      Currently there are no regulations matching your search or your organization has no regulations added yet.
                    </p>
                    <%= render Joyful::ButtonComponent.new(
                        text: "Add Regulations",
                        path: admin_organization_regulations_path,
                        variant: :primary
                    ) %>
                  </div>
                </td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
    </div>
    
    <!-- Footer Pagination -->
    <div class="bg-white border-t border-gray-200 px-4 py-3 flex items-center justify-center sm:px-6">
       <%= paginate @regulations, theme: 'tailwind' %>
    </div>
  </div>
  
  <!-- AI Assistant Sidebar (Joyful Update) -->
  <div data-ai-assistant-target="sidebar" class="hidden w-96 bg-white border-l border-gray-200 flex flex-col shadow-2xl z-30 slide-in-from-right">
    <div class="p-4 bg-primary-600 text-white flex justify-between items-center">
      <div class="flex items-center gap-2">
        <span class="text-2xl">✨</span>
        <h2 class="text-lg font-bold">Compliance Assistant</h2>
      </div>
      <button type="button" data-action="click->ai-assistant#toggleSidebar" class="text-white hover:text-primary-100 transition-colors">
        <svg class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
        </svg>
      </button>
    </div>
    
    <!-- Chat Messages -->
    <div data-ai-assistant-target="messages" class="flex-1 overflow-y-auto p-4 space-y-4 bg-gray-50">
      <div class="bg-white p-4 rounded-xl rounded-tl-none shadow-sm text-sm text-gray-700 border border-gray-100">
        Hi there! I'm your Joyful Compliance Assistant. Ask me anything about the regulations you're viewing, and I'll help you find insights!
      </div>
    </div>
    
    <!-- Input Form -->
    <div class="p-4 border-t border-gray-200 bg-white">
      <form data-action="submit->ai-assistant#sendMessage" class="flex gap-2">
        <input type="text" 
               data-ai-assistant-target="input"
               placeholder="Ask a question..."
               class="flex-1 rounded-pill border-gray-300 shadow-sm focus:border-primary-500 focus:ring-primary-500 text-sm py-2 px-4" />
        <button type="submit" class="rounded-full bg-primary-600 p-2 text-white shadow-sm hover:bg-primary-700 transition-colors">
          <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 19l9 2-9-18-9 18 9-2zm0 0v-8"></path></svg>
        </button>
      </form>
    </div>
  </div>
  
  <!-- Floating Assistant Button -->
  <button type="button" 
          data-action="click->ai-assistant#toggleSidebar"
          class="fixed bottom-6 right-6 bg-primary-600 text-white rounded-full p-4 shadow-primary-glow hover:bg-primary-700 hover:scale-105 transition-all duration-300 z-20 animate-bounce-slow">
    <svg class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19.428 15.428a2 2 0 00-1.022-.547l-2.387-.477a6 6 0 00-3.86.517l-.318.158a6 6 0 01-3.86.517L6.05 15.21a2 2 0 00-1.806.547M8 4h8l-1 1v5.172a2 2 0 00.586 1.414l5 5c1.26 1.26.367 3.414-1.415 3.414H4.828c-1.782 0-2.674-2.154-1.414-3.414l5-5A2 2 0 009 10.172V5L8 4z" />
    </svg>
  </button>

  <!-- New Column Modal (Refactored to cleaner style) -->
  <div data-modal-target="newColumnModal" class="hidden fixed inset-0 z-50 overflow-y-auto" aria-labelledby="modal-title" role="dialog" aria-modal="true">
    <div class="flex items-end justify-center min-h-screen pt-4 px-4 pb-20 text-center sm:block sm:p-0">
      <div class="fixed inset-0 bg-gray-500 bg-opacity-75 backdrop-blur-sm transition-opacity" aria-hidden="true" data-action="click->modal#close"></div>

      <span class="hidden sm:inline-block sm:align-middle sm:h-screen" aria-hidden="true">&#8203;</span>

      <div class="inline-block align-bottom bg-white rounded-2xl px-4 pt-5 pb-4 text-left overflow-hidden shadow-2xl transform transition-all sm:my-8 sm:align-middle sm:max-w-2xl sm:w-full sm:p-8">
        <div class="absolute top-0 right-0 pt-6 pr-6">
          <button type="button" data-action="click->modal#close" class="bg-white rounded-md text-gray-400 hover:text-gray-500 focus:outline-none">
            <span class="sr-only">Close</span>
            <svg class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
            </svg>
          </button>
        </div>
        
        <div class="sm:flex sm:items-start">
          <div class="mt-3 text-center sm:mt-0 sm:text-left w-full">
            <h3 class="text-2xl leading-6 font-bold text-gray-900 mb-2" id="modal-title">
              Add Intelligence Column
            </h3>
            <p class="text-gray-500 mb-8">
                Teach the AI to extract specific data points from your regulations.
            </p>

            <!-- Tabs/Sections (Simplified for now) -->
              
            <!-- Custom Column Form -->
            <%= form_with model: CustomColumn.new, url: admin_custom_columns_path, local: true, data: { turbo: false } do |f| %>
                <% @selected_column_ids.each do |id| %>
                    <%= hidden_field_tag "current_selection[]", id %>
                <% end %>
                <%= hidden_field_tag :redirect_to, request.original_url %>
                
                <div class="space-y-6">
                    <div>
                    <%= f.label :name, "Column Name", class: "block text-sm font-bold text-gray-700 mb-1" %>
                    <%= f.text_field :name, class: "block w-full rounded-lg border-gray-300 shadow-sm focus:border-primary-500 focus:ring-primary-500 sm:text-sm p-3 bg-gray-50", placeholder: "e.g., Fines & Penalties" %>
                    </div>
                    
                    <div>
                    <%= f.label :prompt, "AI Interaction Prompt", class: "block text-sm font-bold text-gray-700 mb-1" %>
                    <%= f.text_area :prompt, rows: 3, class: "block w-full rounded-lg border-gray-300 shadow-sm focus:border-primary-500 focus:ring-primary-500 sm:text-sm p-3 bg-gray-50", placeholder: "e.g. Extract the maximum monetary fine mentioned for non-compliance..." %>
                    <p class="mt-1 text-xs text-gray-500">Be specific! The better your prompt, the better the data.</p>
                    </div>
                    
                    <div>
                    <%= f.label :column_type, "Data Type", class: "block text-sm font-bold text-gray-700 mb-1" %>
                    <%= f.select :column_type, [['Text', 'text'], ['Number', 'number'], ['Date', 'date'], ['Boolean', 'boolean']], {}, class: "block w-full rounded-lg border-gray-300 shadow-sm focus:border-primary-500 focus:ring-primary-500 sm:text-sm p-3 bg-gray-50" %>
                    </div>
                    
                    <div class="mt-8 flex justify-end gap-3">
                        <button type="button" data-action="click->modal#close" class="px-5 py-2.5 rounded-pill border border-gray-200 text-gray-600 font-medium hover:bg-gray-50">
                            Cancel
                        </button>
                        <%= f.submit "Create & Extract", class: "px-5 py-2.5 rounded-pill bg-primary-600 text-white font-medium hover:bg-primary-700 shadow-lg hover:shadow-xl transition-all" %>
                    </div>
                </div>
            <% end %>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>
