<div class="w-full">
  <% if notice.present? %>
    <p class="py-2 px-3 bg-green-50 mb-5 text-green-500 font-medium rounded-lg inline-block" id="notice"><%= notice %></p>
  <% end %>

  <div class="flex justify-between items-center mb-6">
    <h1 class="font-bold text-4xl">Custom Columns</h1>
    <%= link_to "New Column", new_admin_custom_column_path, class: "rounded-lg py-3 px-5 bg-blue-600 text-white inline-block font-medium" %>
  </div>

  <!-- User Columns -->
  <div class="bg-white shadow overflow-hidden sm:rounded-lg mb-8">
    <div class="px-4 py-5 sm:px-6">
      <h3 class="text-lg leading-6 font-medium text-gray-900">Your Custom Columns</h3>
      <p class="mt-1 max-w-2xl text-sm text-gray-500">Columns you've created for analyzing regulations.</p>
    </div>
    <div class="border-t border-gray-200">
      <table class="min-w-full divide-y divide-gray-200">
        <thead class="bg-gray-50">
          <tr>
            <th scope="col" class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Name</th>
            <th scope="col" class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Prompt</th>
            <th scope="col" class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Type</th>
            <th scope="col" class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Extractions</th>
            <th scope="col" class="relative px-6 py-3">
              <span class="sr-only">Actions</span>
            </th>
          </tr>
        </thead>
        <tbody class="bg-white divide-y divide-gray-200">
          <% @custom_columns.each do |column| %>
            <tr>
              <td class="px-6 py-4 whitespace-nowrap text-sm font-medium text-gray-900"><%= column.name %></td>
              <td class="px-6 py-4 text-sm text-gray-500"><%= column.prompt.truncate(100) %></td>
              <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-500"><%= column.column_type.humanize %></td>
              <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-500">
                <%= column.regulation_extractions.count %> / <%= Regulation.count %>
              </td>
              <td class="px-6 py-4 whitespace-nowrap text-right text-sm font-medium">
                <%= link_to 'Extract', extract_admin_custom_column_path(column), method: :post, data: { confirm: 'This will analyze all regulations. Continue?' }, class: "text-indigo-600 hover:text-indigo-900 mr-4" %>
                <%= link_to 'Edit', edit_admin_custom_column_path(column), class: "text-indigo-600 hover:text-indigo-900 mr-4" %>
                <%= link_to 'Delete', admin_custom_column_path(column), method: :delete, data: { confirm: 'Are you sure?' }, class: "text-red-600 hover:text-red-900" %>
              </td>
            </tr>
          <% end %>
          <% if @custom_columns.empty? %>
            <tr>
              <td colspan="5" class="px-6 py-4 text-center text-sm text-gray-500">
                No custom columns yet. Create one to start extracting insights!
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  </div>

  <!-- Templates -->
  <% if @templates.any? %>
    <div class="bg-white shadow overflow-hidden sm:rounded-lg">
      <div class="px-4 py-5 sm:px-6">
        <h3 class="text-lg leading-6 font-medium text-gray-900">Column Templates</h3>
        <p class="mt-1 max-w-2xl text-sm text-gray-500">Pre-built prompts for common compliance questions.</p>
      </div>
      <div class="border-t border-gray-200">
        <table class="min-w-full divide-y divide-gray-200">
          <thead class="bg-gray-50">
            <tr>
              <th scope="col" class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Name</th>
              <th scope="col" class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Prompt</th>
              <th scope="col" class="relative px-6 py-3">
                <span class="sr-only">Actions</span>
              </th>
            </tr>
          </thead>
          <tbody class="bg-white divide-y divide-gray-200">
            <% @templates.each do |template| %>
              <tr>
                <td class="px-6 py-4 whitespace-nowrap text-sm font-medium text-gray-900"><%= template.name %></td>
                <td class="px-6 py-4 text-sm text-gray-500"><%= template.prompt.truncate(100) %></td>
                <td class="px-6 py-4 whitespace-nowrap text-right text-sm font-medium">
                  <%= link_to 'Use Template', new_admin_custom_column_path(template_id: template.id), class: "text-indigo-600 hover:text-indigo-900" %>
                </td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
    </div>
  <% end %>
</div>
