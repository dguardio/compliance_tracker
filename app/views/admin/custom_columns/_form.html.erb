<div class="bg-white shadow sm:rounded-lg">
  <div class="px-4 py-5 sm:p-6">
    <%= form_with(model: [:admin, custom_column], class: "space-y-6") do |form| %>
      <% if custom_column.errors.any? %>
        <div class="rounded-md bg-red-50 p-4">
          <div class="flex">
            <div class="ml-3">
              <h3 class="text-sm font-medium text-red-800">
                <%= pluralize(custom_column.errors.count, "error") %> prohibited this column from being saved:
              </h3>
              <div class="mt-2 text-sm text-red-700">
                <ul class="list-disc pl-5 space-y-1">
                  <% custom_column.errors.each do |error| %>
                    <li><%= error.full_message %></li>
                  <% end %>
                </ul>
              </div>
            </div>
          </div>
        </div>
      <% end %>

      <div>
        <%= form.label :name, class: "block text-sm font-medium text-gray-700" %>
        <%= form.text_field :name, class: "mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:border-indigo-500 focus:ring-indigo-500 sm:text-sm", placeholder: "e.g., Penalties" %>
        <p class="mt-2 text-sm text-gray-500">A short, descriptive name for this column.</p>
      </div>

      <div>
        <%= form.label :prompt, "Question/Prompt", class: "block text-sm font-medium text-gray-700" %>
        <%= form.text_area :prompt, rows: 4, class: "mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:border-indigo-500 focus:ring-indigo-500 sm:text-sm", placeholder: "e.g., What are the penalties for non-compliance with this regulation?" %>
        <p class="mt-2 text-sm text-gray-500">The question you want to ask about each regulation. Be specific!</p>
        
        <div class="mt-3 bg-blue-50 border border-blue-200 rounded-md p-3">
          <p class="text-sm font-medium text-blue-900">Example Prompts:</p>
          <ul class="mt-2 text-sm text-blue-700 list-disc pl-5 space-y-1">
            <li>"What are the maximum penalties for violating this regulation?"</li>
            <li>"Which types of organizations does this regulation apply to?"</li>
            <li>"What is the effective date of this regulation?"</li>
            <li>"Does this regulation require annual reporting?"</li>
          </ul>
        </div>
      </div>

      <div>
        <%= form.label :column_type, "Data Type", class: "block text-sm font-medium text-gray-700" %>
        <%= form.select :column_type, 
            options_for_select([['Text', 'text'], ['Number', 'number'], ['Date', 'date'], ['Yes/No', 'boolean']], custom_column.column_type),
            {},
            class: "mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:border-indigo-500 focus:ring-indigo-500 sm:text-sm" %>
        <p class="mt-2 text-sm text-gray-500">The expected format of the answer.</p>
      </div>

      <div class="flex items-center justify-end space-x-3">
        <%= link_to "Cancel", admin_custom_columns_path, class: "rounded-md border border-gray-300 bg-white py-2 px-4 text-sm font-medium text-gray-700 shadow-sm hover:bg-gray-50 focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:ring-offset-2" %>
        <%= form.submit class: "rounded-md border border-transparent bg-indigo-600 py-2 px-4 text-sm font-medium text-white shadow-sm hover:bg-indigo-700 focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:ring-offset-2" %>
      </div>
    <% end %>
  </div>
</div>
