<div class="w-full">
  <% if notice.present? %>
    <p class="py-2 px-3 bg-green-50 mb-5 text-green-500 font-medium rounded-lg inline-block"><%= notice %></p>
  <% end %>

  <div class="flex justify-between items-center mb-6">
    <div>
      <h1 class="font-bold text-4xl">Organization Regulations</h1>
      <p class="text-gray-600 mt-2">Manage regulations applicable to your organization</p>
    </div>
    <div>
      <%= link_to "Active Tables", admin_compliance_tables_path, class: "rounded-lg py-3 px-5 bg-indigo-600 text-white inline-block font-medium mr-2" %>
      <%= link_to "Add Regulations", available_admin_organization_regulations_path, class: "rounded-lg py-3 px-5 bg-blue-600 text-white inline-block font-medium" %>
    </div>
  </div>

  <div class="bg-white shadow overflow-hidden sm:rounded-lg">
    <table class="min-w-full divide-y divide-gray-200">
      <thead class="bg-gray-50">
        <tr>
          <th scope="col" class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Regulation</th>
          <th scope="col" class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Agency</th>
          <th scope="col" class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Jurisdiction</th>
          <th scope="col" class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Status</th>
          <th scope="col" class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Priority</th>
          <th scope="col" class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Added By</th>
          <th scope="col" class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Added</th>
          <th scope="col" class="relative px-6 py-3">
            <span class="sr-only">Actions</span>
          </th>
        </tr>
      </thead>
      <tbody class="bg-white divide-y divide-gray-200">
        <% @organization_regulations.each do |org_reg| %>
          <tr>
            <td class="px-6 py-4 text-sm font-medium text-gray-900">
              <%= link_to org_reg.regulation.title, admin_regulation_path(org_reg.regulation), class: "text-blue-600 hover:text-blue-800" %>
            </td>
            <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-500"><%= org_reg.regulation.agency %></td>
            <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-500"><%= org_reg.regulation.jurisdiction %></td>
            <td class="px-6 py-4 whitespace-nowrap text-sm">
              <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium <%= org_reg.status == 'active' ? 'bg-green-100 text-green-800' : 'bg-yellow-100 text-yellow-800' %>">
                <%= org_reg.status.humanize %>
              </span>
            </td>
            <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-500">
              <% if org_reg.priority >= 7 %>
                <span class="text-red-600 font-semibold"><%= org_reg.priority %></span>
              <% elsif org_reg.priority >= 4 %>
                <span class="text-yellow-600"><%= org_reg.priority %></span>
              <% else %>
                <%= org_reg.priority %>
              <% end %>
            </td>
            <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-500">
              <% if org_reg.assigned_by_id.nil? %>
                <span class="inline-flex items-center px-2 py-0.5 rounded text-xs font-medium bg-gray-100 text-gray-800">
                  🤖 System
                </span>
              <% else %>
                <%= User.find_by(id: org_reg.assigned_by_id)&.full_name || 'Unknown' %>
              <% end %>
            </td>
            <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-500"><%= org_reg.assigned_at&.strftime('%Y-%m-%d') || '-' %></td>
            <td class="px-6 py-4 whitespace-nowrap text-right text-sm font-medium">
              <% if org_reg.status == 'pending' %>
                <%= button_to 'Activate', update_status_admin_organization_regulation_path(org_reg, status: 'active'), method: :patch, class: "text-green-600 hover:text-green-900 mr-4" %>
              <% else %>
                <%= button_to 'Archive', update_status_admin_organization_regulation_path(org_reg, status: 'archived'), method: :patch, class: "text-yellow-600 hover:text-yellow-900 mr-4" %>
              <% end %>
              <%= button_to 'Remove', admin_organization_regulation_path(org_reg), method: :delete, data: { confirm: 'Are you sure?' }, class: "text-red-600 hover:text-red-900" %>
            </td>
          </tr>
        <% end %>
        <% if @organization_regulations.empty? %>
          <tr>
            <td colspan="8" class="px-6 py-4 text-center text-sm text-gray-500">
              No regulations added yet. <%= link_to "Add some regulations", available_admin_organization_regulations_path, class: "text-blue-600 hover:text-blue-800" %> to get started.
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>

  <div class="mt-4">
    <%= paginate @organization_regulations %>
  </div>
</div>
