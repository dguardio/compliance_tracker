<%= form_with(model: [:admin, regulatory_data_source], class: "space-y-6", data: { controller: "regulatory-auto-config" }) do |form| %>
  <% if regulatory_data_source.errors.any? %>
    <%= render Joyful::CardComponent.new(padding: true) do %>
      <div class="space-y-2">
        <h2 class="text-lg font-bold text-red-700 flex items-center gap-2">
          <i class="fas fa-exclamation-circle"></i>
          <%= pluralize(regulatory_data_source.errors.count, "error") %> prohibited this data source from being saved:
        </h2>
        <ul class="list-disc pl-5 text-red-600">
          <% regulatory_data_source.errors.each do |error| %>
            <li><%= error.full_message %></li>
          <% end %>
        </ul>
      </div>
    <% end %>
  <% end %>

  <%= render Joyful::CardComponent.new(title: "Source Information", icon: "database", padding: true) do %>
    <div class="space-y-6">
      <p class="text-sm text-gray-500">This information will be used to ingest new regulations.</p>

      <%= render Joyful::InputComponent.new(
            form: form, 
            method: :source_type, 
            label: "Source Type", 
            type: :select, 
            choices: RegulatoryDataSource.source_types.keys.map { |w| [w.humanize, w] },
            options: { include_blank: 'Select a source type' },
            html_options: { class: "w-full rounded-xl border-gray-300 shadow-sm focus:border-primary-500 focus:ring-primary-500" }
          ) %>

      <!-- Smart Configuration Section -->
      <div id="smart-config-section" class="bg-blue-50 border border-blue-200 rounded-xl p-4 <%= 'hidden' unless regulatory_data_source.api? %>">
        <h4 class="text-base font-bold text-blue-900 mb-2 flex items-center gap-2">
          <i class="fas fa-magic"></i> Smart Auto-Configuration
        </h4>
        <p class="text-sm text-blue-700 mb-4">Provide the documentation URL or paste its content to automatically configure the API settings.</p>

        <div class="space-y-4">
          <%= render Joyful::InputComponent.new(
                form: form, 
                method: :documentation_url, 
                label: "Documentation URL", 
                placeholder: "https://api.example.com/docs",
                data: { regulatory_auto_config_target: "url" }
              ) %>

          <%= render Joyful::InputComponent.new(
                form: form, 
                method: :documentation_content, 
                label: "Or Paste Documentation Content (for manual override)", 
                type: :text_area,
                rows: 4,
                placeholder: "Paste API documentation here if the URL scraper fails...",
                data: { regulatory_auto_config_target: "content" }
              ) %>

          <div class="flex items-center gap-3">
            <%= render Joyful::ButtonComponent.new(
                  text: "Auto Configure Source",
                  type: :button,
                  variant: :primary,
                  icon: "bolt",
                  data: { action: "regulatory-auto-config#fetchConfig", regulatory_auto_config_target: "button" }
                ) %>
            <span class="text-xs text-gray-500" data-regulatory-auto-config-target="status"></span>
          </div>
        </div>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
        <%= render Joyful::InputComponent.new(
              form: form, 
              method: :name, 
              label: "Name", 
              placeholder: "e.g., EU GDPR Source"
            ) %>

        <%= render Joyful::InputComponent.new(
              form: form, 
              method: :provider_id, 
              label: "Provider", 
              type: :collection_select, 
              collection: @providers, 
              value_method: :id, 
              text_method: :name, 
              options: { include_blank: 'Select a provider' }, 
              html_options: { class: "w-full rounded-xl border-gray-300 shadow-sm focus:border-primary-500 focus:ring-primary-500" }
            ) %>
      </div>

      <%= render Joyful::InputComponent.new(
            form: form, 
            method: :description, 
            label: "Description", 
            type: :text_area,
            rows: 3
          ) %>

      <%= render Joyful::InputComponent.new(
            form: form, 
            method: :url, 
            label: "Endpoint URL", 
            data: { regulatory_auto_config_target: "endpointUrl" }
          ) %>

      <!-- Authentication Section -->
      <div id="auth-settings" class="space-y-6 <%= 'hidden' unless regulatory_data_source.api? %>">
        <div class="border-t border-gray-200 pt-6">
          <h3 class="text-lg font-medium text-gray-900 mb-4">Authentication</h3>
          <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
            <%= render Joyful::InputComponent.new(
                  form: form, 
                  method: :api_key_param, 
                  label: "Header Name / Param", 
                  placeholder: "e.g., Authorization or X-API-KEY"
                ) %>

            <div>
              <%= render Joyful::InputComponent.new(
                    form: form, 
                    method: :api_key, 
                    label: "API Key", 
                    type: :password_field,
                    placeholder: "****************"
                  ) %>
              <p class="mt-1 text-xs text-gray-500">Stored securely using encryption.</p>
            </div>
          </div>
        </div>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
        <%= render Joyful::InputComponent.new(
              form: form, 
              method: :status, 
              label: "Status", 
              type: :select, 
              choices: RegulatoryDataSource.statuses.keys.map { |s| [s.humanize, s] },
              options: {},
              html_options: { class: "w-full rounded-xl border-gray-300 shadow-sm focus:border-primary-500 focus:ring-primary-500" }
            ) %>

        <%= render Joyful::InputComponent.new(
              form: form, 
              method: :sectors, 
              label: "Sectors", 
              placeholder: "e.g., Healthcare, Finance",
              value: regulatory_data_source.sectors.join(','),
              data: { controller: "tagify", regulatory_auto_config_target: "sectors" }
            ) %>

        <%= render Joyful::InputComponent.new(
              form: form, 
              method: :jurisdictions, 
              label: "Jurisdictions", 
              placeholder: "e.g., USA, EU",
              value: regulatory_data_source.jurisdictions.join(','),
              data: { controller: "tagify", regulatory_auto_config_target: "jurisdictions" }
            ) %>
      </div>
    </div>
  <% end %>

  <!-- API Settings Section (Manual) -->
  <div id="api-settings" class="<%= 'hidden' unless regulatory_data_source.api? %>">
    <%= render Joyful::CardComponent.new(title: "Mapping Configuration (Manual)", icon: "code-branch", padding: true) do %>
      <div class="space-y-6">
        <p class="text-sm text-gray-500">Manually map API response keys if auto-configuration is not used.</p>
        
        <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
          <div class="space-y-1">
            <%= form.label :results_key, "Results Key", class: "block text-sm font-medium leading-6 text-gray-900" %>
            <%= text_field_tag "regulatory_data_source[settings][results_key]", regulatory_data_source.settings&.dig('results_key'), class: "block w-full rounded-xl border-gray-300 shadow-sm focus:border-primary-500 focus:ring-primary-500 sm:text-sm", placeholder: "e.g., results", data: { regulatory_auto_config_target: "resultsKey" } %>
          </div>

          <div class="space-y-1">
            <%= form.label :pagination_type, "Pagination Type", class: "block text-sm font-medium leading-6 text-gray-900" %>
            <%= select_tag "regulatory_data_source[settings][pagination_type]", options_for_select([['Page Number', 'page_number'], ['Offset', 'offset']], regulatory_data_source.settings&.dig('pagination_type')), include_blank: 'None', class: "block w-full rounded-xl border-gray-300 shadow-sm focus:border-primary-500 focus:ring-primary-500 sm:text-sm" %>
          </div>

          <div class="space-y-1">
            <%= form.label :title_key, "Title Key", class: "block text-sm font-medium leading-6 text-gray-900" %>
            <%= text_field_tag "regulatory_data_source[settings][title_key]", regulatory_data_source.settings&.dig('title_key'), class: "block w-full rounded-xl border-gray-300 shadow-sm focus:border-primary-500 focus:ring-primary-500 sm:text-sm", placeholder: "e.g., title", data: { regulatory_auto_config_target: "titleKey" } %>
          </div>

          <div class="space-y-1">
            <%= form.label :url_key, "URL Key", class: "block text-sm font-medium leading-6 text-gray-900" %>
            <%= text_field_tag "regulatory_data_source[settings][url_key]", regulatory_data_source.settings&.dig('url_key'), class: "block w-full rounded-xl border-gray-300 shadow-sm focus:border-primary-500 focus:ring-primary-500 sm:text-sm", placeholder: "e.g., url", data: { regulatory_auto_config_target: "urlKey" } %>
          </div>
        </div>
      </div>
    <% end %>
  </div>

  <div class="flex justify-end pt-4 gap-3">
    <%= link_to 'Cancel', admin_regulatory_data_sources_path, class: "inline-flex items-center px-4 py-2 border border-gray-300 shadow-sm text-sm font-medium rounded-xl text-gray-700 bg-white hover:bg-gray-50 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-primary-500 transition-all duration-200" %>
    
    <%= render Joyful::ButtonComponent.new(
          text: "Save Data Source",
          type: :submit,
          variant: :primary,
          icon: "save"
        ) %>
  </div>

  <script>
    document.addEventListener("DOMContentLoaded", function() {
      const sourceTypeSelect = document.querySelector('select[name="regulatory_data_source[source_type]"]');
      const apiSettings = document.getElementById('api-settings');
      const authSettings = document.getElementById('auth-settings');
      const smartConfig = document.getElementById('smart-config-section');

      function toggleApiSettings() {
        if (!sourceTypeSelect) return;
        
        if (sourceTypeSelect.value === 'api') {
          apiSettings.classList.remove('hidden');
          authSettings.classList.remove('hidden');
          smartConfig.classList.remove('hidden');
        } else {
          apiSettings.classList.add('hidden');
          authSettings.classList.add('hidden');
          smartConfig.classList.add('hidden');
        }
      }

      if (sourceTypeSelect) {
        sourceTypeSelect.addEventListener('change', toggleApiSettings);
        // Initial check
        toggleApiSettings();
      }
    });
  </script>
<% end %>
