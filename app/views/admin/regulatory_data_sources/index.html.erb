<div class="max-w-7xl mx-auto py-10 px-4 sm:px-6 lg:px-8">
  <div class="flex justify-between items-center mb-6">
    <h1 class="text-3xl font-bold text-gray-900">Regulatory Data Sources</h1>
    <div>
      <%= link_to 'Discover New Sources', discover_admin_regulatory_data_sources_path, class: "inline-flex items-center px-4 py-2 border border-transparent text-sm font-medium rounded-md text-white bg-blue-600 hover:bg-blue-700 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-blue-500" %>
      <%= link_to 'New Data Source', new_admin_regulatory_data_source_path, class: "ml-3 inline-flex items-center px-4 py-2 border border-transparent text-sm font-medium rounded-md shadow-sm text-white bg-indigo-600 hover:bg-indigo-700 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-indigo-500" %>
    </div>
  </div>

  <%= form_with url: bulk_delete_admin_regulatory_data_sources_path, method: :delete, data: { confirm: "Are you sure you want to delete the selected data sources?" } do |form| %>
    <div class="flex justify-end mb-4">
      <%= form.submit "Delete Selected", class: "inline-flex items-center px-4 py-2 border border-transparent text-sm font-medium rounded-md shadow-sm text-white bg-red-600 hover:bg-red-700 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-red-500" %>
    </div>

    <div class="bg-white shadow overflow-hidden sm:rounded-lg">
      <table class="min-w-full divide-y divide-gray-200">
        <thead class="bg-gray-50">
          <tr>
            <th scope="col" class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">
              <input type="checkbox" id="select-all">
            </th>
            <th scope="col" class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Name</th>
            <th scope="col" class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Source Type</th>
            <th scope="col" class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">URL</th>
            <th scope="col" class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Status</th>
            <th scope="col" class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Sectors</th>
            <th scope="col" class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Jurisdictions</th>
            <th scope="col" class="relative px-6 py-3">
              <span class="sr-only">Actions</span>
            </th>
          </tr>
        </thead>
        <tbody class="bg-white divide-y divide-gray-200">
          <% @regulatory_data_sources.each do |regulatory_data_source| %>
            <tr>
              <td class="px-6 py-4 whitespace-nowrap">
                <%= check_box_tag "regulatory_data_source_ids[]", regulatory_data_source.id %>
              </td>
              <td class="px-6 py-4 whitespace-nowrap text-sm font-medium text-gray-900"><%= regulatory_data_source.name %></td>
              <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-500"><%= regulatory_data_source.source_type.humanize %></td>
              <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-500"><%= link_to regulatory_data_source.url, regulatory_data_source.url, target: "_blank", class: "text-indigo-600 hover:text-indigo-900" %></td>
              <td class="px-6 py-4 whitespace-nowrap text-sm">
                <span class="px-2 inline-flex text-xs leading-5 font-semibold rounded-full <%= 'bg-green-100 text-green-800' if regulatory_data_source.enabled? %> <%= 'bg-red-100 text-red-800' if regulatory_data_source.disabled? %> <%= 'bg-yellow-100 text-yellow-800' if regulatory_data_source.error? %>">
                  <%= regulatory_data_source.status.humanize %>
                </span>
              </td>
              <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-500"><%= regulatory_data_source.sectors.join(', ') %></td>
              <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-500"><%= regulatory_data_source.jurisdictions.join(', ') %></td>
              <td class="px-6 py-4 whitespace-nowrap text-right text-sm font-medium">
                <%= link_to 'Show', [:admin, regulatory_data_source], class: "text-indigo-600 hover:text-indigo-900" %>
                <%= link_to 'Edit', edit_admin_regulatory_data_source_path(regulatory_data_source), class: "ml-4 text-indigo-600 hover:text-indigo-900" %>
                <%= link_to 'Destroy', [:admin, regulatory_data_source], method: :delete, data: { confirm: 'Are you sure?' }, class: "ml-4 text-red-600 hover:text-red-900" %>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  <% end %>

  <script>
    document.getElementById('select-all').addEventListener('change', function(event) {
      var checkboxes = document.querySelectorAll('input[name="regulatory_data_source_ids[]"]');
      checkboxes.forEach(function(checkbox) {
        checkbox.checked = event.target.checked;
      });
    });
  </script>
</div>
