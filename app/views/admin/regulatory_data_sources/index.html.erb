<div class="container mx-auto px-4 py-8">
  <!-- Header Section -->
  <div class="flex flex-col md:flex-row justify-between items-start md:items-center mb-8 gap-4">
    <div>
      <h1 class="text-3xl font-bold text-gray-900 tracking-tight">Source Monitor</h1>
      <p class="mt-1 text-gray-500">Manage external regulatory feeds and data ingestion pipelines.</p>
    </div>
    <div class="flex gap-3">
        <%= button_to run_discovery_admin_regulatory_data_sources_path, method: :post, class: "inline-flex items-center justify-center px-4 py-2 border border-transparent text-sm font-medium rounded-md shadow-sm text-white bg-indigo-600 hover:bg-indigo-700 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-indigo-500" do %>
          <svg class="-ml-1 mr-2 h-5 w-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3.055 11H5a2 2 0 012 2v1a2 2 0 002 2 2 2 0 012 2v2.945M8 3.935V5.5A2.5 2.5 0 0010.5 8h.5a2 2 0 012 2 2 2 0 104 0 2 2 0 012-2h1.064M15 20.488V18a2 2 0 012-2h3.064M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path></svg>
          Run Global Watchdog
        <% end %>

        <%= render Joyful::ButtonComponent.new(
            text: "Discover Sources",
            path: discover_admin_regulatory_data_sources_path,
            variant: :secondary,
            icon: "globe"
        ) %>
        <%= render Joyful::ButtonComponent.new(
            text: "Add Source",
            path: new_admin_regulatory_data_source_path,
            variant: :primary,
            icon: "plus"
        ) %>
    </div>
  </div>

  <% if @regulatory_data_sources.any? %>
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
      <% @regulatory_data_sources.each do |source| %>
        <%= render Joyful::CardComponent.new(class: "h-full flex flex-col group hover:-translate-y-1 transition-all duration-300 relative overflow-hidden") do |card| %>
            <!-- Status Indicator Line -->
            <div class="absolute top-0 left-0 w-full h-1 
                <%= source.enabled? ? 'bg-green-500' : (source.error? ? 'bg-red-500' : 'bg-gray-300') %>">
            </div>

            <div class="flex-grow pt-2">
                <div class="flex justify-between items-start mb-4">
                     <h3 class="text-lg font-bold text-gray-900 group-hover:text-primary-600 transition-colors truncate pr-2" title="<%= source.name %>">
                        <%= link_to source.name, [:admin, source] %>
                     </h3>
                     <%= render Joyful::StatusPillComponent.new(status: source.status) %>
                </div>

                <div class="text-xs text-gray-500 mb-4 flex items-center">
                    <svg class="w-4 h-4 mr-1 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13.828 10.172a4 4 0 00-5.656 0l-4 4a4 4 0 105.656 5.656l1.102-1.101m-.758-4.899a4 4 0 005.656 0l4-4a4 4 0 00-5.656-5.656l-1.1 1.1"></path></svg>
                    <%= link_to source.url, source.url, target: "_blank", class: "hover:text-primary-600 truncate max-w-[200px]" %>
                </div>

                <div class="bg-gray-50 rounded-lg p-3 border border-gray-100 grid grid-cols-2 gap-2 text-xs">
                    <div>
                        <span class="block text-gray-400 font-medium uppercase tracking-wide text-[10px]">Type</span>
                        <span class="font-bold text-gray-700 truncate block"><%= source.source_type.humanize %></span>
                    </div>
                     <div>
                        <span class="block text-gray-400 font-medium uppercase tracking-wide text-[10px]">Provider</span>
                        <span class="font-bold text-gray-700 truncate block"><%= source.provider&.name || 'Custom' %></span>
                    </div>
                    <% if source.sectors.any? %>
                    <div class="col-span-2 mt-1 pt-1 border-t border-gray-100">
                        <span class="block text-gray-400 font-medium uppercase tracking-wide text-[10px]">Sectors</span>
                        <span class="text-gray-600 truncate block"><%= source.sectors.join(', ') %></span>
                    </div>
                    <% end %>
                </div>
            </div>

            <% card.footer do %>
                <div class="flex justify-between items-center w-full mt-2">
                    <%= link_to [:admin, source], class: "text-gray-500 hover:text-primary-600 text-sm font-medium transition-colors" do %>
                        View Details
                    <% end %>

                    <div class="flex space-x-2">
                         <%= link_to edit_admin_regulatory_data_source_path(source), class: "text-gray-400 hover:text-blue-600 transition-colors p-1" do %>
                            <span class="sr-only">Edit</span>
                            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15.232 5.232l3.536 3.536m-2.036-5.036a2.5 2.5 0 113.536 3.536L6.5 21.036H3v-3.572L16.732 3.732z"></path></svg>
                        <% end %>
                        <%= link_to [:admin, source], method: :delete, data: { confirm: 'Remove this data source?' }, class: "text-gray-400 hover:text-red-600 transition-colors p-1" do %>
                            <span class="sr-only">Delete</span>
                            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"></path></svg>
                        <% end %>
                    </div>
                </div>
            <% end %>
        <% end %>
      <% end %>
    </div>
  <% else %>
    <div class="text-center py-20 bg-white rounded-xl shadow-sm border border-dashed border-gray-300">
      <div class="mx-auto h-24 w-24 bg-blue-50 rounded-full flex items-center justify-center mb-6 animate-float">
        <svg class="h-12 w-12 text-blue-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19.428 15.428a2 2 0 00-1.022-.547l-2.387-.477a6 6 0 00-3.86.517l-.318.158a6 6 0 01-3.86.517L6.05 15.21a2 2 0 00-1.806.547M8 4h8l-1 1v5.172a2 2 0 00.586 1.414l5 5c1.26 1.26.367 3.414-1.415 3.414H4.828c-1.782 0-2.674-2.154-1.414-3.414l5-5A2 2 0 009 10.172V5L8 4z"></path>
        </svg>
      </div>
      <h3 class="text-xl font-bold text-gray-900 mb-2">No Data Sources Connected</h3>
      <p class="text-gray-500 mb-8 max-w-sm mx-auto">Connect to regulatory feeds to automatically track compliance updates.</p>
       <div class="flex justify-center gap-4">
        <%= render Joyful::ButtonComponent.new(
            text: "Discover Sources",
            path: discover_admin_regulatory_data_sources_path,
            variant: :secondary,
            icon: "globe"
        ) %>
        <%= render Joyful::ButtonComponent.new(
            text: "Add Manually",
            path: new_admin_regulatory_data_source_path,
            variant: :primary,
            icon: "plus"
        ) %>
       </div>
    </div>
  <% end %>
</div>
