<div class="max-w-4xl mx-auto py-10 px-4 sm:px-6 lg:px-8">
  <div class="bg-white p-8 rounded-lg shadow">
    <div class="flex justify-between items-center mb-6">
      <h1 class="text-2xl font-bold text-gray-900"><%= @regulatory_data_source.name %></h1>
      <div>
        <%= link_to 'Edit', edit_admin_regulatory_data_source_path(@regulatory_data_source), class: "inline-flex items-center px-4 py-2 border border-gray-300 text-sm font-medium rounded-md text-gray-700 bg-white hover:bg-gray-50" %>
        <%= link_to 'Back to list', admin_regulatory_data_sources_path, class: "ml-3 inline-flex items-center px-4 py-2 border border-transparent text-sm font-medium rounded-md shadow-sm text-white bg-indigo-600 hover:bg-indigo-700" %>
      </div>
    </div>

    <div class="border-t border-gray-200 px-4 py-5 sm:p-0">
      <dl class="sm:divide-y sm:divide-gray-200">
        <div class="py-4 sm:py-5 sm:grid sm:grid-cols-3 sm:gap-4 sm:px-6">
          <dt class="text-sm font-medium text-gray-500">Description</dt>
          <dd class="mt-1 text-sm text-gray-900 sm:mt-0 sm:col-span-2"><%= @regulatory_data_source.description %></dd>
        </div>
        <div class="py-4 sm:py-5 sm:grid sm:grid-cols-3 sm:gap-4 sm:px-6">
          <dt class="text-sm font-medium text-gray-500">URL</dt>
          <dd class="mt-1 text-sm text-gray-900 sm:mt-0 sm:col-span-2"><%= link_to @regulatory_data_source.url, @regulatory_data_source.url, target: '_blank', class: "text-indigo-600 hover:text-indigo-900" %></dd>
        </div>
        <div class="py-4 sm:py-5 sm:grid sm:grid-cols-3 sm:gap-4 sm:px-6">
          <dt class="text-sm font-medium text-gray-500">Source Type</dt>
          <dd class="mt-1 text-sm text-gray-900 sm:mt-0 sm:col-span-2"><%= @regulatory_data_source.source_type.humanize %></dd>
        </div>
        <div class="py-4 sm:py-5 sm:grid sm:grid-cols-3 sm:gap-4 sm:px-6">
          <dt class="text-sm font-medium text-gray-500">Status</dt>
          <dd class="mt-1 text-sm text-gray-900 sm:mt-0 sm:col-span-2">
            <span class="px-2 inline-flex text-xs leading-5 font-semibold rounded-full <%= 'bg-green-100 text-green-800' if @regulatory_data_source.enabled? %> <%= 'bg-red-100 text-red-800' if @regulatory_data_source.disabled? %> <%= 'bg-yellow-100 text-yellow-800' if @regulatory_data_source.error? %>">
              <%= @regulatory_data_source.status.humanize %>
            </span>
          </dd>
        </div>
        <div class="py-4 sm:py-5 sm:grid sm:grid-cols-3 sm:gap-4 sm:px-6">
          <dt class="text-sm font-medium text-gray-500">Sectors</dt>
          <dd class="mt-1 text-sm text-gray-900 sm:mt-0 sm:col-span-2">
            <% @regulatory_data_source.sectors.each do |sector| %>
              <span class="inline-block bg-gray-200 rounded-full px-3 py-1 text-sm font-semibold text-gray-700 mr-2 mb-2"><%= sector %></span>
            <% end %>
          </dd>
        </div>
        <div class="py-4 sm:py-5 sm:grid sm:grid-cols-3 sm:gap-4 sm:px-6">
          <dt class="text-sm font-medium text-gray-500">Jurisdictions</dt>
          <dd class="mt-1 text-sm text-gray-900 sm:mt-0 sm:col-span-2">
            <% @regulatory_data_source.jurisdictions.each do |jurisdiction| %>
              <span class="inline-block bg-gray-200 rounded-full px-3 py-1 text-sm font-semibold text-gray-700 mr-2 mb-2"><%= jurisdiction %></span>
            <% end %>
          </dd>
        </div>
        <% if @regulatory_data_source.api? %>
          <div class="py-4 sm:py-5 sm:grid sm:grid-cols-3 sm:gap-4 sm:px-6">
            <dt class="text-sm font-medium text-gray-500">API Configuration</dt>
            <dd class="mt-1 text-sm text-gray-900 sm:mt-0 sm:col-span-2">
              <div class="border border-gray-200 rounded-md overflow-hidden">
                <dl class="divide-y divide-gray-200">
                  <div class="px-4 py-3 bg-gray-50 sm:grid sm:grid-cols-3 sm:gap-4">
                    <dt class="text-xs font-medium text-gray-500 uppercase tracking-wider">Results Key</dt>
                    <dd class="mt-1 text-sm text-gray-900 sm:mt-0 sm:col-span-2"><%= @regulatory_data_source.settings['results_key'] %></dd>
                  </div>
                  <div class="px-4 py-3 bg-white sm:grid sm:grid-cols-3 sm:gap-4">
                    <dt class="text-xs font-medium text-gray-500 uppercase tracking-wider">Pagination Type</dt>
                    <dd class="mt-1 text-sm text-gray-900 sm:mt-0 sm:col-span-2"><%= @regulatory_data_source.settings['pagination_type']&.humanize %></dd>
                  </div>
                  <div class="px-4 py-3 bg-gray-50 sm:grid sm:grid-cols-3 sm:gap-4">
                    <dt class="text-xs font-medium text-gray-500 uppercase tracking-wider">Title Key</dt>
                    <dd class="mt-1 text-sm text-gray-900 sm:mt-0 sm:col-span-2"><%= @regulatory_data_source.settings['title_key'] %></dd>
                  </div>
                  <div class="px-4 py-3 bg-white sm:grid sm:grid-cols-3 sm:gap-4">
                    <dt class="text-xs font-medium text-gray-500 uppercase tracking-wider">Publication Date Key</dt>
                    <dd class="mt-1 text-sm text-gray-900 sm:mt-0 sm:col-span-2"><%= @regulatory_data_source.settings['publication_date_key'] %></dd>
                  </div>
                  <div class="px-4 py-3 bg-gray-50 sm:grid sm:grid-cols-3 sm:gap-4">
                    <dt class="text-xs font-medium text-gray-500 uppercase tracking-wider">URL Key</dt>
                    <dd class="mt-1 text-sm text-gray-900 sm:mt-0 sm:col-span-2"><%= @regulatory_data_source.settings['url_key'] %></dd>
                  </div>
                  <div class="px-4 py-3 bg-white sm:grid sm:grid-cols-3 sm:gap-4">
                    <dt class="text-xs font-medium text-gray-500 uppercase tracking-wider">Full Text Key</dt>
                    <dd class="mt-1 text-sm text-gray-900 sm:mt-0 sm:col-span-2"><%= @regulatory_data_source.settings['full_text_key'].presence || '-' %></dd>
                  </div>
                </dl>
              </div>
            </dd>
          </div>
        <% else %>
          <div class="py-4 sm:py-5 sm:grid sm:grid-cols-3 sm:gap-4 sm:px-6">
            <dt class="text-sm font-medium text-gray-500">Settings</dt>
            <dd class="mt-1 text-sm text-gray-900 sm:mt-0 sm:col-span-2">
              <pre class="bg-gray-100 p-3 rounded-md overflow-x-auto"><%= JSON.pretty_generate(@regulatory_data_source.settings) %></pre>
            </dd>
          </div>
        <% end %>
      </dl>
    </div>
  </div>
</div>
