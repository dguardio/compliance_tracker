<!-- App Drawer Component (Alpine.js) -->
<div x-data="{ open: false }" @keydown.window.escape="open = false" class="relative z-[150]">
  
  <!-- Trigger Button (Replaces Omnibar and Dropdowns) -->
  <button @click="open = !open" 
          class="flex items-center gap-2 px-4 py-2 text-sm font-medium text-gray-700 bg-white border border-gray-300 rounded-lg hover:bg-gray-50 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-primary-500 transition-colors shadow-sm">
    <svg class="w-5 h-5 text-gray-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2H6a2 2 0 01-2-2V6zM14 6a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2h-2a2 2 0 01-2-2V6zM4 16a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2H6a2 2 0 01-2-2v-2zM14 16a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2h-2a2 2 0 01-2-2v-2z"></path>
    </svg>
    <span>Modules</span>
  </button>

  <!-- Slide-out Drawer Overlay -->
  <div x-show="open" 
       x-transition:enter="transition-opacity ease-linear duration-300" 
       x-transition:enter-start="opacity-0" 
       x-transition:enter-end="opacity-100" 
       x-transition:leave="transition-opacity ease-linear duration-300" 
       x-transition:leave-start="opacity-100" 
       x-transition:leave-end="opacity-0" 
       class="fixed inset-0 bg-gray-900/80 backdrop-blur-sm z-40" 
       @click="open = false" 
       style="display: none;"></div>

  <!-- Mega Menu Dropdown Panel -->
  <div x-show="open" 
       x-transition:enter="transition ease-out duration-200 transform origin-top" 
       x-transition:enter-start="opacity-0 -translate-y-2 scale-95" 
       x-transition:enter-end="opacity-100 translate-y-0 scale-100" 
       x-transition:leave="transition ease-in duration-150 transform origin-top" 
       x-transition:leave-start="opacity-100 translate-y-0 scale-100" 
       x-transition:leave-end="opacity-0 -translate-y-2 scale-95" 
       class="fixed top-20 inset-x-4 mx-auto max-w-6xl bg-white shadow-2xl rounded-2xl z-50 overflow-hidden border border-gray-100 flex flex-col max-h-[calc(100vh-6rem)]" 
       style="display: none;">
    
    <!-- Mega Menu Header -->
    <div class="flex items-center justify-between px-8 py-5 border-b border-gray-100 bg-gray-50/80 shrink-0">
      <div class="flex items-center gap-3">
        <div class="w-10 h-10 rounded-lg bg-primary-100 text-primary-600 flex items-center justify-center shadow-sm">
          <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2H6a2 2 0 01-2-2V6zM14 6a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2h-2a2 2 0 01-2-2V6zM4 16a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2H6a2 2 0 01-2-2v-2zM14 16a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2h-2a2 2 0 01-2-2v-2z"></path></svg>
        </div>
        <div>
          <h2 class="text-xl font-bold text-gray-900">Platform Modules</h2>
          <p class="text-sm text-gray-500">Access all of your compliance and risk tools in one place.</p>
        </div>
      </div>
      <button @click="open = false" class="p-2 text-gray-400 hover:text-gray-600 hover:bg-gray-200 rounded-full transition-colors focus:outline-none focus:ring-2 focus:ring-primary-500 bg-white shadow-sm border border-gray-200">
        <span class="sr-only">Close menu</span>
        <svg class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
        </svg>
      </button>
    </div>

    <!-- Mega Menu Content / Categories (3 Column Grid) -->
    <div class="p-8 grid grid-cols-1 md:grid-cols-3 gap-x-12 gap-y-10 bg-white overflow-y-auto min-h-0">
      
      <!-- 1. Compliance & Risk -->
      <div class="space-y-4">
        <h3 class="text-sm font-bold text-gray-900 flex items-center gap-2 border-b border-gray-100 pb-2">
          <div class="w-6 h-6 rounded-md bg-rose-50 text-rose-600 flex items-center justify-center">
            <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"></path></svg>
          </div>
          Compliance & Risk
        </h3>
        <div class="grid grid-cols-1 gap-1">
          <% if feature_enabled?(:compliance_management) %>
            <%= link_to "Frameworks", organization_compliance_frameworks_path(current_user.organization), class: "block px-3 py-2 -mx-3 rounded-lg text-sm text-gray-600 hover:bg-rose-50 hover:text-rose-700 transition-colors font-medium" %>
          <% end %>
          <% if feature_enabled?(:risk_management) %>
            <%= link_to "Risk Dashboard", risk_dashboard_path, class: "block px-3 py-2 -mx-3 rounded-lg text-sm text-gray-600 hover:bg-rose-50 hover:text-rose-700 transition-colors font-medium" %>
          <% end %>
          <% if feature_enabled?(:maturity_assessment) %>
            <%= link_to "Control Maturity", organization_maturity_index_path(current_user.organization), class: "block px-3 py-2 -mx-3 rounded-lg text-sm text-gray-600 hover:bg-rose-50 hover:text-rose-700 transition-colors font-medium" %>
          <% end %>
          <% if feature_enabled?(:policy_gap_analysis) %>
            <%= link_to "Gap Analysis", organization_policy_gap_index_path(current_user.organization), class: "block px-3 py-2 -mx-3 rounded-lg text-sm text-gray-600 hover:bg-rose-50 hover:text-rose-700 transition-colors font-medium" %>
          <% end %>
          <% if feature_enabled?(:regulatory_impact_simulation) %>
            <%= link_to "Impact Simulation", organization_impact_simulations_path(current_user.organization), class: "block px-3 py-2 -mx-3 rounded-lg text-sm text-gray-600 hover:bg-rose-50 hover:text-rose-700 transition-colors font-medium" %>
          <% end %>
          <% if feature_enabled?(:incident_management) %>
            <%= link_to "Incidents", organization_incidents_path(current_user.organization), class: "block px-3 py-2 -mx-3 rounded-lg text-sm text-gray-600 hover:bg-rose-50 hover:text-rose-700 transition-colors font-medium" %>
          <% end %>
        </div>
      </div>

      <!-- 2. Governance & Policy -->
      <div class="space-y-4">
        <h3 class="text-sm font-bold text-gray-900 flex items-center gap-2 border-b border-gray-100 pb-2">
          <div class="w-6 h-6 rounded-md bg-purple-50 text-purple-600 flex items-center justify-center">
            <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4"></path></svg>
          </div>
          Governance & Policy
        </h3>
        <div class="grid grid-cols-1 gap-1">
          <% if feature_enabled?(:policies) %>
            <%= link_to "Policies", organization_policies_path(current_user.organization), class: "block px-3 py-2 -mx-3 rounded-lg text-sm text-gray-600 hover:bg-purple-50 hover:text-purple-700 transition-colors font-medium" %>
          <% end %>
          <% if feature_enabled?(:policy_attestation) %>
            <%= link_to "Attestations", organization_attestation_campaigns_path(current_user.organization), class: "block px-3 py-2 -mx-3 rounded-lg text-sm text-gray-600 hover:bg-purple-50 hover:text-purple-700 transition-colors font-medium" %>
          <% end %>
          <% if feature_enabled?(:obligation_management) %>
            <%= link_to "Obligations", organization_obligations_path(current_user.organization), class: "block px-3 py-2 -mx-3 rounded-lg text-sm text-gray-600 hover:bg-purple-50 hover:text-purple-700 transition-colors font-medium" %>
          <% end %>
          <% if feature_enabled?(:findings_remediation) %>
            <%= link_to "Findings (CAPA)", organization_findings_path(current_user.organization), class: "block px-3 py-2 -mx-3 rounded-lg text-sm text-gray-600 hover:bg-purple-50 hover:text-purple-700 transition-colors font-medium" %>
          <% end %>
          <% if feature_enabled?(:vendor_risk_management) %>
            <%= link_to "Vendors", organization_vendors_path(current_user.organization), class: "block px-3 py-2 -mx-3 rounded-lg text-sm text-gray-600 hover:bg-purple-50 hover:text-purple-700 transition-colors font-medium" %>
          <% end %>
        </div>
      </div>

      <!-- 3. Audit & Evidence -->
      <div class="space-y-4">
        <h3 class="text-sm font-bold text-gray-900 flex items-center gap-2 border-b border-gray-100 pb-2">
          <div class="w-6 h-6 rounded-md bg-blue-50 text-blue-600 flex items-center justify-center">
            <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5H7a2 2 0 00-2-2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2m-6 9l2 2 4-4"></path></svg>
          </div>
          Audit & Evidence
        </h3>
        <div class="grid grid-cols-1 gap-1">
          <% if feature_enabled?(:control_testing) %>
            <%= link_to "Control Testing", organization_control_testing_index_path(current_user.organization), class: "block px-3 py-2 -mx-3 rounded-lg text-sm text-gray-600 hover:bg-blue-50 hover:text-blue-700 transition-colors font-medium" %>
          <% end %>
          <% if feature_enabled?(:compliance_management) %>
            <%= link_to "Evidence Requests", organization_evidence_requests_path(current_user.organization), class: "block px-3 py-2 -mx-3 rounded-lg text-sm text-gray-600 hover:bg-blue-50 hover:text-blue-700 transition-colors font-medium" %>
          <% end %>
          <% if feature_enabled?(:evidence_agents) %>
            <%= link_to "Evidence Agents", organization_evidence_agents_path(current_user.organization), class: "block px-3 py-2 -mx-3 rounded-lg text-sm text-gray-600 hover:bg-blue-50 hover:text-blue-700 transition-colors font-medium" %>
          <% end %>
          <% if feature_enabled?(:evidence_freshness) %>
            <%= link_to "Freshness Tracker", evidence_freshness_index_path, class: "block px-3 py-2 -mx-3 rounded-lg text-sm text-gray-600 hover:bg-blue-50 hover:text-blue-700 transition-colors font-medium" %>
          <% end %>
          <% if feature_enabled?(:continuous_monitoring) %>
            <%= link_to "Security Watchtower", organization_monitoring_dashboard_index_path(current_user.organization), class: "block px-3 py-2 -mx-3 rounded-lg text-sm text-gray-600 hover:bg-blue-50 hover:text-blue-700 transition-colors font-medium" %>
          <% end %>
        </div>
      </div>

      <!-- 4. Library & Intelligence -->
      <div class="space-y-4">
        <h3 class="text-sm font-bold text-gray-900 flex items-center gap-2 border-b border-gray-100 pb-2">
          <div class="w-6 h-6 rounded-md bg-emerald-50 text-emerald-600 flex items-center justify-center">
            <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.247 18 16.5 18c-1.746 0-3.332.477-4.5 1.253"></path></svg>
          </div>
          Library & Intelligence
        </h3>
        <div class="grid grid-cols-1 gap-1">
          <% if feature_enabled?(:regulatory_intelligence) %>
            <%= link_to "Regulation Library", regulation_library_index_path, class: "block px-3 py-2 -mx-3 rounded-lg text-sm text-gray-600 hover:bg-emerald-50 hover:text-emerald-700 transition-colors font-medium" %>
          <% end %>
          <% if feature_enabled?(:document_management) %>
            <%= link_to "Documents", organization_documents_path(current_user.organization), class: "block px-3 py-2 -mx-3 rounded-lg text-sm text-gray-600 hover:bg-emerald-50 hover:text-emerald-700 transition-colors font-medium" %>
          <% end %>
          <% if feature_enabled?(:workflow_intelligence) %>
            <%= link_to "Workflow Analytics", organization_workflow_analytics_path(current_user.organization), class: "block px-3 py-2 -mx-3 rounded-lg text-sm text-gray-600 hover:bg-emerald-50 hover:text-emerald-700 transition-colors font-medium" %>
          <% end %>
          <% if feature_enabled?(:cross_framework_harmonization) %>
            <%= link_to "Harmonization", organization_harmonization_index_path(current_user.organization), class: "block px-3 py-2 -mx-3 rounded-lg text-sm text-gray-600 hover:bg-emerald-50 hover:text-emerald-700 transition-colors font-medium" %>
          <% end %>
          <% if feature_enabled?(:executive_reporting) %>
            <%= link_to "Executive Reports", organization_executive_reports_path(current_user.organization), class: "block px-3 py-2 -mx-3 rounded-lg text-sm text-gray-600 hover:bg-emerald-50 hover:text-emerald-700 transition-colors font-medium" %>
          <% end %>
          <% if feature_enabled?(:questionnaire_autofill) %>
            <%= link_to "Questionnaire Autofill", organization_questionnaire_index_path(current_user.organization), class: "block px-3 py-2 -mx-3 rounded-lg text-sm text-gray-600 hover:bg-emerald-50 hover:text-emerald-700 transition-colors font-medium" %>
          <% end %>
        </div>
      </div>

      <!-- 5. Management & Administration -->
      <div class="space-y-4">
        <h3 class="text-sm font-bold text-gray-900 flex items-center gap-2 border-b border-gray-100 pb-2">
          <div class="w-6 h-6 rounded-md bg-slate-100 text-slate-600 flex items-center justify-center">
             <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10.325 4.317c.426-1.756 2.924-1.756 3.35 0a1.724 1.724 0 002.573 1.066c1.543-.94 3.31.826 2.37 2.37a1.724 1.724 0 001.065 2.572c1.756.426 1.756 2.924 0 3.35a1.724 1.724 0 00-1.066 2.573c.94 1.543-.826 3.31-2.37 2.37a1.724 1.724 0 00-2.572 1.065c-.426 1.756-2.924 1.756-3.35 0a1.724 1.724 0 00-2.573-1.066c-1.543.94-3.31-.826-2.37-2.37a1.724 1.724 0 00-1.065-2.572c-1.756-.426-1.756-2.924 0-3.35a1.724 1.724 0 001.066-2.573c-.94-1.543.826-3.31 2.37-2.37.996.608 2.296.07 2.572-1.065z"></path><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"></path></svg>
          </div>
          System Management
        </h3>
        <div class="grid grid-cols-1 gap-1">
          <%= link_to "Org Settings", organization_path(current_user.organization), class: "block px-3 py-2 -mx-3 rounded-lg text-sm text-gray-600 hover:bg-slate-100 hover:text-slate-900 transition-colors font-medium" %>
          <%= link_to "Users & Roles", organization_users_path(current_user.organization), class: "block px-3 py-2 -mx-3 rounded-lg text-sm text-gray-600 hover:bg-slate-100 hover:text-slate-900 transition-colors font-medium" %>
          <%= link_to "Workflows", organization_workflow_templates_path(current_user.organization), class: "block px-3 py-2 -mx-3 rounded-lg text-sm text-gray-600 hover:bg-slate-100 hover:text-slate-900 transition-colors font-medium" %>
          <% if feature_enabled?(:external_integrations) %>
            <%= link_to "Integrations", organization_external_integrations_path(current_user.organization), class: "block px-3 py-2 -mx-3 rounded-lg text-sm text-gray-600 hover:bg-slate-100 hover:text-slate-900 transition-colors font-medium" %>
          <% end %>
          <% if current_user.super_admin? %>
            <div class="mt-4 pt-4 border-t border-gray-100">
              <span class="text-xs font-semibold text-gray-500 uppercase tracking-wider mb-2 block">Platform Admin</span>
              <%= link_to "All Tenants", organizations_path, class: "block px-3 py-2 -mx-3 rounded-lg text-sm font-bold text-warning-700 bg-warning-50 hover:bg-warning-100 transition-colors" %>
              <%= link_to "Manage Regs", admin_regulations_path, class: "block px-3 py-2 -mx-3 rounded-lg text-sm font-bold text-warning-700 bg-warning-50 hover:bg-warning-100 transition-colors mt-1" %>
              <%= link_to "Data Sources", admin_regulatory_data_sources_path, class: "block px-3 py-2 -mx-3 rounded-lg text-sm font-bold text-warning-700 bg-warning-50 hover:bg-warning-100 transition-colors mt-1" %>
              <%= link_to "Agent Traces", admin_agent_traces_path, class: "block px-3 py-2 -mx-3 rounded-lg text-sm font-bold text-warning-700 bg-warning-50 hover:bg-warning-100 transition-colors mt-1" %>
              <%= link_to "Feature Flags", "/admin/flipper", class: "block px-3 py-2 -mx-3 rounded-lg text-sm font-bold text-warning-700 bg-warning-50 hover:bg-warning-100 transition-colors mt-1" %>
            </div>
          <% end %>
        </div>
      </div>
      
    </div>
  </div>
</div>
