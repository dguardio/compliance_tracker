<div class="relative w-full max-w-2xl mx-auto" data-controller="omnibar">
  <!-- Omnibar Container -->
  <div class="relative flex items-center bg-white rounded-2xl shadow-sm border border-slate-200 p-2 transition-all duration-300" data-omnibar-target="container">
     
     <!-- Search Icon -->
     <div class="pl-3 text-slate-400">
        <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"></path></svg>
     </div>

     <!-- Token Container -->
     <div class="flex flex-wrap items-center pl-2" data-omnibar-target="tokenContainer"></div>

     <!-- Input -->
     <input type="text" 
            class="flex-1 border-0 focus:ring-0 text-lg placeholder-slate-400 text-slate-800 bg-transparent"
            placeholder="Type 'Audits by Mike'..."
            data-omnibar-target="input"
            data-action="focus->omnibar#onFocus blur->omnibar#onBlur input->omnibar#input"
            autocomplete="off">
    
    <!-- Keyboard Shortcut Hint -->
    <div class="pr-4 hidden sm:block">
        <kbd class="inline-flex items-center border border-slate-200 rounded px-2 text-sm font-sans font-medium text-slate-400">⌘K</kbd>
    </div>
  </div>

  <!-- Results Dropdown -->
  <div class="absolute left-0 right-0 top-full mt-4 bg-white rounded-xl shadow-xl border border-slate-100 hidden overflow-hidden z-50 divide-y divide-slate-50" 
       data-omnibar-target="results">
       
       <!-- Quick Filters (Empty State / Greeting) -->
       <div class="p-4 bg-slate-50">
          <h4 class="text-xs font-semibold text-slate-500 uppercase tracking-wider mb-2">Helpful Suggestions</h4>
          <div class="flex gap-2">
             <button class="px-3 py-1 bg-white border border-slate-200 rounded-full text-sm text-slate-600 hover:border-primary-300 hover:text-primary-600 transition-colors">My Tasks</button>
             <button class="px-3 py-1 bg-white border border-slate-200 rounded-full text-sm text-slate-600 hover:border-warning-300 hover:text-warning-600 transition-colors">High Risk</button>
             <button class="px-3 py-1 bg-white border border-slate-200 rounded-full text-sm text-slate-600 hover:border-danger-300 hover:text-danger-600 transition-colors">Overdue</button>
          </div>
       </div>

       <!-- Fake Results (Simulated for Prototype) -->
       <div class="p-2">
          <a href="#" class="flex items-center gap-3 p-3 rounded-lg hover:bg-slate-50 transition-colors group">
             <div class="w-10 h-10 rounded-lg bg-primary-50 text-primary-600 flex items-center justify-center">
                <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"></path></svg>
             </div>
             <div class="flex-1">
                <h5 class="text-sm font-medium text-slate-900 group-hover:text-primary-600">Q3 Financial Audit</h5>
                <p class="text-xs text-slate-500">Document • Updated 2h ago</p>
             </div>
             <%= render Joyful::StatusPillComponent.new(status: :review, text: "Review") %>
          </a>

           <a href="#" class="flex items-center gap-3 p-3 rounded-lg hover:bg-slate-50 transition-colors group">
             <div class="w-10 h-10 rounded-full bg-slate-100 overflow-hidden">
                <img src="https://i.pravatar.cc/150?u=mike" alt="Mike" class="w-full h-full object-cover">
             </div>
             <div class="flex-1">
                <h5 class="text-sm font-medium text-slate-900 group-hover:text-primary-600">Mike Ross</h5>
                <p class="text-xs text-slate-500">Compliance Officer • IT Dept</p>
             </div>
          </a>
       </div>

       <!-- Footer -->
       <div class="p-2 bg-slate-50 border-t border-slate-100 text-center">
          <p class="text-xs text-slate-400">Press <span class="font-medium text-slate-500">Enter</span> to select</p>
       </div>
  </div>
</div>
