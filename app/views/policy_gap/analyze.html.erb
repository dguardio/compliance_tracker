<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
  <nav class="mb-6">
    <ol class="flex items-center space-x-2 text-sm text-gray-500">
      <li><%= link_to "Policy Gap Analysis", organization_policy_gap_index_path(@organization), class: "hover:text-indigo-600" %></li>
      <li><i class="fas fa-chevron-right text-xs"></i></li>
      <li class="text-gray-900 font-medium"><%= @result[:framework].name %></li>
    </ol>
  </nav>

  <h1 class="text-2xl font-bold text-gray-900 mb-2">Gap Analysis: <%= @result[:framework].name %></h1>
  <p class="text-gray-500 mb-6"><%= @result[:coverage_percentage] %>% policy coverage (<%= @result[:covered_count] %>/<%= @result[:total_requirements] %> requirements)</p>

  <!-- Summary Bar -->
  <div class="bg-white rounded-xl shadow-sm border p-6 mb-6">
    <div class="flex items-center gap-6">
      <div class="flex-1">
        <div class="w-full bg-gray-100 rounded-full h-4">
          <div class="h-4 rounded-full transition-all duration-700" style="width: <%= @result[:coverage_percentage] %>%; background: linear-gradient(90deg, #10b981, #34d399);"></div>
        </div>
      </div>
      <div class="text-center px-4 border-l">
        <p class="text-2xl font-bold text-green-600"><%= @result[:covered_count] %></p>
        <p class="text-xs text-gray-500">Covered</p>
      </div>
      <div class="text-center px-4 border-l">
        <p class="text-2xl font-bold text-red-600"><%= @result[:gap_count] %></p>
        <p class="text-xs text-gray-500">Gaps</p>
      </div>
    </div>
  </div>

  <!-- Requirements Table -->
  <div class="bg-white rounded-xl shadow-sm border overflow-hidden">
    <table class="min-w-full divide-y divide-gray-200">
      <thead class="bg-gray-50">
        <tr>
          <th class="px-4 py-3 text-left text-xs font-medium text-gray-500 uppercase">Requirement</th>
          <th class="px-4 py-3 text-center text-xs font-medium text-gray-500 uppercase">Status</th>
          <th class="px-4 py-3 text-left text-xs font-medium text-gray-500 uppercase">Linked Policies</th>
          <th class="px-4 py-3 text-center text-xs font-medium text-gray-500 uppercase">Controls</th>
          <th class="px-4 py-3 text-right text-xs font-medium text-gray-500 uppercase">Actions</th>
        </tr>
      </thead>
      <tbody class="divide-y divide-gray-200">
        <% @result[:gap_analysis].each do |item| %>
          <tr class="hover:bg-gray-50 <%= 'bg-red-50' unless item[:covered] %>">
            <td class="px-4 py-3">
              <div class="text-sm font-medium text-gray-900"><%= item[:requirement].name %></div>
              <% if item[:requirement].description.present? %>
                <div class="text-xs text-gray-500 mt-1"><%= item[:requirement].description.truncate(80) %></div>
              <% end %>
            </td>
            <td class="px-4 py-3 text-center">
              <% strength_badges = { strong: ['green', 'Strong'], good: ['blue', 'Good'], partial: ['yellow', 'Partial'], gap: ['red', 'Gap'] } %>
              <% badge = strength_badges[item[:coverage_strength]] %>
              <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-<%= badge[0] %>-100 text-<%= badge[0] %>-800">
                <%= badge[1] %>
              </span>
            </td>
            <td class="px-4 py-3">
              <% if item[:policies].any? %>
                <% item[:policies].first(3).each do |policy| %>
                  <span class="inline-flex items-center px-2 py-0.5 rounded text-xs bg-blue-50 text-blue-700 mr-1 mb-1">
                    <%= policy.title.truncate(30) %>
                  </span>
                <% end %>
              <% else %>
                <span class="text-xs text-gray-400">None</span>
              <% end %>
            </td>
            <td class="px-4 py-3 text-center">
              <% if item[:has_implemented_controls] %>
                <i class="fas fa-check-circle text-green-500"></i>
              <% elsif item[:has_controls] %>
                <i class="fas fa-minus-circle text-yellow-500"></i>
              <% else %>
                <i class="fas fa-times-circle text-gray-300"></i>
              <% end %>
            </td>
            <td class="px-4 py-3 text-right">
              <% unless item[:covered] %>
                <%= link_to draft_organization_policy_gap_index_path(@organization, framework_id: @result[:framework].id, requirement_id: item[:requirement].id), method: :post, data: { turbo_method: :post, turbo_confirm: "Generate a draft policy for '#{item[:requirement].name}'?" }, class: "inline-flex items-center px-3 py-1.5 text-xs font-medium text-white bg-indigo-600 hover:bg-indigo-700 rounded-lg transition-colors" do %>
                  <i class="fas fa-magic mr-1"></i> Draft Policy
                <% end %>
              <% end %>
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>
</div>
