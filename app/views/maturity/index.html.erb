<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
  <!-- Header -->
  <div class="flex items-center justify-between mb-8">
    <div>
      <h1 class="text-3xl font-bold text-gray-900 flex items-center gap-3">
        <span class="inline-flex items-center justify-center w-10 h-10 rounded-lg" style="background: linear-gradient(135deg, var(--primary-color, #6366f1), var(--secondary-color, #8b5cf6));">
          <i class="fas fa-chart-line text-white text-lg"></i>
        </span>
        Control Maturity Assessment
      </h1>
      <p class="mt-1 text-gray-500">Measure and track the maturity of your compliance controls across frameworks</p>
    </div>
    <div class="flex gap-3">
      <%= link_to snapshot_organization_maturity_index_path(@organization), method: :post, data: { turbo_method: :post, turbo_confirm: "This will re-compute maturity scores for all controls. Continue?" }, class: "inline-flex items-center px-4 py-2 border border-transparent rounded-lg shadow-sm text-sm font-medium text-white bg-indigo-600 hover:bg-indigo-700 transition-colors" do %>
        <i class="fas fa-sync-alt mr-2"></i> Compute Scores
      <% end %>
    </div>
  </div>

  <!-- Summary Cards -->
  <div class="grid grid-cols-1 md:grid-cols-4 gap-6 mb-8">
    <div class="bg-white rounded-xl shadow-sm border border-gray-100 p-6">
      <div class="flex items-center justify-between">
        <div>
          <p class="text-sm font-medium text-gray-500">Total Controls</p>
          <p class="text-3xl font-bold text-gray-900 mt-1"><%= @summary[:total_controls] %></p>
        </div>
        <div class="w-12 h-12 rounded-full bg-blue-100 flex items-center justify-center">
          <i class="fas fa-shield-alt text-blue-600 text-xl"></i>
        </div>
      </div>
    </div>

    <div class="bg-white rounded-xl shadow-sm border border-gray-100 p-6">
      <div class="flex items-center justify-between">
        <div>
          <p class="text-sm font-medium text-gray-500">Average Maturity</p>
          <p class="text-3xl font-bold mt-1" style="color: var(--primary-color, #6366f1);"><%= @summary[:average_maturity] %> / 5</p>
        </div>
        <div class="w-12 h-12 rounded-full bg-indigo-100 flex items-center justify-center">
          <i class="fas fa-tachometer-alt text-indigo-600 text-xl"></i>
        </div>
      </div>
    </div>

    <div class="bg-white rounded-xl shadow-sm border border-gray-100 p-6">
      <div class="flex items-center justify-between">
        <div>
          <p class="text-sm font-medium text-gray-500">Below Target</p>
          <p class="text-3xl font-bold text-amber-600 mt-1"><%= @summary[:below_target] %></p>
        </div>
        <div class="w-12 h-12 rounded-full bg-amber-100 flex items-center justify-center">
          <i class="fas fa-exclamation-triangle text-amber-600 text-xl"></i>
        </div>
      </div>
      <p class="text-xs text-gray-400 mt-2"><%= @summary[:target_gap_percentage] %>% of controls below target</p>
    </div>

    <div class="bg-white rounded-xl shadow-sm border border-gray-100 p-6">
      <div class="flex items-center justify-between">
        <div>
          <p class="text-sm font-medium text-gray-500">Maturity Distribution</p>
        </div>
      </div>
      <div class="mt-3 space-y-1">
        <% @summary[:distribution].each do |item| %>
          <div class="flex items-center text-xs">
            <span class="w-20 text-gray-500"><%= item[:label] %></span>
            <div class="flex-1 bg-gray-100 rounded-full h-2 mx-2">
              <% width = @summary[:total_controls] > 0 ? (item[:count].to_f / @summary[:total_controls] * 100) : 0 %>
              <div class="h-2 rounded-full transition-all duration-500" style="width: <%= width %>%; background: linear-gradient(90deg, var(--primary-color, #6366f1), var(--secondary-color, #8b5cf6));"></div>
            </div>
            <span class="w-6 text-right font-medium text-gray-700"><%= item[:count] %></span>
          </div>
        <% end %>
      </div>
    </div>
  </div>

  <!-- Filters -->
  <div class="bg-white rounded-xl shadow-sm border border-gray-100 p-4 mb-6">
    <%= form_tag(organization_maturity_index_path(@organization), method: :get, class: "flex flex-wrap gap-4 items-end") do %>
      <div>
        <label class="block text-sm font-medium text-gray-700 mb-1">Framework</label>
        <%= select_tag :framework_id, options_from_collection_for_select(@frameworks, :id, :name, params[:framework_id]), include_blank: "All Frameworks", class: "block rounded-lg border-gray-300 shadow-sm focus:ring-indigo-500 focus:border-indigo-500 sm:text-sm" %>
      </div>
      <div>
        <label class="block text-sm font-medium text-gray-700 mb-1">Maturity Level</label>
        <%= select_tag :maturity_level, options_for_select(MaturitySnapshot::MATURITY_LEVELS.map { |k, v| [v, k] }, params[:maturity_level]), include_blank: "All Levels", class: "block rounded-lg border-gray-300 shadow-sm focus:ring-indigo-500 focus:border-indigo-500 sm:text-sm" %>
      </div>
      <div class="flex items-center gap-2">
        <label class="flex items-center gap-2 text-sm text-gray-700">
          <%= check_box_tag :below_target, 'true', params[:below_target] == 'true', class: "rounded border-gray-300 text-indigo-600 focus:ring-indigo-500" %>
          Below target only
        </label>
      </div>
      <div>
        <%= submit_tag "Filter", class: "inline-flex items-center px-4 py-2 border border-gray-300 rounded-lg shadow-sm text-sm font-medium text-gray-700 bg-white hover:bg-gray-50 transition-colors cursor-pointer" %>
      </div>
      <% if params[:framework_id].present? || params[:maturity_level].present? || params[:below_target].present? %>
        <div>
          <%= link_to "Clear", organization_maturity_index_path(@organization), class: "text-sm text-indigo-600 hover:text-indigo-800" %>
        </div>
      <% end %>
    <% end %>
  </div>

  <!-- Controls Table -->
  <div class="bg-white rounded-xl shadow-sm border border-gray-100 overflow-hidden">
    <table class="min-w-full divide-y divide-gray-200">
      <thead class="bg-gray-50">
        <tr>
          <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Control</th>
          <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Framework</th>
          <th class="px-6 py-3 text-center text-xs font-medium text-gray-500 uppercase tracking-wider">Current Level</th>
          <th class="px-6 py-3 text-center text-xs font-medium text-gray-500 uppercase tracking-wider">Target Level</th>
          <th class="px-6 py-3 text-center text-xs font-medium text-gray-500 uppercase tracking-wider">Gap</th>
          <th class="px-6 py-3 text-right text-xs font-medium text-gray-500 uppercase tracking-wider">Actions</th>
        </tr>
      </thead>
      <tbody class="bg-white divide-y divide-gray-200">
        <% @controls.each do |control| %>
          <tr class="hover:bg-gray-50 transition-colors">
            <td class="px-6 py-4">
              <div class="text-sm font-medium text-gray-900"><%= control.name %></div>
              <div class="text-xs text-gray-500"><%= control.control_type&.titleize %></div>
            </td>
            <td class="px-6 py-4">
              <span class="text-sm text-gray-600"><%= control.compliance_requirement&.compliance_framework&.name %></span>
            </td>
            <td class="px-6 py-4 text-center">
              <% level = control.maturity_level || 1 %>
              <% level_colors = { 1 => 'red', 2 => 'orange', 3 => 'yellow', 4 => 'blue', 5 => 'green' } %>
              <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-<%= level_colors[level] %>-100 text-<%= level_colors[level] %>-800">
                <%= level %> — <%= MaturitySnapshot::MATURITY_LEVELS[level] %>
              </span>
            </td>
            <td class="px-6 py-4 text-center">
              <% target = control.target_maturity_level || 3 %>
              <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-gray-100 text-gray-800">
                <%= target %> — <%= MaturitySnapshot::MATURITY_LEVELS[target] %>
              </span>
            </td>
            <td class="px-6 py-4 text-center">
              <% gap = (control.target_maturity_level || 3) - (control.maturity_level || 1) %>
              <% if gap > 0 %>
                <span class="inline-flex items-center px-2 py-0.5 rounded-full text-xs font-medium bg-red-100 text-red-700">
                  -<%= gap %>
                </span>
              <% elsif gap == 0 %>
                <span class="inline-flex items-center px-2 py-0.5 rounded-full text-xs font-medium bg-green-100 text-green-700">
                  <i class="fas fa-check mr-1"></i> On Target
                </span>
              <% else %>
                <span class="inline-flex items-center px-2 py-0.5 rounded-full text-xs font-medium bg-blue-100 text-blue-700">
                  +<%= gap.abs %> Above
                </span>
              <% end %>
            </td>
            <td class="px-6 py-4 text-right">
              <%= link_to organization_maturity_path(@organization, control), class: "text-indigo-600 hover:text-indigo-800 text-sm font-medium" do %>
                View Detail <i class="fas fa-arrow-right ml-1"></i>
              <% end %>
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>
    <% if @controls.empty? %>
      <div class="text-center py-12">
        <i class="fas fa-chart-line text-gray-300 text-4xl mb-3"></i>
        <p class="text-gray-500">No controls found. Create compliance controls first, then compute maturity scores.</p>
      </div>
    <% end %>
  </div>
</div>
