<div class="container mx-auto px-4 py-8">
  <div class="mb-6"><%= link_to "← Back to Obligations", organization_obligations_path(@organization), class: "text-blue-600 hover:text-blue-800 font-medium" %></div>

  <div class="bg-white shadow rounded-lg p-6 mb-6">
    <div class="flex justify-between items-start">
      <div>
        <h1 class="text-2xl font-bold text-gray-900"><%= @obligation.title %></h1>
        <div class="flex space-x-2 mt-2">
          <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-blue-100 text-blue-800"><%= @obligation.obligation_type.titleize %></span>
          <% prio_colors = { 'critical' => 'red', 'high' => 'orange', 'medium' => 'yellow', 'low' => 'green' } %>
          <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-<%= prio_colors[@obligation.priority] || 'gray' %>-100 text-<%= prio_colors[@obligation.priority] || 'gray' %>-800"><%= @obligation.priority.titleize %></span>
          <% obs_colors = { 'identified' => 'gray', 'active' => 'blue', 'in_progress' => 'yellow', 'completed' => 'green', 'waived' => 'purple' } %>
          <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-<%= obs_colors[@obligation.status] || 'gray' %>-100 text-<%= obs_colors[@obligation.status] || 'gray' %>-800"><%= @obligation.status.titleize %></span>
          <% if @obligation.overdue? %><span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-red-100 text-red-800">⚠ Overdue</span><% end %>
        </div>
        <% if @obligation.description.present? %><p class="mt-3 text-gray-600"><%= @obligation.description %></p><% end %>
      </div>
      <div><%= link_to "Edit", edit_organization_obligation_path(@organization, @obligation), class: "inline-flex items-center px-3 py-2 border border-gray-300 text-sm font-medium rounded-md text-gray-700 bg-white hover:bg-gray-50" %></div>
    </div>
  </div>

  <div class="grid grid-cols-1 lg:grid-cols-3 gap-6">
    <div class="lg:col-span-2 space-y-6">
      <% if @obligation.source_text.present? %>
        <div class="bg-white shadow rounded-lg p-6">
          <h2 class="text-lg font-semibold text-gray-900 mb-3">Source Text</h2>
          <div class="text-sm text-gray-700 bg-gray-50 border rounded p-4"><%= simple_format(@obligation.source_text) %></div>
        </div>
      <% end %>

      <div class="bg-white shadow rounded-lg p-6">
        <h2 class="text-lg font-semibold text-gray-900 mb-3">Linked Controls (<%= @obligation.compliance_controls.count %>)</h2>
        <% if @obligation.compliance_controls.any? %>
          <div class="space-y-2">
            <% @obligation.compliance_controls.each do |control| %>
              <div class="border rounded p-3 flex justify-between items-center">
                <span class="text-sm font-medium text-gray-900"><%= control.name %></span>
                <span class="text-xs text-gray-500"><%= control.effectiveness&.titleize %> effectiveness</span>
              </div>
            <% end %>
          </div>
        <% else %>
          <p class="text-sm text-gray-500">No controls linked yet. Edit the obligation to link controls.</p>
        <% end %>
      </div>
    </div>

    <div class="space-y-6">
      <div class="bg-white shadow rounded-lg p-6">
        <h3 class="text-sm font-semibold text-gray-900 mb-3">Details</h3>
        <dl class="space-y-3">
          <div><dt class="text-xs text-gray-500">Due Date</dt><dd class="text-sm <%= @obligation.overdue? ? 'text-red-600 font-semibold' : 'text-gray-900' %>"><%= @obligation.due_date&.strftime("%B %d, %Y") || 'Not set' %></dd></div>
          <div><dt class="text-xs text-gray-500">Frequency</dt><dd class="text-sm text-gray-900"><%= @obligation.frequency.titleize %></dd></div>
          <div><dt class="text-xs text-gray-500">Regulation</dt><dd class="text-sm text-gray-900"><%= @obligation.regulation&.title || '—' %></dd></div>
          <div><dt class="text-xs text-gray-500">Created By</dt><dd class="text-sm text-gray-900"><%= @obligation.created_by&.full_name || '—' %></dd></div>
          <div><dt class="text-xs text-gray-500">Created</dt><dd class="text-sm text-gray-900"><%= @obligation.created_at.strftime("%b %d, %Y") %></dd></div>
        </dl>
      </div>
    </div>
  </div>
</div>
