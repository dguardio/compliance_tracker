<div class="container mx-auto px-4 py-8">
  <div class="mb-6"><%= link_to "← Back to Organization", organization_path(@organization), class: "text-blue-600 hover:text-blue-800 font-medium" %></div>

  <div class="flex justify-between items-center mb-6">
    <div>
      <h1 class="text-3xl font-bold text-gray-900">Obligation Register</h1>
      <p class="mt-1 text-sm text-gray-500">Track regulatory and contractual obligations for <%= @organization.name %></p>
    </div>
    <div><%= link_to "New Obligation", new_organization_obligation_path(@organization), class: "inline-flex items-center px-4 py-2 border border-transparent text-sm font-medium rounded-md shadow-sm text-white bg-indigo-600 hover:bg-indigo-700" %></div>
  </div>

  <div class="grid grid-cols-2 md:grid-cols-4 gap-4 mb-8">
    <div class="bg-white shadow rounded-lg p-4"><dt class="text-xs font-medium text-gray-500">Total</dt><dd class="mt-1 text-2xl font-semibold text-gray-900"><%= @stats[:total] %></dd></div>
    <div class="bg-white shadow rounded-lg p-4"><dt class="text-xs font-medium text-gray-500">Active</dt><dd class="mt-1 text-2xl font-semibold text-green-600"><%= @stats[:active] %></dd></div>
    <div class="bg-white shadow rounded-lg p-4"><dt class="text-xs font-medium text-gray-500">Overdue</dt><dd class="mt-1 text-2xl font-semibold text-red-600"><%= @stats[:overdue] %></dd></div>
    <div class="bg-white shadow rounded-lg p-4"><dt class="text-xs font-medium text-gray-500">Due Soon</dt><dd class="mt-1 text-2xl font-semibold text-yellow-600"><%= @stats[:due_soon] %></dd></div>
  </div>

  <div class="bg-white shadow rounded-lg p-4 mb-6">
    <%= form_tag organization_obligations_path(@organization), method: :get, class: "flex flex-wrap gap-3 items-end" do %>
      <div>
        <label class="block text-xs font-medium text-gray-700 mb-1">Status</label>
        <%= select_tag :status, options_for_select([["All", ""], ["Identified", "identified"], ["Active", "active"], ["In Progress", "in_progress"], ["Completed", "completed"], ["Waived", "waived"]], params[:status]), class: "block w-full rounded-md border-gray-300 shadow-sm focus:ring-indigo-500 focus:border-indigo-500 text-sm" %>
      </div>
      <div>
        <label class="block text-xs font-medium text-gray-700 mb-1">Priority</label>
        <%= select_tag :priority, options_for_select([["All", ""], ["Critical", "critical"], ["High", "high"], ["Medium", "medium"], ["Low", "low"]], params[:priority]), class: "block w-full rounded-md border-gray-300 shadow-sm focus:ring-indigo-500 focus:border-indigo-500 text-sm" %>
      </div>
      <div><%= submit_tag "Filter", class: "inline-flex items-center px-3 py-2 border border-gray-300 shadow-sm text-sm font-medium rounded-md text-gray-700 bg-white hover:bg-gray-50 cursor-pointer" %></div>
    <% end %>
  </div>

  <% if @obligations.any? %>
    <div class="overflow-x-auto shadow ring-1 ring-black ring-opacity-5 md:rounded-lg">
      <table class="min-w-full divide-y divide-gray-300">
        <thead class="bg-gray-50">
          <tr>
            <th class="px-4 py-3 text-left text-xs font-medium text-gray-500 uppercase">Obligation</th>
            <th class="px-4 py-3 text-left text-xs font-medium text-gray-500 uppercase hidden sm:table-cell">Type</th>
            <th class="px-4 py-3 text-left text-xs font-medium text-gray-500 uppercase hidden md:table-cell">Priority</th>
            <th class="px-4 py-3 text-left text-xs font-medium text-gray-500 uppercase hidden md:table-cell">Status</th>
            <th class="px-4 py-3 text-left text-xs font-medium text-gray-500 uppercase hidden lg:table-cell">Due Date</th>
            <th class="px-4 py-3 text-left text-xs font-medium text-gray-500 uppercase hidden lg:table-cell">Controls</th>
            <th class="px-4 py-3 text-left text-xs font-medium text-gray-500 uppercase">Actions</th>
          </tr>
        </thead>
        <tbody class="bg-white divide-y divide-gray-200">
          <% @obligations.each do |obligation| %>
            <tr class="<%= 'bg-red-50' if obligation.overdue? %>">
              <td class="px-4 py-4">
                <div class="text-sm font-medium text-gray-900"><%= obligation.title %></div>
                <% if obligation.regulation %><div class="text-xs text-gray-500"><%= obligation.regulation.title %></div><% end %>
              </td>
              <td class="px-4 py-4 whitespace-nowrap hidden sm:table-cell">
                <span class="inline-flex items-center px-2 py-0.5 rounded-full text-xs font-medium bg-blue-100 text-blue-800"><%= obligation.obligation_type.titleize %></span>
              </td>
              <td class="px-4 py-4 whitespace-nowrap hidden md:table-cell">
                <% prio_colors = { 'critical' => 'red', 'high' => 'orange', 'medium' => 'yellow', 'low' => 'green' } %>
                <span class="inline-flex items-center px-2 py-0.5 rounded-full text-xs font-medium bg-<%= prio_colors[obligation.priority] || 'gray' %>-100 text-<%= prio_colors[obligation.priority] || 'gray' %>-800"><%= obligation.priority.titleize %></span>
              </td>
              <td class="px-4 py-4 whitespace-nowrap hidden md:table-cell">
                <% obs_colors = { 'identified' => 'gray', 'active' => 'blue', 'in_progress' => 'yellow', 'completed' => 'green', 'waived' => 'purple', 'expired' => 'red' } %>
                <span class="inline-flex items-center px-2 py-0.5 rounded-full text-xs font-medium bg-<%= obs_colors[obligation.status] || 'gray' %>-100 text-<%= obs_colors[obligation.status] || 'gray' %>-800"><%= obligation.status.titleize %></span>
              </td>
              <td class="px-4 py-4 whitespace-nowrap text-sm hidden lg:table-cell">
                <% if obligation.due_date %>
                  <span class="<%= obligation.overdue? ? 'text-red-600 font-semibold' : 'text-gray-900' %>"><%= obligation.due_date.strftime("%b %d, %Y") %></span>
                  <% if obligation.overdue? %><span class="ml-1 text-xs text-red-600">Overdue</span><% end %>
                <% else %><span class="text-gray-400">—</span><% end %>
              </td>
              <td class="px-4 py-4 whitespace-nowrap text-sm text-gray-500 hidden lg:table-cell"><%= obligation.compliance_controls.count %></td>
              <td class="px-4 py-4 whitespace-nowrap text-sm font-medium">
                <%= link_to "View", organization_obligation_path(@organization, obligation), class: "text-indigo-600 hover:text-indigo-900" %>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  <% else %>
    <div class="text-center py-12 bg-white rounded-lg shadow">
      <h3 class="text-lg font-medium text-gray-900">No obligations</h3>
      <p class="mt-1 text-sm text-gray-500">Create your first obligation to start tracking.</p>
      <div class="mt-6"><%= link_to "Create Obligation", new_organization_obligation_path(@organization), class: "inline-flex items-center px-4 py-2 border border-transparent shadow-sm text-sm font-medium rounded-md text-white bg-indigo-600 hover:bg-indigo-700" %></div>
    </div>
  <% end %>
</div>
