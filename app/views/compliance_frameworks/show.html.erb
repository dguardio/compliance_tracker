<div class="container mx-auto px-4 py-8">
  <div class="mb-6">
    <%= link_to "← Back to Frameworks", organization_compliance_frameworks_path(@organization), 
                class: "text-blue-600 hover:text-blue-800 font-medium" %>
  </div>

  <div class="bg-white rounded-lg shadow-md p-6 mb-8">
    <div class="flex justify-between items-start mb-6">
      <div>
        <h1 class="text-3xl font-bold text-gray-900 mb-2"><%= @compliance_framework.name %></h1>
        <p class="text-gray-600 text-lg"><%= @compliance_framework.description %></p>
      </div>
      <div class="flex space-x-2">
        <% if policy(@compliance_framework).update? %>
          <%= link_to "Edit", edit_organization_compliance_framework_path(@organization, @compliance_framework), 
                      class: "bg-blue-600 hover:bg-blue-700 text-white font-bold py-2 px-4 rounded" %>
        <% end %>
        <% if policy(@compliance_framework).destroy? %>
          <%= link_to "Delete", organization_compliance_framework_path(@organization, @compliance_framework), 
                      method: :delete, 
                      data: { confirm: "Are you sure you want to delete this framework?" },
                      class: "bg-red-600 hover:bg-red-700 text-white font-bold py-2 px-4 rounded" %>
        <% end %>
      </div>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6 mb-8">
      <div class="bg-gray-50 rounded-lg p-4">
        <h3 class="text-sm font-medium text-gray-500 mb-1">Status</h3>
        <p class="text-lg font-semibold">
          <span class="px-2 py-1 text-xs font-medium rounded-full 
                     <%= @compliance_framework.status == 'active' ? 'bg-green-100 text-green-800' : 'bg-gray-100 text-gray-800' %>">
            <%= @compliance_framework.status.titleize %>
          </span>
        </p>
      </div>
      
      <div class="bg-gray-50 rounded-lg p-4">
        <h3 class="text-sm font-medium text-gray-500 mb-1">Version</h3>
        <p class="text-lg font-semibold text-gray-900"><%= @compliance_framework.version %></p>
      </div>
      
      <div class="bg-gray-50 rounded-lg p-4">
        <h3 class="text-sm font-medium text-gray-500 mb-1">Requirements</h3>
        <p class="text-lg font-semibold text-gray-900"><%= @compliance_requirements.count %></p>
      </div>
      
      <div class="bg-gray-50 rounded-lg p-4">
        <h3 class="text-sm font-medium text-gray-500 mb-1">Slug</h3>
        <p class="text-lg font-semibold text-gray-900"><%= @compliance_framework.slug %></p>
      </div>
    </div>

    <% if @compliance_framework.settings.present? %>
      <div class="border-t border-gray-200 pt-6">
        <h3 class="text-lg font-semibold text-gray-900 mb-4">Framework Details</h3>
        <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
          <% @compliance_framework.settings.each do |key, value| %>
            <div class="flex justify-between">
              <span class="text-gray-600 font-medium"><%= key.titleize %>:</span>
              <span class="text-gray-900"><%= value %></span>
            </div>
          <% end %>
        </div>
      </div>
    <% end %>
  </div>

  <!-- Associated Regulations Section -->
  <div class="bg-white rounded-lg shadow-md p-6 mb-8">
    <h2 class="text-2xl font-bold text-gray-900 mb-6">Associated Regulations</h2>
    <% if @associated_regulations.any? %>
      <div class="overflow-x-auto">
        <table class="min-w-full divide-y divide-gray-200">
          <thead class="bg-gray-50">
            <tr>
              <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Title</th>
              <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Agency</th>
              <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Jurisdiction</th>
              <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Actions</th>
            </tr>
          </thead>
          <tbody class="bg-white divide-y divide-gray-200">
            <% @associated_regulations.each do |org_reg| %>
              <tr>
                <td class="px-6 py-4 whitespace-nowrap text-sm font-medium text-gray-900"><%= org_reg.regulation.title %></td>
                <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-500"><%= org_reg.regulation.agency %></td>
                <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-500"><%= org_reg.regulation.jurisdiction %></td>
                <td class="px-6 py-4 whitespace-nowrap text-sm font-medium">
                  <%= link_to "View Review", regulation_review_path(org_reg.regulation_review), class: "text-indigo-600 hover:text-indigo-900" if org_reg.regulation_review %>
                  <%= button_to "Suggest Requirements", suggest_requirements_organization_compliance_framework_path(@organization, @compliance_framework, regulation_id: org_reg.regulation.id), remote: true, class: "ml-4 text-green-600 hover:text-green-900" %>
                </td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
    <% else %>
      <p class="text-center text-gray-500">No regulations have been classified under this framework yet.</p>
    <% end %>
  </div>

  <!-- Requirements Section -->
  <div class="bg-white rounded-lg shadow-md p-6 mb-8">
    <div class="flex justify-between items-center mb-6">
      <h2 class="text-2xl font-bold text-gray-900">Compliance Requirements</h2>
      <% if policy(ComplianceRequirement.new(compliance_framework: @compliance_framework, organization: @organization)).create? %>
        <%= link_to "New Requirement", new_organization_compliance_framework_compliance_requirement_path(@organization, @compliance_framework), 
                    class: "bg-green-600 hover:bg-green-700 text-white font-bold py-2 px-4 rounded" %>
      <% end %>
    </div>

    <% if @compliance_requirements.any? %>
      <div class="space-y-4">
        <% @compliance_requirements.each do |requirement| %>
          <div class="border border-gray-200 rounded-lg p-4 hover:bg-gray-50">
            <div class="flex justify-between items-start mb-2">
              <div>
                <h3 class="text-lg font-semibold text-gray-900">
                  <%= link_to requirement.name, organization_compliance_framework_compliance_requirement_path(@organization, @compliance_framework, requirement), 
                              class: "hover:text-blue-600" %>
                </h3>
                <p class="text-sm text-gray-500"><%= requirement.code %></p>
              </div>
              <div class="flex space-x-2">
                <span class="px-2 py-1 text-xs font-medium rounded-full 
                           <%= requirement.priority == 'high' ? 'bg-red-100 text-red-800' : 
                               requirement.priority == 'medium' ? 'bg-yellow-100 text-yellow-800' : 'bg-green-100 text-green-800' %>">
                  <%= requirement.priority.titleize %>
                </span>
                <span class="px-2 py-1 text-xs font-medium rounded-full 
                           <%= requirement.status == 'active' ? 'bg-green-100 text-green-800' : 'bg-gray-100 text-gray-800' %>">
                  <%= requirement.status.titleize %>
                </span>
              </div>
            </div>
            <p class="text-gray-600 mb-3"><%= requirement.description %></p>
            <div class="flex justify-between items-center text-sm text-gray-500">
              <span>Type: <%= requirement.requirement_type.titleize %></span>
              <span>Controls: <%= requirement.compliance_controls.count %></span>
            </div>
          </div>
        <% end %>
      </div>
    <% else %>
      <div class="text-center py-8">
        <div class="text-gray-400 mb-4">
          <svg class="mx-auto h-12 w-12" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5H7a2 2 0 00-2 2v10a2 2 0 002 2h8a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2" />
          </svg>
        </div>
        <h3 class="text-lg font-medium text-gray-900 mb-2">No compliance requirements</h3>
        <p class="text-gray-500 mb-4">Add requirements to this framework to get started.</p>
        <% if policy(ComplianceRequirement.new(compliance_framework: @compliance_framework, organization: @organization)).create? %>
          <%= link_to "Add Requirement", new_organization_compliance_framework_compliance_requirement_path(@organization, @compliance_framework), 
                      class: "bg-green-600 hover:bg-green-700 text-white font-bold py-2 px-4 rounded" %>
        <% end %>
      </div>
    <% end %>
  </div>

  <!-- Risk Assessments Section -->
  <div class="bg-white rounded-lg shadow-md p-6">
    <div class="flex justify-between items-center mb-6">
      <h2 class="text-2xl font-bold text-gray-900">Risk Assessments</h2>
      <% if policy(RiskAssessment.new(organization: @organization, compliance_framework: @compliance_framework)).create? %>
        <%= link_to "New Risk Assessment", new_organization_compliance_framework_risk_assessment_path(@organization, @compliance_framework), 
                    class: "bg-red-600 hover:bg-red-700 text-white font-bold py-2 px-4 rounded" %>
      <% end %>
    </div>

    <% framework_risk_assessments = @compliance_framework.risk_assessments.includes(:created_by, :assigned_to, :compliance_requirement, :compliance_control) %>
    
    <% if framework_risk_assessments.any? %>
      <div class="overflow-x-auto">
        <table class="min-w-full divide-y divide-gray-200">
          <thead class="bg-gray-50">
            <tr>
              <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Risk Assessment</th>
              <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Risk Level</th>
              <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Status</th>
              <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Assigned To</th>
              <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Next Review</th>
              <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Actions</th>
            </tr>
          </thead>
          <tbody class="bg-white divide-y divide-gray-200">
            <% framework_risk_assessments.each do |risk_assessment| %>
              <tr>
                <td class="px-6 py-4 whitespace-nowrap">
                  <div class="flex items-center">
                    <div class="flex-shrink-0 h-8 w-8">
                      <div class="h-8 w-8 rounded-full bg-<%= risk_assessment.risk_level_color %>-500 flex items-center justify-center">
                        <span class="text-white font-semibold text-xs">
                          <%= risk_assessment.risk_score %>
                        </span>
                      </div>
                    </div>
                    <div class="ml-4">
                      <div class="text-sm font-medium text-gray-900">
                        <%= link_to risk_assessment.name, organization_compliance_framework_risk_assessment_path(@organization, @compliance_framework, risk_assessment), 
                                    class: "hover:text-blue-600" %>
                      </div>
                      <div class="text-sm text-gray-500">
                        <%= risk_assessment.compliance_requirement.name %>
                        <% if risk_assessment.compliance_control %>
                          → <%= risk_assessment.compliance_control.name %>
                        <% end %>
                      </div>
                    </div>
                  </div>
                </td>
                <td class="px-6 py-4 whitespace-nowrap">
                  <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-<%= risk_assessment.risk_level_color %>-100 text-<%= risk_assessment.risk_level_color %>-800">
                    <%= risk_assessment.risk_level %>
                  </span>
                </td>
                <td class="px-6 py-4 whitespace-nowrap">
                  <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-gray-100 text-gray-800">
                    <%= risk_assessment.status.titleize %>
                  </span>
                </td>
                <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-900">
                  <%= risk_assessment.assigned_to.full_name %>
                </td>
                <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-900">
                  <span class="<%= risk_assessment.overdue? ? 'text-red-600' : risk_assessment.due_soon? ? 'text-yellow-600' : 'text-gray-900' %>">
                    <%= risk_assessment.next_review_date.strftime("%b %d, %Y") %>
                  </span>
                  <% if risk_assessment.overdue? %>
                    <span class="ml-2 inline-flex items-center px-2 py-0.5 rounded-full text-xs font-medium bg-red-100 text-red-800">
                      Overdue
                    </span>
                  <% elsif risk_assessment.due_soon? %>
                    <span class="ml-2 inline-flex items-center px-2 py-0.5 rounded-full text-xs font-medium bg-yellow-100 text-yellow-800">
                      Due Soon
                    </span>
                  <% end %>
                </td>
                <td class="px-6 py-4 whitespace-nowrap text-sm font-medium">
                  <%= link_to "View", organization_compliance_framework_risk_assessment_path(@organization, @compliance_framework, risk_assessment), 
                              class: "text-indigo-600 hover:text-indigo-900" %>
                </td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
    <% else %>
      <div class="text-center py-8">
        <div class="text-gray-400 mb-4">
          <svg class="mx-auto h-12 w-12" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-2.5L13.732 4c-.77-.833-1.964-.833-2.732 0L3.732 16.5c-.77.833.192 2.5 1.732 2.5z"></path>
          </svg>
        </div>
        <h3 class="text-lg font-medium text-gray-900 mb-2">No risk assessments</h3>
        <p class="text-gray-500 mb-4">Create risk assessments for this framework to track compliance risks.</p>
        <% if policy(RiskAssessment.new(organization: @organization, compliance_framework: @compliance_framework)).create? %>
          <%= link_to "Create Risk Assessment", new_organization_compliance_framework_risk_assessment_path(@organization, @compliance_framework), 
                      class: "bg-red-600 hover:bg-red-700 text-white font-bold py-2 px-4 rounded" %>
        <% end %>
      </div>
    <% end %>
  </div>
</div> 