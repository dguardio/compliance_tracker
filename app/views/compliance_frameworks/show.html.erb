<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
  <!-- Navigation -->
  <div class="mb-6 flex items-center justify-between">
    <%= link_to organization_compliance_frameworks_path(@organization), class: "group flex items-center text-gray-500 hover:text-gray-900 transition-colors" do %>
      <div class="p-2 bg-white rounded-full border border-gray-200 group-hover:border-gray-300 mr-2 shadow-sm">
        <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18" /></svg>
      </div>
      <span class="font-medium">Back to Frameworks</span>
    <% end %>
    
    <div class="flex space-x-3">
       <% if policy(@compliance_framework).update? %>
          <%= render Joyful::ButtonComponent.new(text: "Edit Framework", variant: :secondary, path: edit_organization_compliance_framework_path(@organization, @compliance_framework)) %>
       <% end %>
       <% if policy(@compliance_framework).destroy? %>
          <%= render Joyful::ButtonComponent.new(text: "Delete", variant: :danger, path: organization_compliance_framework_path(@organization, @compliance_framework), method: :delete, data: { confirm: "Are you sure?" }) %>
       <% end %>
    </div>
  </div>

  <!-- Hero Section: Project Map -->
  <div class="bg-white rounded-card shadow-lg border border-slate-100 p-8 mb-8 relative overflow-hidden">
    <!-- background decoration -->
    <div class="absolute top-0 right-0 -mr-16 -mt-16 w-64 h-64 bg-primary-50 rounded-full opacity-50 blur-3xl"></div>
    
    <div class="relative z-10 grid grid-cols-1 lg:grid-cols-3 gap-8 items-start">
       <div class="lg:col-span-2 space-y-4">
          <div class="flex items-center gap-3 mb-2">
             <h1 class="text-4xl font-bold text-gray-900 tracking-tight"><%= @compliance_framework.name %></h1>
             <%= render Joyful::StatusPillComponent.new(status: @compliance_framework.status, text: @compliance_framework.status) %>
          </div>
          <p class="text-lg text-gray-500 max-w-2xl leading-relaxed"><%= @compliance_framework.description.presence || "No description provided." %></p>
          
          <div class="flex flex-wrap gap-4 pt-2">
             <div class="flex items-center gap-2 px-3 py-1.5 bg-slate-50 rounded-lg border border-slate-100">
                <span class="text-slate-400 text-xs uppercase font-bold tracking-wider">Version</span>
                <span class="text-gray-900 font-semibold tabular-nums"><%= @compliance_framework.version %></span>
             </div>
             <div class="flex items-center gap-2 px-3 py-1.5 bg-slate-50 rounded-lg border border-slate-100">
                <span class="text-slate-400 text-xs uppercase font-bold tracking-wider">Slug</span>
                <span class="text-gray-500 font-mono text-sm"><%= @compliance_framework.slug %></span>
             </div>
          </div>
       </div>

       <!-- Big Metrics -->
       <div class="grid grid-cols-2 gap-4">
          <div class="bg-indigo-50 rounded-2xl p-4 text-center border bordered-indigo-100">
             <span class="block text-3xl font-bold text-indigo-600 tabular-nums"><%= @compliance_requirements.count %></span>
             <span class="text-xs font-semibold text-indigo-400 uppercase tracking-wide">Requirements</span>
          </div>
          <div class="bg-emerald-50 rounded-2xl p-4 text-center border bordered-emerald-100">
             <span class="block text-3xl font-bold text-emerald-600 tabular-nums"><%= @compliance_framework.compliance_controls.count rescue 0 %></span> <!-- Assuming relation exists -->
             <span class="text-xs font-semibold text-emerald-400 uppercase tracking-wide">Controls</span>
          </div>
       </div>
    </div>
  </div>

  <div class="grid grid-cols-12 gap-8">
     <!-- Left Column: Requirements (8 cols) -->
     <div class="col-span-12 lg:col-span-8 space-y-8">
        
        <!-- Requirements List -->
        <section>
           <div class="flex items-center justify-between mb-6">
              <h2 class="text-2xl font-bold text-gray-900 flex items-center gap-2">
                 Requirements
                 <span class="bg-slate-100 text-slate-600 px-2 py-0.5 rounded-full text-xs font-bold align-middle"><%= @compliance_requirements.count %></span>
              </h2>
            <% if policy(ComplianceRequirement.new(compliance_framework: @compliance_framework, organization: @organization)).create? %>
                 <%= render Joyful::ButtonComponent.new(text: "Import from Standard", variant: :secondary, path: search_standard_requirements_path(organization_id: @organization.id, compliance_framework_id: @compliance_framework.id), icon: "fa fa-file-import") %>
                 <%= render Joyful::ButtonComponent.new(text: "New Requirement", variant: :primary, path: new_organization_compliance_framework_compliance_requirement_path(@organization, @compliance_framework), icon: "fa fa-plus") %>
            <% end %>
         </div>
           
           <% if @compliance_requirements.any? %>
              <div class="grid grid-cols-1 gap-4">
                 <% @compliance_requirements.each do |requirement| %>
                    <%= render Joyful::CardComponent.new(padding: true) do %>
                       <div class="flex items-start justify-between gap-4">
                          <div class="flex-1">
                             <div class="flex items-center gap-3 mb-1">
                                <h3 class="text-lg font-semibold text-gray-900 hover:text-primary-600 transition-colors">
                                   <%= link_to requirement.name, organization_compliance_framework_compliance_requirement_path(@organization, @compliance_framework, requirement) %>
                                </h3>
                                <%= render Joyful::StatusPillComponent.new(status: requirement.priority, text: requirement.priority) %>
                             </div>
                             <p class="text-sm text-gray-400 font-mono mb-2"><%= requirement.code %></p>
                             <p class="text-gray-600 line-clamp-2 leading-relaxed"><%= requirement.description %></p>
                          </div>
                          <div class="flex flex-col items-end gap-2">
                             <%= render Joyful::StatusPillComponent.new(status: requirement.status, text: requirement.status) %>
                             <%= render Joyful::ButtonComponent.new(text: "View", variant: :ghost, path: organization_compliance_framework_compliance_requirement_path(@organization, @compliance_framework, requirement)) %>
                          </div>
                       </div>
                    <% end %>
                 <% end %>
              </div>
           <% else %>
              <!-- Empty State -->
              <div class="text-center py-12 bg-slate-50 rounded-3xl border border-dashed border-slate-300">
                 <div class="bg-white p-4 rounded-full inline-flex mb-4 shadow-sm text-slate-400">
                    <svg class="h-8 w-8" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 11H5m14 0a2 2 0 012 2v6a2 2 0 01-2 2H5a2 2 0 01-2-2v-6a2 2 0 012-2m14 0V9a2 2 0 00-2-2M5 11V9a2 2 0 012-2m0 0V5a2 2 0 012-2h6a2 2 0 012 2v2M7 7h10" /></svg>
                 </div>
                 <h3 class="text-lg font-medium text-gray-900 mb-1">No requirements yet</h3>
                 <p class="text-gray-500 mb-6">Define the requirements to start building controls.</p>
                 <% if policy(ComplianceRequirement.new(compliance_framework: @compliance_framework, organization: @organization)).create? %>
                    <%= render Joyful::ButtonComponent.new(text: "Add First Requirement", variant: :primary, path: new_organization_compliance_framework_compliance_requirement_path(@organization, @compliance_framework)) %>
                 <% end %>
              </div>
           <% end %>
        </section>

        <!-- Risk Maps -->
        <section>
            <div class="flex items-center justify-between mb-6">
               <h2 class="text-2xl font-bold text-gray-900">Risk Assessments</h2>
               <% if policy(RiskAssessment.new(organization: @organization, compliance_framework: @compliance_framework)).create? %>
                  <%= render Joyful::ButtonComponent.new(text: "New Risk Assessment", variant: :secondary, path: new_organization_compliance_framework_risk_assessment_path(@organization, @compliance_framework)) %>
               <% end %>
            </div>
            
            <% framework_risk_assessments = @compliance_framework.risk_assessments.includes(:created_by, :assigned_to, :compliance_requirement, :compliance_control) %>
            <% if framework_risk_assessments.any? %>
                <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                   <% framework_risk_assessments.each do |risk_assessment| %>
                      <%= render Joyful::CardComponent.new(padding: true) do %>
                         <div class="flex items-start justify-between">
                            <div class="flex items-center gap-3">
                               <div class="flex-shrink-0 h-10 w-10 rounded-full bg-<%= risk_assessment.risk_level_color %>-100 flex items-center justify-center text-<%= risk_assessment.risk_level_color %>-600 font-bold border-2 border-white ring-2 ring-<%= risk_assessment.risk_level_color %>-50">
                                  <%= risk_assessment.risk_score %>
                               </div>
                               <div>
                                  <h4 class="text-sm font-semibold text-gray-900 line-clamp-1"><%= link_to risk_assessment.name, organization_compliance_framework_risk_assessment_path(@organization, @compliance_framework, risk_assessment) %></h4>
                                  <p class="text-xs text-gray-500"><%= risk_assessment.assigned_to.full_name %></p>
                               </div>
                            </div>
                            <!-- Status -->
                            <%= render Joyful::StatusPillComponent.new(status: risk_assessment.risk_level, text: risk_assessment.risk_level) %>
                         </div>
                         <div class="mt-4 pt-3 border-t border-slate-50 flex items-center justify-between text-xs text-gray-400">
                            <span>Review: <%= risk_assessment.next_review_date.strftime("%b %d") %></span>
                            <span class="<%= risk_assessment.status == 'active' ? 'text-green-500' : 'text-gray-400' %>">● <%= risk_assessment.status.titleize %></span>
                         </div>
                      <% end %>
                   <% end %>
                </div>
            <% else %>
               <div class="bg-slate-50 rounded-xl p-8 text-center text-gray-500 italic">
                  No risk assessments linked to this framework.
               </div>
            <% end %>
        </section>
     </div>

     <!-- Right Rail: Regulations Links (4 cols) -->
     <div class="col-span-12 lg:col-span-4 space-y-8">
        <div class="bg-slate-50 rounded-2xl p-6">
           <h3 class="text-lg font-bold text-gray-900 mb-4">Associated Regulations</h3>
           <% if @associated_regulations.any? %>
              <div class="space-y-3">
                 <% @associated_regulations.each do |org_reg| %>
                    <div class="bg-white p-3 rounded-xl border border-slate-200 shadow-sm hover:shadow-md transition-shadow">
                       <h4 class="font-semibold text-gray-900 text-sm"><%= org_reg.regulation.title %></h4>
                       <div class="flex justify-between items-center mt-2">
                          <span class="text-xs text-gray-500 bg-gray-100 px-2 py-0.5 rounded"><%= org_reg.regulation.agency %></span>
                          <div class="flex gap-2">
                             <% if org_reg.regulation_review %>
                                <%= link_to regulation_review_path(org_reg.regulation_review), class: "text-primary-600 hover:text-primary-700 text-xs font-medium" do %>
                                   View Review
                                <% end %>
                             <% end %>
                          </div>
                       </div>
                    </div>
                 <% end %>
              </div>
           <% else %>
              <p class="text-sm text-gray-500">No regulations linked.</p>
           <% end %>
        </div>

        <% if @compliance_framework.settings.present? %>
           <div class="bg-white rounded-2xl p-6 border border-slate-100 shadow-sm">
             <h3 class="text-sm font-bold text-gray-900 uppercase tracking-widest mb-4">Metadata</h3>
             <dl class="space-y-3 text-sm">
                <% @compliance_framework.settings.each do |key, value| %>
                  <div class="flex justify-between border-b border-slate-50 pb-2">
                    <dt class="text-gray-500"><%= key.titleize %></dt>
                    <dd class="font-medium text-gray-900"><%= value %></dd>
                  </div>
                <% end %>
             </dl>
           </div>
        <% end %>
     </div>
  </div>
</div>