<div class="bg-white rounded-lg shadow-md p-6 mb-8">
  <h2 class="text-2xl font-bold text-gray-900 mb-6">Suggested Requirements for "<%= @regulation.title %>"</h2>

  <%= form_with(url: organization_compliance_framework_compliance_requirements_path(@organization, @compliance_framework), method: :post) do |form| %>
    <div class="space-y-4">
      <% @suggested_requirements.each_with_index do |requirement, index| %>
        <div class="border border-gray-200 rounded-lg p-4">
          <div class="flex items-start">
            <%= check_box_tag "requirements[#{index}][create]", "1", true, class: "h-4 w-4 text-indigo-600 border-gray-300 rounded mt-1" %>
            <div class="ml-3 text-sm">
              <%= fields_for "requirements[#{index}]", requirement do |req_form| %>
                <div class="mb-2">
                  <%= req_form.label :name, "Name", class: "font-medium text-gray-900" %>
                  <%= req_form.text_field :name, class: "mt-1 block w-full rounded-md border-gray-300 shadow-sm" %>
                </div>
                <div class="mb-2">
                  <%= req_form.label :description, "Description", class: "font-medium text-gray-900" %>
                  <%= req_form.text_area :description, rows: 3, class: "mt-1 block w-full rounded-md border-gray-300 shadow-sm" %>
                </div>
                <div class="grid grid-cols-2 gap-4">
                  <div>
                    <%= req_form.label :priority, "Priority", class: "font-medium text-gray-900" %>
                    <%= req_form.select :priority, ComplianceRequirement.priorities.keys, {}, class: "mt-1 block w-full rounded-md border-gray-300 shadow-sm" %>
                  </div>
                  <div>
                    <%= req_form.label :requirement_type, "Type", class: "font-medium text-gray-900" %>
                    <%= req_form.select :requirement_type, ComplianceRequirement.requirement_types.keys, {}, class: "mt-1 block w-full rounded-md border-gray-300 shadow-sm" %>
                  </div>
                </div>
              <% end %>
            </div>
          </div>
        </div>
      <% end %>
    </div>

    <div class="mt-6 text-right">
      <%= form.submit "Create Selected Requirements", class: "cursor-pointer rounded-md bg-green-600 px-4 py-2 text-sm font-semibold text-white shadow-sm hover:bg-green-500" %>
      <%= link_to "Cancel", organization_compliance_framework_path(@organization, @compliance_framework), class: "ml-4 cursor-pointer rounded-md bg-gray-200 px-4 py-2 text-sm font-semibold text-gray-800 shadow-sm hover:bg-gray-300" %>
    </div>
  <% end %>
</div>
