<%= form_with model: [@organization, @compliance_framework], local: true, class: "space-y-6" do |form| %>
  <% if @compliance_framework.errors.any? %>
    <%= render Joyful::CardComponent.new(padding: true) do %>
      <div class="space-y-2">
        <h2 class="text-lg font-bold text-red-700 flex items-center gap-2">
          <i class="fas fa-exclamation-circle"></i>
          <%= pluralize(@compliance_framework.errors.count, "error") %> prohibited this framework from being saved:
        </h2>
        <ul class="list-disc pl-5 text-red-600">
          <% @compliance_framework.errors.full_messages.each do |message| %>
            <li><%= message %></li>
          <% end %>
        </ul>
      </div>
    <% end %>
  <% end %>

  <%= render Joyful::CardComponent.new(title: "Framework Details", icon: "shield-alt", padding: true) do %>
    <div class="space-y-6">
      <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
        <%= render Joyful::InputComponent.new(
              form: form, 
              method: :name, 
              label: "Name", 
              placeholder: "e.g., SOC 2 Type II"
            ) %>

        <%= render Joyful::InputComponent.new(
              form: form, 
              method: :slug, 
              label: "Slug", 
              placeholder: "e.g., soc-2-type-ii",
              hint: "Unique identifier for the framework."
            ) %>
      </div>

      <%= render Joyful::InputComponent.new(
            form: form, 
            method: :description, 
            label: "Description", 
            type: :text_area,
            rows: 4
          ) %>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
        <%= render Joyful::InputComponent.new(
              form: form, 
              method: :version, 
              label: "Version", 
              placeholder: "e.g., 2017"
            ) %>

        <%= render Joyful::InputComponent.new(
              form: form, 
              method: :status, 
              label: "Status", 
              type: :select, 
              choices: [['Active', 'active'], ['Inactive', 'inactive'], ['Draft', 'draft']],
              options: {},
              html_options: { class: "w-full rounded-xl border-gray-300 shadow-sm focus:border-primary-500 focus:ring-primary-500" }
            ) %>
      </div>
    </div>
  <% end %>

  <div class="flex justify-end pt-4 gap-3">
    <%= link_to "Cancel", organization_compliance_frameworks_path(@organization), 
                class: "inline-flex items-center px-4 py-2 border border-gray-300 shadow-sm text-sm font-medium rounded-xl text-gray-700 bg-white hover:bg-gray-50 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-primary-500 transition-all duration-200" %>
    
    <%= render Joyful::ButtonComponent.new(
          text: "Save Framework",
          type: :submit,
          variant: :primary,
          icon: "save"
        ) %>
  </div>
<% end %> 