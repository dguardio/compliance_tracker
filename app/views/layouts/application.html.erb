<!DOCTYPE html>
<html>
  <head>
    <title>ComplianceTracker</title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    <%= stylesheet_link_tag "tailwind", "inter-font", "data-turbo-track": "reload" %>

    <%= stylesheet_link_tag "application", "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
    <!-- Alpine.js for dismissible alerts -->
    <script src="https://cdn.jsdelivr.net/npm/alpinejs@3.x.x/dist/cdn.min.js" defer></script>
  </head>

  <body class="bg-gradient-to-br from-blue-50 to-indigo-100 min-h-screen">
    <% if notice %>
      <div class="fixed top-4 right-4 z-50" x-data="{ show: true }" x-show="show" x-transition>
        <div class="bg-green-500 text-white px-6 py-3 rounded-lg shadow-lg transform transition-all duration-300 hover:scale-105 relative">
          <button @click="show = false" aria-label="Close" class="absolute top-2 right-2 text-white hover:text-gray-200 text-xl font-bold focus:outline-none">
            &times;
          </button>
          <%= notice %>
        </div>
      </div>
    <% end %>
    <% if alert %>
      <div class="fixed top-4 right-4 z-50" x-data="{ show: true }" x-show="show" x-transition>
        <div class="bg-red-500 text-white px-6 py-3 rounded-lg shadow-lg transform transition-all duration-300 hover:scale-105 relative">
          <button @click="show = false" aria-label="Close" class="absolute top-2 right-2 text-white hover:text-gray-200 text-xl font-bold focus:outline-none">
            &times;
          </button>
          <%= alert %>
        </div>
      </div>
    <% end %>
    
    <!-- Navigation -->
    <nav class="bg-white/80 backdrop-blur-md shadow-lg border-b border-gray-200 sticky top-0 z-40">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="flex justify-between items-center h-16">
          <div class="flex items-center">
            <h1 class="text-2xl font-bold text-indigo-600">ComplianceTracker</h1>
          </div>
          
          <div class="flex items-center space-x-4">
            <% if user_signed_in? %>
              <span class="text-gray-700 font-medium">Welcome, <%= current_user.full_name %></span>
              <%= link_to "Dashboard", dashboard_path, class: "text-indigo-600 hover:text-indigo-800 font-medium transition-colors" %>
              <%= link_to "Organizations", organizations_path, class: "text-gray-300 hover:bg-gray-700 hover:text-white px-3 py-2 rounded-md text-sm font-medium" %>
              <%= link_to "Permissions", organization_permissions_path(current_user.organization), class: "text-gray-300 hover:bg-gray-700 hover:text-white px-3 py-2 rounded-md text-sm font-medium" %>
              <%= link_to "Sign out", destroy_user_session_path, data: { turbo_method: :delete }, 
                  class: "bg-red-500 hover:bg-red-600 text-white px-4 py-2 rounded-lg font-medium transition-colors" %>
            <% else %>
              <%= link_to "Sign in", new_user_session_path, 
                  class: "text-indigo-600 hover:text-indigo-800 font-medium transition-colors" %>
              <%= link_to "Sign up", new_user_registration_path, 
                  class: "bg-indigo-600 hover:bg-indigo-700 text-white px-4 py-2 rounded-lg font-medium transition-colors" %>
            <% end %>
          </div>
        </div>
      </div>
    </nav>
    
    <!-- Main Content -->
    <%= yield %>
  </body>
</html>
