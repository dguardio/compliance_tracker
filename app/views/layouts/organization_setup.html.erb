<!DOCTYPE html>
<html>
  <head>
    <title>Organization Setup - ComplyFlow</title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    <%= stylesheet_link_tag "tailwind", "inter-font", "data-turbo-track": "reload" %>
    <%= stylesheet_link_tag "application", "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>

  <body class="bg-gray-50">
    <div class="min-h-screen flex flex-col">
      <!-- Top Navigation -->
      <nav class="bg-white border-b border-gray-200">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
          <div class="flex justify-between h-16">
            <div class="flex">
              <div class="flex-shrink-0 flex items-center">
                <span class="text-xl font-bold text-indigo-600">ComplyFlow Setup</span>
              </div>
            </div>
            <div class="flex items-center">
              <%= link_to "Exit Setup", organization_path(@organization), class: "text-gray-500 hover:text-gray-700 text-sm font-medium" %>
            </div>
          </div>
        </div>
      </nav>

      <!-- Progress Bar -->
      <div class="bg-white shadow-sm">
        <div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8">
          <div class="py-4">
            <nav aria-label="Progress">
              <ol role="list" class="flex items-center">
                <% steps = [:departments, :teams, :units, :users] %>
                <% current_idx = steps.index(@step) || 0 %>
                
                <% steps.each_with_index do |step, idx| %>
                  <% if idx > 0 %>
                    <li class="relative w-full h-0.5 bg-gray-200 mx-2">
                      <div class="absolute inset-0 bg-indigo-600" style="width: <%= idx <= current_idx ? '100%' : '0%' %>"></div>
                    </li>
                  <% end %>
                  
                  <li class="relative flex items-center justify-center">
                    <% if idx < current_idx %>
                      <span class="h-8 w-8 rounded-full bg-indigo-600 flex items-center justify-center hover:bg-indigo-900">
                        <svg class="h-5 w-5 text-white" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
                          <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd" />
                        </svg>
                      </span>
                    <% elsif idx == current_idx %>
                      <span class="h-8 w-8 rounded-full border-2 border-indigo-600 bg-white flex items-center justify-center" aria-current="step">
                        <span class="h-2.5 w-2.5 rounded-full bg-indigo-600"></span>
                      </span>
                    <% else %>
                      <span class="h-8 w-8 rounded-full border-2 border-gray-300 bg-white flex items-center justify-center group-hover:border-gray-400">
                        <span class="h-2.5 w-2.5 rounded-full bg-transparent group-hover:bg-gray-300"></span>
                      </span>
                    <% end %>
                    <span class="absolute -bottom-6 text-xs font-medium <%= idx == current_idx ? 'text-indigo-600' : 'text-gray-500' %>">
                      <%= step.to_s.titleize %>
                    </span>
                  </li>
                <% end %>
              </ol>
            </nav>
          </div>
        </div>
      </div>

      <!-- Main Content -->
      <main class="flex-grow">
        <%= yield %>
      </main>
    </div>
  </body>
</html>
