<%= form_with(model: [@organization, @workflow_template, workflow_step], class: "space-y-4") do |form| %>
  <%= render Joyful::InputComponent.new(
        form: form,
        method: :name,
        label: "Step Name",
        placeholder: "e.g., Legal Review"
      ) %>

  <div>
    <%= form.label :role_id, "Assign to Role", class: "block text-sm font-medium text-gray-700 mb-1" %>
    <%= form.collection_select :role_id, @organization.roles, :id, :name, { include_blank: 'Select a role' }, class: "mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:border-primary-500 focus:ring-primary-500 sm:text-sm" %>
  </div>

  <div>
    <%= form.label :step_type, class: "block text-sm font-medium text-gray-700 mb-1" %>
    <%= form.select :step_type, ['review', 'decision', 'classification', 'acknowledgement'], {}, { class: "mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:border-primary-500 focus:ring-primary-500 sm:text-sm" } %>
  </div>
  
  <div>
    <%= form.label :decision_options, "Decision Options", class: "block text-sm font-medium text-gray-700 mb-1" %>
    <%= form.text_field :decision_options, value: workflow_step.decision_options.join(','), "data-controller": "tagify", class: "mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:border-primary-500 focus:ring-primary-500 sm:text-sm", placeholder: "e.g., Applicable, Not Applicable, Escalate" %>
    <p class="mt-1 text-xs text-gray-500">Separated by commas</p>
  </div>

  <div class="pt-2">
    <%= render Joyful::ButtonComponent.new(
          text: "Save Step",
          form: form,
          variant: :primary,
          class: "w-full justify-center shadow-primary-glow"
        ) %>
  </div>
<% end %>
