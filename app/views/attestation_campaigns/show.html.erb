<div class="container mx-auto px-4 py-8">
  <div class="mb-6">
    <%= link_to "← Back to Campaigns", organization_attestation_campaigns_path(@organization),
                class: "text-blue-600 hover:text-blue-800 font-medium" %>
  </div>

  <!-- Header -->
  <div class="bg-white shadow rounded-lg p-6 mb-6">
    <div class="flex justify-between items-start">
      <div>
        <h1 class="text-2xl font-bold text-gray-900"><%= @campaign.title %></h1>
        <p class="text-sm text-gray-500 mt-1">Policy: <strong><%= @campaign.policy.title %></strong></p>
        <div class="flex space-x-2 mt-2">
          <% status_colors = { 'draft' => 'gray', 'active' => 'green', 'closed' => 'blue', 'cancelled' => 'red' } %>
          <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-<%= status_colors[@campaign.status] || 'gray' %>-100 text-<%= status_colors[@campaign.status] || 'gray' %>-800"><%= @campaign.status.titleize %></span>
          <% if @campaign.overdue? %>
            <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-red-100 text-red-800">⚠ Overdue</span>
          <% end %>
        </div>
        <% if @campaign.description.present? %>
          <p class="mt-3 text-gray-600"><%= @campaign.description %></p>
        <% end %>
      </div>
      <div class="flex space-x-2">
        <% if @campaign.status_draft? %>
          <%= button_to "Launch Campaign", launch_organization_attestation_campaign_path(@organization, @campaign),
                        method: :post,
                        class: "inline-flex items-center px-3 py-2 border border-transparent text-sm font-medium rounded-md text-white bg-green-600 hover:bg-green-700" %>
        <% elsif @campaign.status_active? %>
          <%= button_to "Close Campaign", close_organization_attestation_campaign_path(@organization, @campaign),
                        method: :patch,
                        class: "inline-flex items-center px-3 py-2 border border-gray-300 text-sm font-medium rounded-md text-gray-700 bg-white hover:bg-gray-50" %>
        <% end %>
        <%= link_to "Edit", edit_organization_attestation_campaign_path(@organization, @campaign),
                    class: "inline-flex items-center px-3 py-2 border border-gray-300 text-sm font-medium rounded-md text-gray-700 bg-white hover:bg-gray-50" %>
      </div>
    </div>

    <!-- Progress -->
    <div class="mt-4">
      <div class="flex justify-between text-sm mb-1">
        <span class="text-gray-600"><%= @campaign.completed_count %>/<%= @attestations.count %> attested</span>
        <span class="font-medium"><%= @campaign.completion_rate %>%</span>
      </div>
      <div class="w-full bg-gray-200 rounded-full h-3">
        <div class="bg-indigo-600 h-3 rounded-full transition-all" style="width: <%= @campaign.completion_rate %>%"></div>
      </div>
      <div class="flex justify-between text-xs text-gray-400 mt-1">
        <span>Deadline: <%= @campaign.deadline&.strftime("%B %d, %Y %I:%M %p") || '—' %></span>
        <span>Created: <%= @campaign.created_at.strftime("%b %d, %Y") %></span>
      </div>
    </div>
  </div>

  <!-- Attestation Table -->
  <div class="bg-white shadow rounded-lg overflow-hidden">
    <div class="px-6 py-4 bg-gray-50 border-b">
      <h2 class="text-lg font-semibold text-gray-900">Attestation Records</h2>
    </div>
    <% if @attestations.any? %>
      <table class="min-w-full divide-y divide-gray-300">
        <thead class="bg-gray-50">
          <tr>
            <th class="px-4 py-3 text-left text-xs font-medium text-gray-500 uppercase">User</th>
            <th class="px-4 py-3 text-left text-xs font-medium text-gray-500 uppercase">Status</th>
            <th class="px-4 py-3 text-left text-xs font-medium text-gray-500 uppercase hidden md:table-cell">Attested At</th>
            <th class="px-4 py-3 text-left text-xs font-medium text-gray-500 uppercase hidden lg:table-cell">IP Address</th>
            <th class="px-4 py-3 text-left text-xs font-medium text-gray-500 uppercase hidden lg:table-cell">Policy Version</th>
          </tr>
        </thead>
        <tbody class="bg-white divide-y divide-gray-200">
          <% @attestations.each do |attestation| %>
            <tr>
              <td class="px-4 py-3">
                <div class="text-sm font-medium text-gray-900"><%= attestation.user.full_name %></div>
                <div class="text-xs text-gray-500"><%= attestation.user.email %></div>
              </td>
              <td class="px-4 py-3">
                <% att_colors = { 'pending' => 'yellow', 'completed' => 'green', 'declined' => 'red', 'expired' => 'gray' } %>
                <span class="inline-flex items-center px-2 py-0.5 rounded-full text-xs font-medium bg-<%= att_colors[attestation.status] || 'gray' %>-100 text-<%= att_colors[attestation.status] || 'gray' %>-800"><%= attestation.status.titleize %></span>
              </td>
              <td class="px-4 py-3 text-sm text-gray-500 hidden md:table-cell">
                <%= attestation.attested_at&.strftime("%b %d, %Y %I:%M %p") || '—' %>
              </td>
              <td class="px-4 py-3 text-sm text-gray-500 hidden lg:table-cell font-mono">
                <%= attestation.ip_address || '—' %>
              </td>
              <td class="px-4 py-3 text-sm text-gray-500 hidden lg:table-cell">
                <%= attestation.policy_version.present? ? attestation.policy_version.truncate(20) : '—' %>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    <% else %>
      <div class="text-center py-8">
        <p class="text-sm text-gray-500">No attestations yet. Launch the campaign to create attestation records for all users.</p>
      </div>
    <% end %>
  </div>
</div>
