<div class="container mx-auto px-4 py-8">
  <!-- Header Section -->
  <div class="flex flex-col md:flex-row justify-between items-start md:items-center mb-8 gap-4">
    <div>
      <h1 class="text-3xl font-bold text-gray-900 tracking-tight">Permission Registry</h1>
      <p class="mt-1 text-gray-500">Fine-grained access control for specific resources and actions.</p>
    </div>
    <div class="flex gap-3">
        <%= render Joyful::ButtonComponent.new(
            text: "Manage Roles",
            path: organization_roles_path(current_user.organization),
            variant: :secondary,
            icon: "shield-check"
          ) %>
        <%= render Joyful::ButtonComponent.new(
            text: "Grant Permission",
            path: new_organization_permission_path(current_user.organization),
            variant: :primary,
            icon: "key"
          ) %>
    </div>
  </div>

  <!-- Search & Filter Bar -->
  <div class="bg-white rounded-xl shadow-sm border border-gray-100 p-4 mb-8">
    <%= form_with url: organization_permissions_path(current_user.organization), method: :get, local: true, class: "flex flex-col gap-4" do |f| %>
      <div class="flex flex-col md:flex-row gap-4 items-end">
        <div class="flex-grow w-full">
            <%= f.label :search, "Search Permissions", class: "text-xs font-semibold text-gray-500 uppercase tracking-wider mb-1 block" %>
            <div class="relative">
                <div class="absolute inset-y-0 left-0 pl-3 flex items-center pointer-events-none">
                    <svg class="h-5 w-5 text-gray-400" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor">
                        <path fill-rule="evenodd" d="M8 4a4 4 0 100 8 4 4 0 000-8zM2 8a6 6 0 1110.89 3.476l4.817 4.817a1 1 0 01-1.414 1.414l-4.816-4.816A6 6 0 012 8z" clip-rule="evenodd" />
                    </svg>
                </div>
                <%= f.text_field :search, value: params[:search], 
                                class: "block w-full pl-10 pr-3 py-2 border border-gray-200 rounded-lg leading-5 bg-gray-50 placeholder-gray-400 focus:outline-none focus:bg-white focus:ring-2 focus:ring-primary-500 focus:border-primary-500 sm:text-sm transition-all duration-200", 
                                placeholder: "Search by grantee, resource, or action..." %>
            </div>
        </div>
        
        <div class="w-full md:w-48">
             <%= f.label :permission_action, "Action", class: "text-xs font-semibold text-gray-500 uppercase tracking-wider mb-1 block" %>
             <%= f.select :permission_action, options_for_select([["All Actions", ""]] + @actions.map { |a| [a.titleize, a] }, params[:permission_action]), 
                          {}, class: "block w-full px-3 py-2 border border-gray-200 rounded-lg bg-gray-50 focus:outline-none focus:ring-primary-500 focus:border-primary-500 sm:text-sm" %>
        </div>

        <div class="w-full md:w-48">
            <%= f.label :grantee_type, "Grantee Type", class: "text-xs font-semibold text-gray-500 uppercase tracking-wider mb-1 block" %>
            <%= f.select :grantee_type, options_for_select([['All Types', ''], ['User', 'User'], ['Role', 'Role']], params[:grantee_type]), 
                        {}, class: "block w-full px-3 py-2 border border-gray-200 rounded-lg bg-gray-50 focus:outline-none focus:ring-primary-500 focus:border-primary-500 sm:text-sm" %>
        </div>
        
        <div class="flex gap-2">
             <%= render Joyful::ButtonComponent.new(
                text: "Filter",
                variant: :secondary,
                form: f
            ) %>
        </div>
      </div>
    <% end %>
  </div>

  <!-- Permissions List -->
  <% if @permissions.any? %>
    <div class="bg-white rounded-xl shadow-sm border border-gray-100 overflow-hidden">
        <ul class="divide-y divide-gray-100">
          <% @permissions.each do |permission| %>
            <li class="group hover:bg-gray-50 transition-colors duration-150">
              <div class="px-6 py-4 flex items-center justify-between">
                <div class="flex items-center flex-1 min-w-0">
                    <!-- Icon/Avatar -->
                    <div class="flex-shrink-0 mr-4">
                         <% if permission.grantee_type == 'User' %>
                            <div class="h-10 w-10 rounded-full bg-blue-100 flex items-center justify-center text-blue-600 font-bold border border-blue-200">
                                <%= permission.grantee&.first_name&.first&.upcase || 'U' %>
                            </div>
                         <% else %>
                             <div class="h-10 w-10 rounded-lg bg-purple-100 flex items-center justify-center text-purple-600 font-bold border border-purple-200">
                                <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0zm6 3a2 2 0 11-4 0 2 2 0 014 0zM7 10a2 2 0 11-4 0 2 2 0 014 0z"></path></svg>
                            </div>
                         <% end %>
                    </div>

                    <div class="flex-1 min-w-0 grid grid-cols-1 sm:grid-cols-3 gap-4 items-center">
                        <!-- Grantee -->
                         <div>
                            <p class="text-sm font-bold text-gray-900 group-hover:text-primary-600 transition-colors truncate">
                                <%= permission.name %>
                            </p>
                            <p class="text-xs text-gray-500">
                                <%= permission.grantee_type %> • 
                                <% if permission.grantee_type == 'User' %>
                                    <%= permission.grantee&.full_name || 'N/A' %>
                                <% else %>
                                    <%= permission.grantee&.name || 'N/A' %>
                                <% end %>
                            </p>
                        </div>
                        
                        <!-- Action -->
                        <div>
                             <%= render Joyful::StatusPillComponent.new(status: permission.action) %>
                        </div>

                        <!-- Resource -->
                        <div class="text-sm text-gray-500">
                            <span class="font-medium text-gray-900"><%= permission.resource_type %></span>
                             <% if permission.resource %>
                                <span class="bg-gray-100 px-1.5 py-0.5 rounded text-xs ml-1"><%= permission.resource.name %></span>
                             <% else %>
                                <span class="text-gray-400 italic text-xs ml-1">(Global)</span>
                             <% end %>
                        </div>
                    </div>
                </div>

                <div class="ml-4 flex items-center space-x-3 opacity-0 group-hover:opacity-100 transition-opacity">
                   <%= link_to edit_organization_permission_path(current_user.organization, permission), class: "text-gray-400 hover:text-blue-600 transition-colors p-1" do %>
                        <span class="sr-only">Edit</span>
                        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15.232 5.232l3.536 3.536m-2.036-5.036a2.5 2.5 0 113.536 3.536L6.5 21.036H3v-3.572L16.732 3.732z"></path></svg>
                    <% end %>
                    <%= link_to organization_permission_path(current_user.organization, permission), method: :delete, data: { confirm: 'Revoke this permission?' }, class: "text-gray-400 hover:text-red-600 transition-colors p-1" do %>
                        <span class="sr-only">Delete</span>
                        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"></path></svg>
                    <% end %>
                </div>
              </div>
            </li>
          <% end %>
        </ul>
    </div>

    <!-- Pagination -->
    <div class="mt-8 flex justify-center">
      <%= paginate @permissions, theme: 'tailwind' %>
    </div>
  <% else %>
    <div class="text-center py-20 bg-white rounded-xl shadow-sm border border-dashed border-gray-300">
      <div class="mx-auto h-24 w-24 bg-indigo-50 rounded-full flex items-center justify-center mb-6 animate-float">
        <svg class="h-12 w-12 text-indigo-500" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6v6m0 0v6m0-6h6m-6 0H6"/>
        </svg>
      </div>
      <h3 class="text-xl font-bold text-gray-900 mb-2">No Permissions Granting</h3>
      <p class="text-gray-500 mb-8 max-w-sm mx-auto">Permissions allow you to fine-tune what users and roles can do.</p>
      <%= render Joyful::ButtonComponent.new(
          text: "Grant Permission",
          path: new_organization_permission_path(current_user.organization),
          variant: :primary,
          icon: "key"
      ) %>
    </div>
  <% end %>
</div>
