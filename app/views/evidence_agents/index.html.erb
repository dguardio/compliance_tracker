<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
  <div class="flex items-center justify-between mb-8">
    <div>
      <h1 class="text-3xl font-bold text-gray-900 flex items-center gap-3">
        <span class="inline-flex items-center justify-center w-10 h-10 rounded-lg" style="background: linear-gradient(135deg, #10b981, #3b82f6);">
          <i class="fas fa-robot text-white text-lg"></i>
        </span>
        Evidence Collection Agents
      </h1>
      <p class="mt-1 text-gray-500">Automated evidence collection from connected services</p>
    </div>
  </div>

  <!-- Connected Agents -->
  <div class="bg-white rounded-xl shadow-sm border p-6 mb-8">
    <h2 class="text-lg font-semibold text-gray-900 mb-4">Connected Integrations</h2>
    <% if @credentials.any? %>
      <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
        <% @credentials.each do |cred| %>
          <div class="border rounded-lg p-4 flex items-center gap-4">
            <div class="w-10 h-10 rounded-lg flex items-center justify-center" style="background-color: <%= cred.provider_info[:color] %>20;">
              <i class="<%= cred.provider_info[:icon] %> text-lg" style="color: <%= cred.provider_info[:color] %>;"></i>
            </div>
            <div class="flex-1">
              <p class="text-sm font-medium text-gray-900"><%= cred.label %></p>
              <p class="text-xs text-gray-500"><%= cred.provider_info[:name] %></p>
            </div>
            <% if cred.connected? %>
              <span class="w-2.5 h-2.5 rounded-full bg-green-500"></span>
            <% else %>
              <span class="w-2.5 h-2.5 rounded-full bg-gray-300"></span>
            <% end %>
          </div>
        <% end %>
      </div>
    <% else %>
      <p class="text-gray-500 text-sm">No integrations configured. Set up connections to GitHub, AWS, or Google Workspace to start collecting evidence automatically.</p>
    <% end %>
  </div>

  <!-- Recent Checks -->
  <div class="bg-white rounded-xl shadow-sm border overflow-hidden">
    <div class="px-6 py-4 border-b border-gray-100">
      <h2 class="text-lg font-semibold text-gray-900">Recent Evidence Checks</h2>
    </div>
    <% if @checks.any? %>
      <table class="min-w-full divide-y divide-gray-200">
        <thead class="bg-gray-50">
          <tr>
            <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase">Check</th>
            <th class="px-6 py-3 text-center text-xs font-medium text-gray-500 uppercase">Provider</th>
            <th class="px-6 py-3 text-center text-xs font-medium text-gray-500 uppercase">Result</th>
            <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase">Last Run</th>
          </tr>
        </thead>
        <tbody class="divide-y divide-gray-200">
          <% @checks.each do |check| %>
            <tr class="hover:bg-gray-50">
              <td class="px-6 py-4">
                <div class="text-sm font-medium text-gray-900"><%= check.check_type.titleize %></div>
                <% if check.compliance_control %>
                  <div class="text-xs text-gray-500"><%= check.compliance_control.name.truncate(40) %></div>
                <% end %>
              </td>
              <td class="px-6 py-4 text-center">
                <i class="<%= check.provider_info[:icon] %>" style="color: <%= check.provider_info[:color] %>;"></i>
              </td>
              <td class="px-6 py-4 text-center">
                <% result_badges = { 'pass' => ['green', 'Pass'], 'fail' => ['red', 'Fail'], 'error_result' => ['gray', 'Error'] } %>
                <% badge = result_badges[check.last_result] || ['gray', 'Unknown'] %>
                <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-<%= badge[0] %>-100 text-<%= badge[0] %>-800"><%= badge[1] %></span>
              </td>
              <td class="px-6 py-4 text-sm text-gray-500"><%= check.last_run_at&.strftime("%b %d, %H:%M") || 'Never' %></td>
            </tr>
          <% end %>
        </tbody>
      </table>
    <% else %>
      <div class="text-center py-12">
        <i class="fas fa-robot text-gray-300 text-4xl mb-3"></i>
        <p class="text-gray-500">No evidence checks configured yet.</p>
      </div>
    <% end %>
  </div>
</div>
