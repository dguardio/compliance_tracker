<div class="container mx-auto px-4 py-8">
  <div class="mb-6"><%= link_to "← Back to Organization", organization_path(@organization), class: "text-blue-600 hover:text-blue-800 font-medium" %></div>

  <div class="flex justify-between items-center mb-6">
    <div>
      <h1 class="text-3xl font-bold text-gray-900">Incident Management</h1>
      <p class="mt-1 text-sm text-gray-500">Track and respond to security and compliance incidents</p>
    </div>
    <div><%= link_to "Report Incident", new_organization_incident_path(@organization), class: "inline-flex items-center px-4 py-2 border border-transparent text-sm font-medium rounded-md shadow-sm text-white bg-red-600 hover:bg-red-700" %></div>
  </div>

  <div class="grid grid-cols-2 md:grid-cols-4 gap-4 mb-8">
    <div class="bg-white shadow rounded-lg p-4"><dt class="text-xs font-medium text-gray-500">Total</dt><dd class="mt-1 text-2xl font-semibold text-gray-900"><%= @stats[:total] %></dd></div>
    <div class="bg-white shadow rounded-lg p-4"><dt class="text-xs font-medium text-gray-500">Active</dt><dd class="mt-1 text-2xl font-semibold text-orange-600"><%= @stats[:active] %></dd></div>
    <div class="bg-white shadow rounded-lg p-4"><dt class="text-xs font-medium text-gray-500">Critical</dt><dd class="mt-1 text-2xl font-semibold text-red-600"><%= @stats[:critical] %></dd></div>
    <div class="bg-white shadow rounded-lg p-4"><dt class="text-xs font-medium text-gray-500">High</dt><dd class="mt-1 text-2xl font-semibold text-orange-500"><%= @stats[:high] %></dd></div>
  </div>

  <div class="bg-white shadow rounded-lg p-4 mb-6">
    <%= form_tag organization_incidents_path(@organization), method: :get, class: "flex flex-wrap gap-3 items-end" do %>
      <div>
        <label class="block text-xs font-medium text-gray-700 mb-1">Status</label>
        <%= select_tag :status, options_for_select([["All", ""], ["Reported", "reported"], ["Investigating", "investigating"], ["Contained", "contained"], ["Resolved", "resolved"], ["Closed", "closed"]], params[:status]), class: "block w-full rounded-md border-gray-300 shadow-sm focus:ring-indigo-500 focus:border-indigo-500 text-sm" %>
      </div>
      <div>
        <label class="block text-xs font-medium text-gray-700 mb-1">Severity</label>
        <%= select_tag :severity, options_for_select([["All", ""], ["Critical", "critical"], ["High", "high"], ["Medium", "medium"], ["Low", "low"]], params[:severity]), class: "block w-full rounded-md border-gray-300 shadow-sm focus:ring-indigo-500 focus:border-indigo-500 text-sm" %>
      </div>
      <div>
        <label class="block text-xs font-medium text-gray-700 mb-1">Category</label>
        <%= select_tag :category, options_for_select([["All", ""]] + Incident.categories.keys.map { |k| [k.titleize, k] }, params[:category]), class: "block w-full rounded-md border-gray-300 shadow-sm focus:ring-indigo-500 focus:border-indigo-500 text-sm" %>
      </div>
      <div><%= submit_tag "Filter", class: "inline-flex items-center px-3 py-2 border border-gray-300 shadow-sm text-sm font-medium rounded-md text-gray-700 bg-white hover:bg-gray-50 cursor-pointer" %></div>
    <% end %>
  </div>

  <% if @incidents.any? %>
    <div class="overflow-x-auto shadow ring-1 ring-black ring-opacity-5 md:rounded-lg">
      <table class="min-w-full divide-y divide-gray-300">
        <thead class="bg-gray-50">
          <tr>
            <th class="px-4 py-3 text-left text-xs font-medium text-gray-500 uppercase">Incident</th>
            <th class="px-4 py-3 text-left text-xs font-medium text-gray-500 uppercase hidden sm:table-cell">Category</th>
            <th class="px-4 py-3 text-left text-xs font-medium text-gray-500 uppercase hidden md:table-cell">Severity</th>
            <th class="px-4 py-3 text-left text-xs font-medium text-gray-500 uppercase hidden md:table-cell">Status</th>
            <th class="px-4 py-3 text-left text-xs font-medium text-gray-500 uppercase hidden lg:table-cell">Reported</th>
            <th class="px-4 py-3 text-left text-xs font-medium text-gray-500 uppercase">Actions</th>
          </tr>
        </thead>
        <tbody class="bg-white divide-y divide-gray-200">
          <% @incidents.each do |incident| %>
            <tr>
              <td class="px-4 py-4">
                <div class="text-sm font-medium text-gray-900"><%= incident.title %></div>
                <div class="text-xs text-gray-500">By <%= incident.reported_by&.full_name || '—' %></div>
              </td>
              <td class="px-4 py-4 whitespace-nowrap hidden sm:table-cell">
                <span class="inline-flex items-center px-2 py-0.5 rounded-full text-xs font-medium bg-gray-100 text-gray-800"><%= incident.category.titleize %></span>
              </td>
              <td class="px-4 py-4 whitespace-nowrap hidden md:table-cell">
                <% sev_colors = { 'critical' => 'red', 'high' => 'orange', 'medium' => 'yellow', 'low' => 'green' } %>
                <span class="inline-flex items-center px-2 py-0.5 rounded-full text-xs font-medium bg-<%= sev_colors[incident.severity] || 'gray' %>-100 text-<%= sev_colors[incident.severity] || 'gray' %>-800"><%= incident.severity.titleize %></span>
              </td>
              <td class="px-4 py-4 whitespace-nowrap hidden md:table-cell">
                <% inc_colors = { 'reported' => 'blue', 'investigating' => 'yellow', 'contained' => 'purple', 'resolved' => 'green', 'closed' => 'gray' } %>
                <span class="inline-flex items-center px-2 py-0.5 rounded-full text-xs font-medium bg-<%= inc_colors[incident.status] || 'gray' %>-100 text-<%= inc_colors[incident.status] || 'gray' %>-800"><%= incident.status.titleize %></span>
              </td>
              <td class="px-4 py-4 whitespace-nowrap text-sm text-gray-500 hidden lg:table-cell"><%= incident.created_at.strftime("%b %d, %Y") %></td>
              <td class="px-4 py-4 whitespace-nowrap text-sm font-medium">
                <%= link_to "View", organization_incident_path(@organization, incident), class: "text-indigo-600 hover:text-indigo-900" %>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  <% else %>
    <div class="text-center py-12 bg-white rounded-lg shadow">
      <h3 class="text-lg font-medium text-gray-900">No incidents</h3>
      <p class="mt-1 text-sm text-gray-500">No incidents have been reported.</p>
    </div>
  <% end %>
</div>
