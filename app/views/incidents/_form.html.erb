<%= form_with model: @incident, url: @incident.persisted? ? organization_incident_path(@organization, @incident) : organization_incidents_path(@organization), class: "space-y-6" do |f| %>
  <% if @incident.errors.any? %>
    <div class="bg-red-50 border-l-4 border-red-400 p-4 rounded">
      <ul class="text-sm text-red-700 list-disc list-inside"><% @incident.errors.full_messages.each do |msg| %><li><%= msg %></li><% end %></ul>
    </div>
  <% end %>

  <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
    <div class="md:col-span-2">
      <%= f.label :title, class: "block text-sm font-medium text-gray-700" %>
      <%= f.text_field :title, class: "mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:ring-indigo-500 focus:border-indigo-500 sm:text-sm", required: true %>
    </div>
    <div class="md:col-span-2">
      <%= f.label :description, class: "block text-sm font-medium text-gray-700" %>
      <%= f.text_area :description, rows: 4, class: "mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:ring-indigo-500 focus:border-indigo-500 sm:text-sm" %>
    </div>
    <div>
      <%= f.label :category, class: "block text-sm font-medium text-gray-700" %>
      <%= f.select :category, Incident.categories.keys.map { |k| [k.titleize, k] }, {}, class: "mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:ring-indigo-500 focus:border-indigo-500 sm:text-sm" %>
    </div>
    <div>
      <%= f.label :severity, class: "block text-sm font-medium text-gray-700" %>
      <%= f.select :severity, Incident.severities.keys.map { |k| [k.titleize, k] }, {}, class: "mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:ring-indigo-500 focus:border-indigo-500 sm:text-sm" %>
    </div>
    <div>
      <%= f.label :status, class: "block text-sm font-medium text-gray-700" %>
      <%= f.select :status, Incident.statuses.keys.map { |k| [k.titleize, k] }, {}, class: "mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:ring-indigo-500 focus:border-indigo-500 sm:text-sm" %>
    </div>
    <div>
      <%= f.label :assigned_to_id, "Assign To", class: "block text-sm font-medium text-gray-700" %>
      <%= f.select :assigned_to_id, @organization.users.sort_by { |u| u.first_name.to_s }.map { |u| [u.full_name, u.id] }, { include_blank: "Unassigned" }, class: "mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:ring-indigo-500 focus:border-indigo-500 sm:text-sm" %>
    </div>
    <div>
      <%= f.label :occurred_at, class: "block text-sm font-medium text-gray-700" %>
      <%= f.datetime_field :occurred_at, class: "mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:ring-indigo-500 focus:border-indigo-500 sm:text-sm" %>
    </div>
    <div>
      <%= f.label :detected_at, class: "block text-sm font-medium text-gray-700" %>
      <%= f.datetime_field :detected_at, class: "mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:ring-indigo-500 focus:border-indigo-500 sm:text-sm" %>
    </div>
    <div class="md:col-span-2">
      <%= f.label :impact_description, "Impact Description", class: "block text-sm font-medium text-gray-700" %>
      <%= f.text_area :impact_description, rows: 2, class: "mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:ring-indigo-500 focus:border-indigo-500 sm:text-sm" %>
    </div>
  </div>

  <div class="flex justify-end space-x-3 pt-4 border-t">
    <%= link_to "Cancel", @incident.persisted? ? organization_incident_path(@organization, @incident) : organization_incidents_path(@organization), class: "inline-flex items-center px-4 py-2 border border-gray-300 text-sm font-medium rounded-md text-gray-700 bg-white hover:bg-gray-50" %>
    <%= f.submit @incident.persisted? ? "Update Incident" : "Report Incident", class: "inline-flex items-center px-4 py-2 border border-transparent text-sm font-medium rounded-md text-white bg-red-600 hover:bg-red-700 cursor-pointer" %>
  </div>
<% end %>
