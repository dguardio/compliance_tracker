<div class="container mx-auto px-4 py-8">
  <div class="mb-6"><%= link_to "← Back to Incidents", organization_incidents_path(@organization), class: "text-blue-600 hover:text-blue-800 font-medium" %></div>

  <div class="bg-white shadow rounded-lg p-6 mb-6">
    <div class="flex justify-between items-start">
      <div>
        <h1 class="text-2xl font-bold text-gray-900"><%= @incident.title %></h1>
        <div class="flex space-x-2 mt-2">
          <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-gray-100 text-gray-800"><%= @incident.category.titleize %></span>
          <% sev_colors = { 'critical' => 'red', 'high' => 'orange', 'medium' => 'yellow', 'low' => 'green' } %>
          <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-<%= sev_colors[@incident.severity] || 'gray' %>-100 text-<%= sev_colors[@incident.severity] || 'gray' %>-800"><%= @incident.severity.titleize %></span>
          <% inc_colors = { 'reported' => 'blue', 'investigating' => 'yellow', 'contained' => 'purple', 'resolved' => 'green', 'closed' => 'gray' } %>
          <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-<%= inc_colors[@incident.status] || 'gray' %>-100 text-<%= inc_colors[@incident.status] || 'gray' %>-800"><%= @incident.status.titleize %></span>
        </div>
        <% if @incident.description.present? %><p class="mt-3 text-gray-600"><%= @incident.description %></p><% end %>
      </div>
      <div class="flex space-x-2">
        <%= link_to "Edit", edit_organization_incident_path(@organization, @incident), class: "inline-flex items-center px-3 py-2 border border-gray-300 text-sm font-medium rounded-md text-gray-700 bg-white hover:bg-gray-50" %>
        <% if @incident.active? %>
          <%= button_to "Resolve", resolve_organization_incident_path(@organization, @incident), method: :patch, class: "inline-flex items-center px-3 py-2 border border-transparent text-sm font-medium rounded-md text-white bg-green-600 hover:bg-green-700" %>
        <% elsif @incident.status_resolved? %>
          <%= button_to "Close", close_organization_incident_path(@organization, @incident), method: :patch, class: "inline-flex items-center px-3 py-2 border border-gray-300 text-sm font-medium rounded-md text-gray-700 bg-white hover:bg-gray-50" %>
        <% end %>
      </div>
    </div>
  </div>

  <div class="grid grid-cols-1 lg:grid-cols-3 gap-6">
    <div class="lg:col-span-2 space-y-6">
      <!-- Details -->
      <div class="bg-white shadow rounded-lg p-6">
        <h2 class="text-lg font-semibold text-gray-900 mb-4">Details</h2>
        <dl class="grid grid-cols-1 sm:grid-cols-2 gap-4">
          <div><dt class="text-sm font-medium text-gray-500">Occurred At</dt><dd class="mt-1 text-sm text-gray-900"><%= @incident.occurred_at&.strftime("%B %d, %Y %I:%M %p") || '—' %></dd></div>
          <div><dt class="text-sm font-medium text-gray-500">Detected At</dt><dd class="mt-1 text-sm text-gray-900"><%= @incident.detected_at&.strftime("%B %d, %Y %I:%M %p") || '—' %></dd></div>
          <% if @incident.resolved_at %><div><dt class="text-sm font-medium text-gray-500">Resolved At</dt><dd class="mt-1 text-sm text-gray-900"><%= @incident.resolved_at.strftime("%B %d, %Y %I:%M %p") %></dd></div><% end %>
          <% if @incident.duration %><div><dt class="text-sm font-medium text-gray-500">Duration</dt><dd class="mt-1 text-sm text-gray-900"><%= @incident.duration %> hours</dd></div><% end %>
          <% if @incident.impact_description.present? %><div class="sm:col-span-2"><dt class="text-sm font-medium text-gray-500">Impact</dt><dd class="mt-1 text-sm text-gray-900"><%= @incident.impact_description %></dd></div><% end %>
          <% if @incident.root_cause.present? %><div class="sm:col-span-2"><dt class="text-sm font-medium text-gray-500">Root Cause</dt><dd class="mt-1 text-sm text-gray-900"><%= @incident.root_cause %></dd></div><% end %>
        </dl>
      </div>

      <!-- Lessons Learned -->
      <div class="bg-white shadow rounded-lg p-6">
        <h2 class="text-lg font-semibold text-gray-900 mb-4">Lessons Learned (<%= @lessons.count %>)</h2>
        <% if @lessons.any? %>
          <div class="space-y-3">
            <% @lessons.each do |lesson| %>
              <div class="border rounded-lg p-4">
                <div class="flex items-center space-x-2">
                  <h3 class="text-sm font-medium text-gray-900"><%= lesson.title %></h3>
                  <span class="inline-flex items-center px-2 py-0.5 rounded-full text-xs font-medium bg-blue-100 text-blue-800"><%= lesson.category.titleize %></span>
                </div>
                <% if lesson.description.present? %><p class="text-sm text-gray-600 mt-1"><%= lesson.description %></p><% end %>
                <% if lesson.recommendations.present? %>
                  <div class="mt-2 bg-gray-50 rounded p-2"><p class="text-xs text-gray-700"><strong>Recommendations:</strong> <%= lesson.recommendations %></p></div>
                <% end %>
                <p class="text-xs text-gray-400 mt-1"><%= lesson.created_by&.full_name %> · <%= lesson.created_at.strftime("%b %d, %Y") %></p>
              </div>
            <% end %>
          </div>
        <% else %>
          <p class="text-sm text-gray-500 text-center py-4">No lessons learned yet.</p>
        <% end %>

        <!-- Add Lesson Form -->
        <div class="mt-6 border-t pt-6">
          <h3 class="text-sm font-semibold text-gray-900 mb-3">Add Lesson Learned</h3>
          <%= form_with model: @new_lesson, url: organization_incident_lesson_learneds_path(@organization, @incident), class: "space-y-4" do |f| %>
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
              <div class="sm:col-span-2">
                <%= f.label :title, class: "block text-sm font-medium text-gray-700" %>
                <%= f.text_field :title, class: "mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:ring-indigo-500 focus:border-indigo-500 text-sm", required: true %>
              </div>
              <div class="sm:col-span-2">
                <%= f.label :description, class: "block text-sm font-medium text-gray-700" %>
                <%= f.text_area :description, rows: 2, class: "mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:ring-indigo-500 focus:border-indigo-500 text-sm" %>
              </div>
              <div>
                <%= f.label :category, class: "block text-sm font-medium text-gray-700" %>
                <%= f.select :category, LessonLearned.categories.keys.map { |k| [k.titleize, k] }, {}, class: "mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:ring-indigo-500 focus:border-indigo-500 text-sm" %>
              </div>
              <div>
                <%= f.label :recommendations, class: "block text-sm font-medium text-gray-700" %>
                <%= f.text_field :recommendations, class: "mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:ring-indigo-500 focus:border-indigo-500 text-sm" %>
              </div>
            </div>
            <div><%= f.submit "Add Lesson", class: "inline-flex items-center px-4 py-2 border border-transparent text-sm font-medium rounded-md text-white bg-indigo-600 hover:bg-indigo-700 cursor-pointer" %></div>
          <% end %>
        </div>
      </div>
    </div>

    <!-- Sidebar -->
    <div class="space-y-6">
      <div class="bg-white shadow rounded-lg p-6">
        <h3 class="text-sm font-semibold text-gray-900 mb-3">People</h3>
        <dl class="space-y-3">
          <div><dt class="text-xs text-gray-500">Reported By</dt><dd class="text-sm text-gray-900"><%= @incident.reported_by&.full_name || '—' %></dd></div>
          <div><dt class="text-xs text-gray-500">Assigned To</dt><dd class="text-sm text-gray-900"><%= @incident.assigned_to&.full_name || 'Unassigned' %></dd></div>
        </dl>
      </div>

      <div class="bg-white shadow rounded-lg p-6">
        <h3 class="text-sm font-semibold text-gray-900 mb-3">Timeline</h3>
        <dl class="space-y-2 text-sm">
          <div class="flex justify-between"><span class="text-gray-500">Reported</span><span class="text-gray-900"><%= @incident.created_at.strftime("%b %d, %Y") %></span></div>
          <% if @incident.occurred_at %><div class="flex justify-between"><span class="text-gray-500">Occurred</span><span class="text-gray-900"><%= @incident.occurred_at.strftime("%b %d, %Y") %></span></div><% end %>
          <% if @incident.detected_at %><div class="flex justify-between"><span class="text-gray-500">Detected</span><span class="text-gray-900"><%= @incident.detected_at.strftime("%b %d, %Y") %></span></div><% end %>
          <% if @incident.resolved_at %><div class="flex justify-between"><span class="text-gray-500">Resolved</span><span class="text-green-600 font-medium"><%= @incident.resolved_at.strftime("%b %d, %Y") %></span></div><% end %>
        </dl>
      </div>
    </div>
  </div>
</div>
