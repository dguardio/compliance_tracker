<% content_for :title, "Roles - #{current_user.organization.name}" %>

<div class="container mx-auto px-4 py-8">
  <!-- Header Section -->
  <div class="flex flex-col md:flex-row justify-between items-start md:items-center mb-8 gap-4">
    <div>
      <h1 class="text-3xl font-bold text-gray-900 tracking-tight">Role Definitions</h1>
      <p class="mt-1 text-gray-500">Define responsibilities and access levels for your organization.</p>
    </div>
    <div class="flex gap-3">
        <%= render Joyful::ButtonComponent.new(
            text: "Manage Permissions",
            path: organization_permissions_path(current_user.organization),
            variant: :secondary,
            icon: "key"
          ) %>
        <%= render Joyful::ButtonComponent.new(
            text: "New Role",
            path: new_organization_role_path(current_user.organization),
            variant: :primary,
            icon: "plus"
          ) %>
    </div>
  </div>

  <!-- Search & Filter Bar -->
  <div class="bg-white rounded-xl shadow-sm border border-gray-100 p-4 mb-8">
    <%= form_with url: organization_roles_path(current_user.organization), method: :get, local: true, class: "flex flex-col gap-4" do |f| %>
      <div class="flex flex-col md:flex-row gap-4 items-end">
        <div class="flex-grow w-full">
            <%= f.label :search, "Search Roles", class: "text-xs font-semibold text-gray-500 uppercase tracking-wider mb-1 block" %>
            <div class="relative">
                <div class="absolute inset-y-0 left-0 pl-3 flex items-center pointer-events-none">
                    <svg class="h-5 w-5 text-gray-400" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor">
                        <path fill-rule="evenodd" d="M8 4a4 4 0 100 8 4 4 0 000-8zM2 8a6 6 0 1110.89 3.476l4.817 4.817a1 1 0 01-1.414 1.414l-4.816-4.816A6 6 0 012 8z" clip-rule="evenodd" />
                    </svg>
                </div>
                <%= f.text_field :search, value: params[:search], 
                                class: "block w-full pl-10 pr-3 py-2 border border-gray-200 rounded-lg leading-5 bg-gray-50 placeholder-gray-400 focus:outline-none focus:bg-white focus:ring-2 focus:ring-primary-500 focus:border-primary-500 sm:text-sm transition-all duration-200", 
                                placeholder: "e.g. Administrator, Auditor..." %>
            </div>
        </div>
        
        <div class="w-full md:w-64">
            <%= f.label :resource_type, "Resource Type", class: "text-xs font-semibold text-gray-500 uppercase tracking-wider mb-1 block" %>
            <%= f.select :resource_type, options_for_select([["All Resources", ""]] + @resource_types.map { |rt| [rt, rt] }, params[:resource_type]), 
                    {}, class: "block w-full px-3 py-2 border border-gray-200 rounded-lg bg-gray-50 focus:outline-none focus:ring-primary-500 focus:border-primary-500 sm:text-sm" %>
        </div>
        
        <div class="flex gap-2">
             <%= render Joyful::ButtonComponent.new(
                text: "Filter",
                variant: :secondary,
                form: f
            ) %>
        </div>
      </div>
    <% end %>
  </div>

  <!-- Roles Grid -->
  <% if @roles.any? %>
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
      <% @roles.each do |role| %>
        <%= render Joyful::CardComponent.new(class: "h-full flex flex-col group hover:-translate-y-1 transition-all duration-300") do |card| %>
            <div class="flex-grow">
                <div class="flex justify-between items-start mb-4">
                     <h3 class="text-xl font-bold text-gray-900 group-hover:text-primary-600 transition-colors">
                        <%= link_to role.display_name, organization_role_path(current_user.organization, role) %>
                     </h3>
                     <div class="bg-gray-100 rounded-lg px-2 py-1 text-xs font-bold text-gray-600 uppercase tracking-wider">
                        <%= role.resource_type || "GLOBAL" %>
                     </div>
                </div>

                <div class="mb-6 space-y-2">
                    <div class="flex justify-between items-center text-sm">
                        <span class="text-gray-500">Resource Context</span>
                        <span class="font-medium text-gray-900 truncate max-w-[150px]">
                            <%= role.resource&.name || "All Resources" %>
                        </span>
                    </div>
                </div>

                <div class="bg-primary-50 rounded-lg p-3 text-center border border-primary-100">
                    <span class="block text-2xl font-bold text-primary-700 tabular-nums"><%= role.users.count %></span>
                    <span class="text-xs text-primary-600 font-medium uppercase tracking-wide">Assigned Users</span>
                </div>
            </div>

            <% card.footer do %>
                <div class="flex justify-between items-center w-full mt-4">
                     <%= link_to organization_role_path(current_user.organization, role), class: "text-gray-500 hover:text-primary-600 text-sm font-medium transition-colors" do %>
                        View Details
                     <% end %>
                     
                     <div class="flex space-x-2">
                        <%= link_to edit_organization_role_path(current_user.organization, role), class: "text-gray-400 hover:text-blue-600 transition-colors" do %>
                            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z"></path></svg>
                        <% end %>
                        <%= link_to organization_role_path(current_user.organization, role), method: :delete, data: { confirm: "Delete this role?" }, class: "text-gray-400 hover:text-red-600 transition-colors" do %>
                            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"></path></svg>
                        <% end %>
                     </div>
                </div>
            <% end %>
        <% end %>
      <% end %>
    </div>

    <!-- Pagination -->
    <div class="mt-8 flex justify-center">
      <%= paginate @roles, theme: 'tailwind' %>
    </div>
  <% else %>
    <div class="text-center py-20 bg-white rounded-xl shadow-sm border border-dashed border-gray-300">
      <div class="mx-auto h-24 w-24 bg-indigo-50 rounded-full flex items-center justify-center mb-6 animate-float">
        <svg class="h-12 w-12 text-indigo-500" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6v6m0 0v6m0-6h6m-6 0H6" />
        </svg>
      </div>
      <h3 class="text-xl font-bold text-gray-900 mb-2">No Roles Found</h3>
      <p class="text-gray-500 mb-8 max-w-sm mx-auto">Define roles to structure permissions for your organization.</p>
      <%= render Joyful::ButtonComponent.new(
          text: "Create Role",
          path: new_organization_role_path(current_user.organization),
          variant: :primary,
          icon: "plus"
      ) %>
    </div>
  <% end %>
</div>
