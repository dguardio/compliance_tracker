<% content_for :title, "Roles - #{current_user.organization.name}" %>

<div class="min-h-screen bg-gray-50">
  <!-- Header -->
  <div class="bg-white shadow">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="flex justify-between items-center py-6">
        <div>
          <h1 class="text-3xl font-bold text-gray-900">Roles</h1>
          <p class="mt-1 text-sm text-gray-500">
            Manage roles and permissions for <%= current_user.organization.name %>
          </p>
        </div>
        <div class="flex space-x-3">
          <%= link_to new_organization_role_path(current_user.organization), 
                      class: "inline-flex items-center px-4 py-2 border border-transparent text-sm font-medium rounded-md shadow-sm text-white bg-indigo-600 hover:bg-indigo-700 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-indigo-500" do %>
            <svg class="-ml-1 mr-2 h-5 w-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6v6m0 0v6m0-6h6m-6 0H6"/>
            </svg>
            New Role
          <% end %>
        </div>
      </div>
    </div>
  </div>

  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
    <!-- Filters and Search -->
    <div class="bg-white rounded-lg shadow mb-6">
      <div class="px-6 py-4 border-b border-gray-200">
        <h3 class="text-lg font-medium text-gray-900">Filters</h3>
      </div>
      <div class="px-6 py-4">
        <%= form_with url: organization_roles_path(current_user.organization), method: :get, local: true, class: "space-y-4" do |f| %>
          <div class="grid grid-cols-1 md:grid-cols-4 gap-4">
            <!-- Search -->
            <div>
              <%= f.label :search, "Search", class: "block text-sm font-medium text-gray-700 mb-1" %>
              <%= f.text_field :search, value: params[:search], 
                              placeholder: "Search roles...",
                              class: "block w-full rounded-md border-gray-300 shadow-sm focus:border-indigo-500 focus:ring-indigo-500 sm:text-sm" %>
            </div>

            <!-- Resource Type Filter -->
            <div>
              <%= f.label :resource_type, "Resource Type", class: "block text-sm font-medium text-gray-700 mb-1" %>
              <%= f.select :resource_type, options_for_select([["All", ""]] + @resource_types.map { |rt| [rt, rt] }, params[:resource_type]), 
                          {}, class: "block w-full rounded-md border-gray-300 shadow-sm focus:border-indigo-500 focus:ring-indigo-500 sm:text-sm" %>
            </div>

            <!-- Name Filter -->
            <div>
              <%= f.label :name, "Role Name", class: "block text-sm font-medium text-gray-700 mb-1" %>
              <%= f.text_field :name, value: params[:name], 
                              placeholder: "Filter by name...",
                              class: "block w-full rounded-md border-gray-300 shadow-sm focus:border-indigo-500 focus:ring-indigo-500 sm:text-sm" %>
            </div>

            <!-- Filter Button -->
            <div class="flex items-end">
              <%= f.submit "Filter", class: "w-full bg-indigo-600 text-white px-4 py-2 rounded-md hover:bg-indigo-700 focus:outline-none focus:ring-2 focus:ring-indigo-500" %>
            </div>
          </div>
        <% end %>
      </div>
    </div>

    <!-- Results Count -->
    <div class="mb-4">
      <div class="text-sm text-gray-500">
        <% if @roles.respond_to?(:total_count) %>
          <%= pluralize(@roles.total_count, 'role') %> found
        <% else %>
          <%= pluralize(@roles.count, 'role') %> found
        <% end %>
      </div>
    </div>

    <!-- Roles List -->
    <div class="bg-white shadow overflow-hidden sm:rounded-md">
      <ul class="divide-y divide-gray-200">
        <% @roles.each do |role| %>
          <li>
            <div class="px-6 py-4 flex items-center justify-between hover:bg-gray-50">
              <div class="flex-1 min-w-0">
                <div class="flex items-center justify-between">
                  <div>
                    <h3 class="text-lg font-medium text-gray-900">
                      <%= link_to role.name, organization_role_path(current_user.organization, role), 
                                  class: "hover:text-indigo-600" %>
                    </h3>
                    <div class="mt-1 flex items-center space-x-4 text-sm text-gray-500">
                      <span>
                        <span class="font-medium">Resource:</span> 
                        <%= role.resource_type %>
                        <% if role.resource %>
                          - <%= role.resource.name %>
                        <% else %>
                          (All)
                        <% end %>
                      </span>
                      <span>
                        <span class="font-medium">Users:</span> 
                        <%= role.users.count %>
                      </span>
                    </div>
                  </div>
                  <div class="flex items-center space-x-2">
                    <%= link_to "View", organization_role_path(current_user.organization, role), 
                                class: "text-indigo-600 hover:text-indigo-900 text-sm font-medium" %>
                    <%= link_to "Edit", edit_organization_role_path(current_user.organization, role), 
                                class: "text-gray-600 hover:text-gray-900 text-sm font-medium" %>
                    <%= link_to "Delete", organization_role_path(current_user.organization, role), 
                                method: :delete,
                                data: { confirm: "Are you sure you want to delete this role?" },
                                class: "text-red-600 hover:text-red-900 text-sm font-medium" %>
                  </div>
                </div>
              </div>
            </div>
          </li>
        <% end %>
      </ul>

      <% if @roles.empty? %>
        <div class="text-center py-12">
          <svg class="mx-auto h-12 w-12 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0zm6 3a2 2 0 11-4 0 2 2 0 014 0zM7 10a2 2 0 11-4 0 2 2 0 014 0z"/>
          </svg>
          <h3 class="mt-2 text-sm font-medium text-gray-900">No roles found</h3>
          <p class="mt-1 text-sm text-gray-500">
            Get started by creating a new role.
          </p>
          <div class="mt-6">
            <%= link_to new_organization_role_path(current_user.organization), 
                        class: "inline-flex items-center px-4 py-2 border border-transparent shadow-sm text-sm font-medium rounded-md text-white bg-indigo-600 hover:bg-indigo-700 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-indigo-500" do %>
              <svg class="-ml-1 mr-2 h-5 w-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6v6m0 0v6m0-6h6m-6 0H6"/>
              </svg>
              New Role
            <% end %>
          </div>
        </div>
      <% end %>
    </div>

    <!-- Pagination -->
    <div class="bg-white px-4 py-3 flex items-center justify-between border-t border-gray-200 sm:px-6">
      <%= paginate @roles %>
    </div>
  </div>
</div>
