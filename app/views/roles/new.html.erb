<% content_for :title, "New Role - #{current_user.organization.name}" %>

<div class="min-h-screen bg-gray-50">
  <!-- Header -->
  <div class="bg-white shadow">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="flex justify-between items-center py-6">
        <div>
          <nav class="flex" aria-label="Breadcrumb">
            <ol class="flex items-center space-x-4">
              <li>
                <%= link_to organization_roles_path(current_user.organization), 
                            class: "text-gray-400 hover:text-gray-500" do %>
                  <i class="fas fa-arrow-left"></i>
                <% end %>
              </li>
              <li>
                <%= link_to "Roles", organization_roles_path(current_user.organization), 
                            class: "text-gray-500 hover:text-gray-700 font-medium" %>
              </li>
              <li><span class="text-gray-400">/</span></li>
              <li><span class="text-gray-900 font-medium">New Role</span></li>
            </ol>
          </nav>
          <h1 class="mt-2 text-3xl font-bold text-gray-900">Create New Role</h1>
          <p class="mt-1 text-sm text-gray-500">
            Define a new role for <%= current_user.organization.name %>
          </p>
        </div>
      </div>
    </div>
  </div>

  <div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
    <%= form_with model: [current_user.organization, @role], local: true do |f| %>
      <% if @role.errors.any? %>
        <%= render Joyful::CardComponent.new(padding: true) do %>
          <div class="space-y-2">
            <h2 class="text-lg font-bold text-red-700 flex items-center gap-2">
              <i class="fas fa-exclamation-circle"></i>
              <%= pluralize(@role.errors.count, "error") %> prohibited this role from being saved:
            </h2>
            <ul class="list-disc pl-5 text-red-600">
              <% @role.errors.full_messages.each do |message| %>
                <li><%= message %></li>
              <% end %>
            </ul>
          </div>
        <% end %>
      <% end %>

      <%= render Joyful::CardComponent.new(title: "Role Information", icon: "shield-alt", padding: true) do %>
        <div class="space-y-6">
          <%= render Joyful::InputComponent.new(
                form: f, 
                method: :name, 
                label: "Role Name", 
                placeholder: "e.g., Department Manager, Team Lead, Compliance Officer",
                hint: "Choose a descriptive name for this role."
              ) %>

          <%= render Joyful::InputComponent.new(
                form: f, 
                method: :resource_type, 
                label: "Resource Type", 
                type: :select,
                choices: @resource_types.map { |rt| [rt, rt] },
                options: { prompt: "Select a resource type..." },
                html_options: { 
                  class: "w-full rounded-xl border-gray-300 shadow-sm focus:border-primary-500 focus:ring-primary-500",
                  data: { controller: "role-form" } # Keep existing controller data attribute if any, or just for targeting
                },
                hint: "The type of resource this role applies to."
              ) %>
              
          <!-- Manual JS-controlled section for Resource Selection -->
          <div id="resource-selection" class="hidden space-y-1">
            <%= f.label :resource_id, "Specific Resource", class: "block text-sm font-medium leading-6 text-gray-900" %>
            <div id="resource-options" class="mt-1">
              <!-- Options will be loaded via AJAX -->
            </div>
            <p class="mt-1 text-sm text-gray-500">Leave blank to apply to all resources of this type</p>
          </div>
        </div>

        <div class="flex justify-end gap-3 pt-6 border-t border-gray-100 mt-6">
          <%= link_to "Cancel", organization_roles_path(current_user.organization), 
                      class: "inline-flex items-center px-4 py-2 border border-gray-300 shadow-sm text-sm font-medium rounded-xl text-gray-700 bg-white hover:bg-gray-50 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-primary-500 transition-all" %>
          
          <%= render Joyful::ButtonComponent.new(
                text: "Create Role",
                type: :submit,
                variant: :primary,
                icon: "plus"
              ) %>
        </div>
      <% end %>
    <% end %>
  </div>
</div>

<script>
document.addEventListener('DOMContentLoaded', function() {
  const resourceTypeSelect = document.querySelector('select[name="role[resource_type]"]');
  const resourceSelection = document.getElementById('resource-selection');
  const resourceOptions = document.getElementById('resource-options');

  if (resourceTypeSelect) {
    resourceTypeSelect.addEventListener('change', function() {
      const resourceType = this.value;
      
      if (resourceType) {
        // Show resource selection
        resourceSelection.classList.remove('hidden');
        
        // Load resources via AJAX
        fetch(`/organizations/<%= current_user.organization.id %>/roles/get_resources?resource_type=${resourceType}`)
          .then(response => response.json())
          .then(data => {
            resourceOptions.innerHTML = '';
            
            if (data.length > 0) {
              const select = document.createElement('select');
              select.name = 'role[resource_id]';
              select.className = 'block w-full rounded-xl border-gray-300 shadow-sm focus:border-indigo-500 focus:ring-indigo-500 sm:text-sm'; // Updated classes
              
              // Add blank option
              const blankOption = document.createElement('option');
              blankOption.value = '';
              blankOption.textContent = 'All resources of this type';
              select.appendChild(blankOption);
              
              // Add resource options
              data.forEach(resource => {
                const option = document.createElement('option');
                option.value = resource.id;
                option.textContent = resource.name;
                select.appendChild(option);
              });
              
              resourceOptions.appendChild(select);
            }
          })
          .catch(error => {
            console.error('Error loading resources:', error);
            resourceOptions.innerHTML = '<p class="text-sm text-red-600">Error loading resources</p>';
          });
      } else {
        resourceSelection.classList.add('hidden');
      }
    });
  }
});
</script>
