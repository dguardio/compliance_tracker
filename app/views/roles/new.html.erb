<% content_for :title, "New Role - #{current_user.organization.name}" %>

<div class="min-h-screen bg-gray-50">
  <!-- Header -->
  <div class="bg-white shadow">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="flex justify-between items-center py-6">
        <div>
          <nav class="flex" aria-label="Breadcrumb">
            <ol class="flex items-center space-x-4">
              <li>
                <%= link_to organization_roles_path(current_user.organization), 
                            class: "text-gray-400 hover:text-gray-500" do %>
                  <svg class="flex-shrink-0 h-5 w-5" fill="currentColor" viewBox="0 0 20 20">
                    <path fill-rule="evenodd" d="M7.707 14.707a1 1 0 01-1.414 0l-4-4a1 1 0 010-1.414l4-4a1 1 0 011.414 1.414L5.414 9H17a1 1 0 110 2H5.414l2.293 2.293a1 1 0 010 1.414z" clip-rule="evenodd"/>
                  </svg>
                <% end %>
              </li>
              <li>
                <%= link_to "Roles", organization_roles_path(current_user.organization), 
                            class: "text-gray-500 hover:text-gray-700" %>
              </li>
              <li>
                <span class="text-gray-400">/</span>
              </li>
              <li>
                <span class="text-gray-900 font-medium">New Role</span>
              </li>
            </ol>
          </nav>
          <h1 class="mt-2 text-3xl font-bold text-gray-900">Create New Role</h1>
          <p class="mt-1 text-sm text-gray-500">
            Define a new role for <%= current_user.organization.name %>
          </p>
        </div>
      </div>
    </div>
  </div>

  <div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
    <div class="bg-white shadow rounded-lg">
      <div class="px-6 py-4 border-b border-gray-200">
        <h3 class="text-lg font-medium text-gray-900">Role Information</h3>
      </div>
      
      <%= form_with model: [current_user.organization, @role], local: true, class: "px-6 py-4" do |f| %>
        <% if @role.errors.any? %>
          <div class="mb-6 bg-red-50 border border-red-200 rounded-md p-4">
            <div class="flex">
              <div class="flex-shrink-0">
                <svg class="h-5 w-5 text-red-400" fill="currentColor" viewBox="0 0 20 20">
                  <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zM8.707 7.293a1 1 0 00-1.414 1.414L8.586 10l-1.293 1.293a1 1 0 101.414 1.414L10 11.414l1.293 1.293a1 1 0 001.414-1.414L11.414 10l1.293-1.293a1 1 0 00-1.414-1.414L10 8.586 8.707 7.293z" clip-rule="evenodd"/>
                </svg>
              </div>
              <div class="ml-3">
                <h3 class="text-sm font-medium text-red-800">
                  <%= pluralize(@role.errors.count, "error") %> prohibited this role from being saved:
                </h3>
                <div class="mt-2 text-sm text-red-700">
                  <ul class="list-disc pl-5 space-y-1">
                    <% @role.errors.full_messages.each do |message| %>
                      <li><%= message %></li>
                    <% end %>
                  </ul>
                </div>
              </div>
            </div>
          </div>
        <% end %>

        <div class="space-y-6">
          <!-- Role Name -->
          <div>
            <%= f.label :name, "Role Name", class: "block text-sm font-medium text-gray-700" %>
            <%= f.text_field :name, 
                            placeholder: "e.g., Department Manager, Team Lead, Compliance Officer",
                            class: "mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:border-indigo-500 focus:ring-indigo-500 sm:text-sm" %>
            <p class="mt-1 text-sm text-gray-500">
              Choose a descriptive name for this role
            </p>
          </div>

          <!-- Resource Type -->
          <div>
            <%= f.label :resource_type, "Resource Type", class: "block text-sm font-medium text-gray-700" %>
            <%= f.select :resource_type, 
                        options_for_select(@resource_types.map { |rt| [rt, rt] }, @role.resource_type),
                        { prompt: "Select a resource type..." },
                        { class: "mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:border-indigo-500 focus:ring-indigo-500 sm:text-sm",
                          data: { controller: "role-form" } } %>
            <p class="mt-1 text-sm text-gray-500">
              The type of resource this role applies to
            </p>
          </div>

          <!-- Resource Selection -->
          <div id="resource-selection" class="hidden">
            <%= f.label :resource_id, "Specific Resource", class: "block text-sm font-medium text-gray-700" %>
            <div id="resource-options" class="mt-1">
              <!-- Options will be loaded via AJAX -->
            </div>
            <p class="mt-1 text-sm text-gray-500">
              Leave blank to apply to all resources of this type
            </p>
          </div>

          <div class="flex justify-end space-x-3 pt-6 border-t border-gray-200">
            <%= link_to "Cancel", organization_roles_path(current_user.organization), 
                        class: "inline-flex items-center px-4 py-2 border border-gray-300 shadow-sm text-sm font-medium rounded-md text-gray-700 bg-white hover:bg-gray-50 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-indigo-500" %>
            <%= f.submit "Create Role", 
                        class: "inline-flex items-center px-4 py-2 border border-transparent text-sm font-medium rounded-md shadow-sm text-white bg-indigo-600 hover:bg-indigo-700 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-indigo-500" %>
          </div>
        </div>
      <% end %>
    </div>
  </div>
</div>

<script>
document.addEventListener('DOMContentLoaded', function() {
  const resourceTypeSelect = document.querySelector('select[name="role[resource_type]"]');
  const resourceSelection = document.getElementById('resource-selection');
  const resourceOptions = document.getElementById('resource-options');

  resourceTypeSelect.addEventListener('change', function() {
    const resourceType = this.value;
    
    if (resourceType) {
      // Show resource selection
      resourceSelection.classList.remove('hidden');
      
      // Load resources via AJAX
      fetch(`/organizations/<%= current_user.organization.id %>/roles/get_resources?resource_type=${resourceType}`)
        .then(response => response.json())
        .then(data => {
          resourceOptions.innerHTML = '';
          
          if (data.length > 0) {
            const select = document.createElement('select');
            select.name = 'role[resource_id]';
            select.className = 'block w-full rounded-md border-gray-300 shadow-sm focus:border-indigo-500 focus:ring-indigo-500 sm:text-sm';
            
            // Add blank option
            const blankOption = document.createElement('option');
            blankOption.value = '';
            blankOption.textContent = 'All resources of this type';
            select.appendChild(blankOption);
            
            // Add resource options
            data.forEach(resource => {
              const option = document.createElement('option');
              option.value = resource.id;
              option.textContent = resource.name;
              select.appendChild(option);
            });
            
            resourceOptions.appendChild(select);
          }
        })
        .catch(error => {
          console.error('Error loading resources:', error);
          resourceOptions.innerHTML = '<p class="text-sm text-red-600">Error loading resources</p>';
        });
    } else {
      resourceSelection.classList.add('hidden');
    }
  });
});
</script>
