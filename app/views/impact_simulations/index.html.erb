<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
  <div class="flex items-center justify-between mb-8">
    <div>
      <h1 class="text-3xl font-bold text-gray-900 flex items-center gap-3">
        <span class="inline-flex items-center justify-center w-10 h-10 rounded-lg" style="background: linear-gradient(135deg, #ef4444, #f97316);">
          <i class="fas fa-bolt text-white text-lg"></i>
        </span>
        Regulatory Impact Simulation
      </h1>
      <p class="mt-1 text-gray-500">Predict which controls and policies are affected by regulatory changes</p>
    </div>
  </div>

  <!-- Run New Simulation -->
  <div class="bg-white rounded-xl shadow-sm border border-gray-100 p-6 mb-8">
    <h2 class="text-lg font-semibold text-gray-900 mb-3">Run Impact Simulation</h2>
    <%= form_tag(simulate_organization_impact_simulations_path(@organization), method: :post, class: "flex items-end gap-3") do %>
      <div class="flex-1">
        <label class="block text-sm font-medium text-gray-700 mb-1">Select Regulation</label>
        <%= select_tag :regulation_id, options_from_collection_for_select(@regulations, :id, :title), prompt: "Choose a regulation...", class: "block w-full rounded-lg border-gray-300 shadow-sm focus:ring-indigo-500 focus:border-indigo-500 sm:text-sm" %>
      </div>
      <%= submit_tag "Run Simulation", class: "inline-flex items-center px-4 py-2 text-sm font-medium text-white bg-red-600 hover:bg-red-700 rounded-lg transition-colors cursor-pointer", data: { turbo_confirm: "Run impact simulation for the selected regulation?" } %>
    <% end %>
  </div>

  <!-- Previous Assessments -->
  <div class="bg-white rounded-xl shadow-sm border border-gray-100 overflow-hidden">
    <div class="px-6 py-4 border-b border-gray-100">
      <h2 class="text-lg font-semibold text-gray-900">Previous Assessments</h2>
    </div>
    <% if @assessments.any? %>
      <table class="min-w-full divide-y divide-gray-200">
        <thead class="bg-gray-50">
          <tr>
            <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase">Regulation</th>
            <th class="px-6 py-3 text-center text-xs font-medium text-gray-500 uppercase">Status</th>
            <th class="px-6 py-3 text-center text-xs font-medium text-gray-500 uppercase">Impact</th>
            <th class="px-6 py-3 text-center text-xs font-medium text-gray-500 uppercase">Effort (hrs)</th>
            <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase">Date</th>
            <th class="px-6 py-3 text-right text-xs font-medium text-gray-500 uppercase">Actions</th>
          </tr>
        </thead>
        <tbody class="divide-y divide-gray-200">
          <% @assessments.each do |assessment| %>
            <tr class="hover:bg-gray-50">
              <td class="px-6 py-4 text-sm font-medium text-gray-900"><%= assessment.regulation.title %></td>
              <td class="px-6 py-4 text-center">
                <% status_colors = { 'pending' => 'yellow', 'analyzing' => 'blue', 'completed' => 'green', 'dismissed' => 'gray' } %>
                <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-<%= status_colors[assessment.status] %>-100 text-<%= status_colors[assessment.status] %>-800">
                  <%= assessment.status.titleize %>
                </span>
              </td>
              <td class="px-6 py-4 text-center text-sm text-gray-900">
                <%= assessment.impacted_controls_count %> controls, <%= assessment.impacted_policies_count %> policies
              </td>
              <td class="px-6 py-4 text-center text-sm font-medium text-gray-900"><%= assessment.estimated_effort_hours %></td>
              <td class="px-6 py-4 text-sm text-gray-500"><%= assessment.created_at.strftime("%b %d, %Y") %></td>
              <td class="px-6 py-4 text-right">
                <%= link_to organization_impact_simulation_path(@organization, assessment), class: "text-indigo-600 hover:text-indigo-800 text-sm font-medium" do %>
                  View <i class="fas fa-arrow-right ml-1"></i>
                <% end %>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    <% else %>
      <div class="text-center py-12">
        <i class="fas fa-bolt text-gray-300 text-4xl mb-3"></i>
        <p class="text-gray-500">No impact assessments yet. Select a regulation above to run your first simulation.</p>
      </div>
    <% end %>
  </div>
</div>
