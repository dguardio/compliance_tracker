<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
  <nav class="mb-6">
    <ol class="flex items-center space-x-2 text-sm text-gray-500">
      <li><%= link_to "Impact Simulations", organization_impact_simulations_path(@organization), class: "hover:text-indigo-600" %></li>
      <li><i class="fas fa-chevron-right text-xs"></i></li>
      <li class="text-gray-900 font-medium"><%= @assessment.regulation.title.truncate(50) %></li>
    </ol>
  </nav>

  <div class="flex items-center justify-between mb-8">
    <div>
      <h1 class="text-2xl font-bold text-gray-900">Impact Assessment: <%= @assessment.regulation.title %></h1>
      <p class="mt-1 text-gray-500"><%= @assessment.ai_summary %></p>
    </div>
    <% if @assessment.high_impact_items.any? %>
      <%= link_to create_findings_organization_impact_simulation_path(@organization, @assessment), method: :post, data: { turbo_method: :post, turbo_confirm: "Create findings for #{@assessment.high_impact_items.size} high-impact items?" }, class: "inline-flex items-center px-4 py-2 text-sm font-medium text-white bg-red-600 hover:bg-red-700 rounded-lg transition-colors" do %>
        <i class="fas fa-exclamation-triangle mr-2"></i> Create Findings (<%= @assessment.high_impact_items.size %>)
      <% end %>
    <% end %>
  </div>

  <!-- Summary Cards -->
  <div class="grid grid-cols-1 md:grid-cols-4 gap-4 mb-8">
    <div class="bg-white rounded-lg border p-4 text-center">
      <p class="text-3xl font-bold text-red-600"><%= @assessment.high_impact_items.size %></p>
      <p class="text-xs text-gray-500">High Impact</p>
    </div>
    <div class="bg-white rounded-lg border p-4 text-center">
      <p class="text-3xl font-bold text-amber-600"><%= @assessment.medium_impact_items.size %></p>
      <p class="text-xs text-gray-500">Medium Impact</p>
    </div>
    <div class="bg-white rounded-lg border p-4 text-center">
      <p class="text-3xl font-bold text-green-600"><%= @assessment.low_impact_items.size %></p>
      <p class="text-xs text-gray-500">Low Impact</p>
    </div>
    <div class="bg-white rounded-lg border p-4 text-center">
      <p class="text-3xl font-bold" style="color: var(--primary-color, #6366f1);"><%= @assessment.estimated_effort_hours %>h</p>
      <p class="text-xs text-gray-500">Est. Effort</p>
    </div>
  </div>

  <!-- Diff Section -->
  <% if @assessment.diff_sections.any? %>
    <div class="bg-white rounded-xl shadow-sm border p-6 mb-8">
      <h2 class="text-lg font-semibold text-gray-900 mb-4">Regulation Changes</h2>
      <p class="text-sm text-gray-500 mb-4"><%= @assessment.diff_summary %></p>
      <div class="space-y-3">
        <% @assessment.diff_sections.each do |section| %>
          <div class="border rounded-lg p-4">
            <div class="flex items-center gap-2 mb-2">
              <% change_colors = { 'added' => 'green', 'removed' => 'red', 'modified' => 'amber' } %>
              <span class="inline-flex items-center px-2 py-0.5 rounded-full text-xs font-medium bg-<%= change_colors[section['change_type']] %>-100 text-<%= change_colors[section['change_type']] %>-800">
                <%= section['change_type'].titleize %>
              </span>
              <span class="text-sm font-medium text-gray-900"><%= section['title'] %></span>
            </div>
            <% if section['change_type'] == 'modified' %>
              <div class="grid grid-cols-2 gap-3 text-xs">
                <div class="bg-red-50 p-2 rounded"><pre class="whitespace-pre-wrap text-red-800"><%= section['old_content']&.truncate(200) %></pre></div>
                <div class="bg-green-50 p-2 rounded"><pre class="whitespace-pre-wrap text-green-800"><%= section['new_content']&.truncate(200) %></pre></div>
              </div>
            <% end %>
          </div>
        <% end %>
      </div>
    </div>
  <% end %>

  <!-- Impacted Items -->
  <div class="bg-white rounded-xl shadow-sm border overflow-hidden">
    <div class="px-6 py-4 border-b border-gray-100">
      <h2 class="text-lg font-semibold text-gray-900">Impacted Items (<%= @items.size %>)</h2>
    </div>
    <table class="min-w-full divide-y divide-gray-200">
      <thead class="bg-gray-50">
        <tr>
          <th class="px-4 py-3 text-left text-xs font-medium text-gray-500 uppercase">Item</th>
          <th class="px-4 py-3 text-center text-xs font-medium text-gray-500 uppercase">Type</th>
          <th class="px-4 py-3 text-center text-xs font-medium text-gray-500 uppercase">Impact</th>
          <th class="px-4 py-3 text-center text-xs font-medium text-gray-500 uppercase">Score</th>
        </tr>
      </thead>
      <tbody class="divide-y divide-gray-200">
        <% @items.each do |item| %>
          <tr class="hover:bg-gray-50">
            <td class="px-4 py-3">
              <div class="text-sm font-medium text-gray-900"><%= item['name'] %></div>
              <div class="text-xs text-gray-500"><%= item['description'] %></div>
            </td>
            <td class="px-4 py-3 text-center">
              <% type_colors = { 'control' => 'blue', 'policy' => 'purple', 'obligation' => 'orange' } %>
              <span class="inline-flex items-center px-2 py-0.5 rounded-full text-xs font-medium bg-<%= type_colors[item['type']] || 'gray' %>-100 text-<%= type_colors[item['type']] || 'gray' %>-800">
                <%= item['type'].titleize %>
              </span>
            </td>
            <td class="px-4 py-3 text-center">
              <% level_colors = { 'high' => 'red', 'medium' => 'amber', 'low' => 'green' } %>
              <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-<%= level_colors[item['impact_level']] %>-100 text-<%= level_colors[item['impact_level']] %>-800">
                <%= item['impact_level'].titleize %>
              </span>
            </td>
            <td class="px-4 py-3 text-center text-sm text-gray-600"><%= (item['similarity_score'].to_f * 100).round(0) %>%</td>
          </tr>
        <% end %>
      </tbody>
    </table>
    <% if @items.empty? %>
      <div class="text-center py-8">
        <p class="text-gray-500">No impacted items found for this regulation.</p>
      </div>
    <% end %>
  </div>
</div>
