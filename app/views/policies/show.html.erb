<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
  <!-- Header -->
  <div class="md:flex md:items-center md:justify-between mb-8">
    <div class="min-w-0 flex-1">
      <h2 class="text-2xl font-bold leading-7 text-gray-900 sm:truncate sm:text-3xl sm:tracking-tight">
        <%= @policy.title %>
      </h2>
      <div class="mt-1 flex flex-col sm:mt-0 sm:flex-row sm:flex-wrap sm:space-x-6">
        <div class="mt-2 flex items-center text-sm text-gray-500">
          <span class="inline-flex items-center rounded-md px-2 py-1 text-xs font-medium ring-1 ring-inset <%= @policy.active? ? 'bg-green-50 text-green-700 ring-green-600/20' : 'bg-gray-50 text-gray-600 ring-gray-500/10' %>">
            <%= @policy.status.humanize %>
          </span>
        </div>
        <div class="mt-2 flex items-center text-sm text-gray-500">
          Effective: <%= @policy.effective_date&.strftime("%B %d, %Y") || "Not set" %>
        </div>
      </div>
    </div>
    <div class="mt-4 flex md:ml-4 md:mt-0">
      <% if policy(@policy).edit? %>
        <%= link_to "Edit", edit_organization_policy_path(@organization, @policy), class: "inline-flex items-center rounded-md bg-white px-3 py-2 text-sm font-semibold text-gray-900 shadow-sm ring-1 ring-inset ring-gray-300 hover:bg-gray-50" %>
      <% end %>
      <%= link_to "Back", organization_policies_path(@organization), class: "ml-3 inline-flex items-center rounded-md bg-white px-3 py-2 text-sm font-semibold text-gray-900 shadow-sm ring-1 ring-inset ring-gray-300 hover:bg-gray-50" %>
    </div>
  </div>

  <div class="grid grid-cols-1 gap-6 lg:grid-cols-3">
    <!-- Main Content -->
    <div class="lg:col-span-2 space-y-6">
      <div class="bg-white shadow sm:rounded-lg">
        <div class="px-4 py-5 sm:p-6">
          <div class="prose max-w-none">
            <%= @policy.content %>
          </div>
        </div>
      </div>
    </div>

    <!-- Sidebar: The Golden Thread -->
    <div class="space-y-6">
      <!-- Linked Regulations -->
      <div class="bg-white shadow sm:rounded-lg">
        <div class="px-4 py-5 sm:px-6 border-b border-gray-200 flex justify-between items-center">
          <h3 class="text-base font-semibold leading-6 text-gray-900">Regulations</h3>
          <% if policy(@policy).edit? %>
            <%= link_to "Link", new_organization_policy_policy_link_path(@organization, @policy, linkable_type: 'Regulation'), class: "rounded bg-white px-2 py-1 text-xs font-semibold text-gray-900 shadow-sm ring-1 ring-inset ring-gray-300 hover:bg-gray-50" %>
          <% end %>
        </div>
        <ul role="list" class="divide-y divide-gray-200">
          <% @policy.policy_links.where(linkable_type: 'Regulation').each do |link| %>
            <li class="px-4 py-4 sm:px-6 group relative">
              <div class="flex items-center justify-between">
                <p class="text-sm font-medium text-indigo-600 truncate">
                  <%= link_to link.linkable.title, admin_regulation_path(link.linkable) %>
                </p>
                <% if policy(@policy).edit? %>
                  <%= button_to organization_policy_policy_link_path(@organization, @policy, link), method: :delete, class: "hidden group-hover:block text-red-600 hover:text-red-900", form: { data: { turbo_confirm: "Are you sure?" } } do %>
                    <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
                      <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" />
                    </svg>
                  <% end %>
                <% end %>
              </div>
              <% if link.citation.present? %>
                <p class="mt-1 text-xs text-gray-500">Citation: <%= link.citation %></p>
              <% end %>
            </li>
          <% end %>
          <% if @policy.policy_links.where(linkable_type: 'Regulation').empty? %>
            <li class="px-4 py-4 sm:px-6 text-sm text-gray-500 italic">No linked regulations.</li>
          <% end %>
        </ul>
      </div>

      <!-- Linked Controls -->
      <div class="bg-white shadow sm:rounded-lg">
        <div class="px-4 py-5 sm:px-6 border-b border-gray-200 flex justify-between items-center">
          <h3 class="text-base font-semibold leading-6 text-gray-900">Controls</h3>
          <% if policy(@policy).edit? %>
            <%= link_to "Link", new_organization_policy_policy_link_path(@organization, @policy, linkable_type: 'ComplianceControl'), class: "rounded bg-white px-2 py-1 text-xs font-semibold text-gray-900 shadow-sm ring-1 ring-inset ring-gray-300 hover:bg-gray-50" %>
          <% end %>
        </div>
        <ul role="list" class="divide-y divide-gray-200">
           <% @policy.policy_links.where(linkable_type: 'ComplianceControl').each do |link| %>
            <li class="px-4 py-4 sm:px-6 group relative">
              <div class="flex items-center justify-between">
                <p class="text-sm font-medium text-gray-900"><%= link.linkable.name %></p>
                <% if policy(@policy).edit? %>
                  <%= button_to organization_policy_policy_link_path(@organization, @policy, link), method: :delete, class: "hidden group-hover:block text-red-600 hover:text-red-900", form: { data: { turbo_confirm: "Are you sure?" } } do %>
                    <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
                      <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" />
                    </svg>
                  <% end %>
                <% end %>
              </div>
            </li>
          <% end %>
           <% if @policy.policy_links.where(linkable_type: 'ComplianceControl').empty? %>
            <li class="px-4 py-4 sm:px-6 text-sm text-gray-500 italic">No linked controls.</li>
          <% end %>
        </ul>
      </div>

    </div>
  </div>
</div>
