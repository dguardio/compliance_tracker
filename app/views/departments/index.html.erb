<div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
  <div class="md:flex md:items-center md:justify-between mb-8">
    <div class="min-w-0 flex-1">
      <h2 class="text-3xl font-bold leading-7 text-gray-900 sm:truncate sm:tracking-tight">
        Departments
      </h2>
      <p class="mt-2 text-sm text-gray-500">Manage organizational departments and their structure.</p>
    </div>
    <div class="mt-4 flex md:ml-4 md:mt-0">
      <%= render Joyful::ButtonComponent.new(
            text: "New Department",
            path: new_organization_department_path(@organization),
            variant: :primary,
            icon: "plus"
          ) %>
    </div>
  </div>

  <div class="grid grid-cols-1 gap-4 sm:grid-cols-2 lg:grid-cols-3">
    <% @departments.each do |department| %>
      <%= render Joyful::CardComponent.new(
            title: department.name,
            icon: "building",
            padding: true,
            actions: [
              link_to(
                content_tag(:i, "", class: "fas fa-edit"),
                edit_organization_department_path(@organization, department),
                class: "text-gray-400 hover:text-primary-600 transition-colors"
              )
            ]
          ) do %>
        <div class="space-y-4">
          <p class="text-sm text-gray-500 line-clamp-2 min-h-[2.5rem]">
            <%= department.description.presence || "No description provided." %>
          </p>
          
          <div class="flex items-center gap-2 text-xs text-gray-500">
             <i class="fas fa-users w-4 text-center"></i>
             <span><%= pluralize(department.teams.count, 'team') %></span>
          </div>

          <div class="pt-2">
            <%= render Joyful::ButtonComponent.new(
                  text: "View Details",
                  path: organization_department_path(@organization, department),
                  variant: :secondary,
                  size: :sm,
                  class: "w-full justify-center"
                ) %>
          </div>
        </div>
      <% end %>
    <% end %>
  </div>
  
  <% if @departments.empty? %>
    <div class="text-center py-12">
      <div class="inline-flex items-center justify-center w-16 h-16 rounded-full bg-gray-100 mb-4">
        <i class="fas fa-building text-2xl text-gray-400"></i>
      </div>
      <h3 class="mt-2 text-sm font-semibold text-gray-900">No departments</h3>
      <p class="mt-1 text-sm text-gray-500">Get started by creating a new department.</p>
      <div class="mt-6">
        <%= render Joyful::ButtonComponent.new(
              text: "New Department",
              path: new_organization_department_path(@organization),
              variant: :primary,
              icon: "plus"
            ) %>
      </div>
    </div>
  <% end %>
</div>
