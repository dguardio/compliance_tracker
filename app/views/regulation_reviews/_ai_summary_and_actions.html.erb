<div class="grid grid-cols-1 lg:grid-cols-3 gap-8">
  <!-- AI Summary -->
  <div class="lg:col-span-2 space-y-6">
    <div class="bg-white shadow rounded-lg p-6">
      <h3 class="text-xl font-bold text-gray-900 mb-4">AI Summary</h3>
      <div class="prose prose-indigo max-w-none">
        <%= simple_format(@regulation.summary) %>
      </div>
    </div>
    <div class="bg-white shadow rounded-lg p-6">
      <h3 class="text-lg font-medium text-gray-900 mb-4">AI-Extracted Keywords</h3>
      <div class="flex flex-wrap gap-2">
        <% @regulation.keywords.each do |keyword| %>
          <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-indigo-100 text-indigo-800">
            <%= keyword %>
          </span>
        <% end %>
      </div>
    </div>
  </div>

  <!-- Workflow Sidebar -->
  <div class="space-y-6">
    <div class="bg-white shadow rounded-lg p-6">
      <h2 class="text-2xl font-bold text-gray-900 mb-4">Review Workflow</h2>
      
      <div>
        <h3 class="font-medium text-gray-700">Current Status</h3>
        <p class="mt-1 text-lg font-semibold text-indigo-600"><%= @regulation_review.workflow_state.humanize %></p>
      </div>

      <%= form_with(model: @regulation_review, url: regulation_review_path(@regulation_review), method: :patch, class: "space-y-6") do |form| %>
        <div class="mt-6">
          <h3 class="font-medium text-gray-700 mb-2">Take Action</h3>
          <div class="space-y-3">
            <% if @current_step&.step_type == 'decision' && @current_step.decision_options.any? %>
              <% @current_step.decision_options.each do |decision| %>
                <%= form.button decision, name: 'decision', value: decision, class: "w-full text-center px-4 py-2 border border-transparent text-sm font-medium rounded-md shadow-sm text-white bg-indigo-600 hover:bg-indigo-700" %>
              <% end %>
              <hr>
              <%= form.button 'Reject', name: 'event', value: 'reject', class: "w-full text-center px-4 py-2 border border-transparent text-sm font-medium rounded-md shadow-sm text-white bg-red-600 hover:bg-red-700" %>
            <% else %>
              <% @regulation_review.workflow.spec.events.keys.each do |event| %>
                <%= form.button event.to_s.humanize, name: 'event', value: event, class: "w-full text-center px-4 py-2 border border-transparent text-sm font-medium rounded-md shadow-sm text-white bg-indigo-600 hover:bg-indigo-700" %>
              <% end %>
            <% end %>
          </div>
        </div>

        <div class="bg-white shadow rounded-lg p-6">
          <h3 class="text-lg font-medium text-gray-900 mb-4">Add Notes</h3>
          <div>
            <%= form.text_area :decision_notes, rows: 5, class: "w-full rounded-md border-gray-300 shadow-sm" %>
          </div>
          <div class="mt-4 text-right">
            <%= form.submit "Save Notes", class: "cursor-pointer rounded-md bg-gray-600 px-4 py-2 text-sm font-semibold text-white shadow-sm hover:bg-gray-500" %>
          </div>
        </div>
      <% end %>
    </div>

    <% if @current_step&.step_type == 'classification' %>
      <div class="bg-white shadow rounded-lg p-6">
        <h3 class="text-lg font-medium text-gray-900 mb-4">Classify Regulation</h3>
        <%= form_with(model: @regulation_review.organization_regulation, url: classify_regulation_review_path(@regulation_review), method: :post) do |form| %>
          <div>
            <%= form.label :compliance_framework_id, "Select Framework", class: "block text-sm font-medium text-gray-700" %>
            <%= form.collection_select :compliance_framework_id, @compliance_frameworks, :id, :name, { include_blank: 'Select a framework' }, class: "mt-1 block w-full rounded-md border-gray-300 shadow-sm" %>
          </div>
          <div class="mt-4 text-right">
            <%= form.submit "Classify and Complete", class: "cursor-pointer rounded-md bg-indigo-600 px-4 py-2 text-sm font-semibold text-white shadow-sm hover:bg-indigo-500" %>
          </div>
        <% end %>
      </div>
    <% end %>
  </div>
</div>
