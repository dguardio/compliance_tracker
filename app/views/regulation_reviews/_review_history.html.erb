<div class="bg-white shadow rounded-lg p-6">
  <h3 class="text-xl font-bold text-gray-900 mb-4">Review History</h3>
  <div class="flow-root">
    <ul role="list" class="-mb-8">
      <% @regulation_review.regulation_review_decisions.order(created_at: :desc).each_with_index do |decision, index| %>
        <li>
          <div class="relative pb-8">
            <% unless index == @regulation_review.regulation_review_decisions.size - 1 %>
              <span class="absolute top-4 left-4 -ml-px h-full w-0.5 bg-gray-200" aria-hidden="true"></span>
            <% end %>
            <div class="relative flex space-x-3">
              <div>
                <span class="h-8 w-8 rounded-full bg-gray-400 flex items-center justify-center ring-8 ring-white">
                  <svg class="h-5 w-5 text-white" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
                    <path fill-rule="evenodd" d="M10 9a3 3 0 100-6 3 3 0 000 6zm-7 9a7 7 0 1114 0H3z" clip-rule="evenodd" />
                  </svg>
                </span>
              </div>
              <div class="min-w-0 flex-1 pt-1.5 flex justify-between space-x-4">
                <div>
                  <p class="text-sm text-gray-500">
                    Decision made by <a href="#" class="font-medium text-gray-900"><%= decision.user.full_name %></a>
                  </p>
                  <p class="mt-0.5 text-sm text-gray-500">
                    Step: <%= decision.workflow_step.name %>
                  </p>
                  <div class="mt-2 text-sm text-gray-700">
                    <p><strong>Decision:</strong> <%= decision.decision %></p>
                    <% if decision.notes.present? %>
                      <p class="mt-1"><strong>Notes:</strong> <%= decision.notes %></p>
                    <% end %>
                  </div>
                </div>
                <div class="text-right text-sm whitespace-nowrap text-gray-500">
                  <time datetime="<%= decision.created_at.iso8601 %>"><%= time_ago_in_words(decision.created_at) %> ago</time>
                </div>
              </div>
            </div>
          </div>
        </li>
      <% end %>
    </ul>
  </div>
</div>
