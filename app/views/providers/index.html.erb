<div class="container mx-auto px-4 py-8">
  <div class="mb-6">
    <%= link_to "← Back to Dashboard", dashboard_path, 
                class: "text-blue-600 hover:text-blue-800 font-medium" %>
  </div>

  <div class="flex justify-between items-center mb-6">
    <h1 class="text-3xl font-bold text-gray-900">Regulatory Providers</h1>
    <div class="flex space-x-3">
      <%= link_to "Get Recommendations", recommendations_providers_path, 
                  class: "bg-green-600 hover:bg-green-700 text-white font-bold py-2 px-4 rounded" %>
      <%= link_to "Add New Provider", new_provider_path, 
                  class: "bg-blue-600 hover:bg-blue-700 text-white font-bold py-2 px-4 rounded" %>
    </div>
  </div>

  <!-- Filters -->
  <div class="bg-white shadow rounded-lg p-6 mb-6">
    <h3 class="text-lg font-medium text-gray-900 mb-4">Filters</h3>
    <%= form_with url: providers_path, method: :get, local: true, class: "grid grid-cols-1 md:grid-cols-5 gap-4" do |form| %>
      <div>
        <%= form.label :jurisdiction, "Jurisdiction", class: "block text-sm font-medium text-gray-700 mb-1" %>
        <%= form.select :jurisdiction, 
                        options_for_select([['All Jurisdictions', '']] + @jurisdictions.map { |j| [j, j] }, params[:jurisdiction]),
                        {},
                        class: "w-full border-gray-300 rounded-md shadow-sm focus:ring-blue-500 focus:border-blue-500" %>
      </div>

      <div>
        <%= form.label :country, "Country", class: "block text-sm font-medium text-gray-700 mb-1" %>
        <%= form.select :country, 
                        options_for_select([['All Countries', '']] + @countries.map { |c| [c, c] }, params[:country]),
                        {},
                        class: "w-full border-gray-300 rounded-md shadow-sm focus:ring-blue-500 focus:border-blue-500" %>
      </div>

      <div>
        <%= form.label :status, "Status", class: "block text-sm font-medium text-gray-700 mb-1" %>
        <%= form.select :status, 
                        options_for_select([['All Statuses', '']] + Provider.statuses.keys.map { |s| [s.titleize, s] }, params[:status]),
                        {},
                        class: "w-full border-gray-300 rounded-md shadow-sm focus:ring-blue-500 focus:border-blue-500" %>
      </div>

      <div>
        <%= form.label :provider_type, "Type", class: "block text-sm font-medium text-gray-700 mb-1" %>
        <%= form.select :provider_type, 
                        options_for_select([['All Types', '']] + @provider_types.map { |t| [t.titleize, t] }, params[:provider_type]),
                        {},
                        class: "w-full border-gray-300 rounded-md shadow-sm focus:ring-blue-500 focus:border-blue-500" %>
      </div>

      <div class="flex items-end">
        <%= form.submit "Filter", class: "bg-gray-600 hover:bg-gray-700 text-white font-bold py-2 px-4 rounded mr-2" %>
        <%= link_to "Clear", providers_path, class: "bg-gray-300 hover:bg-gray-400 text-gray-800 font-bold py-2 px-4 rounded" %>
      </div>
    <% end %>
  </div>

  <% if @providers.any? %>
    <div class="bg-white shadow overflow-hidden sm:rounded-md">
      <ul class="divide-y divide-gray-200">
        <% @providers.each do |provider| %>
          <li>
            <div class="px-4 py-4 sm:px-6">
              <div class="flex items-center justify-between">
                <div class="flex items-center">
                  <div class="flex-shrink-0">
                    <div class="h-10 w-10 bg-blue-100 rounded-full flex items-center justify-center">
                      <span class="text-blue-600 font-semibold text-sm"><%= provider.code %></span>
                    </div>
                  </div>
                  <div class="ml-4 flex-1">
                    <div class="flex items-center justify-between">
                      <div>
                        <h3 class="text-lg font-medium text-gray-900">
                          <%= link_to provider.name, provider_path(provider), class: "hover:text-blue-600" %>
                        </h3>
                        <p class="text-sm text-gray-500">
                          <%= provider.full_jurisdiction %>
                        </p>
                      </div>
                      <div class="flex items-center space-x-2">
                        <span class="px-2 py-1 text-xs font-semibold rounded-full 
                                     <%= provider.active? ? 'bg-green-100 text-green-800' : 'bg-gray-100 text-gray-800' %>">
                          <%= provider.status.titleize %>
                        </span>
                        <span class="px-2 py-1 text-xs font-semibold rounded-full 
                                     <%= provider.platform_wide? ? 'bg-purple-100 text-purple-800' : 'bg-blue-100 text-blue-800' %>">
                          <%= provider.provider_type.titleize %>
                        </span>
                        <% if provider.is_regulatory_authority? %>
                          <span class="px-2 py-1 text-xs font-semibold rounded-full bg-orange-100 text-orange-800">
                            Regulatory Authority
                          </span>
                        <% end %>
                      </div>
                    </div>
                    
                    <% if provider.description.present? %>
                      <p class="text-sm text-gray-600 mt-2 line-clamp-2">
                        <%= provider.description %>
                      </p>
                    <% end %>

                    <div class="mt-3 flex items-center justify-between">
                      <div class="flex items-center space-x-4 text-sm text-gray-500">
                        <span>Frameworks: <%= provider.framework_count %></span>
                        <span>Active: <%= provider.active_framework_count %></span>
                        <% if provider.website.present? %>
                          <%= link_to "Website", provider.website, target: "_blank", 
                                      class: "text-blue-600 hover:text-blue-800" %>
                        <% end %>
                      </div>
                      
                      <div class="flex space-x-2">
                        <%= link_to "View", provider_path(provider), 
                                    class: "text-blue-600 hover:text-blue-800 text-sm font-medium" %>
                        <% if provider.can_be_edited_by?(current_user) %>
                          <%= link_to "Edit", edit_provider_path(provider), 
                                      class: "text-gray-600 hover:text-gray-800 text-sm font-medium" %>
                        <% end %>
                        <% if provider.can_be_deleted_by?(current_user) %>
                          <%= link_to "Delete", provider_path(provider), 
                                      method: :delete,
                                      data: { confirm: "Are you sure you want to delete this provider?" },
                                      class: "text-red-600 hover:text-red-800 text-sm font-medium" %>
                        <% end %>
                      </div>
                    </div>
                  </div>
                </div>
              </div>
            </div>
          </li>
        <% end %>
      </ul>
    </div>

    <!-- Pagination -->
    <div class="mt-8">
      <%= paginate @providers %>
    </div>
  <% else %>
    <div class="text-center py-12">
      <div class="text-gray-400 mb-4">
        <svg class="mx-auto h-12 w-12" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4"></path>
        </svg>
      </div>
      <h3 class="text-lg font-medium text-gray-900 mb-2">No providers found</h3>
      <p class="text-gray-500">Get started by adding your first regulatory provider.</p>
      <div class="mt-4">
        <%= link_to "Add Provider", new_provider_path, 
                    class: "bg-blue-600 hover:bg-blue-700 text-white font-bold py-2 px-4 rounded" %>
      </div>
    </div>
  <% end %>
</div>
