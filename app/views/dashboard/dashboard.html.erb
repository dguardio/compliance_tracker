<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
  <div class="grid grid-cols-12 gap-8">
    <!-- Main Content (8 cols) -->
    <div class="col-span-12 lg:col-span-8 space-y-8">
      
      <!-- Zone 1: Welcome -->
      <div class="flex items-center justify-between">
         <div>
            <% greeting = Time.current.hour < 12 ? "Good Morning" : (Time.current.hour < 18 ? "Good Afternoon" : "Good Evening") %>
            <h1 class="text-3xl font-bold text-gray-900 tracking-tight"><%= greeting %>, <%= current_user.first_name.presence || 'Compliance Officer' %>.</h1>
            <p class="mt-1 text-gray-500 text-lg">
              <% if @stats[:due_soon_tasks] > 0 %>
                You have <%= pluralize(@stats[:due_soon_tasks], 'task') %> due soon.
              <% else %>
                You're all caught up! Enjoy the quiet.
              <% end %>
            </p>
         </div>
         <!-- Illustration -->
         <div class="hidden sm:block text-amber-500">
            <svg class="w-12 h-12 animate-pulse" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 3v1m0 16v1m9-9h-1M4 12H3m15.364 6.364l-.707-.707M6.343 6.343l-.707-.707m12.728 0l-.707.707M6.343 17.657l-.707.707M16 12a4 4 0 11-8 0 4 4 0 018 0z"></path></svg>
         </div>
      </div>

      <!-- Onboarding Callout (if active) -->
      <% if @onboarding_percent < 100 %>
        <%= render Joyful::CardComponent.new(padding: true) do %>
            <div class="flex items-center justify-between">
                <div>
                   <h3 class="text-lg font-bold text-gray-900">Setup In Progress</h3>
                   <p class="text-sm text-gray-500"><%= @onboarding_percent %>% Complete</p>
                </div>
                <%= link_to "Continue Setup", organization_setup_index_path(@organization), class: "text-sm font-semibold text-indigo-600 hover:text-indigo-500" %>
            </div>
            <div class="w-full bg-slate-200 rounded-full h-2.5 mt-4">
              <div class="bg-indigo-600 h-2.5 rounded-full transition-all duration-500" style="width: <%= @onboarding_percent %>%;"></div>
            </div>
        <% end %>
      <% end %>

      <!-- Zone 2: Pulse Cards -->
      <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
         <!-- Card A: Compliance Score -->
         <%= render Joyful::CardComponent.new(padding: true) do %>
             <div class="flex flex-col items-center justify-center py-2 h-full">
                <div class="relative w-24 h-24 mb-2">
                   <svg class="w-full h-full transform -rotate-90" viewBox="0 0 36 36">
                      <path class="text-slate-100" d="M18 2.0845 a 15.9155 15.9155 0 0 1 0 31.831 a 15.9155 15.9155 0 0 1 0 -31.831" fill="none" stroke="currentColor" stroke-width="3" />
                      <path class="<%= @compliance_score >= 80 ? 'text-success-600' : (@compliance_score >= 50 ? 'text-warning-500' : 'text-danger-500') %> drop-shadow-md transition-all duration-1000 ease-out" stroke-dasharray="<%= @compliance_score %>, 100" d="M18 2.0845 a 15.9155 15.9155 0 0 1 0 31.831 a 15.9155 15.9155 0 0 1 0 -31.831" fill="none" stroke="currentColor" stroke-width="3" />
                   </svg>
                   <div class="absolute inset-0 flex items-center justify-center flex-col">
                      <span class="text-2xl font-bold text-gray-900 tabular-nums"><%= @compliance_score %>%</span>
                   </div>
                </div>
                <span class="text-sm font-medium text-gray-500">Compliance Score</span>
             </div>
         <% end %>

         <!-- Card B: Streak -->
         <%= render Joyful::CardComponent.new do %>
             <div class="flex flex-col items-center justify-center py-4 h-full text-center">
                <div class="p-3 bg-warning-50 rounded-full text-warning-500 mb-3">
                   <svg class="w-6 h-6" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M12.395 2.553a1 1 0 00-1.45-.385c-.345.23-.614.558-.822.88-.214.33-.403.713-.57 1.116-.334.804-.614 1.768-.84 2.734a31.365 31.365 0 00-.613 3.58 2.64 2.64 0 01-.945-1.067c-.328-.68-.398-1.534-.398-2.654A1 1 0 005.05 6.05 6.981 6.981 0 003 11a7 7 0 1011.95-4.95c-.592-.591-.98-.985-1.348-1.467-.363-.476-.724-1.063-1.207-2.03zM12.12 15.12A3 3 0 017 13s.879.5 2.5.5c0-1 .5-4 1.25-4.5.5 1 .786 1.293 1.371 1.879A2.99 2.99 0 0113 13a2.99 2.99 0 01-.879 2.121z" clip-rule="evenodd"></path></svg>
                </div>
                <h3 class="text-2xl font-bold text-gray-900 tabular-nums mb-1"><%= @streak %> Days</h3>
                <p class="text-sm text-gray-500">Since last high risk.</p>
             </div>
         <% end %>

         <!-- Card C: Approvals -->
         <%= render Joyful::CardComponent.new do %>
             <div class="flex flex-col items-center justify-center py-4 h-full text-center">
                 <div class="flex -space-x-2 overflow-hidden mb-4 p-1">
                    <% @organization.users.limit(3).each_with_index do |u, i| %>
                       <div class="inline-block h-8 w-8 rounded-full ring-2 ring-white bg-primary-100 flex items-center justify-center text-xs font-bold text-primary-600 z-<%= 30 - (i*10) %>">
                         <%= u.first_name&.first || u.email.first.upcase %>
                       </div>
                    <% end %>
                 </div>
                 <p class="text-sm text-gray-500 mb-3"><%= @stats[:documents_needing_review] %> items waiting for review</p>
                 <%= render Joyful::ButtonComponent.new(text: "Review All", variant: :primary, path: organization_documents_path(@organization, status: 'review')) %>
             </div>
         <% end %>
      </div>

      <!-- Zone 3: Up Next -->
      <section>
          <div class="flex items-center justify-between mb-4">
             <h2 class="text-xl font-bold text-gray-900">Up Next</h2>
          </div>
          
          <div class="space-y-4">
             <% tasks = @overdue_tasks.presence || @compliance_controls.due_soon.limit(3) %>
             <% if tasks.any? %>
                <% tasks.each do |task| %>
                    <!-- Using a clickable div to act as the card that triggers drawer -->
                    <%= render Joyful::CardComponent.new(padding: false) do %>
                        <div class="p-4 flex items-center gap-4 hover:bg-slate-50 transition-colors cursor-pointer group"
                             data-controller="drawer-trigger" 
                             data-action="click->drawer-trigger#open" 
                             data-drawer-trigger-id-value="task-drawer-<%= task.id %>"> <!-- Unique ID per task -->
                        
                        <div class="p-3 bg-primary-50 text-primary-600 rounded-xl group-hover:bg-primary-100 transition-colors">
                            <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"></path></svg>
                        </div>
                        <div class="flex-1 min-w-0">
                            <h4 class="text-base font-semibold text-gray-900 truncate"><%= task.name %></h4>
                            <p class="text-sm <%= task.overdue? ? 'text-danger-600' : 'text-gray-500' %>">
                                <%= task.overdue? ? 'Overdue by' : 'Due in' %> <%= time_ago_in_words(task.due_date) %>
                            </p>
                        </div>
                        <div class="flex items-center gap-3">
                            <%= render Joyful::StatusPillComponent.new(status: task.status.to_sym, text: task.status.titleize) %>
                            <div class="opacity-0 group-hover:opacity-100 transition-opacity">
                                <span class="text-sm font-medium text-gray-500">View</span>
                            </div>
                        </div>
                        </div>
                    <% end %>

                    <!-- Render a unique drawer for each task for now (simple approach) -->
                    <!-- In production, we'd load content dynamically, but for safe refactor we render hidden drawers -->
                    <%= render Joyful::DrawerComponent.new(title: task.name, id: "task-drawer-#{task.id}") do %>
                        <div class="space-y-6">
                            <div>
                                <h3 class="text-sm font-medium text-gray-500">Description</h3>
                                <div class="mt-1 text-sm text-gray-900 prose prose-sm">
                                    <%= task.description.presence || "No description provided." %>
                                </div>
                            </div>
                            <div>
                                <h3 class="text-sm font-medium text-gray-500">Due Date</h3>
                                <p class="mt-1 text-sm text-gray-900"><%= task.due_date.strftime("%B %d, %Y") %></p>
                            </div>
                             <div>
                                <h3 class="text-sm font-medium text-gray-500">Status</h3>
                                <div class="mt-2">
                                    <%= render Joyful::StatusPillComponent.new(status: task.status.to_sym, text: task.status.titleize) %>
                                </div>
                            </div>
                            <div class="pt-4 border-t border-gray-100">
                                <%= link_to "Go to Task Detail", organization_compliance_control_path(@organization, task), class: "w-full flex justify-center py-2 px-4 border border-transparent rounded-pill shadow-sm text-sm font-medium text-white bg-primary-600 hover:bg-primary-700 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-primary-500" %>
                            </div>
                        </div>
                    <% end %>

                <% end %>
             <% else %>
                <%= render Joyful::CardComponent.new(padding: true) do %>
                    <div class="text-center py-8">
                        <p class="text-gray-500">No urgent tasks. Enjoy your coffee! ☕</p>
                    </div>
                <% end %>
             <% end %>
          </div>
      </section>
    </div>

    <!-- Right Rail (4 cols) -->
    <div class="col-span-12 lg:col-span-4 space-y-8">
       <section>
          <h2 class="text-lg font-bold text-gray-900 mb-4">Team Activity</h2>
          <div class="relative pl-4 border-l-2 border-slate-100 space-y-8">
              
              <% if @recent_activity.any? %>
                  <% @recent_activity.each do |activity| %>
                    <!-- Activity Item -->
                    <div class="relative group">
                        <div class="absolute -left-[21px] top-1 h-3 w-3 rounded-full border-2 border-white bg-primary-500 ring-4 ring-primary-50"></div>
                        <div class="flex flex-col space-y-1">
                            <div class="flex items-center justify-between">
                                <span class="text-sm font-semibold text-gray-900"><%= activity[:user]&.full_name || 'System' %></span>
                                <span class="text-xs text-gray-500 tabular-nums"><%= time_ago_in_words(activity[:time]) %> ago</span>
                            </div>
                            <p class="text-sm text-gray-500">
                                <%= activity[:action] %> <span class="font-medium text-gray-900"><%= truncate(activity[:item_name], length: 30) %></span>.
                                <% if activity[:action].include?("Resolved") || activity[:type] == 'risk' %>
                                   <!-- Joy Factor: Simple check for positive actions -->
                                   🎉
                                <% end %>
                            </p>
                        </div>
                    </div>
                  <% end %>
              <% else %>
                  <p class="text-sm text-gray-500 italic">No recent activity.</p>
              <% end %>

          </div>
       </section>
    </div>
  </div>
</div>
