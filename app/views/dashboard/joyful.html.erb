  // Temporary bridge to open drawer from existing buttons until we wire them fully with Stimulus values
  function openJoyfulDrawer() {
     const drawerController = document.getElementById('task-drawer').getAttribute('data-controller');
     // Since Stimulus controller instance isn't globally exposed easily, we rely on the data-action in HTML.
     // But wait, the button needs to target the drawer.
     // Let's assume the button below has data-action="click->drawer#open" and we wrap it all in a controller or reference it.
     // Actually, simplest is to give the drawer controller an ID or listen to an event.
     // For now, let's just make the "View" buttons trigger the drawer by ID logic if they were adjacent.
     // Better: Wrap the "Up Next" item and the drawer in the same controller scope? No, reuse issues.
     // Solution: Simple event bus or just get the controller element.
     
     // This script is just a placeholder fallback. The real wiring is in the button replacement below.
  }
</script>
