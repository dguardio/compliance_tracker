<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
  <div class="grid grid-cols-12 gap-8">
    <!-- Main Content (8 cols) -->
    <div class="col-span-12 lg:col-span-8 space-y-8">
      
      <!-- Zone 1: Welcome -->
      <div class="flex items-center justify-between">
         <div>
            <h1 class="text-3xl font-bold text-gray-900 tracking-tight">Good Morning, <%= current_user.first_name.presence || 'Compliance Officer' %>.</h1>
            <p class="mt-1 text-gray-500 text-lg">Looks like a calm Tuesday. You have 3 items for review.</p>
         </div>
         <!-- Illustration -->
         <div class="hidden sm:block text-warning-500">
            <svg class="w-12 h-12 animate-pulse" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 3v1m0 16v1m9-9h-1M4 12H3m15.364 6.364l-.707-.707M6.343 6.343l-.707-.707m12.728 0l-.707.707M6.343 17.657l-.707.707M16 12a4 4 0 11-8 0 4 4 0 018 0z"></path></svg>
         </div>
      </div>

      <!-- Zone 2: Pulse Cards -->
      <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
         <!-- Card A: Compliance Score -->
         <%= render Joyful::CardComponent.new(
               padding: true
             ) do %>
             <div class="flex flex-col items-center justify-center py-2">
                <!-- Simple donut representation for now -->
                <div class="relative w-24 h-24 mb-2">
                   <svg class="w-full h-full transform -rotate-90" viewBox="0 0 36 36">
                      <path class="text-slate-100" d="M18 2.0845 a 15.9155 15.9155 0 0 1 0 31.831 a 15.9155 15.9155 0 0 1 0 -31.831" fill="none" stroke="currentColor" stroke-width="3" />
                      <path class="text-success-600 drop-shadow-md" stroke-dasharray="94, 100" d="M18 2.0845 a 15.9155 15.9155 0 0 1 0 31.831 a 15.9155 15.9155 0 0 1 0 -31.831" fill="none" stroke="currentColor" stroke-width="3" />
                   </svg>
                   <div class="absolute inset-0 flex items-center justify-center flex-col">
                      <span class="text-2xl font-bold text-gray-900 tabular-nums">94%</span>
                   </div>
                </div>
                <span class="text-sm font-medium text-gray-500">Compliance Score</span>
             </div>
         <% end %>

         <!-- Card B: Streak -->
         <%= render Joyful::CardComponent.new do %>
             <div class="flex flex-col items-center justify-center py-4 h-full text-center">
                <div class="p-3 bg-amber-50 rounded-full text-amber-500 mb-3">
                   <svg class="w-6 h-6" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M12.395 2.553a1 1 0 00-1.45-.385c-.345.23-.614.558-.822.88-.214.33-.403.713-.57 1.116-.334.804-.614 1.768-.84 2.734a31.365 31.365 0 00-.613 3.58 2.64 2.64 0 01-.945-1.067c-.328-.68-.398-1.534-.398-2.654A1 1 0 005.05 6.05 6.981 6.981 0 003 11a7 7 0 1011.95-4.95c-.592-.591-.98-.985-1.348-1.467-.363-.476-.724-1.063-1.207-2.03zM12.12 15.12A3 3 0 017 13s.879.5 2.5.5c0-1 .5-4 1.25-4.5.5 1 .786 1.293 1.371 1.879A2.99 2.99 0 0113 13a2.99 2.99 0 01-.879 2.121z" clip-rule="evenodd"></path></svg>
                </div>
                <h3 class="text-2xl font-bold text-gray-900 tabular-nums mb-1">45 Days</h3>
                <p class="text-sm text-gray-500">Without a critical breach.</p>
             </div>
         <% end %>

         <!-- Card C: Approvals -->
         <%= render Joyful::CardComponent.new do %>
             <div class="flex flex-col items-center justify-center py-4 h-full text-center">
                 <div class="flex -space-x-2 overflow-hidden mb-4 p-1">
                    <div class="inline-block h-8 w-8 rounded-full ring-2 ring-white bg-indigo-100 flex items-center justify-center text-xs font-bold text-indigo-600">MR</div>
                    <div class="inline-block h-8 w-8 rounded-full ring-2 ring-white bg-green-100 flex items-center justify-center text-xs font-bold text-green-600">SL</div>
                    <div class="inline-block h-8 w-8 rounded-full ring-2 ring-white bg-blue-100 flex items-center justify-center text-xs font-bold text-blue-600">JD</div>
                 </div>
                 <p class="text-sm text-gray-500 mb-3">5 items waiting for review</p>
                 <%= render Joyful::ButtonComponent.new(text: "Review All", variant: :primary, path: "#") %>
             </div>
         <% end %>
      </div>

      <!-- Zone 3: Up Next -->
      <section>
          <div class="flex items-center justify-between mb-4">
             <h2 class="text-xl font-bold text-gray-900">Up Next</h2>
          </div>
          
          <div class="space-y-4">
             <!-- Item 1 -->
             <%= render Joyful::CardComponent.new(padding: false) do %>
                <div class="p-4 flex items-center gap-4 hover:bg-slate-50 transition-colors cursor-pointer group">
                   <div class="p-3 bg-red-50 text-red-600 rounded-xl group-hover:bg-red-100 transition-colors">
                      <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z"></path></svg>
                   </div>
                   <div class="flex-1 min-w-0">
                      <h4 class="text-base font-semibold text-gray-900 truncate">GDPR Annual Review</h4>
                      <p class="text-sm text-orange-600 font-medium">Due Today at 5:00 PM</p>
                   </div>
                   <div class="flex items-center gap-3">
                      <%= render Joyful::StatusPillComponent.new(status: :review, text: "Review Needed") %>
                      <div class="opacity-0 group-hover:opacity-100 transition-opacity">
                         <%= render Joyful::ButtonComponent.new(text: "View", variant: :ghost, data: { controller: "drawer-trigger", action: "click->drawer-trigger#open", drawer_trigger_id_value: "task-drawer" }) %>
                      </div>
                   </div>
                </div>
             <% end %>

             <!-- Item 2 -->
             <%= render Joyful::CardComponent.new(padding: false) do %>
                <div class="p-4 flex items-center gap-4 hover:bg-slate-50 transition-colors cursor-pointer group">
                   <div class="p-3 bg-blue-50 text-blue-600 rounded-xl group-hover:bg-blue-100 transition-colors">
                      <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"></path></svg>
                   </div>
                   <div class="flex-1 min-w-0">
                      <h4 class="text-base font-semibold text-gray-900 truncate">Q3 Financial Audit</h4>
                      <p class="text-sm text-gray-500">Due Tomorrow</p>
                   </div>
                   <div class="flex items-center gap-3">
                      <%= render Joyful::StatusPillComponent.new(status: :in_progress, text: "In Progress") %>
                      <div class="opacity-0 group-hover:opacity-100 transition-opacity">
                        <%= render Joyful::ButtonComponent.new(text: "View", variant: :ghost, data: { controller: "drawer-trigger", action: "click->drawer-trigger#open", drawer_trigger_id_value: "task-drawer" }) %>
                      </div>
                   </div>
                </div>
             <% end %>
          </div>
      </section>
    </div>

    <!-- Right Rail (4 cols) -->
    <div class="col-span-12 lg:col-span-4 space-y-8">
       <section>
          <h2 class="text-lg font-bold text-gray-900 mb-4">Team Activity</h2>
          <div class="relative pl-4 border-l-2 border-slate-100 space-y-8">
              
              <!-- Timeline Item -->
              <div class="relative">
                  <div class="absolute -left-[21px] top-1 h-3 w-3 rounded-full border-2 border-white bg-indigo-500 ring-4 ring-indigo-50"></div>
                  <div class="flex flex-col space-y-1">
                      <div class="flex items-center justify-between">
                          <span class="text-sm font-semibold text-gray-900">Mike Ross</span>
                          <span class="text-xs text-gray-500 tabular-nums">2 min ago</span>
                      </div>
                      <p class="text-sm text-gray-500">
                        Uploaded <span class="font-medium text-gray-900">Q3 Audit Evidence</span>.
                      </p>
                  </div>
              </div>
              
               <!-- Timeline Item -->
              <div class="relative cursor-pointer hover:bg-slate-50 p-2 rounded-lg transition-colors -ml-2" data-controller="confetti" data-action="click->confetti#fire">
                  <div class="absolute -left-[13px] top-3 h-3 w-3 rounded-full border-2 border-white bg-green-500 ring-4 ring-green-50"></div>
                  <div class="flex flex-col space-y-1">
                      <div class="flex items-center justify-between">
                          <span class="text-sm font-semibold text-gray-900">Sarah Lee</span>
                          <span class="text-xs text-gray-500 tabular-nums">2 hrs ago</span>
                      </div>
                      <p class="text-sm text-gray-500">
                        Resolved <span class="font-medium text-gray-900">Access Control Issue</span> 🎉
                      </p>
                  </div>
              </div>

          </div>
       </section>
    </div>
  </div>

  <!-- Detail Drawer -->
  <%= render Joyful::DrawerComponent.new(title: "Task Details", id: "task-drawer") do %>
     <div class="space-y-6">
        <div>
           <h3 class="text-sm font-medium text-gray-500">Description</h3>
           <p class="mt-1 text-sm text-gray-900">
              Review and update the annual GDPR compliance documentation. This includes checking data processing registries and consent forms.
           </p>
        </div>
        
        <div>
           <h3 class="text-sm font-medium text-gray-500">Status</h3>
           <div class="mt-2">
              <%= render Joyful::StatusPillComponent.new(status: :review, text: "Review Needed") %>
           </div>
        </div>
        
        <div class="bg-gray-50 p-4 rounded-lg">
           <h4 class="text-xs font-semibold text-gray-500 uppercase tracking-wider mb-2">Checklist</h4>
           <div class="space-y-2">
              <label class="flex items-center space-x-2">
                 <input type="checkbox" class="rounded text-primary-600 focus:ring-primary-500">
                 <span class="text-sm text-gray-700">Verify Processor Agreements</span>
              </label>
              <label class="flex items-center space-x-2">
                 <input type="checkbox" class="rounded text-primary-600 focus:ring-primary-500">
                 <span class="text-sm text-gray-700">Update Privacy Policy</span>
              </label>
           </div>
        </div>
     </div>
  <% end %>
</div>

