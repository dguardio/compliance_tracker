<div class="container mx-auto px-4 py-8">
  <div class="mb-6">
    <%= link_to "← Back to Organization", organization_path(@organization), 
                class: "text-blue-600 hover:text-blue-800 font-medium" %>
  </div>

  <div class="flex justify-between items-center mb-6">
    <div>
      <h1 class="text-3xl font-bold text-gray-900">Teams</h1>
      <p class="mt-1 text-sm text-gray-500">
        Manage teams for <%= @organization.name %>
      </p>
    </div>
    <div class="flex flex-col sm:flex-row space-y-2 sm:space-y-0 sm:space-x-3">
      <%= link_to "New Team", new_organization_team_path(@organization), 
                  class: "inline-flex items-center justify-center px-4 py-2 border border-transparent text-sm font-medium rounded-md shadow-sm text-white bg-indigo-600 hover:bg-indigo-700 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-indigo-500" %>
    </div>
  </div>

  <% if @teams.any? %>
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
      <% @teams.each do |team| %>
        <div class="bg-white rounded-lg shadow-md p-6 border border-gray-200">
          <div class="flex justify-between items-start mb-4">
            <h3 class="text-xl font-semibold text-gray-900">
              <%= link_to team.name, organization_team_path(@organization, team), 
                          class: "hover:text-blue-600" %>
            </h3>
            <span class="px-2 py-1 text-xs font-medium rounded-full 
                       <%= team.status == 'active' ? 'bg-green-100 text-green-800' : 'bg-gray-100 text-gray-800' %>">
              <%= team.status.titleize %>
            </span>
          </div>
          
          <p class="text-gray-600 mb-4"><%= team.settings&.dig('description') || 'No description' %></p>
          
          <div class="space-y-2 mb-4">
            <div class="flex justify-between text-sm">
              <span class="text-gray-500">Department:</span>
              <span class="font-medium"><%= team.department.name %></span>
            </div>
            <div class="flex justify-between text-sm">
              <span class="text-gray-500">Units:</span>
              <span class="font-medium"><%= team.unit_count %></span>
            </div>
            <div class="flex justify-between text-sm">
              <span class="text-gray-500">Users:</span>
              <span class="font-medium"><%= team.user_count %></span>
            </div>
          </div>
          
          <div class="flex space-x-2">
            <%= link_to "View", organization_team_path(@organization, team), 
                        class: "flex-1 text-center bg-blue-600 hover:bg-blue-700 text-white font-bold py-2 px-4 rounded text-sm" %>
            <%= link_to "Edit", edit_organization_team_path(@organization, team), 
                        class: "flex-1 text-center bg-gray-600 hover:bg-gray-700 text-white font-bold py-2 px-4 rounded text-sm" %>
          </div>
        </div>
      <% end %>
    </div>

    <!-- Pagination -->
    <div class="mt-8">
      <%= paginate @teams %>
    </div>
  <% else %>
    <div class="text-center py-12">
      <div class="text-gray-400 mb-4">
        <svg class="mx-auto h-12 w-12" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0zm6 3a2 2 0 11-4 0 2 2 0 014 0zM7 10a2 2 0 11-4 0 2 2 0 014 0z"></path>
        </svg>
      </div>
      <h3 class="text-lg font-medium text-gray-900 mb-2">No teams yet</h3>
      <p class="text-gray-500 mb-4">Get started by creating teams for your organization.</p>
      <%= link_to "Create Team", new_organization_team_path(@organization), 
                  class: "inline-flex items-center px-4 py-2 border border-transparent shadow-sm text-sm font-medium rounded-md text-white bg-indigo-600 hover:bg-indigo-700 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-indigo-500" %>
    </div>
  <% end %>
</div> 