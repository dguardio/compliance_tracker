<div class="container mx-auto px-4 py-8">
  <!-- Header Section -->
  <div class="flex flex-col md:flex-row justify-between items-start md:items-center mb-8 gap-4">
    <div>
      <h1 class="text-3xl font-bold text-gray-900 tracking-tight">Teams</h1>
      <p class="mt-1 text-gray-500">Organize your people into functional groups for easier management.</p>
    </div>
    <% if policy(Team.new(organization: @organization)).create? %>
      <%= render Joyful::ButtonComponent.new(
          text: "Create Team",
          path: new_organization_team_path(@organization),
          variant: :primary,
          icon: "plus"
        ) %>
    <% end %>
  </div>

  <% if @teams.any? %>
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 gap-6">
      <% @teams.each do |team| %>
        <%= render Joyful::CardComponent.new(class: "h-full flex flex-col group hover:-translate-y-1 transition-all duration-300") do |card| %>
            <div class="flex-grow">
                <div class="flex justify-between items-start mb-4">
                     <div class="w-12 h-12 rounded-xl bg-gradient-to-br from-blue-400 to-indigo-600 flex items-center justify-center text-white font-bold text-lg shadow-lg">
                        <%= team.name.first(2).upcase %>
                    </div>
                    <%= render Joyful::StatusPillComponent.new(status: team.status) %>
                </div>

                <h3 class="text-xl font-bold text-gray-900 mb-2 group-hover:text-primary-600 transition-colors">
                    <%= link_to team.name, organization_team_path(@organization, team) %>
                </h3>

                <p class="text-sm text-gray-500 line-clamp-2 mb-6 h-10">
                    <%= team.settings&.dig('description').presence || "No description provided for this team." %>
                </p>

                <div class="bg-gray-50 rounded-lg p-3 grid grid-cols-2 gap-2 border border-gray-100">
                    <div class="text-center">
                        <span class="block text-lg font-bold text-gray-900 tabular-nums"><%= team.user_count %></span>
                        <span class="text-xs text-gray-500 font-medium uppercase tracking-wide">Members</span>
                    </div>
                    <div class="text-center border-l border-gray-200">
                        <span class="block text-lg font-bold text-gray-900 tabular-nums"><%= team.unit_count %></span>
                        <span class="text-xs text-gray-500 font-medium uppercase tracking-wide">Units</span>
                    </div>
                </div>
            </div>

            <% card.footer do %>
                <div class="flex justify-between items-center w-full mt-4">
                    <span class="text-xs text-gray-400 font-medium truncate max-w-[50%]">
                        <%= team.department.name %>
                    </span>
                    <div class="flex space-x-2">
                         <%= link_to organization_team_path(@organization, team), class: "text-primary-600 hover:text-primary-800 text-sm font-medium transition-colors" do %>
                            Manage Team →
                         <% end %>
                    </div>
                </div>
            <% end %>
        <% end %>
      <% end %>
    </div>

    <!-- Pagination -->
    <div class="mt-8 flex justify-center">
      <%= paginate @teams, theme: 'tailwind' %>
    </div>
  <% else %>
    <div class="text-center py-20 bg-white rounded-xl shadow-sm border border-dashed border-gray-300">
      <div class="mx-auto h-24 w-24 bg-indigo-50 rounded-full flex items-center justify-center mb-6 animate-float">
        <svg class="h-12 w-12 text-indigo-500" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0zm6 3a2 2 0 11-4 0 2 2 0 014 0zM7 10a2 2 0 11-4 0 2 2 0 014 0z" />
        </svg>
      </div>
      <h3 class="text-xl font-bold text-gray-900 mb-2">No Teams Established</h3>
      <p class="text-gray-500 mb-8 max-w-sm mx-auto">Create teams to group users and assign responsibilities effectively.</p>
      <% if policy(Team.new(organization: @organization)).create? %>
        <%= render Joyful::ButtonComponent.new(
            text: "Create Team",
            path: new_organization_team_path(@organization),
            variant: :primary,
            icon: "plus"
        ) %>
      <% end %>
    </div>
  <% end %>
</div>