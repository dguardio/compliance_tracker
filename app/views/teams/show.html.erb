<div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
  <div class="mb-8 flex justify-between items-start">
    <div>
      <h1 class="text-3xl font-bold text-gray-900"><%= @team.name %></h1>
      <p class="mt-2 text-sm text-gray-500"><%= @team.settings&.dig('description') || 'No description provided' %></p>
    </div>
    <div class="flex gap-3">
        <% if @team.persisted? %>
          <% if policy(@team).update? %>
            <%= render Joyful::ButtonComponent.new(
                  text: "Edit",
                  path: edit_organization_team_path(@organization, @team),
                  variant: :secondary,
                  icon: "edit"
                ) %>
          <% end %>
          <% if policy(@team).destroy? %>
            <%= render Joyful::ButtonComponent.new(
                  text: "Delete",
                  path: organization_team_path(@organization, @team),
                  variant: :danger,
                  icon: "trash",
                  method: :delete,
                  confirm: "Are you sure you want to delete this team?"
                ) %>
          <% end %>
        <% end %>
        <%= render Joyful::ButtonComponent.new(
              text: "Back",
              path: organization_teams_path(@organization),
              variant: :secondary,
              icon: "arrow-left"
            ) %>
    </div>
  </div>

  <div class="grid grid-cols-1 md:grid-cols-3 gap-6 mb-8">
    <%= render Joyful::CardComponent.new(title: "Overview", icon: "info-circle", padding: true) do %>
       <dl class="space-y-4">
         <div>
           <dt class="text-sm font-medium text-gray-500">Department</dt>
           <dd class="mt-1 text-sm text-gray-900">
             <%= link_to @team.department.name, organization_department_path(@organization, @team.department), class: "text-primary-600 hover:text-primary-800" %>
           </dd>
         </div>
         <div>
           <dt class="text-sm font-medium text-gray-500">Status</dt>
           <dd class="mt-1">
             <span class="inline-flex items-center rounded-full px-2.5 py-0.5 text-xs font-medium <%= @team.status == 'active' ? 'bg-green-100 text-green-800' : 'bg-gray-100 text-gray-800' %>">
                <%= @team.status.titleize %>
             </span>
           </dd>
         </div>
         <div>
           <dt class="text-sm font-medium text-gray-500">Total Users</dt>
           <dd class="mt-1 text-2xl font-semibold text-gray-900"><%= @team.user_count %></dd>
         </div>
       </dl>
    <% end %>

    <%= render Joyful::CardComponent.new(title: "Units", icon: "layer-group", padding: true, class: "md:col-span-2") do %>
      <div class="mb-4 flex justify-end">
         <% if policy(Unit.new(team: @team)).create? %>
            <%= render Joyful::ButtonComponent.new(
                  text: "New Unit",
                  path: new_organization_unit_path(@organization, team_id: @team.id),
                  variant: :primary,
                  size: :sm,
                  icon: "plus"
                ) %>
         <% end %>
      </div>

      <% if @units.any? %>
        <div class="flow-root">
          <ul role="list" class="-my-5 divide-y divide-gray-200">
            <% @units.each do |unit| %>
              <li class="py-4">
                <div class="flex items-center space-x-4">
                  <div class="flex-shrink-0">
                    <span class="inline-flex items-center justify-center h-10 w-10 rounded-full bg-gray-100">
                      <i class="fas fa-layer-group text-gray-500"></i>
                    </span>
                  </div>
                  <div class="flex-1 min-w-0">
                    <p class="text-sm font-medium text-gray-900 truncate">
                      <%= link_to unit.name, organization_unit_path(@organization, unit), class: "hover:text-primary-600" %>
                    </p>
                    <p class="text-xs text-gray-500 truncate">
                      <%= pluralize(unit.user_count, 'user') %>
                    </p>
                  </div>
                  <div>
                    <span class="inline-flex items-center rounded-md bg-gray-50 px-2 py-1 text-xs font-medium text-gray-600 ring-1 ring-inset ring-gray-500/10"><%= unit.status.titleize %></span>
                  </div>
                </div>
              </li>
            <% end %>
          </ul>
        </div>
      <% else %>
        <div class="text-center py-6 text-gray-500 text-sm">
          No units created for this team yet.
        </div>
      <% end %>
    <% end %>
  </div>
</div> 