<div class="container mx-auto px-4 py-8">
  <div class="mb-6">
    <%= link_to "← Back to Organization", organization_path(@organization), 
                class: "text-blue-600 hover:text-blue-800 font-medium" %>
  </div>

  <div class="bg-white rounded-lg shadow-md p-6 mb-8">
    <div class="flex justify-between items-start mb-6">
      <div>
        <h1 class="text-3xl font-bold text-gray-900 mb-2"><%= @team.name %></h1>
        <p class="text-gray-600 text-lg"><%= @team.settings&.dig('description') || 'No description available' %></p>
      </div>
      <div class="flex space-x-2">
        <% if policy(@team).update? %>
          <%= link_to "Edit", edit_organization_team_path(@organization, @team), 
                      class: "bg-blue-600 hover:bg-blue-700 text-white font-bold py-2 px-4 rounded" %>
        <% end %>
        <% if policy(@team).destroy? %>
          <%= link_to "Delete", organization_team_path(@organization, @team), 
                      method: :delete, 
                      data: { confirm: "Are you sure you want to delete this team?" },
                      class: "bg-red-600 hover:bg-red-700 text-white font-bold py-2 px-4 rounded" %>
        <% end %>
      </div>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6 mb-8">
      <div class="bg-gray-50 rounded-lg p-4">
        <h3 class="text-sm font-medium text-gray-500 mb-1">Department</h3>
        <p class="text-lg font-semibold text-gray-900"><%= @team.department.name %></p>
      </div>
      
      <div class="bg-gray-50 rounded-lg p-4">
        <h3 class="text-sm font-medium text-gray-500 mb-1">Status</h3>
        <p class="text-lg font-semibold">
          <span class="px-2 py-1 text-xs font-medium rounded-full 
                     <%= @team.status == 'active' ? 'bg-green-100 text-green-800' : 'bg-gray-100 text-gray-800' %>">
            <%= @team.status.titleize %>
          </span>
        </p>
      </div>
      
      <div class="bg-gray-50 rounded-lg p-4">
        <h3 class="text-sm font-medium text-gray-500 mb-1">Units</h3>
        <p class="text-lg font-semibold text-gray-900"><%= @units.count %></p>
      </div>
      
      <div class="bg-gray-50 rounded-lg p-4">
        <h3 class="text-sm font-medium text-gray-500 mb-1">Users</h3>
        <p class="text-lg font-semibold text-gray-900"><%= @team.user_count %></p>
      </div>
    </div>

    <% if @team.settings.present? %>
      <div class="border-t border-gray-200 pt-6">
        <h3 class="text-lg font-semibold text-gray-900 mb-4">Team Details</h3>
        <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
          <% @team.settings.each do |key, value| %>
            <div class="flex justify-between">
              <span class="text-gray-600 font-medium"><%= key.titleize %>:</span>
              <span class="text-gray-900"><%= value %></span>
            </div>
          <% end %>
        </div>
      </div>
    <% end %>
  </div>

  <!-- Units Section -->
  <div class="bg-white rounded-lg shadow-md p-6">
    <div class="flex justify-between items-center mb-6">
      <h2 class="text-2xl font-bold text-gray-900">Units</h2>
      <% if policy(Unit.new(team: @team, organization: @organization)).create? %>
        <%= link_to "New Unit", new_organization_unit_path(@organization), 
                    class: "bg-green-600 hover:bg-green-700 text-white font-bold py-2 px-4 rounded" %>
      <% end %>
    </div>

    <% if @units.any? %>
      <div class="space-y-4">
        <% @units.each do |unit| %>
          <div class="border border-gray-200 rounded-lg p-4 hover:bg-gray-50">
            <div class="flex justify-between items-start mb-2">
              <div>
                <h3 class="text-lg font-semibold text-gray-900">
                  <%= link_to unit.name, organization_unit_path(@organization, unit), 
                              class: "hover:text-blue-600" %>
                </h3>
                <p class="text-sm text-gray-500"><%= unit.settings&.dig('description') || 'No description' %></p>
              </div>
              <div class="flex space-x-2">
                <span class="px-2 py-1 text-xs font-medium rounded-full 
                           <%= unit.status == 'active' ? 'bg-green-100 text-green-800' : 'bg-gray-100 text-gray-800' %>">
                  <%= unit.status.titleize %>
                </span>
              </div>
            </div>
            <div class="flex justify-between items-center text-sm text-gray-500">
              <span>Users: <%= unit.user_count %></span>
              <span>Created: <%= unit.created_at.strftime("%B %d, %Y") %></span>
            </div>
          </div>
        <% end %>
      </div>
    <% else %>
      <div class="text-center py-8">
        <div class="text-gray-400 mb-4">
          <svg class="mx-auto h-12 w-12" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"></path>
          </svg>
        </div>
        <h3 class="text-lg font-medium text-gray-900 mb-2">No units yet</h3>
        <p class="text-gray-500 mb-4">Add units to this team to get started.</p>
        <% if policy(Unit.new(team: @team, organization: @organization)).create? %>
          <%= link_to "Add Unit", new_organization_unit_path(@organization), 
                      class: "bg-green-600 hover:bg-green-700 text-white font-bold py-2 px-4 rounded" %>
        <% end %>
      </div>
    <% end %>
  </div>
</div> 