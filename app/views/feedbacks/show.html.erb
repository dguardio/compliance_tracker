<div class="max-w-4xl mx-auto py-10 px-4 sm:px-6 lg:px-8">
  <div class="mb-6">
    <%= link_to "← Back to Feedback", feedbacks_path, class: "text-blue-600 hover:text-blue-800 font-medium" %>
  </div>

  <div class="bg-white shadow overflow-hidden sm:rounded-lg">
    <div class="px-4 py-5 sm:px-6">
      <h3 class="text-lg leading-6 font-medium text-gray-900">Feedback Details</h3>
      <p class="mt-1 max-w-2xl text-sm text-gray-500">Submitted by <%= @feedback.user.full_name %> on <%= @feedback.created_at.strftime('%Y-%m-%d %H:%M') %></p>
    </div>
    <div class="border-t border-gray-200 px-4 py-5 sm:p-0">
      <dl class="sm:divide-y sm:divide-gray-200">
        <div class="py-4 sm:py-5 sm:grid sm:grid-cols-3 sm:gap-4 sm:px-6">
          <dt class="text-sm font-medium text-gray-500">Feedbackable Item</dt>
          <dd class="mt-1 text-sm text-gray-900 sm:mt-0 sm:col-span-2">
            <%= link_to @feedback.feedbackable.name, polymorphic_path(@feedback.feedbackable), class: "text-indigo-600 hover:text-indigo-900" %>
            (<%= @feedback.feedbackable_type %>)
          </dd>
        </div>
        <div class="py-4 sm:py-5 sm:grid sm:grid-cols-3 sm:gap-4 sm:px-6">
          <dt class="text-sm font-medium text-gray-500">Content</dt>
          <dd class="mt-1 text-sm text-gray-900 sm:mt-0 sm:col-span-2">
            <%= @feedback.content %>
          </dd>
        </div>
        <div class="py-4 sm:py-5 sm:grid sm:grid-cols-3 sm:gap-4 sm:px-6">
          <dt class="text-sm font-medium text-gray-500">Status</dt>
          <dd class="mt-1 text-sm text-gray-900 sm:mt-0 sm:col-span-2">
            <span class="px-2 inline-flex text-xs leading-5 font-semibold rounded-full <%= @feedback.open? ? 'bg-yellow-100 text-yellow-800' : 'bg-green-100 text-green-800' %>">
              <%= @feedback.status.humanize %>
            </span>
            <% unless @feedback.resolved? %>
              <%= form_with(model: @feedback, class: "inline-block ml-4") do |form| %>
                <%= form.hidden_field :status, value: 'resolved' %>
                <%= form.submit "Mark as Resolved", class: "cursor-pointer rounded-md bg-green-600 px-3 py-1 text-xs font-semibold text-white shadow-sm hover:bg-green-500" %>
              <% end %>
            <% end %>
          </dd>
        </div>
      </dl>
    </div>
  </div>
</div>
