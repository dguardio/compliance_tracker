<div class="container mx-auto px-4 py-8">
  <div class="max-w-4xl mx-auto">
    <!-- Header -->
    <div class="mb-8">
      <div class="flex justify-between items-center">
        <h1 class="text-3xl font-bold text-gray-900">My Profile</h1>
        <%= link_to "Edit Profile", edit_profile_path, 
                    class: "bg-blue-600 hover:bg-blue-700 text-white font-bold py-2 px-4 rounded" %>
      </div>
    </div>

    <div class="grid grid-cols-1 lg:grid-cols-3 gap-8">
      <!-- Main Profile Information -->
      <div class="lg:col-span-2 space-y-6">
        <!-- Basic Information Card -->
        <div class="bg-white rounded-lg shadow-md p-6">
          <div class="flex items-center mb-6">
            <div class="h-16 w-16 bg-blue-100 rounded-full flex items-center justify-center">
              <span class="text-2xl font-bold text-blue-600">
                <%= @user.first_name&.first&.upcase || @user.email.first.upcase %>
              </span>
            </div>
            <div class="ml-4">
              <h2 class="text-xl font-semibold text-gray-900"><%= @user.full_name %></h2>
              <p class="text-gray-600"><%= @user.email %></p>
              <% if @user.job_title.present? %>
                <p class="text-sm text-gray-500"><%= @user.job_title %></p>
              <% end %>
            </div>
          </div>

          <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
            <div>
              <h3 class="text-sm font-medium text-gray-500 mb-2">Contact Information</h3>
              <div class="space-y-2">
                <% if @user.phone.present? %>
                  <div class="flex items-center">
                    <svg class="h-4 w-4 text-gray-400 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"></path>
                    </svg>
                    <span class="text-gray-900"><%= @user.phone %></span>
                  </div>
                <% end %>
                <div class="flex items-center">
                  <svg class="h-4 w-4 text-gray-400 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 12a4 4 0 10-8 0 4 4 0 008 0zm0 0v1.5a2.5 2.5 0 005 0V12a9 9 0 10-9 9m4.5-1.206a8.959 8.959 0 01-4.5 1.207"></path>
                  </svg>
                  <span class="text-gray-900"><%= @user.email %></span>
                </div>
                <% if @user.timezone.present? %>
                  <div class="flex items-center">
                    <svg class="h-4 w-4 text-gray-400 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"></path>
                    </svg>
                    <span class="text-gray-900"><%= @user.timezone %></span>
                  </div>
                <% end %>
              </div>
            </div>

            <div>
              <h3 class="text-sm font-medium text-gray-500 mb-2">Organization</h3>
              <div class="space-y-2">
                <div class="flex items-center">
                  <svg class="h-4 w-4 text-gray-400 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4"></path>
                  </svg>
                  <span class="text-gray-900"><%= @user.organization.name %></span>
                </div>
                <% if @user.department.present? %>
                  <div class="flex items-center">
                    <svg class="h-4 w-4 text-gray-400 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4"></path>
                    </svg>
                    <span class="text-gray-900"><%= @user.department.name %></span>
                  </div>
                <% end %>
                <% if @user.team.present? %>
                  <div class="flex items-center">
                    <svg class="h-4 w-4 text-gray-400 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0zm6 3a2 2 0 11-4 0 2 2 0 014 0zM7 10a2 2 0 11-4 0 2 2 0 014 0z"></path>
                    </svg>
                    <span class="text-gray-900"><%= @user.team.name %></span>
                  </div>
                <% end %>
                <% if @user.unit.present? %>
                  <div class="flex items-center">
                    <svg class="h-4 w-4 text-gray-400 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0zm6 3a2 2 0 11-4 0 2 2 0 014 0zM7 10a2 2 0 11-4 0 2 2 0 014 0z"></path>
                    </svg>
                    <span class="text-gray-900"><%= @user.unit.name %></span>
                  </div>
                <% end %>
              </div>
            </div>
          </div>
        </div>

        <!-- Roles and Permissions Card -->
        <div class="bg-white rounded-lg shadow-md p-6">
          <h3 class="text-lg font-semibold text-gray-900 mb-4">Roles & Permissions</h3>
          <% if @roles.any? %>
            <div class="space-y-3">
              <% @roles.each do |role| %>
                <div class="flex items-center justify-between p-3 bg-gray-50 rounded-lg">
                  <div>
                    <span class="font-medium text-gray-900"><%= role.name.titleize %></span>
                    <% if role.resource_type.present? %>
                      <span class="text-sm text-gray-500 ml-2">(<%= role.resource_type %>)</span>
                    <% end %>
                  </div>
                  <span class="px-2 py-1 text-xs font-medium bg-blue-100 text-blue-800 rounded-full">
                    Active
                  </span>
                </div>
              <% end %>
            </div>
          <% else %>
            <p class="text-gray-500">No roles assigned.</p>
          <% end %>
        </div>

        <!-- Recent Activity Card -->
        <div class="bg-white rounded-lg shadow-md p-6">
          <h3 class="text-lg font-semibold text-gray-900 mb-4">Recent Notifications</h3>
          <% if @notifications.any? %>
            <div class="space-y-3">
              <% @notifications.each do |notification| %>
                <div class="flex items-start space-x-3 p-3 bg-gray-50 rounded-lg">
                  <div class="flex-shrink-0">
                    <div class="h-8 w-8 bg-blue-100 rounded-full flex items-center justify-center">
                      <svg class="h-4 w-4 text-blue-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 17h5l-5 5v-5zM4 19h6v-2H4v2zM20 9h-6v2h6V9zM4 15h6v-2H4v2z"></path>
                      </svg>
                    </div>
                  </div>
                  <div class="flex-1 min-w-0">
                    <p class="text-sm text-gray-900"><%= notification.message %></p>
                    <p class="text-xs text-gray-500"><%= time_ago_in_words(notification.created_at) %> ago</p>
                  </div>
                </div>
              <% end %>
            </div>
            <div class="mt-4">
              <%= link_to "View All Notifications", mailboxes_path, 
                          class: "text-blue-600 hover:text-blue-800 text-sm font-medium" %>
            </div>
          <% else %>
            <p class="text-gray-500">No recent notifications.</p>
          <% end %>
        </div>
      </div>

      <!-- Sidebar -->
      <div class="space-y-6">
        <!-- Quick Actions Card -->
        <div class="bg-white rounded-lg shadow-md p-6">
          <h3 class="text-lg font-semibold text-gray-900 mb-4">Quick Actions</h3>
          <div class="space-y-3">
            <%= link_to edit_profile_path, 
                        class: "flex items-center p-3 text-gray-700 hover:bg-gray-50 rounded-lg transition-colors" do %>
              <svg class="h-5 w-5 text-gray-400 mr-3" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z"></path>
              </svg>
              <span>Edit Profile</span>
            <% end %>
            
            <%= link_to dashboard_path, 
                        class: "flex items-center p-3 text-gray-700 hover:bg-gray-50 rounded-lg transition-colors" do %>
              <svg class="h-5 w-5 text-gray-400 mr-3" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 7v10a2 2 0 002 2h14a2 2 0 002-2V9a2 2 0 00-2-2H5a2 2 0 00-2-2z"></path>
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 5a2 2 0 012-2h4a2 2 0 012 2v6H8V5z"></path>
              </svg>
              <span>Dashboard</span>
            <% end %>
            
            <%= link_to risk_dashboard_path, 
                        class: "flex items-center p-3 text-gray-700 hover:bg-gray-50 rounded-lg transition-colors" do %>
              <svg class="h-5 w-5 text-gray-400 mr-3" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-2.5L13.732 4c-.77-.833-1.964-.833-2.732 0L3.732 16.5c-.77.833.192 2.5 1.732 2.5z"></path>
              </svg>
              <span>Risk Dashboard</span>
            <% end %>
          </div>
        </div>

        <!-- Settings Summary Card -->
        <div class="bg-white rounded-lg shadow-md p-6">
          <h3 class="text-lg font-semibold text-gray-900 mb-4">Settings</h3>
          <div class="space-y-3">
            <div class="flex items-center justify-between">
              <span class="text-sm text-gray-600">Notifications</span>
              <span class="text-sm text-gray-900">
                <%= @user.settings&.dig('notification_settings', 'email_enabled') ? 'On' : 'Off' %>
              </span>
            </div>
            <div class="flex items-center justify-between">
              <span class="text-sm text-gray-600">Timezone</span>
              <span class="text-sm text-gray-900"><%= @user.timezone || 'Not set' %></span>
            </div>
            <div class="flex items-center justify-between">
              <span class="text-sm text-gray-600">Last Login</span>
              <span class="text-sm text-gray-900">
                <% if @user.current_sign_in_at %>
                  <%= time_ago_in_words(@user.current_sign_in_at) %> ago
                <% else %>
                  Never
                <% end %>
              </span>
            </div>
            <div class="flex items-center justify-between">
              <span class="text-sm text-gray-600">Sign-in Count</span>
              <span class="text-sm text-gray-900"><%= @user.sign_in_count %></span>
            </div>
            <% if @user.current_sign_in_ip.present? %>
              <div class="flex items-center justify-between">
                <span class="text-sm text-gray-600">Current IP</span>
                <span class="text-sm text-gray-900"><%= @user.current_sign_in_ip %></span>
              </div>
            <% end %>
          </div>
        </div>
      </div>
    </div>
  </div>
</div> 