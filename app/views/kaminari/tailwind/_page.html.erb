<% if page.current? %>
  <a href="#" aria-current="page" class="inline-flex items-center border-t-2 border-primary-500 px-4 pt-4 text-sm font-medium text-primary-600">
    <%= page %>
  </a>
<% else %>
  <a href="<%= url %>" class="inline-flex items-center border-t-2 border-transparent px-4 pt-4 text-sm font-medium text-gray-500 hover:border-gray-300 hover:text-gray-700">
    <%= page %>
  </a>
<% end %>
