<%# locals: { organization: organization } %>
<% profile = organization.settings['ai_compliance_profile'] || {} %>
<% report = organization.settings['ai_research_report'] %>
<% error = organization.settings['ai_research_error'] %>

<div id="compliance_profile_card" class="bg-white rounded-card shadow-sm border border-slate-100 p-6 mb-8 animate-fade-in-up">
  <% if error %>
    <div class="rounded-md bg-red-50 p-4 mb-4">
      <div class="flex">
        <div class="flex-shrink-0">
          <svg class="h-5 w-5 text-red-400" viewBox="0 0 20 20" fill="currentColor">
            <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zM8.707 7.293a1 1 0 00-1.414 1.414L8.586 10l-1.293 1.293a1 1 0 101.414 1.414L10 11.414l1.293 1.293a1 1 0 001.414-1.414L11.414 10l1.293-1.293a1 1 0 00-1.414-1.414L10 8.586 8.707 7.293z" clip-rule="evenodd"/>
          </svg>
        </div>
        <div class="ml-3">
          <h3 class="text-sm font-medium text-red-800">Research Agent Encountered an Error</h3>
          <div class="mt-2 text-sm text-red-700">
            <p><%= error %></p>
            <p class="mt-1 text-xs">Time: <%= organization.settings['ai_research_error_at'] %></p>
          </div>
        </div>
      </div>
    </div>
  <% end %>

  <div class="flex items-center justify-between mb-4">
    <div class="flex items-center gap-2">
      <div class="p-2 bg-indigo-50 text-indigo-600 rounded-lg">
        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19.428 15.428a2 2 0 00-1.022-.547l-2.387-.477a6 6 0 00-3.86.517l-.318.158a6 6 0 01-3.86.517L6.05 15.21a2 2 0 00-1.806.547M8 4h8l-1 1v5.172a2 2 0 00.586 1.414l5 5c1.26 1.26.367 3.414-1.415 3.414H4.828c-1.782 0-2.674-2.154-1.414-3.414l5-5A2 2 0 009 10.172V5L8 4z"></path></svg>
      </div>
      <div>
        <h3 class="text-lg font-bold text-gray-900">Compliance Profile</h3>
        <p class="text-sm text-gray-500">AI-generated insights about your regulatory environment.</p>
      </div>
    </div>
    
    <%# Check if current_user exists (it might be nil during Turbo Stream broadcast) %>
    <% user = local_assigns[:current_user] || (defined?(current_user) ? current_user : nil) %>
    
    <% if user&.can_manage_organization?(organization) %>
      <%= button_to enrich_organization_path(organization), 
            method: :post, 
            class: "text-sm text-indigo-600 hover:text-indigo-800 font-medium flex items-center gap-1 transition-colors",  
            form: { data: { turbo_confirm: "This will start a background research agent. It may take a minute. Continue?" } },
            data: { turbo: false } do %>
        
        <span class="flex items-center gap-1" id="enrich_btn_text_<%= organization.id %>">
           <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15"></path></svg>
           <%= profile.present? ? "Re-Enrich Profile" : "Enrich Profile" %>
        </span>
      <% end %>

    <% end %>
  </div>

  <!-- Agent Trace Log (Initially Hidden) -->
  <div id="agent_trace_log" class="hidden bg-slate-900 border border-slate-700 rounded-md p-4 mb-6 font-mono text-xs text-green-400 leading-relaxed shadow-inner max-h-48 overflow-y-auto custom-scrollbar">
    <div class="flex items-center gap-2 mb-2 border-b border-slate-800 pb-2 text-slate-500">
      <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 9l3 3-3 3m5 0h3M5 20h14a2 2 0 002-2V6a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"></path></svg>
      <span>Agent Terminal</span>
    </div>
    <div id="agent_trace_content" class="space-y-1">
      <!-- Live logs will appear here -->
    </div>
  </div>

  <% if profile.present? %>
    <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
      
      <!-- Jurisdictions -->
      <div class="bg-gray-50 rounded-lg p-4 custom-scrollbar">
        <h4 class="text-xs font-semibold text-gray-500 uppercase tracking-wide mb-3">Operating Jurisdictions</h4>
        <div class="flex flex-wrap gap-2">
          <% (profile['jurisdictions'] || []).each do |jur| %>
            <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-blue-100 text-blue-800">
              <%= jur %>
            </span>
          <% end %>
          <% if (profile['jurisdictions'] || []).empty? %>
            <span class="text-sm text-gray-400 italic">None detected</span>
          <% end %>
        </div>
      </div>

      <!-- Industries -->
      <div class="bg-gray-50 rounded-lg p-4">
        <h4 class="text-xs font-semibold text-gray-500 uppercase tracking-wide mb-3">Industries</h4>
        <div class="flex flex-wrap gap-2">
          <% (profile['industries'] || []).each do |ind| %>
            <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-purple-100 text-purple-800">
              <%= ind %>
            </span>
          <% end %>
          <% if (profile['industries'] || []).empty? %>
             <span class="text-sm text-gray-400 italic">None detected</span>
          <% end %>
        </div>
      </div>

      <!-- Data Types -->
      <div class="bg-gray-50 rounded-lg p-4">
        <h4 class="text-xs font-semibold text-gray-500 uppercase tracking-wide mb-3">Data Types</h4>
        <div class="flex flex-wrap gap-2">
          <% (profile['data_types'] || []).each do |dt| %>
            <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-rose-100 text-rose-800">
              <%= dt %>
            </span>
          <% end %>
          <% if (profile['data_types'] || []).empty? %>
             <span class="text-sm text-gray-400 italic">None detected</span>
          <% end %>
        </div>
      </div>
      
    </div>
    
    <% if profile['summary'].present? %>
      <div class="mt-4 pt-4 border-t border-gray-200">
          <h4 class="text-xs font-semibold text-gray-500 uppercase tracking-wide mb-2">AI Summary</h4>
          <p class="text-sm text-gray-600 leading-relaxed"><%= profile['summary'] %></p>
      </div>
    <% end %>

  <% else %>
    <!-- Empty State -->
    <div class="text-center py-8">
      <div class="mx-auto h-12 w-12 text-gray-300 mb-3">
        <svg fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19.428 15.428a2 2 0 00-1.022-.547l-2.387-.477a6 6 0 00-3.86.517l-.318.158a6 6 0 01-3.86.517L6.05 15.21a2 2 0 00-1.806.547M8 4h8l-1 1v5.172a2 2 0 00.586 1.414l5 5c1.26 1.26.367 3.414-1.415 3.414H4.828c-1.782 0-2.674-2.154-1.414-3.414l5-5A2 2 0 009 10.172V5L8 4z"></path></svg>
      </div>
      <h3 class="text-sm font-medium text-gray-900">No Compliance Profile Found</h3>
      <p class="mt-1 text-sm text-gray-500 max-w-sm mx-auto p-4">Run the enrichment agent to scan your public presence and automatically detect jurisdictions, industries, and data risks.</p>
       <% if user&.can_manage_organization?(organization) %>
         <%= button_to enrich_organization_path(organization), 
               method: :post,  
              class: "inline-flex items-center px-4 py-2 border border-transparent text-sm font-medium rounded-md shadow-sm text-white bg-indigo-600 hover:bg-indigo-700 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-indigo-500 mt-2", 
              form: { data: { turbo_confirm: "Start research agent?" } },
              data: { turbo: false } do %>
          <span id="enrich_btn_text_empty_<%= organization.id %>">Start Research</span>
        <% end %>

      <% end %>

      <!-- Unified Script for Instant Feedback on ALL Enrich Buttons -->
      <script>
        (function() {
          const enrichForms = document.querySelectorAll('form[action="<%= enrich_organization_path(organization) %>"]');
          enrichForms.forEach(form => {
            form.addEventListener('submit', function(e) {
               const btn = this.querySelector('button');
               // Prevent double-clicks
               if (btn.disabled) return;
               btn.disabled = true;
               
               // Instant visual feedback
               const originalContent = btn.innerHTML;
               btn.innerHTML = `
                 <svg class="animate-spin -ml-1 mr-2 h-4 w-4 text-currentColor" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24">
                   <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
                   <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path>
                 </svg>
                 <span>Researching...</span>
               `;
               
               // The Turbo Stream will replace this button shortly, 
               // but we set a timeout just in case of network lag to show "Agent Started"
               setTimeout(() => {
                 if(document.body.contains(btn)) {
                    btn.innerHTML = `<span class="opacity-75">Agent Started...</span>`;
                 }
               }, 1500);
            });
          });
        })();
      </script>
    </div>
  <% end %>
</div>
