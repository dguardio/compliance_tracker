<%= turbo_stream.replace "flash" do %>
  <%= render "shared/flash", flash: { notice: "Deep Research initiated. We're building your compliance profile..." } %>
<% end %>

<%= turbo_stream.replace "enrich_btn_text_#{organization.id}" do %>
  <span class="flex items-center gap-1 text-indigo-400">
    <svg class="animate-spin h-4 w-4" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24">
      <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
      <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path>
    </svg>
    Scanning...
  </span>
<% end %>

<%= turbo_stream.replace "enrich_btn_text_empty_#{organization.id}" do %>
  <span class="flex items-center gap-1">
    <svg class="animate-spin h-4 w-4" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24">
      <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
      <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path>
    </svg>
    Scanning...
  </span>
<% end %>

<%= turbo_stream.replace "agent_trace_log" do %>
  <div id="agent_trace_log" class="bg-slate-900 border border-slate-700 rounded-md p-4 mb-6 font-mono text-xs text-green-400 leading-relaxed shadow-inner max-h-48 overflow-y-auto custom-scrollbar animate-fade-in-down">
    <div class="flex items-center gap-2 mb-2 border-b border-slate-800 pb-2 text-slate-500">
      <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 9l3 3-3 3m5 0h3M5 20h14a2 2 0 002-2V6a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"></path></svg>
      <span>Agent Terminal</span>
    </div>
    <div id="agent_trace_content" class="space-y-1">
      <div class="flex items-center gap-2">
        <span class="text-slate-500">[<%= Time.current.strftime("%H:%M:%S") %>]</span>
        <span class="text-blue-400">🚀 Initializing Research Agent...</span>
      </div>
    </div>
  </div>
<% end %>
