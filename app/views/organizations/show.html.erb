<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8 animate-fade-in-up">
  <!-- Header -->
  <div class="flex items-end justify-between mb-8">
    <div>
      <h1 class="text-3xl font-bold text-gray-900 tracking-tight">Mission Control</h1>
      <p class="mt-2 text-lg text-gray-500">Manage <span class="font-semibold text-indigo-600"><%= @organization.name %></span> structure and settings.</p>
    </div>
    <div class="flex gap-3">
        <%= render Joyful::ButtonComponent.new(text: "Back to Dashboard", variant: :secondary, path: dashboard_path) %>
        <% if current_user.can_manage_organization?(@organization) %>
          <%= render Joyful::ButtonComponent.new(text: "Edit Settings", variant: :primary, path: edit_organization_path(@organization), icon: "fa fa-cog") %>
        <% end %>
    </div>
  </div>

  <!-- Stats Grid -->
  <div class="grid grid-cols-1 md:grid-cols-4 gap-6 mb-8">
     <div class="bg-white p-4 rounded-card shadow-sm border border-slate-100 flex items-center gap-4">
        <div class="p-3 bg-indigo-50 text-indigo-600 rounded-full">
           <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4"></path></svg>
        </div>
        <div>
           <p class="text-xs font-semibold text-gray-400 uppercase tracking-wide">Departments</p>
           <p class="text-2xl font-bold text-gray-900 tabular-nums"><%= @stats[:departments] %></p>
        </div>
     </div>
     <div class="bg-white p-4 rounded-card shadow-sm border border-slate-100 flex items-center gap-4">
        <div class="p-3 bg-fuchsia-50 text-fuchsia-600 rounded-full">
           <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0zm6 3a2 2 0 11-4 0 2 2 0 014 0zM7 10a2 2 0 11-4 0 2 2 0 014 0z"></path></svg>
        </div>
         <div>
           <p class="text-xs font-semibold text-gray-400 uppercase tracking-wide">Teams</p>
           <p class="text-2xl font-bold text-gray-900 tabular-nums"><%= @stats[:teams] %></p>
        </div>
     </div>
     <div class="bg-white p-4 rounded-card shadow-sm border border-slate-100 flex items-center gap-4">
         <div class="p-3 bg-emerald-50 text-emerald-600 rounded-full">
           <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"></path></svg>
        </div>
         <div>
           <p class="text-xs font-semibold text-gray-400 uppercase tracking-wide">Units</p>
           <p class="text-2xl font-bold text-gray-900 tabular-nums"><%= @stats[:units] %></p>
        </div>
     </div>
     <div class="bg-white p-4 rounded-card shadow-sm border border-slate-100 flex items-center gap-4">
         <div class="p-3 bg-rose-50 text-rose-600 rounded-full">
           <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4.354a4 4 0 110 5.292M15 21H3v-1a6 6 0 0112 0v1zm0 0h6v-1a6 6 0 00-9-5.197m13.5-9a2.5 2.5 0 11-5 0 2.5 2.5 0 015 0z"></path></svg>
        </div>
         <div>
           <p class="text-xs font-semibold text-gray-400 uppercase tracking-wide">Users</p>
           <p class="text-2xl font-bold text-gray-900 tabular-nums"><%= @stats[:users] %></p>
        </div>
     </div>
  </div>

  <div class="grid grid-cols-1 gap-8">
     
     <!-- Departments Section -->
     <%= render Joyful::CardComponent.new(padding: true) do %>
        <div class="flex items-center justify-between mb-6">
           <div>
              <h2 class="text-xl font-bold text-gray-900">Departments</h2>
              <p class="text-sm text-gray-500">The high-level divisions of your organization.</p>
           </div>
           <% if current_user.can_manage_organization?(@organization) %>
              <%= render Joyful::ButtonComponent.new(text: "Add Department", variant: :secondary, path: new_organization_department_path(@organization)) %>
           <% end %>
        </div>
        
        <% if @departments.any? %>
           <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4">
              <% @departments.each do |dept| %>
                 <div class="p-4 border border-slate-200 rounded-lg hover:border-indigo-300 hover:shadow-md transition-all group">
                    <div class="flex justify-between items-start mb-2">
                       <h3 class="font-bold text-gray-900"><%= link_to dept.name, organization_department_path(@organization, dept) %></h3>
                       <%= render Joyful::StatusPillComponent.new(status: dept.status, text: dept.status) %>
                    </div>
                    <p class="text-sm text-gray-500 mb-4 line-clamp-2"><%= dept.settings['description'] || 'No description' %></p>
                    <div class="flex items-center gap-4 text-xs text-gray-400">
                       <span class="flex items-center gap-1"><svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0zm6 3a2 2 0 11-4 0 2 2 0 014 0zM7 10a2 2 0 11-4 0 2 2 0 014 0z"></path></svg> <%= dept.team_count %> Teams</span>
                       <span class="flex items-center gap-1"><svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"></path></svg> <%= dept.user_count %> Users</span>
                    </div>
                 </div>
              <% end %>
           </div>
        <% else %>
           <p class="text-center text-gray-400 italic py-4">No departments found.</p>
        <% end %>
     <% end %>

     <!-- Organization Users -->
     <%= render Joyful::CardComponent.new(padding: true) do %>
        <div class="flex items-center justify-between mb-6">
           <div>
              <h2 class="text-xl font-bold text-gray-900">Team Members</h2>
              <p class="text-sm text-gray-500">Everyone who makes compliance happen.</p>
           </div>
           <% if current_user.can_manage_organization?(@organization) %>
              <%= render Joyful::ButtonComponent.new(text: "Add Member", variant: :secondary, path: new_users_registration_path) %>
           <% end %>
        </div>

         <% if @users.any? %>
            <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4">
               <% @users.each do |user| %>
                  <div class="flex items-center gap-3 p-3 border border-slate-100 rounded-lg hover:bg-slate-50">
                     <div class="h-10 w-10 rounded-full bg-indigo-500 flex items-center justify-center text-white font-bold flex-shrink-0">
                        <%= user.first_name&.first || user.email.first.upcase %>
                     </div>
                     <div class="min-w-0">
                        <p class="text-sm font-semibold text-gray-900 truncate"><%= user.full_name %></p>
                        <p class="text-xs text-gray-500 truncate"><%= user.email %></p>
                     </div>
                  </div>
               <% end %>
            </div>
         <% else %>
            <p class="text-center text-gray-400 italic py-4">No users found.</p>
         <% end %>
     <% end %>

  </div>
</div>
