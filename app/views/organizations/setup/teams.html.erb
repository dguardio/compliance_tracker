<div class="max-w-3xl mx-auto py-8 px-4 sm:px-6 lg:px-8">
  <div class="mb-8">
    <h1 class="text-3xl font-bold text-gray-900">Step 2: Create Teams</h1>
    <p class="mt-2 text-sm text-gray-600">Teams belong to departments and represent functional groups (e.g., DevOps, Recruitment).</p>
  </div>

  <!-- List existing -->
  <% if @teams.any? %>
    <div class="bg-white shadow overflow-hidden sm:rounded-md mb-8">
      <ul class="divide-y divide-gray-200">
        <% @teams.each do |team| %>
          <li class="px-4 py-4 sm:px-6">
            <div class="flex items-center justify-between">
              <div>
                <p class="text-sm font-medium text-indigo-600 truncate"><%= team.name %></p>
                <p class="text-xs text-gray-500"><%= team.department.name %></p>
              </div>
            </div>
          </li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <!-- Add new -->
  <div class="bg-white shadow sm:rounded-lg mb-8">
    <div class="px-4 py-5 sm:p-6">
      <h3 class="text-lg leading-6 font-medium text-gray-900">Add a Team</h3>
      <%= form_with(model: [@organization, @team], url: organization_setup_path(@organization, :teams), method: :patch, class: "mt-5 space-y-6") do |f| %>
        <div>
          <%= f.label :department_id, "Department", class: "block text-sm font-medium text-gray-700" %>
          <div class="mt-1">
            <%= f.collection_select :department_id, @organization.departments, :id, :name, {}, class: "shadow-sm focus:ring-indigo-500 focus:border-indigo-500 block w-full sm:text-sm border-gray-300 rounded-md" %>
          </div>
        </div>
        <div>
          <%= f.label :name, class: "block text-sm font-medium text-gray-700" %>
          <div class="mt-1">
            <%= f.text_field :name, class: "shadow-sm focus:ring-indigo-500 focus:border-indigo-500 block w-full sm:text-sm border-gray-300 rounded-md" %>
          </div>
        </div>
        <div>
          <%= f.label :description, class: "block text-sm font-medium text-gray-700" %>
          <div class="mt-1">
            <%= f.text_area :description, rows: 3, class: "shadow-sm focus:ring-indigo-500 focus:border-indigo-500 block w-full sm:text-sm border-gray-300 rounded-md" %>
          </div>
        </div>
        <%= f.submit "Add Team", class: "inline-flex items-center px-4 py-2 border border-transparent text-sm font-medium rounded-md shadow-sm text-white bg-indigo-600 hover:bg-indigo-700 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-indigo-500" %>
      <% end %>
    </div>
  </div>

  <div class="flex justify-between">
    <%= link_to "← Back", organization_setup_path(@organization, :departments), class: "inline-flex justify-center py-2 px-4 border border-gray-300 shadow-sm text-sm font-medium rounded-md text-gray-700 bg-white hover:bg-gray-50 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-indigo-500" %>
    <%= link_to "Next: Create Units →", organization_setup_path(@organization, :units), class: "ml-3 inline-flex justify-center py-2 px-4 border border-transparent shadow-sm text-sm font-medium rounded-md text-white bg-green-600 hover:bg-green-700 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-green-500" %>
  </div>
</div>
