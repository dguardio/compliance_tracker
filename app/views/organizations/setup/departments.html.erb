<div class="max-w-3xl mx-auto py-8 px-4 sm:px-6 lg:px-8">
  <div class="mb-8">
    <h1 class="text-3xl font-bold text-gray-900">Step 1: Create Departments</h1>
    <p class="mt-2 text-sm text-gray-600">Departments are the top-level divisions in your organization (e.g., IT, HR, Finance).</p>
  </div>

  <!-- List existing -->
  <% if @departments.any? %>
    <div class="bg-white shadow overflow-hidden sm:rounded-md mb-8">
      <ul class="divide-y divide-gray-200">
        <% @departments.each do |dept| %>
          <li class="px-4 py-4 sm:px-6">
            <div class="flex items-center justify-between">
              <p class="text-sm font-medium text-indigo-600 truncate"><%= dept.name %></p>
            </div>
          </li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <!-- Add new -->
  <div class="bg-white shadow sm:rounded-lg mb-8">
    <div class="px-4 py-5 sm:p-6">
      <h3 class="text-lg leading-6 font-medium text-gray-900">Add a Department</h3>
      <%= form_with(model: [@organization, @department], url: organization_setup_path(@organization, :departments), method: :patch, class: "mt-5 space-y-6") do |f| %>
        <div>
          <%= f.label :name, class: "block text-sm font-medium text-gray-700" %>
          <div class="mt-1">
            <%= f.text_field :name, class: "shadow-sm focus:ring-indigo-500 focus:border-indigo-500 block w-full sm:text-sm border-gray-300 rounded-md" %>
          </div>
        </div>
        <div>
          <%= f.label :description, class: "block text-sm font-medium text-gray-700" %>
          <div class="mt-1">
            <%= f.text_area :description, rows: 3, class: "shadow-sm focus:ring-indigo-500 focus:border-indigo-500 block w-full sm:text-sm border-gray-300 rounded-md" %>
          </div>
        </div>
        <%= f.submit "Add Department", class: "inline-flex items-center px-4 py-2 border border-transparent text-sm font-medium rounded-md shadow-sm text-white bg-indigo-600 hover:bg-indigo-700 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-indigo-500" %>
      <% end %>
    </div>
  </div>

  <div class="flex justify-end">
    <%= link_to "Next: Create Teams →", organization_setup_path(@organization, :teams), class: "ml-3 inline-flex justify-center py-2 px-4 border border-transparent shadow-sm text-sm font-medium rounded-md text-white bg-green-600 hover:bg-green-700 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-green-500" %>
  </div>
</div>
