<div class="min-h-screen bg-gray-50 py-6">
  <div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="bg-white shadow rounded-lg">
      <div class="px-4 py-5 sm:p-6">
        <div class="mb-6">
          <h1 class="text-2xl font-bold text-gray-900">Create New Organization</h1>
          <p class="mt-1 text-sm text-gray-500">
            Set up your organization's profile and compliance settings
          </p>
        </div>

        <%= form_with model: @organization, local: true, class: "space-y-6" do |form| %>
          <% if @organization.errors.any? %>
            <div class="rounded-md bg-red-50 p-4">
              <div class="flex">
                <div class="flex-shrink-0">
                  <svg class="h-5 w-5 text-red-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-2.5L13.732 4c-.77-.833-1.964-.833-2.732 0L3.732 16.5c-.77.833.192 2.5 1.732 2.5z"></path>
                  </svg>
                </div>
                <div class="ml-3">
                  <h3 class="text-sm font-medium text-red-800">
                    There were <%= pluralize(@organization.errors.count, 'error') %> with your submission:
                  </h3>
                  <div class="mt-2 text-sm text-red-700">
                    <ul class="list-disc pl-5 space-y-1">
                      <% @organization.errors.full_messages.each do |message| %>
                        <li><%= message %></li>
                      <% end %>
                    </ul>
                  </div>
                </div>
              </div>
            </div>
          <% end %>

          <!-- Basic Information -->
          <div>
            <h3 class="text-lg font-medium text-gray-900 mb-4">Basic Information</h3>
            <div class="grid grid-cols-1 gap-6 sm:grid-cols-2">
              <div>
                <%= form.label :name, class: "block text-sm font-medium text-gray-700" %>
                <%= form.text_field :name, class: "mt-1 block w-full border-gray-300 rounded-md shadow-sm focus:ring-indigo-500 focus:border-indigo-500 sm:text-sm", placeholder: "Acme Corporation" %>
              </div>

              <div>
                <%= form.label :domain, class: "block text-sm font-medium text-gray-700" %>
                <%= form.text_field :domain, class: "mt-1 block w-full border-gray-300 rounded-md shadow-sm focus:ring-indigo-500 focus:border-indigo-500 sm:text-sm", placeholder: "acme.com" %>
              </div>
            </div>
          </div>

          <!-- Industry and Jurisdiction -->
          <div>
            <h3 class="text-lg font-medium text-gray-900 mb-4">Industry & Compliance</h3>
            <div class="grid grid-cols-1 gap-6 sm:grid-cols-2">
              <div>
                <%= form.label :industry, "Industry", class: "block text-sm font-medium text-gray-700" %>
                <%= form.select :industry, 
                    options_for_select([
                      ['Technology', 'Technology'],
                      ['Healthcare', 'Healthcare'],
                      ['Finance', 'Finance'],
                      ['Manufacturing', 'Manufacturing'],
                      ['Retail', 'Retail'],
                      ['Education', 'Education'],
                      ['Government', 'Government'],
                      ['Other', 'Other']
                    ], @organization.settings&.dig('industry')), 
                    { prompt: 'Select an industry' },
                    { class: "mt-1 block w-full border-gray-300 rounded-md shadow-sm focus:ring-indigo-500 focus:border-indigo-500 sm:text-sm" } %>
              </div>

              <div>
                <%= form.label :jurisdiction, "Jurisdiction", class: "block text-sm font-medium text-gray-700" %>
                <%= form.select :jurisdiction, 
                    options_for_select([
                      ['United States', 'US'],
                      ['European Union', 'EU'],
                      ['Canada', 'CA'],
                      ['United Kingdom', 'UK'],
                      ['Australia', 'AU'],
                      ['Other', 'Other']
                    ], @organization.settings&.dig('jurisdiction')), 
                    { prompt: 'Select jurisdiction' },
                    { class: "mt-1 block w-full border-gray-300 rounded-md shadow-sm focus:ring-indigo-500 focus:border-indigo-500 sm:text-sm" } %>
              </div>
            </div>
          </div>

          <!-- Compliance Keywords -->
          <div>
            <%= form.label :compliance_keywords, "Compliance Keywords", class: "block text-sm font-medium text-gray-700" %>
            <p class="mt-1 text-sm text-gray-500">Enter keywords related to your compliance focus areas (comma-separated)</p>
            <%= form.text_field :compliance_keywords, 
                value: @organization.settings&.dig('compliance_keywords')&.join(', '),
                class: "mt-1 block w-full border-gray-300 rounded-md shadow-sm focus:ring-indigo-500 focus:border-indigo-500 sm:text-sm", 
                placeholder: "data privacy, cybersecurity, GDPR, SOX" %>
          </div>

          <!-- Exclusion Terms -->
          <div>
            <%= form.label :exclusion_terms, "Exclusion Terms", class: "block text-sm font-medium text-gray-700" %>
            <p class="mt-1 text-sm text-gray-500">Enter terms to exclude from compliance monitoring (comma-separated)</p>
            <%= form.text_field :exclusion_terms, 
                value: @organization.settings&.dig('exclusion_terms')&.join(', '),
                class: "mt-1 block w-full border-gray-300 rounded-md shadow-sm focus:ring-indigo-500 focus:border-indigo-500 sm:text-sm", 
                placeholder: "wildlife, agriculture, unrelated topics" %>
          </div>

          <!-- Status -->
          <div>
            <%= form.label :status, class: "block text-sm font-medium text-gray-700" %>
            <%= form.select :status, 
                options_for_select(Organization.statuses.keys.map { |s| [s.titleize, s] }, @organization.status), 
                {},
                { class: "mt-1 block w-full border-gray-300 rounded-md shadow-sm focus:ring-indigo-500 focus:border-indigo-500 sm:text-sm" } %>
          </div>

          <!-- Form Actions -->
          <div class="flex justify-end space-x-3 pt-6 border-t border-gray-200">
            <%= link_to "Cancel", organizations_path, class: "inline-flex items-center px-4 py-2 border border-gray-300 shadow-sm text-sm font-medium rounded-md text-gray-700 bg-white hover:bg-gray-50 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-indigo-500" %>
            <%= form.submit "Create Organization", class: "inline-flex items-center px-4 py-2 border border-transparent text-sm font-medium rounded-md shadow-sm text-white bg-indigo-600 hover:bg-indigo-700 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-indigo-500" %>
          </div>
        <% end %>
      </div>
    </div>
  </div>
</div>
