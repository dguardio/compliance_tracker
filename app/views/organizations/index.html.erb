<div class="min-h-screen bg-gray-50">
  <div class="max-w-7xl mx-auto py-6 sm:px-6 lg:px-8">
    <!-- Header -->
    <div class="px-4 py-6 sm:px-0">
      <div class="flex justify-between items-center">
<div>
          <h1 class="text-3xl font-bold text-gray-900">Organizations</h1>
          <p class="mt-1 text-sm text-gray-500">
            Manage your organizations and their settings
          </p>
        </div>
        <% if current_user.super_admin? || current_user.organization.nil? %>
          <%= link_to new_organization_path, class: "inline-flex items-center px-4 py-2 border border-transparent text-sm font-medium rounded-md shadow-sm text-white bg-indigo-600 hover:bg-indigo-700 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-indigo-500" do %>
            <svg class="-ml-1 mr-2 h-5 w-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6v6m0 0v6m0-6h6m-6 0H6"></path>
            </svg>
            New Organization
          <% end %>
        <% end %>
      </div>
    </div>

    <!-- Organizations Grid -->
    <div class="px-4 py-6 sm:px-0">
      <% if @organizations.any? %>
        <div class="grid grid-cols-1 gap-6 sm:grid-cols-2 lg:grid-cols-3">
          <% @organizations.each do |organization| %>
            <div class="bg-white overflow-hidden shadow rounded-lg">
              <div class="p-6">
                <div class="flex items-center">
                  <div class="flex-shrink-0">
                    <div class="h-10 w-10 rounded-full bg-indigo-500 flex items-center justify-center">
                      <span class="text-white font-semibold text-lg">
                        <%= organization.name.first.upcase %>
                      </span>
                    </div>
                  </div>
                  <div class="ml-4 flex-1">
                    <h3 class="text-lg font-medium text-gray-900">
                      <%= link_to organization.name, organization_path(organization), class: "hover:text-indigo-600" %>
                    </h3>
                    <p class="text-sm text-gray-500">
                      <%= organization.settings['industry'] || 'No industry specified' %>
                    </p>
                  </div>
                </div>
                
                <div class="mt-4">
                  <div class="flex justify-between text-sm text-gray-500">
                    <span>Status: <%= organization.status.titleize %></span>
                    <span><%= pluralize(organization.user_count, 'user') %></span>
                  </div>
                  
                  <div class="mt-2 flex justify-between text-sm text-gray-500">
                    <span><%= pluralize(organization.department_count, 'department') %></span>
                    <span><%= pluralize(organization.team_count, 'team') %></span>
                  </div>
                </div>
                
                <div class="mt-4 flex justify-between">
                  <%= link_to "View Details", organization_path(organization), class: "text-indigo-600 hover:text-indigo-900 text-sm font-medium" %>
                  <% if current_user.can_manage_organization?(organization) %>
                    <%= link_to "Edit", edit_organization_path(organization), class: "text-gray-600 hover:text-gray-900 text-sm font-medium" %>
                  <% end %>
                </div>
              </div>
            </div>
          <% end %>
        </div>
      <% else %>
        <div class="text-center py-12">
          <svg class="mx-auto h-12 w-12 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4"></path>
          </svg>
          <h3 class="mt-2 text-sm font-medium text-gray-900">No organizations</h3>
          <p class="mt-1 text-sm text-gray-500">
            Get started by creating a new organization.
          </p>
          <div class="mt-6">
            <%= link_to new_organization_path, class: "inline-flex items-center px-4 py-2 border border-transparent shadow-sm text-sm font-medium rounded-md text-white bg-indigo-600 hover:bg-indigo-700 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-indigo-500" do %>
              <svg class="-ml-1 mr-2 h-5 w-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6v6m0 0v6m0-6h6m-6 0H6"></path>
              </svg>
              New Organization
            <% end %>
          </div>
        </div>
      <% end %>
    </div>
  </div>
</div>
