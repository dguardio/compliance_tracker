<div class="container mx-auto px-4 py-8">
  <!-- Header -->
  <div class="mb-8">
    <div class="flex justify-between items-start">
      <div>
        <nav class="flex" aria-label="Breadcrumb">
          <ol class="flex items-center space-x-4">
            <li>
              <%= link_to "Documents", organization_documents_path(@organization), 
                          class: "text-gray-400 hover:text-gray-500" %>
            </li>
            <li>
              <div class="flex items-center">
                <svg class="flex-shrink-0 h-5 w-5 text-gray-300" fill="currentColor" viewBox="0 0 20 20">
                  <path fill-rule="evenodd" d="M7.293 14.707a1 1 0 010-1.414L10.586 10 7.293 6.707a1 1 0 011.414-1.414l4 4a1 1 0 010 1.414l-4 4a1 1 0 01-1.414 0z" clip-rule="evenodd"></path>
                </svg>
                <span class="ml-4 text-sm font-medium text-gray-500"><%= @document.title %></span>
              </div>
            </li>
          </ol>
        </nav>
        <h1 class="text-3xl font-bold text-gray-900 mt-2"><%= @document.title %></h1>
      </div>
      
      <div class="flex space-x-2">
        <% if policy(@document).update? %>
          <%= link_to "Edit", edit_organization_document_path(@organization, @document), 
                      class: "bg-blue-600 hover:bg-blue-700 text-white font-bold py-2 px-4 rounded" %>
        <% end %>
        
        <% if @document.needs_review? && policy(@document).approve? %>
          <%= link_to "Approve", approve_organization_document_path(@organization, @document), 
                      method: :patch,
                      data: { confirm: "Are you sure you want to approve this document?" },
                      class: "bg-green-600 hover:bg-green-700 text-white font-bold py-2 px-4 rounded" %>
        <% end %>
        
        <% if @document.needs_review? && policy(@document).approve? %>
          <%= link_to "Reject", reject_organization_document_path(@organization, @document), 
                      method: :patch,
                      data: { confirm: "Are you sure you want to reject this document?" },
                      class: "bg-red-600 hover:bg-red-700 text-white font-bold py-2 px-4 rounded" %>
        <% end %>
        
        <% if policy(@document).update? %>
          <%= link_to "Duplicate", duplicate_organization_document_path(@organization, @document), 
                      method: :post,
                      class: "bg-purple-600 hover:bg-purple-700 text-white font-bold py-2 px-4 rounded" %>
        <% end %>
      </div>
    </div>
  </div>

  <% if @document.workflow_template %>
    <div class="mb-8">
      <div class="bg-white rounded-lg shadow-md p-6">
        <h3 class="text-lg font-medium text-gray-900 mb-4">Approval Workflow: <%= @document.workflow_template.name %></h3>
        <nav aria-label="Progress">
          <ol role="list" class="overflow-hidden">
            <li class="relative pb-10">
              <div class="absolute top-4 left-4 -ml-px h-full w-0.5 bg-gray-200" aria-hidden="true"></div>
              <!-- Draft Step (Always first) -->
              <div class="relative flex items-start group">
                <span class="h-9 flex items-center">
                  <span class="relative z-10 w-8 h-8 flex items-center justify-center bg-indigo-600 rounded-full group-hover:bg-indigo-800">
                    <svg class="w-5 h-5 text-white" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
                      <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd" />
                    </svg>
                  </span>
                </span>
                <span class="ml-4 min-w-0 flex flex-col">
                  <span class="text-xs font-semibold tracking-wide uppercase text-indigo-600">Step 1</span>
                  <span class="text-sm font-medium text-gray-900">Draft</span>
                </span>
              </div>
            </li>

            <% @document.workflow_template.workflow_steps.order(:created_at).each_with_index do |step, index| %>
              <li class="relative pb-10">
                <% unless index == @document.workflow_template.workflow_steps.count - 1 %>
                  <div class="absolute top-4 left-4 -ml-px h-full w-0.5 bg-gray-200" aria-hidden="true"></div>
                <% end %>
                <div class="relative flex items-start group">
                  <span class="h-9 flex items-center">
                    <% if @document.approved? || (@document.needs_review? && index == 0) # Simplified logic %>
                      <span class="relative z-10 w-8 h-8 flex items-center justify-center bg-indigo-600 rounded-full group-hover:bg-indigo-800">
                        <svg class="w-5 h-5 text-white" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
                          <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd" />
                        </svg>
                      </span>
                    <% elsif @document.needs_review? %>
                       <span class="relative z-10 w-8 h-8 flex items-center justify-center bg-white border-2 border-gray-300 rounded-full">
                        <span class="h-2.5 w-2.5 bg-transparent rounded-full"></span>
                      </span>
                    <% else %>
                      <span class="relative z-10 w-8 h-8 flex items-center justify-center bg-white border-2 border-gray-300 rounded-full">
                        <span class="h-2.5 w-2.5 bg-transparent rounded-full"></span>
                      </span>
                    <% end %>
                  </span>
                  <span class="ml-4 min-w-0 flex flex-col">
                    <span class="text-xs font-semibold tracking-wide uppercase text-gray-500">Step <%= index + 2 %></span>
                    <span class="text-sm font-medium text-gray-900"><%= step.name %> (<%= step.role.name.titleize %>)</span>
                  </span>
                </div>
              </li>
            <% end %>
          </ol>
        </nav>
      </div>
    </div>
  <% end %>

  <div class="grid grid-cols-1 lg:grid-cols-3 gap-8">
    <!-- Main Content -->
    <div class="lg:col-span-2">
      <!-- Document Preview -->
      <div data-controller="document-preview">
        <% if @document.file.attached? %>
          <%= render DocumentPreviewComponent.new(document: @document, current_user: current_user) %>
        <% else %>
          <div class="bg-white rounded-lg shadow-md p-6 mb-6">
            <div class="text-center py-8 text-gray-500">
              <i class="fas fa-file-upload text-4xl mb-4"></i>
              <p>No file attached to this document.</p>
            </div>
          </div>
        <% end %>
      </div>



      <!-- Description -->
      <% if @document.description.present? %>
        <div class="bg-white rounded-lg shadow-md p-6 mb-6">
          <h2 class="text-xl font-semibold text-gray-900 mb-4">Description</h2>
          <div class="prose max-w-none">
            <%= simple_format(@document.description) %>
          </div>
        </div>
      <% end %>

      <!-- Version History -->
      <% if @document_versions.any? %>
        <div class="bg-white rounded-lg shadow-md p-6">
          <h2 class="text-xl font-semibold text-gray-900 mb-4">Version History</h2>
          <div class="space-y-4">
            <% @document_versions.each do |version| %>
              <div class="flex items-center justify-between p-4 border border-gray-200 rounded-lg">
                <div>
                  <div class="font-medium text-gray-900">Version <%= safe_version_display(version, 'version') %></div>
                  <div class="text-sm text-gray-500">
                    <%= time_ago_in_words(version.created_at) %> ago
                    by <%= version_user_name(version) %>
                  </div>
                </div>
                <div class="text-sm text-gray-500">
                  <%= version_changes_summary(version) %>
                </div>
              </div>
            <% end %>
          </div>
        </div>
      <% end %>
    </div>

    <!-- Sidebar -->
    <div class="lg:col-span-1">
      <!-- Document Info -->
      <div class="bg-white rounded-lg shadow-md p-6 mb-6">
        <h2 class="text-xl font-semibold text-gray-900 mb-4">Document Information</h2>
        
        <dl class="space-y-4">
          <div>
            <dt class="text-sm font-medium text-gray-500">Status</dt>
            <dd class="mt-1">
              <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium 
                           <%= @document.status == 'approved' ? 'bg-green-100 text-green-800' :
                               @document.status == 'review' ? 'bg-yellow-100 text-yellow-800' :
                               @document.status == 'draft' ? 'bg-gray-100 text-gray-800' :
                               @document.status == 'archived' ? 'bg-red-100 text-red-800' :
                               'bg-gray-100 text-gray-800' %>">
                <%= @document.status.titleize %>
              </span>
            </dd>
          </div>

          <div>
            <dt class="text-sm font-medium text-gray-500">Category</dt>
            <dd class="mt-1 text-sm text-gray-900"><%= @document.category&.titleize %></dd>
          </div>

          <div>
            <dt class="text-sm font-medium text-gray-500">Version</dt>
            <dd class="mt-1 text-sm text-gray-900"><%= @document.version %></dd>
          </div>

          <div>
            <dt class="text-sm font-medium text-gray-500">File Type</dt>
            <dd class="mt-1 text-sm text-gray-900"><%= @document.file_type %></dd>
          </div>

          <div>
            <dt class="text-sm font-medium text-gray-500">File Size</dt>
            <dd class="mt-1 text-sm text-gray-900"><%= number_to_human_size(@document.file_size_mb * 1024 * 1024) %></dd>
          </div>

          <% if @document.expires_at %>
            <div>
              <dt class="text-sm font-medium text-gray-500">Expires At</dt>
              <dd class="mt-1 text-sm text-gray-900">
                <%= @document.expires_at.strftime("%B %d, %Y") %>
                <% if @document.expired? %>
                  <span class="ml-2 inline-flex items-center px-2 py-0.5 rounded-full text-xs font-medium bg-red-100 text-red-800">
                    Expired
                  </span>
                <% elsif @document.expiring_soon? %>
                  <span class="ml-2 inline-flex items-center px-2 py-0.5 rounded-full text-xs font-medium bg-yellow-100 text-yellow-800">
                    Expires in <%= @document.days_until_expiry %> days
                  </span>
                <% end %>
              </dd>
            </div>
          <% end %>

          <% if @document.compliance_hierarchy.present? %>
            <div>
              <dt class="text-sm font-medium text-gray-500">Compliance</dt>
              <dd class="mt-1 text-sm text-gray-900"><%= @document.compliance_hierarchy %></dd>
            </div>
          <% end %>
        </dl>
      </div>

      <!-- People -->
      <div class="bg-white rounded-lg shadow-md p-6 mb-6">
        <h2 class="text-xl font-semibold text-gray-900 mb-4">People</h2>
        
        <dl class="space-y-4">
          <div>
            <dt class="text-sm font-medium text-gray-500">Uploaded By</dt>
            <dd class="mt-1 text-sm text-gray-900"><%= @document.uploaded_by.full_name %></dd>
          </div>

          <% if @document.approved_by %>
            <div>
              <dt class="text-sm font-medium text-gray-500">Approved By</dt>
              <dd class="mt-1 text-sm text-gray-900"><%= @document.approved_by.full_name %></dd>
            </div>
          <% end %>

          <% if @document.approved_at %>
            <div>
              <dt class="text-sm font-medium text-gray-500">Approved At</dt>
              <dd class="mt-1 text-sm text-gray-900"><%= @document.approved_at.strftime("%B %d, %Y at %I:%M %p") %></dd>
            </div>
          <% end %>
        </dl>
      </div>

      <!-- Tags -->
      <% if @document.tags_array.any? %>
        <div class="bg-white rounded-lg shadow-md p-6 mb-6">
          <h2 class="text-xl font-semibold text-gray-900 mb-4">Tags</h2>
          <div class="flex flex-wrap gap-2">
            <% @document.tags_array.each do |tag| %>
              <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-blue-100 text-blue-800">
                <%= tag %>
              </span>
            <% end %>
          </div>
        </div>
      <% end %>

      <!-- Custom Fields -->
      <% if @document.custom_fields.present? %>
        <div class="bg-white rounded-lg shadow-md p-6">
          <h2 class="text-xl font-semibold text-gray-900 mb-4">Custom Fields</h2>
          <dl class="space-y-4">
            <% @document.custom_fields.each do |key, value| %>
              <div>
                <dt class="text-sm font-medium text-gray-500"><%= key.titleize %></dt>
                <dd class="mt-1 text-sm text-gray-900"><%= value %></dd>
              </div>
            <% end %>
          </dl>
        </div>
      <% end %>
    </div>
  </div>
</div> 