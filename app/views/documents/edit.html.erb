<div class="container mx-auto px-4 py-8">
  <div class="mb-8">
    <nav class="flex" aria-label="Breadcrumb">
      <ol class="flex items-center space-x-4">
        <li>
          <%= link_to "Documents", organization_documents_path(@organization), 
                      class: "text-gray-400 hover:text-gray-500" %>
        </li>
        <li>
          <div class="flex items-center">
            <svg class="flex-shrink-0 h-5 w-5 text-gray-300" fill="currentColor" viewBox="0 0 20 20">
              <path fill-rule="evenodd" d="M7.293 14.707a1 1 0 010-1.414L10.586 10 7.293 6.707a1 1 0 011.414-1.414l4 4a1 1 0 010 1.414l-4 4a1 1 0 01-1.414 0z" clip-rule="evenodd"></path>
            </svg>
            <%= link_to @document.title, organization_document_path(@organization, @document), 
                        class: "ml-4 text-sm font-medium text-gray-500 hover:text-gray-700" %>
          </div>
        </li>
        <li>
          <div class="flex items-center">
            <svg class="flex-shrink-0 h-5 w-5 text-gray-300" fill="currentColor" viewBox="0 0 20 20">
              <path fill-rule="evenodd" d="M7.293 14.707a1 1 0 010-1.414L10.586 10 7.293 6.707a1 1 0 011.414-1.414l4 4a1 1 0 010 1.414l-4 4a1 1 0 01-1.414 0z" clip-rule="evenodd"></path>
            </svg>
            <span class="ml-4 text-sm font-medium text-gray-500">Edit</span>
          </div>
        </li>
      </ol>
    </nav>
    <h1 class="text-3xl font-bold text-gray-900 mt-2">Edit Document</h1>
  </div>

  <div class="max-w-4xl mx-auto">
    <div class="bg-white rounded-lg shadow-md p-6">
      <%= form_with model: [@organization, @document], local: true, class: "space-y-6" do |form| %>
        <% if @document.errors.any? %>
          <div class="bg-red-50 border border-red-200 rounded-md p-4">
            <div class="flex">
              <div class="flex-shrink-0">
                <svg class="h-5 w-5 text-red-400" fill="currentColor" viewBox="0 0 20 20">
                  <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zM8.707 7.293a1 1 0 00-1.414 1.414L8.586 10l-1.293 1.293a1 1 0 101.414 1.414L10 11.414l1.293 1.293a1 1 0 001.414-1.414L11.414 10l1.293-1.293a1 1 0 00-1.414-1.414L10 8.586 8.707 7.293z" clip-rule="evenodd"></path>
                </svg>
              </div>
              <div class="ml-3">
                <h3 class="text-sm font-medium text-red-800">
                  <%= pluralize(@document.errors.count, "error") %> prohibited this document from being saved:
                </h3>
                <div class="mt-2 text-sm text-red-700">
                  <ul class="list-disc pl-5 space-y-1">
                    <% @document.errors.full_messages.each do |message| %>
                      <li><%= message %></li>
                    <% end %>
                  </ul>
                </div>
              </div>
            </div>
          </div>
        <% end %>

        <!-- Basic Information -->
        <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
          <div>
            <%= form.label :title, class: "block text-sm font-medium text-gray-700 mb-1" %>
            <%= form.text_field :title, class: "block w-full border-gray-300 rounded-md shadow-sm focus:ring-indigo-500 focus:border-indigo-500 sm:text-sm" %>
          </div>

          <div>
            <%= form.label :category, class: "block text-sm font-medium text-gray-700 mb-1" %>
            <%= form.select :category, 
                options_for_select([
                  ['Policy', 'policy'],
                  ['Procedure', 'procedure'],
                  ['Standard', 'standard'],
                  ['Guideline', 'guideline'],
                  ['Form', 'form'],
                  ['Template', 'template'],
                  ['Report', 'report'],
                  ['Assessment', 'assessment'],
                  ['Certificate', 'certificate'],
                  ['Other', 'other']
                ], @document.category),
                { prompt: 'Select a category' },
                { class: "block w-full border-gray-300 rounded-md shadow-sm focus:ring-indigo-500 focus:border-indigo-500 sm:text-sm" } %>
          </div>
        </div>

        <div>
          <%= form.label :description, class: "block text-sm font-medium text-gray-700 mb-1" %>
          <%= form.text_area :description, rows: 4, 
                            placeholder: "Describe the document's purpose and content...",
                            class: "block w-full border-gray-300 rounded-md shadow-sm focus:ring-indigo-500 focus:border-indigo-500 sm:text-sm" %>
        </div>

        <!-- File Upload -->
        <div>
          <%= form.label :file, "Document File", class: "block text-sm font-medium text-gray-700 mb-1" %>
          
          <% if @document.file.attached? %>
            <div class="mb-4 p-4 bg-gray-50 rounded-lg">
              <div class="flex items-center">
                <svg class="h-8 w-8 text-gray-400 mr-3" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"></path>
                </svg>
                <div class="flex-1">
                  <p class="text-sm font-medium text-gray-900"><%= @document.file.filename %></p>
                  <p class="text-sm text-gray-500"><%= number_to_human_size(@document.file.byte_size) %></p>
                </div>
                <%= link_to "Download", rails_blob_path(@document.file, disposition: 'attachment'), 
                            class: "text-indigo-600 hover:text-indigo-900 text-sm font-medium" %>
              </div>
            </div>
          <% end %>
          
          <div class="mt-1 flex justify-center px-6 pt-5 pb-6 border-2 border-gray-300 border-dashed rounded-md">
            <div class="space-y-1 text-center">
              <svg class="mx-auto h-12 w-12 text-gray-400" stroke="currentColor" fill="none" viewBox="0 0 48 48">
                <path d="M28 8H12a4 4 0 00-4 4v20m32-12v8m0 0v8a4 4 0 01-4 4H12a4 4 0 01-4-4v-4m32-4l-3.172-3.172a4 4 0 00-5.656 0L28 28M8 32l9.172-9.172a4 4 0 015.656 0L28 28m0 0l4 4m4-24h8m-4-4v8m-12 4h.02" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"></path>
              </svg>
              <div class="flex text-sm text-gray-600">
                <label for="document_file" class="relative cursor-pointer bg-white rounded-md font-medium text-indigo-600 hover:text-indigo-500 focus-within:outline-none focus-within:ring-2 focus-within:ring-offset-2 focus-within:ring-indigo-500">
                  <span>Upload a new file</span>
                  <%= form.file_field :file, 
                                     accept: ".pdf,.doc,.docx,.xls,.xlsx,.ppt,.pptx,.txt,.csv,.jpg,.jpeg,.png,.gif",
                                     class: "sr-only" %>
                </label>
                <p class="pl-1">or drag and drop</p>
              </div>
              <p class="text-xs text-gray-500">
                PDF, Word, Excel, PowerPoint, text, CSV, or images up to 50MB
              </p>
              <p class="text-xs text-gray-500">
                Uploading a new file will create a new version
              </p>
            </div>
          </div>
        </div>

        <!-- Compliance Association -->
        <div class="border-t border-gray-200 pt-6">
          <h3 class="text-lg font-medium text-gray-900 mb-4">Compliance Association (Optional)</h3>
          
          <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
            <div>
              <%= form.label :compliance_framework_id, "Framework", class: "block text-sm font-medium text-gray-700 mb-1" %>
              <%= form.select :compliance_framework_id, 
                  options_for_select([['Select Framework', '']] + @compliance_frameworks.map { |f| [f.name, f.id] }, @document.compliance_framework_id),
                  {},
                  { class: "block w-full border-gray-300 rounded-md shadow-sm focus:ring-indigo-500 focus:border-indigo-500 sm:text-sm",
                    data: { action: "change->document#frameworkChanged" } } %>
            </div>

            <div>
              <%= form.label :compliance_requirement_id, "Requirement", class: "block text-sm font-medium text-gray-700 mb-1" %>
              <%= form.select :compliance_requirement_id, 
                  options_for_select([['Select Requirement', '']] + @compliance_requirements.map { |r| [r.name, r.id] }, @document.compliance_requirement_id),
                  {},
                  { class: "block w-full border-gray-300 rounded-md shadow-sm focus:ring-indigo-500 focus:border-indigo-500 sm:text-sm",
                    data: { action: "change->document#requirementChanged" } } %>
            </div>

            <div>
              <%= form.label :compliance_control_id, "Control", class: "block text-sm font-medium text-gray-700 mb-1" %>
              <%= form.select :compliance_control_id, 
                  options_for_select([['Select Control', '']] + @compliance_controls.map { |c| [c.name, c.id] }, @document.compliance_control_id),
                  {},
                  { class: "block w-full border-gray-300 rounded-md shadow-sm focus:ring-indigo-500 focus:border-indigo-500 sm:text-sm" } %>
            </div>
          </div>
        </div>

        <!-- Additional Settings -->
        <div class="border-t border-gray-200 pt-6">
          <h3 class="text-lg font-medium text-gray-900 mb-4">Additional Settings</h3>
          
          <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
            <div>
              <%= form.label :expires_at, "Expiration Date", class: "block text-sm font-medium text-gray-700 mb-1" %>
              <%= form.date_field :expires_at, 
                                 value: @document.expires_at&.strftime('%Y-%m-%d'),
                                 class: "block w-full border-gray-300 rounded-md shadow-sm focus:ring-indigo-500 focus:border-indigo-500 sm:text-sm" %>
              <p class="mt-1 text-sm text-gray-500">Leave blank if document doesn't expire</p>
            </div>

            <div>
              <%= form.label :tags, "Tags", class: "block text-sm font-medium text-gray-700 mb-1" %>
              <%= form.text_field :tags, 
                                 value: @document.tags_array.join(', '),
                                 placeholder: "Enter tags separated by commas",
                                 class: "block w-full border-gray-300 rounded-md shadow-sm focus:ring-indigo-500 focus:border-indigo-500 sm:text-sm" %>
              <p class="mt-1 text-sm text-gray-500">Use commas to separate multiple tags</p>
            </div>
          </div>
        </div>

        <!-- Form Actions -->
        <div class="flex justify-end space-x-3 pt-6 border-t border-gray-200">
          <%= link_to "Cancel", organization_document_path(@organization, @document), 
                      class: "bg-white py-2 px-4 border border-gray-300 rounded-md shadow-sm text-sm font-medium text-gray-700 hover:bg-gray-50 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-indigo-500" %>
          <%= form.submit "Update Document", 
                         class: "bg-indigo-600 py-2 px-4 border border-transparent rounded-md shadow-sm text-sm font-medium text-white hover:bg-indigo-700 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-indigo-500" %>
        </div>
      <% end %>
    </div>
  </div>
</div>

<script>
document.addEventListener('DOMContentLoaded', function() {
  const frameworkSelect = document.getElementById('document_compliance_framework_id');
  const requirementSelect = document.getElementById('document_compliance_requirement_id');
  const controlSelect = document.getElementById('document_compliance_control_id');

  frameworkSelect.addEventListener('change', function() {
    const frameworkId = this.value;
    if (frameworkId) {
      fetch(`/organizations/<%= @organization.id %>/documents/get_requirements?framework_id=${frameworkId}`)
        .then(response => response.json())
        .then(data => {
          requirementSelect.innerHTML = '<option value="">Select Requirement</option>';
          data.forEach(item => {
            const option = document.createElement('option');
            option.value = item.id;
            option.textContent = item.name;
            requirementSelect.appendChild(option);
          });
          requirementSelect.disabled = false;
        });
    } else {
      requirementSelect.innerHTML = '<option value="">Select Requirement</option>';
      requirementSelect.disabled = true;
      controlSelect.innerHTML = '<option value="">Select Control</option>';
      controlSelect.disabled = true;
    }
  });

  requirementSelect.addEventListener('change', function() {
    const requirementId = this.value;
    if (requirementId) {
      fetch(`/organizations/<%= @organization.id %>/documents/get_controls?requirement_id=${requirementId}`)
        .then(response => response.json())
        .then(data => {
          controlSelect.innerHTML = '<option value="">Select Control</option>';
          data.forEach(item => {
            const option = document.createElement('option');
            option.value = item.id;
            option.textContent = item.name;
            controlSelect.appendChild(option);
          });
          controlSelect.disabled = false;
        });
    } else {
      controlSelect.innerHTML = '<option value="">Select Control</option>';
      controlSelect.disabled = true;
    }
  });
});
</script> 