<div class="container mx-auto px-4 py-8">
  <div class="mb-6">
    <%= link_to "← Back to Dashboard", dashboard_path, 
                class: "text-blue-600 hover:text-blue-800 font-medium" %>
  </div>

  <div class="flex justify-between items-center mb-6">
    <h1 class="text-3xl font-bold text-gray-900">Notifications</h1>
    <% if current_user.notifications.unread.any? %>
      <%= link_to "Mark all as read", mark_all_as_read_mailboxes_path, 
                  method: :patch,
                  class: "bg-blue-600 hover:bg-blue-700 text-white font-bold py-2 px-4 rounded" %>
    <% end %>
  </div>

  <% if @notifications.any? %>
    <div class="bg-white shadow overflow-hidden sm:rounded-md">
      <ul class="divide-y divide-gray-200">
        <% @notifications.each do |notification| %>
          <li class="<%= notification.read? ? 'bg-white' : 'bg-blue-50' %>">
            <div class="px-4 py-4 sm:px-6">
              <div class="flex items-center justify-between">
                <div class="flex items-center">
                  <% unless notification.read? %>
                    <div class="flex-shrink-0">
                      <div class="h-2 w-2 bg-blue-600 rounded-full"></div>
                    </div>
                  <% end %>
                  <div class="ml-3 flex-1">
                    <div class="flex items-center justify-between">
                      <p class="text-sm font-medium text-gray-900">
                        <%= notification.event.title %>
                      </p>
                      <div class="ml-2 flex-shrink-0 flex">
                        <p class="px-2 inline-flex text-xs leading-5 font-semibold rounded-full 
                                 <%= notification.read? ? 'bg-gray-100 text-gray-800' : 'bg-blue-100 text-blue-800' %>">
                          <%= notification.read? ? 'Read' : 'New' %>
                        </p>
                      </div>
                    </div>
                    <p class="text-sm text-gray-500 mt-1">
                      <%= notification.event.message %>
                    </p>
                    <div class="mt-2 flex items-center justify-between">
                      <div class="flex items-center text-sm text-gray-500">
                        <time datetime="<%= notification.created_at.iso8601 %>">
                          <%= time_ago_in_words(notification.created_at) %> ago
                        </time>
                      </div>
                      <div class="flex space-x-2">
                        <% if notification.event.url.present? %>
                          <%= link_to "View", notification.event.url, 
                                      class: "text-blue-600 hover:text-blue-800 text-sm font-medium" %>
                        <% end %>
                        <% unless notification.read? %>
                          <%= link_to "Mark as read", mark_as_read_mailbox_path(notification), 
                                      method: :patch,
                                      class: "text-gray-600 hover:text-gray-800 text-sm font-medium" %>
                        <% end %>
                        <%= link_to "Delete", mailbox_path(notification), 
                                    method: :delete,
                                    data: { confirm: "Are you sure you want to delete this notification?" },
                                    class: "text-red-600 hover:text-red-800 text-sm font-medium" %>
                      </div>
                    </div>
                  </div>
                </div>
              </div>
            </div>
          </li>
        <% end %>
      </ul>
    </div>

    <!-- Pagination -->
    <div class="mt-8">
      <%= paginate @notifications %>
    </div>
  <% else %>
    <div class="text-center py-12">
      <div class="text-gray-400 mb-4">
        <svg class="mx-auto h-12 w-12" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M20 13V6a2 2 0 00-2-2H6a2 2 0 00-2 2v7m16 0v5a2 2 0 01-2 2H6a2 2 0 01-2-2v-5m16 0h-2.586a1 1 0 00-.707.293l-2.414 2.414a1 1 0 01-.707.293h-3.172a1 1 0 01-.707-.293l-2.414-2.414A1 1 0 006.586 13H4"></path>
        </svg>
      </div>
      <h3 class="text-lg font-medium text-gray-900 mb-2">No notifications</h3>
      <p class="text-gray-500">You're all caught up! Check back later for new notifications.</p>
    </div>
  <% end %>
</div> 