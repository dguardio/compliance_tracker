<div class="container mx-auto px-4 py-8">
  <div class="mb-6">
    <%= link_to "← Back to Dashboard", dashboard_path, 
                class: "text-primary-600 hover:text-primary-800 font-medium text-sm transition-colors" %>
  </div>

  <div class="flex justify-between items-center mb-6">
    <h1 class="text-3xl font-bold text-gray-900">Notifications</h1>
    <% if current_user.notifications.unread.any? %>
      <%= render Joyful::ButtonComponent.new(
            text: "Mark all as read",
            path: mark_all_as_read_mailboxes_path,
            method: :patch,
            variant: :primary,
            icon: "check-double",
            class: "shadow-primary-glow"
          ) %>
    <% end %>
  </div>

  <% if @notifications.any? %>
    <%= render Joyful::CardComponent.new(class: "overflow-hidden") do %>
      <div class="divide-y divide-gray-100">
        <% @notifications.each do |notification| %>
          <div class="group px-6 py-5 flex items-start space-x-4 transition-colors duration-200 hover:bg-slate-50 <%= notification.read? ? 'bg-white' : 'bg-primary-50/30' %>">
            
            <!-- Icon/Status Indicator -->
            <div class="flex-shrink-0 mt-1">
              <% unless notification.read? %>
                <div class="h-3 w-3 bg-primary-600 rounded-full ring-4 ring-primary-50 animate-pulse"></div>
              <% else %>
                <div class="h-3 w-3 bg-gray-200 rounded-full"></div>
              <% end %>
            </div>

            <div class="flex-1 min-w-0">
              <div class="flex items-center justify-between mb-1">
                <p class="text-sm font-semibold text-gray-900 truncate">
                  <%= notification.event.title %>
                </p>
                <div class="ml-2 flex-shrink-0 flex items-center space-x-2">
                   <time datetime="<%= notification.created_at.iso8601 %>" class="text-xs text-gray-500">
                      <%= time_ago_in_words(notification.created_at) %> ago
                   </time>
                   
                   <!-- Actions (Visible on Hover/Focus) -->
                   <div class="opacity-0 group-hover:opacity-100 transition-opacity flex items-center space-x-1">
                     <% unless notification.read? %>
                        <%= button_to mark_as_read_mailbox_path(notification), method: :patch, class: "p-1 text-gray-400 hover:text-primary-600 rounded transition-colors", title: "Mark as read" do %>
                          <i class="fas fa-check"></i>
                        <% end %>
                     <% end %>
                     
                     <%= button_to mailbox_path(notification), method: :delete, class: "p-1 text-gray-400 hover:text-red-600 rounded transition-colors", title: "Delete", form: { data: { turbo_confirm: "Are you sure?" } } do %>
                        <i class="fas fa-trash-alt"></i>
                     <% end %>
                   </div>
                </div>
              </div>
              
              <p class="text-sm text-gray-600 line-clamp-2 mb-2">
                <%= notification.event.message %>
              </p>
              
              <% if notification.event.url.present? %>
                 <%= link_to "View Details", notification.event.url, class: "inline-flex items-center text-xs font-medium text-primary-600 hover:text-primary-700" %>
              <% end %>
            </div>
          </div>
        <% end %>
      </div>
      
      <!-- Pagination -->
      <div class="bg-gray-50 px-6 py-3 border-t border-gray-100">
        <%= paginate @notifications, theme: 'tailwind' %>
      </div>
    <% end %>
  <% else %>
    <%= render Joyful::CardComponent.new(class: "text-center py-16") do %>
      <div class="w-16 h-16 bg-gray-100 rounded-full flex items-center justify-center mx-auto mb-4">
        <i class="far fa-bell-slash text-2xl text-gray-400"></i>
      </div>
      <h3 class="text-lg font-medium text-gray-900 mb-2">No notifications</h3>
      <p class="text-gray-500 max-w-sm mx-auto">You're all caught up! Check back later for new notifications from your compliance workflows.</p>
    <% end %>
  <% end %>
</div> 