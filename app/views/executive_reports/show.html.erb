<div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
  <nav class="mb-6">
    <ol class="flex items-center space-x-2 text-sm text-gray-500">
      <li><%= link_to "Executive Reports", organization_executive_reports_path(@organization), class: "hover:text-indigo-600" %></li>
      <li><i class="fas fa-chevron-right text-xs"></i></li>
      <li class="text-gray-900 font-medium"><%= @report.title.truncate(40) %></li>
    </ol>
  </nav>

  <div class="flex items-center justify-between mb-6">
    <div>
      <h1 class="text-2xl font-bold text-gray-900"><%= @report.title %></h1>
      <p class="text-sm text-gray-500 mt-1"><%= @report.period_label %> • Generated by <%= @report.generated_by&.full_name || 'System' %></p>
    </div>
    <div class="flex gap-2">
      <% unless @report.status_published? %>
        <%= link_to publish_organization_executive_report_path(@organization, @report), method: :patch, data: { turbo_method: :patch }, class: "inline-flex items-center px-3 py-2 text-sm font-medium text-white bg-green-600 hover:bg-green-700 rounded-lg transition-colors" do %>
          <i class="fas fa-check mr-1"></i> Publish
        <% end %>
      <% end %>
    </div>
  </div>

  <!-- Metrics Grid -->
  <div class="grid grid-cols-2 md:grid-cols-4 gap-4 mb-8">
    <div class="bg-white rounded-lg border p-4 text-center">
      <p class="text-3xl font-bold" style="color: var(--primary-color, #6366f1);"><%= @report.metric('compliance_score') || 0 %>%</p>
      <p class="text-xs text-gray-500">Compliance Score</p>
    </div>
    <div class="bg-white rounded-lg border p-4 text-center">
      <p class="text-3xl font-bold text-amber-600"><%= @report.metric('findings')&.dig('active') || 0 %></p>
      <p class="text-xs text-gray-500">Active Findings</p>
    </div>
    <div class="bg-white rounded-lg border p-4 text-center">
      <p class="text-3xl font-bold text-green-600"><%= @report.metric('testing')&.dig('pass_rate') || 0 %>%</p>
      <p class="text-xs text-gray-500">Test Pass Rate</p>
    </div>
    <div class="bg-white rounded-lg border p-4 text-center">
      <p class="text-3xl font-bold text-blue-600"><%= @report.metric('maturity')&.dig('average_maturity') || 0 %></p>
      <p class="text-xs text-gray-500">Avg Maturity</p>
    </div>
  </div>

  <!-- Narrative -->
  <div class="bg-white rounded-xl shadow-sm border p-8 prose max-w-none">
    <%= simple_format(@report.narrative) %>
  </div>
</div>
