<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
  <div class="flex items-center justify-between mb-8">
    <div>
      <h1 class="text-3xl font-bold text-gray-900 flex items-center gap-3">
        <span class="inline-flex items-center justify-center w-10 h-10 rounded-lg" style="background: linear-gradient(135deg, #8b5cf6, #ec4899);">
          <i class="fas fa-handshake text-white text-lg"></i>
        </span>
        Vendor Risk Management
      </h1>
      <p class="mt-1 text-gray-500">Manage third-party vendors and track risk assessments</p>
    </div>
    <%= link_to new_organization_vendor_path(@organization), class: "inline-flex items-center px-4 py-2 text-sm font-medium text-white bg-indigo-600 hover:bg-indigo-700 rounded-lg" do %>
      <i class="fas fa-plus mr-2"></i> Add Vendor
    <% end %>
  </div>

  <% if @expiring.any? %>
    <div class="bg-amber-50 border border-amber-200 rounded-xl p-4 mb-6">
      <p class="text-sm font-medium text-amber-800"><i class="fas fa-exclamation-triangle mr-1"></i> <%= @expiring.count %> vendor contract(s) expiring within 30 days</p>
    </div>
  <% end %>

  <div class="bg-white rounded-xl shadow-sm border overflow-hidden">
    <table class="min-w-full divide-y divide-gray-200">
      <thead class="bg-gray-50">
        <tr>
          <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase">Vendor</th>
          <th class="px-6 py-3 text-center text-xs font-medium text-gray-500 uppercase">Risk Tier</th>
          <th class="px-6 py-3 text-center text-xs font-medium text-gray-500 uppercase">Status</th>
          <th class="px-6 py-3 text-center text-xs font-medium text-gray-500 uppercase">Contract End</th>
          <th class="px-6 py-3 text-right text-xs font-medium text-gray-500 uppercase">Actions</th>
        </tr>
      </thead>
      <tbody class="divide-y divide-gray-200">
        <% @vendors.each do |vendor| %>
          <tr class="hover:bg-gray-50">
            <td class="px-6 py-4">
              <div class="text-sm font-medium text-gray-900"><%= vendor.name %></div>
              <div class="text-xs text-gray-500"><%= vendor.primary_contact_email %></div>
            </td>
            <td class="px-6 py-4 text-center">
              <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-<%= vendor.risk_tier_color %>-100 text-<%= vendor.risk_tier_color %>-800">
                <%= vendor.risk_tier.titleize %>
              </span>
            </td>
            <td class="px-6 py-4 text-center">
              <% status_colors = { 'active' => 'green', 'inactive' => 'gray', 'under_review' => 'yellow', 'offboarding' => 'red' } %>
              <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-<%= status_colors[vendor.status] %>-100 text-<%= status_colors[vendor.status] %>-800">
                <%= vendor.status.titleize %>
              </span>
            </td>
            <td class="px-6 py-4 text-center text-sm text-gray-500"><%= vendor.contract_end&.strftime("%b %d, %Y") || '—' %></td>
            <td class="px-6 py-4 text-right">
              <%= link_to organization_vendor_path(@organization, vendor), class: "text-indigo-600 hover:text-indigo-800 text-sm font-medium" do %>
                View <i class="fas fa-arrow-right ml-1"></i>
              <% end %>
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>
    <% if @vendors.empty? %>
      <div class="text-center py-12">
        <i class="fas fa-handshake text-gray-300 text-4xl mb-3"></i>
        <p class="text-gray-500">No vendors registered yet.</p>
      </div>
    <% end %>
  </div>
</div>
