<div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
  <h1 class="text-2xl font-bold text-gray-900 mb-6"><%= @vendor&.persisted? ? 'Edit' : 'New' %> Vendor</h1>

  <div class="bg-white rounded-xl shadow-sm border p-6">
    <%= form_for [@organization, (@vendor || Vendor.new)], html: { class: "space-y-6" } do |f| %>
      <% if @vendor.errors.any? %>
        <div class="bg-red-50 border border-red-200 rounded-lg p-4">
          <% @vendor.errors.full_messages.each do |msg| %>
            <p class="text-sm text-red-700"><%= msg %></p>
          <% end %>
        </div>
      <% end %>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
        <div>
          <%= f.label :name, class: "block text-sm font-medium text-gray-700 mb-1" %>
          <%= f.text_field :name, class: "block w-full rounded-lg border-gray-300 shadow-sm focus:ring-indigo-500 focus:border-indigo-500 sm:text-sm" %>
        </div>
        <div>
          <%= f.label :website, class: "block text-sm font-medium text-gray-700 mb-1" %>
          <%= f.text_field :website, class: "block w-full rounded-lg border-gray-300 shadow-sm focus:ring-indigo-500 focus:border-indigo-500 sm:text-sm" %>
        </div>
        <div>
          <%= f.label :risk_tier, class: "block text-sm font-medium text-gray-700 mb-1" %>
          <%= f.select :risk_tier, Vendor.risk_tiers.keys.map { |k| [k.titleize, k] }, {}, class: "block w-full rounded-lg border-gray-300 shadow-sm sm:text-sm" %>
        </div>
        <div>
          <%= f.label :status, class: "block text-sm font-medium text-gray-700 mb-1" %>
          <%= f.select :status, Vendor.statuses.keys.map { |k| [k.titleize, k] }, {}, class: "block w-full rounded-lg border-gray-300 shadow-sm sm:text-sm" %>
        </div>
        <div>
          <%= f.label :primary_contact_name, class: "block text-sm font-medium text-gray-700 mb-1" %>
          <%= f.text_field :primary_contact_name, class: "block w-full rounded-lg border-gray-300 shadow-sm sm:text-sm" %>
        </div>
        <div>
          <%= f.label :primary_contact_email, class: "block text-sm font-medium text-gray-700 mb-1" %>
          <%= f.email_field :primary_contact_email, class: "block w-full rounded-lg border-gray-300 shadow-sm sm:text-sm" %>
        </div>
        <div>
          <%= f.label :contract_start, class: "block text-sm font-medium text-gray-700 mb-1" %>
          <%= f.date_field :contract_start, class: "block w-full rounded-lg border-gray-300 shadow-sm sm:text-sm" %>
        </div>
        <div>
          <%= f.label :contract_end, class: "block text-sm font-medium text-gray-700 mb-1" %>
          <%= f.date_field :contract_end, class: "block w-full rounded-lg border-gray-300 shadow-sm sm:text-sm" %>
        </div>
      </div>
      <div>
        <%= f.label :description, class: "block text-sm font-medium text-gray-700 mb-1" %>
        <%= f.text_area :description, rows: 3, class: "block w-full rounded-lg border-gray-300 shadow-sm sm:text-sm" %>
      </div>
      <div class="flex gap-3">
        <%= f.submit class: "px-6 py-2 text-sm font-medium text-white bg-indigo-600 hover:bg-indigo-700 rounded-lg cursor-pointer" %>
        <%= link_to "Cancel", organization_vendors_path(@organization), class: "px-6 py-2 text-sm font-medium text-gray-700 bg-gray-100 hover:bg-gray-200 rounded-lg" %>
      </div>
    <% end %>
  </div>
</div>
