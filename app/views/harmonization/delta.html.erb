<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
  <nav class="mb-6">
    <ol class="flex items-center space-x-2 text-sm text-gray-500">
      <li><%= link_to "Harmonization", organization_harmonization_index_path(@organization), class: "hover:text-indigo-600" %></li>
      <li><i class="fas fa-chevron-right text-xs"></i></li>
      <li class="text-gray-900 font-medium">Delta Analysis: <%= @result[:framework].name %></li>
    </ol>
  </nav>

  <h1 class="text-2xl font-bold text-gray-900 mb-6">Delta Analysis: <%= @result[:framework].name %></h1>

  <!-- Coverage Summary -->
  <div class="bg-white rounded-xl shadow-sm border p-6 mb-6">
    <div class="flex items-center gap-6">
      <div class="flex-1">
        <div class="flex justify-between text-sm mb-2">
          <span class="font-medium text-gray-700">Coverage</span>
          <span class="font-bold text-gray-900"><%= @result[:coverage_percentage] %>%</span>
        </div>
        <div class="w-full bg-gray-100 rounded-full h-4">
          <div class="h-4 rounded-full transition-all duration-700" style="width: <%= @result[:coverage_percentage] %>%; background: linear-gradient(90deg, #10b981, #34d399);"></div>
        </div>
      </div>
      <div class="text-center px-4">
        <p class="text-2xl font-bold text-green-600"><%= @result[:covered_count] %></p>
        <p class="text-xs text-gray-500">Already Covered</p>
      </div>
      <div class="text-center px-4">
        <p class="text-2xl font-bold text-red-600"><%= @result[:gap_count] %></p>
        <p class="text-xs text-gray-500">Gaps</p>
      </div>
      <div class="text-center px-4">
        <p class="text-2xl font-bold text-gray-900"><%= @result[:total_requirements] %></p>
        <p class="text-xs text-gray-500">Total Requirements</p>
      </div>
    </div>
  </div>

  <!-- Gap Items -->
  <div class="bg-white rounded-xl shadow-sm border overflow-hidden">
    <table class="min-w-full divide-y divide-gray-200">
      <thead class="bg-gray-50">
        <tr>
          <th class="px-4 py-3 text-left text-xs font-medium text-gray-500 uppercase">Requirement</th>
          <th class="px-4 py-3 text-center text-xs font-medium text-gray-500 uppercase">Status</th>
          <th class="px-4 py-3 text-left text-xs font-medium text-gray-500 uppercase">Covering Controls</th>
          <th class="px-4 py-3 text-right text-xs font-medium text-gray-500 uppercase">Actions</th>
        </tr>
      </thead>
      <tbody class="divide-y divide-gray-200">
        <% @result[:gap_analysis].each do |item| %>
          <tr class="hover:bg-gray-50">
            <td class="px-4 py-3">
              <div class="text-sm font-medium text-gray-900"><%= item[:requirement].name %></div>
              <% if item[:requirement].description.present? %>
                <div class="text-xs text-gray-500 mt-1"><%= item[:requirement].description.truncate(100) %></div>
              <% end %>
            </td>
            <td class="px-4 py-3 text-center">
              <% if item[:covered] %>
                <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-green-100 text-green-800">
                  <i class="fas fa-check mr-1"></i> Covered
                </span>
              <% else %>
                <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-red-100 text-red-800">
                  <i class="fas fa-times mr-1"></i> Gap
                </span>
              <% end %>
            </td>
            <td class="px-4 py-3">
              <% if item[:covering_controls].any? %>
                <% item[:covering_controls].first(3).each do |ctrl| %>
                  <span class="inline-flex items-center px-2 py-0.5 rounded text-xs bg-blue-50 text-blue-700 mr-1 mb-1"><%= ctrl.name.truncate(30) %></span>
                <% end %>
              <% else %>
                <span class="text-xs text-gray-400">None</span>
              <% end %>
            </td>
            <td class="px-4 py-3 text-right">
              <% unless item[:covered] %>
                <%= link_to new_organization_compliance_framework_compliance_requirement_path(@organization, @result[:framework], item[:requirement]), class: "text-xs text-indigo-600 hover:text-indigo-800 font-medium" do %>
                  Create Control <i class="fas fa-plus ml-1"></i>
                <% end %>
              <% end %>
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>
</div>
