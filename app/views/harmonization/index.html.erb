<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
  <!-- Header -->
  <div class="flex items-center justify-between mb-8">
    <div>
      <h1 class="text-3xl font-bold text-gray-900 flex items-center gap-3">
        <span class="inline-flex items-center justify-center w-10 h-10 rounded-lg" style="background: linear-gradient(135deg, var(--primary-color, #6366f1), var(--accent-color, #ec4899));">
          <i class="fas fa-project-diagram text-white text-lg"></i>
        </span>
        Cross-Framework Harmonization
      </h1>
      <p class="mt-1 text-gray-500">Identify overlap and optimize controls across compliance frameworks</p>
    </div>
  </div>

  <!-- Feature Cards -->
  <div class="grid grid-cols-1 md:grid-cols-3 gap-6 mb-8">
    <!-- Matrix View -->
    <div class="bg-white rounded-xl shadow-sm border border-gray-100 p-6 hover:shadow-md transition-shadow">
      <div class="w-12 h-12 rounded-lg bg-blue-100 flex items-center justify-center mb-4">
        <i class="fas fa-th text-blue-600 text-xl"></i>
      </div>
      <h3 class="text-lg font-semibold text-gray-900 mb-2">Harmonization Matrix</h3>
      <p class="text-sm text-gray-500 mb-4">See which controls satisfy requirements across multiple frameworks. Identify unified controls and gaps.</p>
      <%= link_to matrix_organization_harmonization_index_path(@organization), class: "inline-flex items-center text-sm font-medium text-indigo-600 hover:text-indigo-800" do %>
        View Matrix <i class="fas fa-arrow-right ml-2"></i>
      <% end %>
      <% if @overlap_count > 0 %>
        <div class="mt-3 inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-green-100 text-green-800">
          <i class="fas fa-check-circle mr-1"></i> <%= @overlap_count %> multi-framework controls found
        </div>
      <% end %>
    </div>

    <!-- Delta Analysis -->
    <div class="bg-white rounded-xl shadow-sm border border-gray-100 p-6 hover:shadow-md transition-shadow">
      <div class="w-12 h-12 rounded-lg bg-amber-100 flex items-center justify-center mb-4">
        <i class="fas fa-code-branch text-amber-600 text-xl"></i>
      </div>
      <h3 class="text-lg font-semibold text-gray-900 mb-2">Framework Delta Analysis</h3>
      <p class="text-sm text-gray-500 mb-4">Planning to adopt a new framework? See what you already cover and what gaps remain.</p>
      <% if @frameworks.any? %>
        <%= form_tag(delta_organization_harmonization_index_path(@organization), method: :get, class: "flex items-end gap-2") do %>
          <%= select_tag :framework_id, options_from_collection_for_select(@frameworks, :id, :name), prompt: "Select framework...", class: "block rounded-lg border-gray-300 shadow-sm focus:ring-indigo-500 focus:border-indigo-500 text-sm" %>
          <%= submit_tag "Analyze", class: "inline-flex items-center px-3 py-2 text-sm font-medium text-white bg-amber-600 hover:bg-amber-700 rounded-lg transition-colors cursor-pointer" %>
        <% end %>
      <% end %>
    </div>

    <!-- AI Suggestions -->
    <div class="bg-white rounded-xl shadow-sm border border-gray-100 p-6 hover:shadow-md transition-shadow">
      <div class="w-12 h-12 rounded-lg bg-purple-100 flex items-center justify-center mb-4">
        <i class="fas fa-magic text-purple-600 text-xl"></i>
      </div>
      <h3 class="text-lg font-semibold text-gray-900 mb-2">Extension Suggestions</h3>
      <p class="text-sm text-gray-500 mb-4">AI identifies existing controls that could be extended to cover additional framework requirements.</p>
      <%= link_to suggestions_organization_harmonization_index_path(@organization), class: "inline-flex items-center text-sm font-medium text-purple-600 hover:text-purple-800" do %>
        View Suggestions <i class="fas fa-arrow-right ml-2"></i>
      <% end %>
    </div>
  </div>

  <!-- Your Frameworks -->
  <div class="bg-white rounded-xl shadow-sm border border-gray-100 p-6">
    <h2 class="text-lg font-semibold text-gray-900 mb-4">Your Compliance Frameworks</h2>
    <% if @frameworks.any? %>
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4">
        <% @frameworks.each do |fw| %>
          <div class="border border-gray-200 rounded-lg p-4 hover:border-indigo-300 transition-colors">
            <h4 class="font-medium text-gray-900"><%= fw.name %></h4>
            <p class="text-sm text-gray-500 mt-1"><%= fw.compliance_requirements.count %> requirements</p>
            <p class="text-xs text-gray-400"><%= fw.compliance_requirements.joins(:compliance_controls).distinct.count %> linked controls</p>
          </div>
        <% end %>
      </div>
    <% else %>
      <p class="text-gray-500">No frameworks found. Create compliance frameworks first.</p>
    <% end %>
  </div>
</div>
