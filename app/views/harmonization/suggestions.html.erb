<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
  <nav class="mb-6">
    <ol class="flex items-center space-x-2 text-sm text-gray-500">
      <li><%= link_to "Harmonization", organization_harmonization_index_path(@organization), class: "hover:text-indigo-600" %></li>
      <li><i class="fas fa-chevron-right text-xs"></i></li>
      <li class="text-gray-900 font-medium">Extension Suggestions</li>
    </ol>
  </nav>

  <h1 class="text-2xl font-bold text-gray-900 mb-2">AI Extension Suggestions</h1>
  <p class="text-gray-500 mb-6">Controls that could be extended to cover additional framework requirements</p>

  <% if @suggestions.any? %>
    <div class="space-y-4">
      <% @suggestions.each do |suggestion| %>
        <div class="bg-white rounded-xl shadow-sm border border-gray-100 p-6 hover:shadow-md transition-shadow">
          <div class="flex items-start justify-between">
            <div class="flex-1">
              <div class="flex items-center gap-3 mb-3">
                <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-purple-100 text-purple-800">
                  <i class="fas fa-magic mr-1"></i> <%= suggestion[:confidence] %>% confidence
                </span>
              </div>
              <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                <div class="border-l-4 border-blue-400 pl-4">
                  <p class="text-xs font-medium text-gray-400 uppercase mb-1">Existing Control</p>
                  <p class="text-sm font-semibold text-gray-900"><%= suggestion[:suggested_control].name %></p>
                  <p class="text-xs text-gray-500 mt-1">
                    <%= suggestion[:suggested_control].compliance_requirement&.compliance_framework&.name %> ›
                    <%= suggestion[:suggested_control].compliance_requirement&.name&.truncate(40) %>
                  </p>
                </div>
                <div class="border-l-4 border-amber-400 pl-4">
                  <p class="text-xs font-medium text-gray-400 uppercase mb-1">Could Also Cover</p>
                  <p class="text-sm font-semibold text-gray-900"><%= suggestion[:requirement].name %></p>
                  <p class="text-xs text-gray-500 mt-1">
                    <%= suggestion[:requirement].compliance_framework&.name %>
                  </p>
                </div>
              </div>
              <p class="text-xs text-gray-400 mt-3"><i class="fas fa-info-circle mr-1"></i> <%= suggestion[:similarity_reason] %></p>
            </div>
            <div class="flex gap-2 ml-4">
              <%= form_tag(organization_harmonization_create_mapping_path(@organization), method: :post) do %>
                <%= hidden_field_tag "framework_mapping[source_requirement_id]", suggestion[:suggested_control].compliance_requirement_id %>
                <%= hidden_field_tag "framework_mapping[target_requirement_id]", suggestion[:requirement].id %>
                <%= hidden_field_tag "framework_mapping[mapping_type]", "related" %>
                <%= hidden_field_tag "framework_mapping[confidence]", suggestion[:confidence] %>
                <%= hidden_field_tag "framework_mapping[ai_generated]", true %>
                <%= submit_tag "Accept", class: "px-3 py-1.5 text-xs font-medium text-white bg-green-600 hover:bg-green-700 rounded-lg cursor-pointer transition-colors" %>
              <% end %>
            </div>
          </div>
        </div>
      <% end %>
    </div>
  <% else %>
    <div class="bg-white rounded-xl shadow-sm border p-12 text-center">
      <i class="fas fa-magic text-gray-300 text-4xl mb-3"></i>
      <p class="text-gray-500">No extension suggestions at this time. Add more frameworks and controls to generate suggestions.</p>
    </div>
  <% end %>
</div>
