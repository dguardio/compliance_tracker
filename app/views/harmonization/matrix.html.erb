<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
  <nav class="mb-6">
    <ol class="flex items-center space-x-2 text-sm text-gray-500">
      <li><%= link_to "Harmonization", organization_harmonization_index_path(@organization), class: "hover:text-indigo-600" %></li>
      <li><i class="fas fa-chevron-right text-xs"></i></li>
      <li class="text-gray-900 font-medium">Cross-Reference Matrix</li>
    </ol>
  </nav>

  <div class="flex items-center justify-between mb-6">
    <h1 class="text-2xl font-bold text-gray-900">Harmonization Matrix</h1>
    <%= form_tag(matrix_organization_harmonization_index_path(@organization), method: :get, class: "flex items-end gap-2") do %>
      <% @frameworks.each do |fw| %>
        <label class="flex items-center gap-1 text-sm">
          <%= check_box_tag "framework_ids[]", fw.id, @result[:frameworks].map(&:id).include?(fw.id), class: "rounded border-gray-300 text-indigo-600" %>
          <%= fw.name %>
        </label>
      <% end %>
      <%= submit_tag "Update", class: "px-3 py-1.5 text-sm font-medium text-white bg-indigo-600 hover:bg-indigo-700 rounded-lg cursor-pointer" %>
    <% end %>
  </div>

  <!-- Summary -->
  <div class="grid grid-cols-1 md:grid-cols-4 gap-4 mb-6">
    <div class="bg-white rounded-lg border p-4 text-center">
      <p class="text-2xl font-bold text-gray-900"><%= @result[:summary][:total_controls] %></p>
      <p class="text-xs text-gray-500">Total Controls</p>
    </div>
    <div class="bg-white rounded-lg border p-4 text-center">
      <p class="text-2xl font-bold text-green-600"><%= @result[:summary][:multi_framework] %></p>
      <p class="text-xs text-gray-500">Multi-Framework</p>
    </div>
    <div class="bg-white rounded-lg border p-4 text-center">
      <p class="text-2xl font-bold text-amber-600"><%= @result[:summary][:single_framework] %></p>
      <p class="text-xs text-gray-500">Single-Framework</p>
    </div>
    <div class="bg-white rounded-lg border p-4 text-center">
      <p class="text-2xl font-bold" style="color: var(--primary-color, #6366f1);"><%= @result[:summary][:harmonization_rate] %>%</p>
      <p class="text-xs text-gray-500">Harmonization Rate</p>
    </div>
  </div>

  <!-- Matrix Table -->
  <div class="bg-white rounded-xl shadow-sm border overflow-x-auto">
    <table class="min-w-full divide-y divide-gray-200">
      <thead class="bg-gray-50">
        <tr>
          <th class="px-4 py-3 text-left text-xs font-medium text-gray-500 uppercase">Control</th>
          <% @result[:frameworks].each do |fw| %>
            <th class="px-4 py-3 text-center text-xs font-medium text-gray-500 uppercase"><%= fw.name %></th>
          <% end %>
          <th class="px-4 py-3 text-center text-xs font-medium text-gray-500 uppercase">Coverage</th>
        </tr>
      </thead>
      <tbody class="divide-y divide-gray-200">
        <% @result[:matrix].each do |row| %>
          <tr class="hover:bg-gray-50">
            <td class="px-4 py-3">
              <div class="text-sm font-medium text-gray-900"><%= row[:control].name %></div>
              <div class="text-xs text-gray-500"><%= row[:control].compliance_requirement&.name&.truncate(50) %></div>
            </td>
            <% row[:framework_coverage].each do |cov| %>
              <td class="px-4 py-3 text-center">
                <% if cov[:covered] %>
                  <span class="inline-flex items-center justify-center w-8 h-8 rounded-full bg-green-100">
                    <i class="fas fa-check text-green-600"></i>
                  </span>
                <% else %>
                  <span class="inline-flex items-center justify-center w-8 h-8 rounded-full bg-gray-100">
                    <i class="fas fa-minus text-gray-400"></i>
                  </span>
                <% end %>
              </td>
            <% end %>
            <td class="px-4 py-3 text-center">
              <span class="inline-flex items-center px-2 py-0.5 rounded-full text-xs font-medium <%= row[:multi_framework] ? 'bg-green-100 text-green-800' : 'bg-gray-100 text-gray-600' %>">
                <%= row[:coverage_count] %>/<%= @result[:frameworks].size %>
              </span>
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>
    <% if @result[:matrix].empty? %>
      <div class="text-center py-12">
        <i class="fas fa-th text-gray-300 text-4xl mb-3"></i>
        <p class="text-gray-500">No controls found for the selected frameworks.</p>
      </div>
    <% end %>
  </div>
</div>
