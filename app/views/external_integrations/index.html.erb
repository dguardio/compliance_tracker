<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
  <div class="flex items-center justify-between mb-8">
    <div>
      <h1 class="text-3xl font-bold text-gray-900 flex items-center gap-3">
        <span class="inline-flex items-center justify-center w-10 h-10 rounded-lg" style="background: linear-gradient(135deg, #0052CC, #5E6AD2);">
          <i class="fas fa-plug text-white text-lg"></i>
        </span>
        External Integrations
      </h1>
      <p class="mt-1 text-gray-500">Connect to Jira, Linear, or ServiceNow for bi-directional ticket sync</p>
    </div>
    <%= link_to new_organization_external_integration_path(@organization), class: "inline-flex items-center px-4 py-2 text-sm font-medium text-white bg-indigo-600 hover:bg-indigo-700 rounded-lg" do %>
      <i class="fas fa-plus mr-2"></i> Add Integration
    <% end %>
  </div>

  <!-- Integrations -->
  <div class="grid grid-cols-1 md:grid-cols-3 gap-6 mb-8">
    <% @integrations.each do |integration| %>
      <div class="bg-white rounded-xl shadow-sm border border-gray-100 p-6 hover:shadow-md transition-shadow">
        <div class="flex items-center gap-3 mb-4">
          <div class="w-12 h-12 rounded-lg flex items-center justify-center" style="background-color: <%= integration.provider_info[:color] %>20;">
            <i class="<%= integration.provider_info[:icon] %> text-2xl" style="color: <%= integration.provider_info[:color] %>;"></i>
          </div>
          <div>
            <h3 class="font-semibold text-gray-900"><%= integration.label %></h3>
            <p class="text-xs text-gray-500"><%= integration.provider_info[:name] %></p>
          </div>
          <% if integration.connected? %>
            <span class="w-2.5 h-2.5 rounded-full bg-green-500 ml-auto"></span>
          <% else %>
            <span class="w-2.5 h-2.5 rounded-full bg-gray-300 ml-auto"></span>
          <% end %>
        </div>
        <p class="text-xs text-gray-400 mb-3">
          <% if integration.last_synced_at %>
            Last synced: <%= time_ago_in_words(integration.last_synced_at) %> ago
          <% else %>
            Never synced
          <% end %>
        </p>
        <div class="flex gap-2">
          <%= link_to organization_external_integration_path(@organization, integration), class: "text-sm text-indigo-600 hover:text-indigo-800 font-medium" do %>
            Manage <i class="fas fa-arrow-right ml-1"></i>
          <% end %>
        </div>
      </div>
    <% end %>
    <% if @integrations.empty? %>
      <div class="col-span-3 bg-white rounded-xl shadow-sm border p-12 text-center">
        <i class="fas fa-plug text-gray-300 text-4xl mb-3"></i>
        <p class="text-gray-500">No integrations configured yet.</p>
      </div>
    <% end %>
  </div>

  <!-- Recent Tickets -->
  <div class="bg-white rounded-xl shadow-sm border overflow-hidden">
    <div class="px-6 py-4 border-b border-gray-100">
      <h2 class="text-lg font-semibold text-gray-900">Recent Synced Tickets</h2>
    </div>
    <% if @recent_tickets.any? %>
      <table class="min-w-full divide-y divide-gray-200">
        <thead class="bg-gray-50">
          <tr>
            <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase">External ID</th>
            <th class="px-6 py-3 text-center text-xs font-medium text-gray-500 uppercase">Provider</th>
            <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase">Linked To</th>
            <th class="px-6 py-3 text-center text-xs font-medium text-gray-500 uppercase">Status</th>
            <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase">Last Synced</th>
          </tr>
        </thead>
        <tbody class="divide-y divide-gray-200">
          <% @recent_tickets.each do |ticket| %>
            <tr class="hover:bg-gray-50">
              <td class="px-6 py-4 text-sm font-medium text-indigo-600">
                <% if ticket.external_url.present? %>
                  <%= link_to ticket.external_id, ticket.external_url, target: '_blank', class: "hover:underline" %>
                <% else %>
                  <%= ticket.external_id %>
                <% end %>
              </td>
              <td class="px-6 py-4 text-center">
                <i class="<%= ticket.provider_info[:icon] %>" style="color: <%= ticket.provider_info[:color] %>;"></i>
              </td>
              <td class="px-6 py-4 text-sm text-gray-500">
                <%= ticket.source_type %>: <%= ticket.source&.title&.truncate(40) || 'N/A' %>
              </td>
              <td class="px-6 py-4 text-center">
                <span class="inline-flex items-center px-2 py-0.5 rounded-full text-xs font-medium bg-gray-100 text-gray-800"><%= ticket.external_status %></span>
              </td>
              <td class="px-6 py-4 text-sm text-gray-500"><%= ticket.last_synced_at&.strftime("%b %d, %H:%M") || 'Never' %></td>
            </tr>
          <% end %>
        </tbody>
      </table>
    <% else %>
      <div class="text-center py-8">
        <p class="text-gray-500 text-sm">No tickets synced yet.</p>
      </div>
    <% end %>
  </div>
</div>
