<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
  <!-- Header -->
  <div class="mb-8 flex items-center justify-between">
    <div>
      <h1 class="text-3xl font-bold text-gray-900 tracking-tight">Risk Dashboard</h1>
      <p class="mt-1 text-lg text-gray-500">
        Monitoring compliance health for <span class="font-semibold text-indigo-600"><%= @organization.name %></span>.
      </p>
    </div>
    <div class="flex space-x-3">
        <%= render Joyful::ButtonComponent.new(text: "Dashboard", variant: :secondary, path: dashboard_path, icon: "fa fa-home") %>
        <%= render Joyful::ButtonComponent.new(text: "Frameworks / Compliance", variant: :primary, path: organization_compliance_frameworks_path(@organization), icon: "fa fa-shield-alt") %>
    </div>
  </div>

  <!-- Risk Overview (Pulse) -->
  <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6 mb-8">
      <!-- Critical Risk -->
      <%= render Joyful::CardComponent.new(padding: true) do %>
         <div class="flex flex-col items-center justify-center py-2 text-center">
            <div class="p-3 bg-danger-50 rounded-full text-danger-500 mb-2">
               <svg class="h-6 w-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-2.5L13.732 4c-.77-.833-1.964-.833-2.732 0L3.732 16.5c-.77.833.192 2.5 1.732 2.5z"></path></svg>
            </div>
            <% count = @risk_stats[:critical_risk_requirements] %>
            <span class="text-3xl font-bold <%= count > 0 ? 'text-danger-600' : 'text-gray-900' %> tabular-nums"><%= count %></span>
            <span class="text-xs font-semibold text-gray-400 uppercase tracking-wide">Critical Risks</span>
         </div>
      <% end %>

      <!-- High Risk -->
      <%= render Joyful::CardComponent.new(padding: true) do %>
         <div class="flex flex-col items-center justify-center py-2 text-center">
            <div class="p-3 bg-warning-50 rounded-full text-warning-500 mb-2">
               <svg class="h-6 w-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-2.5L13.732 4c-.77-.833-1.964-.833-2.732 0L3.732 16.5c-.77.833.192 2.5 1.732 2.5z"></path></svg>
            </div>
            <% count = @risk_stats[:high_risk_requirements] %>
            <span class="text-3xl font-bold <%= count > 0 ? 'text-warning-600' : 'text-gray-900' %> tabular-nums"><%= count %></span>
            <span class="text-xs font-semibold text-gray-400 uppercase tracking-wide">High Risks</span>
         </div>
      <% end %>

      <!-- Effective Controls -->
      <%= render Joyful::CardComponent.new(padding: true) do %>
         <div class="flex flex-col items-center justify-center py-2 text-center">
            <div class="p-3 bg-success-50 rounded-full text-success-600 mb-2">
               <svg class="h-6 w-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"></path></svg>
            </div>
            <span class="text-3xl font-bold text-success-600 tabular-nums"><%= @risk_stats[:effective_controls] %></span>
            <span class="text-xs font-semibold text-gray-400 uppercase tracking-wide">Effective Controls</span>
         </div>
      <% end %>

      <!-- Total Reqs -->
      <%= render Joyful::CardComponent.new(padding: true) do %>
         <div class="flex flex-col items-center justify-center py-2 text-center">
            <div class="p-3 bg-primary-50 rounded-full text-primary-600 mb-2">
               <svg class="h-6 w-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5H7a2 2 0 00-2 2v10a2 2 0 002 2h8a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2"></path></svg>
            </div>
            <span class="text-3xl font-bold text-primary-600 tabular-nums"><%= @risk_stats[:total_requirements] %></span>
            <span class="text-xs font-semibold text-gray-400 uppercase tracking-wide">Total Requirements</span>
         </div>
      <% end %>

  </div>

  <!-- Heatmap: Risk by Framework -->
  <div class="mb-12">
     <h2 class="text-xl font-bold text-gray-900 mb-6 flex items-center gap-2">
        Risk Heatmap
        <span class="text-sm font-normal text-gray-500">by Framework</span>
     </h2>
     
     <% if @risk_by_framework.any? %>
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
           <% @risk_by_framework.each do |fw_data| %>
              <%= render Joyful::CardComponent.new(padding: true) do %>
                 <div class="flex items-start justify-between mb-4">
                    <h3 class="font-bold text-gray-900 group-hover:text-primary-600 transition-colors line-clamp-1">
                       <%= link_to fw_data[:framework].name, organization_compliance_framework_path(@organization, fw_data[:framework]) %>
                    </h3>
                    <span class="text-xs font-mono text-gray-400"><%= fw_data[:requirements] %> REQ</span>
                 </div>
                 
                 <!-- Visual Bar Chart -->
                 <div class="flex h-4 w-full rounded-full overflow-hidden bg-slate-100 mb-4">
                    <% total = fw_data[:requirements].to_f %>
                    <% if total > 0 %>
                        <div style="width: <%= (fw_data[:critical_risk] / total * 100) %>%" class="bg-danger-500" title="Critical: <%= fw_data[:critical_risk] %>"></div>
                        <div style="width: <%= (fw_data[:high_risk] / total * 100) %>%" class="bg-warning-500" title="High: <%= fw_data[:high_risk] %>"></div>
                        <div style="width: <%= (fw_data[:medium_risk] / total * 100) %>%" class="bg-yellow-400" title="Medium: <%= fw_data[:medium_risk] %>"></div>
                        <div style="width: <%= (fw_data[:low_risk] / total * 100) %>%" class="bg-success-400" title="Low: <%= fw_data[:low_risk] %>"></div>
                    <% end %>
                 </div>

                 <!-- Legend / Stats -->
                 <div class="grid grid-cols-4 gap-2 text-center text-xs">
                    <div class="flex flex-col">
                       <span class="font-bold text-danger-600"><%= fw_data[:critical_risk] %></span>
                       <span class="text-gray-400">Crit</span>
                    </div>
                    <div class="flex flex-col">
                       <span class="font-bold text-warning-600"><%= fw_data[:high_risk] %></span>
                       <span class="text-gray-400">High</span>
                    </div>
                    <div class="flex flex-col">
                       <span class="font-bold text-yellow-600"><%= fw_data[:medium_risk] %></span>
                       <span class="text-gray-400">Med</span>
                    </div>
                    <div class="flex flex-col">
                       <span class="font-bold text-success-600"><%= fw_data[:low_risk] %></span>
                       <span class="text-gray-400">Low</span>
                    </div>
                 </div>
              <% end %>
           <% end %>
        </div>
     <% else %>
        <div class="text-center py-12 bg-slate-50 rounded-3xl border border-dashed border-slate-300">
           <h3 class="text-lg font-medium text-gray-900 mb-2">No frameworks configured</h3>
           <p class="text-gray-500 mb-4">Add frameworks to visualize risk distribution.</p>
        </div>
     <% end %>
  </div>

  <!-- Priority Focus: High Risk Items -->
  <div class="grid grid-cols-1 lg:grid-cols-2 gap-8">
     <!-- High Risk Requirements -->
     <section>
        <div class="flex items-center justify-between mb-4">
           <h2 class="text-lg font-bold text-gray-900">Highest Risk Requirements</h2>
           <span class="bg-danger-100 text-danger-800 text-xs font-bold px-2 py-1 rounded-full"><%= @high_risk_requirements.count %></span>
        </div>
        
        <div class="space-y-3">
           <% if @high_risk_requirements.any? %>
              <% @high_risk_requirements.each do |req| %>
                 <div class="bg-white p-4 rounded-xl border border-slate-200 shadow-sm hover:border-danger-200 hover:shadow-md transition-all group cursor-pointer relative overflow-hidden">
                    <div class="absolute left-0 top-0 bottom-0 w-1 bg-danger-500"></div>
                    <div class="pl-2">
                       <h4 class="text-sm font-semibold text-gray-900 group-hover:text-danger-700 transition-colors">
                          <%= link_to req.name, organization_compliance_framework_compliance_requirement_path(@organization, req.compliance_framework, req), class: "focus:outline-none" %>
                       </h4>
                       <div class="flex justify-between items-center mt-2">
                          <p class="text-xs text-gray-500"><%= req.compliance_framework.name %></p>
                          <%= render Joyful::StatusPillComponent.new(status: :critical, text: "Critical") %>
                       </div>
                    </div>
                 </div>
              <% end %>
           <% else %>
              <div class="bg-success-50 rounded-xl p-6 text-center border border-success-100">
                 <p class="text-success-700 font-medium">All clear! No critical requirements.</p>
              </div>
           <% end %>
        </div>
     </section>

     <!-- High Risk Controls -->
     <section>
        <div class="flex items-center justify-between mb-4">
           <h2 class="text-lg font-bold text-gray-900">Controls Needing Attention</h2>
        </div>
        
        <div class="space-y-3">
           <% if @high_risk_controls.any? %>
              <% @high_risk_controls.each do |control| %>
                 <div class="bg-white p-4 rounded-xl border border-slate-200 shadow-sm hover:border-warning-200 hover:shadow-md transition-all group cursor-pointer">
                    <h4 class="text-sm font-semibold text-gray-900 group-hover:text-warning-700 transition-colors">
                       <%= link_to control.name, organization_compliance_framework_compliance_requirement_compliance_control_path(@organization, control.compliance_requirement.compliance_framework, control.compliance_requirement, control) %>
                    </h4>
                    <div class="flex justify-between items-center mt-2">
                       <div class="flex items-center gap-2">
                          <div class="h-6 w-6 rounded-full bg-slate-200 border-2 border-white overflow-hidden" title="Assignee Placeholder">
                            <!-- Placeholder avatar -->
                            <svg class="h-full w-full text-slate-400" fill="currentColor" viewBox="0 0 24 24"><path d="M24 20.993V24H0v-2.996A14.977 14.977 0 0112.004 15c4.904 0 9.26 2.354 11.996 5.993zM16.002 8.999a4 4 0 11-8 0 4 4 0 018 0z" /></svg>
                          </div>
                          <span class="text-xs text-gray-500"><%= control.compliance_requirement.name %></span>
                       </div>
                       <%= render Joyful::StatusPillComponent.new(status: :high, text: "High Risk") %>
                    </div>
                 </div>
              <% end %>
           <% else %>
              <div class="bg-success-50 rounded-xl p-6 text-center border border-success-100">
                 <p class="text-success-700 font-medium">Controls are looking good!</p>
              </div>
           <% end %>
        </div>
     </section>
  </div>
</div>