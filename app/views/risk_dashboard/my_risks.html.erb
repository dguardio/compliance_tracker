<div class="min-h-screen bg-gray-50 py-8">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="md:flex md:items-center md:justify-between mb-8">
      <div class="flex-1 min-w-0">
        <h2 class="text-2xl font-bold leading-7 text-gray-900 sm:text-3xl sm:truncate">My Risks</h2>
        <p class="mt-1 text-sm text-gray-500">Risk assessments assigned to you.</p>
      </div>
      <div class="mt-4 flex md:mt-0 md:ml-4">
        <%= link_to "Back to Dashboard", risk_dashboard_path, class: "inline-flex items-center px-4 py-2 border border-gray-300 rounded-md shadow-sm text-sm font-medium text-gray-700 bg-white hover:bg-gray-50 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-indigo-500" %>
      </div>
    </div>

    <% if @risk_assessments.any? %>
      <%= render 'risk_table', risks: @risk_assessments %>
      <div class="mt-4">
        <%= paginate @risk_assessments %>
      </div>
    <% else %>
      <div class="text-center py-12 bg-white rounded-lg shadow">
        <svg class="mx-auto h-12 w-12 text-gray-400" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z" />
        </svg>
        <h3 class="mt-2 text-sm font-medium text-gray-900">No risks assigned</h3>
        <p class="mt-1 text-sm text-gray-500">You don't have any risk assessments assigned to you.</p>
      </div>
    <% end %>
  </div>
</div>
