<div class="max-w-7xl mx-auto py-10 px-4 sm:px-6 lg:px-8" data-controller="kanban">
  <div class="flex justify-between items-center mb-6">
    <h1 class="text-3xl font-bold text-gray-900">
      <%= @filter_title || "My Tasks" %>
    </h1>
    <% if @filter_title %>
      <%= render Joyful::ButtonComponent.new(
            text: "Clear Filter",
            path: tasks_path,
            variant: :secondary,
            icon: "times",
            class: "text-sm",
            data: { turbo: false }
          ) %>
    <% end %>
  </div>

  <div class="flex space-x-6 overflow-x-auto pb-8 snap-x">
    <% @statuses.each do |status| %>
      <div class="bg-slate-100/50 rounded-xl p-4 w-80 flex-shrink-0 snap-center border border-slate-200/60 backdrop-blur-sm">
        <div class="flex items-center justify-between mb-4">
          <h2 class="text-sm font-bold text-gray-700 uppercase tracking-wider"><%= status.humanize %></h2>
          <span class="bg-white text-gray-500 text-xs font-medium px-2 py-0.5 rounded-full shadow-sm border border-gray-100">
            <%= (@tasks[status] || []).count %>
          </span>
        </div>
        
        <div class="space-y-3 min-h-[500px]" data-kanban-target="column" data-status="<%= status %>">
          <% (@tasks[status] || []).each do |task| %>
            <%= link_to task_path(task), data: { turbo_frame: "modal" }, class: "block group" do %>
              <%= render Joyful::CardComponent.new(class: "hover:shadow-primary-glow hover:-translate-y-1 transition-all duration-200 cursor-pointer border-l-4 #{priority_color_class(task.priority)}") do %>
                <div class="flex justify-between items-start mb-2">
                   <%= render Joyful::StatusPillComponent.new(status: task.priority, text: task.priority) %>
                   <% if task.due_date %>
                     <span class="text-xs font-medium <%= task.due_date < Date.current ? 'text-red-500' : 'text-gray-400' %> flex items-center">
                       <i class="far fa-clock mr-1"></i>
                       <%= task.due_date.strftime('%b %d') %>
                     </span>
                   <% end %>
                </div>
                
                <h3 class="font-semibold text-gray-900 mb-1 group-hover:text-primary-600 transition-colors line-clamp-2">
                  <%= task.name %>
                </h3>
                
                <p class="text-xs text-gray-500 mb-3 line-clamp-2">
                  <%= task.compliance_requirement.name %>
                </p>
                
                <p class="text-sm text-gray-600 line-clamp-3">
                  <%= truncate(task.description, length: 100) %>
                </p>
              <% end %>
            <% end %>
          <% end %>
        </div>
      </div>
    <% end %>
  </div>
</div>
