<div class="max-w-7xl mx-auto py-10 px-4 sm:px-6 lg:px-8" data-controller="kanban">
  <h1 class="text-3xl font-bold text-gray-900 mb-2">
    <%= @filter_title || "My Tasks" %>
  </h1>
  <% if @filter_title %>
    <%= link_to "Clear filter", tasks_path, class: "text-sm text-indigo-600 hover:text-indigo-800 mb-6 block" %>
  <% end %>

  <div class="flex space-x-4 overflow-x-auto pb-4">
    <% @statuses.each do |status| %>
      <div class="bg-gray-100 rounded-lg p-4 w-80 flex-shrink-0">
        <h2 class="text-lg font-bold text-gray-800 mb-4 capitalize"><%= status.humanize %></h2>
        <div class="space-y-4 h-full" data-kanban-target="column" data-status="<%= status %>">
          <% (@tasks[status] || []).each do |task| %>
            <%= link_to task_path(task), data: { turbo_frame: "modal" } do %>
              <div class="bg-white rounded-lg shadow p-4 hover:shadow-md transition-shadow" data-id="<%= task.id %>">
                <p class="text-xs text-gray-500"><%= task.compliance_requirement.name %></p>
                <h3 class="font-semibold text-gray-900"><%= task.name %></h3>
                <p class="text-sm text-gray-600 mt-1"><%= truncate(task.description, length: 100) %></p>
                <div class="mt-3 flex justify-between items-center">
                  <span class="text-xs font-medium <%= task.due_date && task.due_date < Date.current ? 'text-red-600' : 'text-gray-500' %>">
                    Due: <%= task.due_date ? task.due_date.strftime('%b %d') : 'N/A' %>
                  </span>
                  <span class="px-2 py-1 text-xs font-semibold rounded-full <%= task.priority == 'high' ? 'bg-red-100 text-red-800' : 'bg-gray-100 text-gray-800' %>">
                    <%= task.priority %>
                  </span>
                </div>
              </div>
            <% end %>
          <% end %>
        </div>
      </div>
    <% end %>
  </div>
</div>
