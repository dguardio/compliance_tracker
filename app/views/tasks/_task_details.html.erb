<div class="p-6">
  <p class="text-sm text-gray-500 mb-2">
    From Requirement: <%= task.compliance_requirement.name %>
  </p>
  
  <p class="text-gray-700"><%= task.description %></p>

  <div class="mt-6 border-t border-gray-200 pt-6">
    <dl class="grid grid-cols-1 gap-x-4 gap-y-8 sm:grid-cols-2">
      <div class="sm:col-span-1">
        <dt class="text-sm font-medium text-gray-500">Assignee</dt>
        <dd class="mt-1 text-sm text-gray-900"><%= task.assignee&.full_name || 'Unassigned' %></dd>
      </div>
      <div class="sm:col-span-1">
        <dt class="text-sm font-medium text-gray-500">Due Date</dt>
        <dd class="mt-1 text-sm <%= task.due_date && task.due_date < Date.current ? 'text-red-600' : 'text-gray-900' %>">
          <%= task.due_date ? task.due_date.strftime('%B %d, %Y') : 'N/A' %>
        </dd>
      </div>
      <div class="sm:col-span-1">
        <dt class="text-sm font-medium text-gray-500">Status</dt>
        <dd class="mt-1 text-sm text-gray-900"><%= task.status.humanize %></dd>
      </div>
      <div class="sm:col-span-1">
        <dt class="text-sm font-medium text-gray-500">Priority</dt>
        <dd class="mt-1 text-sm text-gray-900">
          <span class="px-2 py-1 text-xs font-semibold rounded-full <%= task.priority == 'high' ? 'bg-red-100 text-red-800' : 'bg-gray-100 text-gray-800' %>">
            <%= task.priority %>
          </span>
        </dd>
      </div>
    </dl>
  </div>

  <div class="mt-6 flex justify-end space-x-3">
    <%= link_to "Close", "#", data: { action: "click->modal#close" }, class: "bg-white py-2 px-4 border border-gray-300 rounded-md shadow-sm text-sm font-medium text-gray-700 hover:bg-gray-50" %>
    <%= link_to "Provide Feedback", new_feedback_path(feedbackable_type: 'ComplianceControl', feedbackable_id: task.id), class: "bg-indigo-600 py-2 px-4 border border-transparent rounded-md shadow-sm text-sm font-medium text-white hover:bg-indigo-700" %>
  </div>
</div>
